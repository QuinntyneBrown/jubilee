{
  "name": "jubilee-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve jubilee",
    "start:marketing": "npm run media:sync && ng serve marketing",
    "start:admin": "ng serve admin",
    "prebuild": "npm run media:sync",
    "build": "ng build jubilee && ng build marketing && ng build admin",
    "build:app": "ng build jubilee",
    "watch": "ng build jubilee --watch --configuration development",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "cd .. && husky frontend/.husky || true",
    "design:sync": "cp ../docs/design-system/tokens/tokens.css projects/components/src/lib/styles/tokens.css && cp ../docs/design-system/assets/fonts/Archivo.woff2 projects/components/src/lib/assets/fonts/Archivo.woff2 && cp ../docs/design-system/assets/fonts/Inter.woff2 projects/components/src/lib/assets/fonts/Inter.woff2",
    "design:check": "cmp ../docs/design-system/tokens/tokens.css projects/components/src/lib/styles/tokens.css && cmp ../docs/design-system/assets/fonts/Archivo.woff2 projects/components/src/lib/assets/fonts/Archivo.woff2 && cmp ../docs/design-system/assets/fonts/Inter.woff2 projects/components/src/lib/assets/fonts/Inter.woff2",
    "media:sync": "cp ../docs/videos/01-jubilee-pitch/01-jubilee-pitch.mp4 projects/marketing/public/media/jubilee-pitch.mp4 && cp ../docs/assets/photos/*.jpg projects/marketing/public/photos/"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
