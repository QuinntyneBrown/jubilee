@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Review and approve a listing
enum ListingStage {
  Draft
  ReadyToReview
  ChangesRequested
  Live
  Paused
  OnHold
  Removed
  Declined
}
enum ChecklistItem {
  TaglineAndDescriptionHonest
  AtLeastOnePhoto
  CategoryFits
}
enum DecisionKind {
  Approved
  ChangesRequested
  Declined
}
class Listing {
  +Guid Id
  +Guid OwnerId
  +string Name
  +ListingStage Stage
  +bool Verified
  +DateOnly? VerifiedOn
  +DateTimeOffset SubmittedAt
  +byte[] RowVersion
  +Approve(verifier: Member, note: string, now: DateTimeOffset): VerificationDecision
}
class VerificationReview {
  +Guid ListingId
  +IReadOnlyList<ChecklistTick> Ticks
  +SetTick(item: ChecklistItem, ticked: bool, by: Guid, at: DateTimeOffset): void
  +UntickedItems(): IReadOnlyList<ChecklistItem>
}
class ChecklistTick {
  +ChecklistItem Item
  +bool Ticked
  +Guid ReviewerId
  +DateTimeOffset At
}
class ListingFlag {
  +string Code
  +string Detail
}
class VerificationDecision {
  +DecisionKind Kind
  +Guid VerifierId
  +DateTimeOffset DecidedAt
  +string Note
  +string ChecklistSnapshot
}
class ApproveListingCommand {
  +Guid ListingId
  +string Note
  +byte[] ExpectedVersion
}
class ApproveListingCommandHandler {
  +Handle(command: ApproveListingCommand): Task<Result>
}
class ApproveListingCommandValidator {
  +Validate(command: ApproveListingCommand): ValidationResult
}

ApproveListingCommandHandler ..> ApproveListingCommand : handles
ApproveListingCommandValidator ..> ApproveListingCommand : validates
ApproveListingCommandHandler --> Listing : loads / mutates
ApproveListingCommandHandler ..> VerificationReview : reads ticks
Listing "1" *-- "0..1" VerificationReview
Listing "1" *-- "*" ListingFlag
Listing "1" *-- "*" VerificationDecision
VerificationReview "1" *-- "0..3" ChecklistTick
ChecklistTick --> ChecklistItem
VerificationDecision --> DecisionKind
Listing --> ListingStage
@enduml
