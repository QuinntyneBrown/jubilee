@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Review and approve a listing
Person(verifier, "Verification team member", "Reviews one submitted listing and decides on it")
Person(owner, "Owner", "Submitted the listing and waits for the decision")
Person(member, "Member", "Finds the approved listing in public lists")
System(jubilee, "Jubilee", "Toronto's Christian marketplace")
System_Ext(email, "E-mail provider", "Delivers the approval e-mail to the owner")

Rel(verifier, jubilee, "Reviews and approves listings in", "HTTPS")
Rel(jubilee, owner, "Notifies of the approval")
Rel(jubilee, email, "Sends the approval e-mail via")
Rel(email, owner, "Delivers e-mail to")
Rel(member, jubilee, "Browses the live listing in", "HTTPS")
@enduml
