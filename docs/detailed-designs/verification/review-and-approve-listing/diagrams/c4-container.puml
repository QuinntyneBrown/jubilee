@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Review and approve a listing
Person(verifier, "Verification team member", "Reviews and approves a listing")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Review page and approve dialog")
  Container(api, "Jubilee API", "ASP.NET Core", "Review and checklist and approve endpoints plus the real-time hub")
  Container(worker, "Jubilee Worker", ".NET worker service", "Dispatches the outbox: e-mail and notification and search indexing")
  ContainerDb(db, "Jubilee database", "SQL Server", "Listings and reviews and audit entries and outbox")
  ContainerDb(search, "Search index", "Query-time analysis over SQL Server", "Public search over live listings")
  ContainerDb(cache, "Cache", "Redis", "Short-lived read caches of public lists")
}
System_Ext(email, "E-mail provider", "Delivers the approval e-mail")

Rel(verifier, web, "Uses", "HTTPS")
Rel(web, api, "Calls and subscribes", "JSON/HTTPS and WebSocket")
Rel(api, db, "Reads and writes", "EF Core")
Rel(worker, db, "Reads outbox messages", "EF Core")
Rel(worker, search, "Indexes the live listing")
Rel(worker, cache, "Invalidates public list caches")
Rel(worker, email, "Sends approval e-mail", "HTTPS")
@enduml
