@startuml
title UML sequence behaviour — Review a listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Verification team member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "VerificationReviewPage" as page
  participant "ReviewChecklist" as check
  participant "AdminApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AdminVerificationsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetListingReviewQueryHandler" as qh
  participant "SetChecklistItemCommandHandler" as th
  participant "IAuditLog" as audit
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Open /admin/verifications/:id
page -> client : getReview(id)
client -> controller : GET /api/admin/verifications/{id}
controller -> controller : Authenticate session and apply VerifierPolicy (L2-098)
controller -> qh : Send GetListingReviewQuery
qh -> db : Load listing, owner, flags and ticks
db --> qh : Review state
qh -> audit : Record access to personal data with the listing ID (L2-150)
audit --> qh : AuditEntry appended
qh --> controller : ListingReviewDto
alt load succeeds
  controller --> client : 200 with review, flags and allowed actions
  client --> page : Review
  page --> actor : Show panels, flags above the checklist and "How members see you" (L2-100)
  opt stage is "Changes requested"
    page --> actor : Offer no decision until the owner resubmits (L2-100)
  end
else upstream dependency fails
  controller --> client : 502 ProblemDetails with JB-ADM-502
  client --> page : Load error
  page --> actor : Show "We couldn't load this listing" and "Back to the queue"
end
actor -> check : Tick a checklist item
check -> client : setTick(id, item, true)
client -> controller : PUT /api/admin/verifications/{id}/checklist/{item}
controller -> th : Send SetChecklistItemCommand
th -> db : Save tick with reviewer and time (L2-100)
db --> th : Commit result
th --> controller : Typed result
controller --> client : 200 with tick
client --> check : Saved tick
check --> actor : Show the tick as saved
@enduml
