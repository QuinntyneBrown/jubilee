@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Work the verification queue
Person(verifier, "Verification team member", "Works the verification queue")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Admin Web", "Angular single-page application", "Queue page and the admin bar count")
  Container(api, "Jubilee API", "ASP.NET Core", "Admin endpoints under /api/admin for staff sessions with the verifier role")
  ContainerDb(db, "Jubilee database", "SQL Server", "Listings - church references - staff accounts and sessions")
}
Rel(verifier, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
