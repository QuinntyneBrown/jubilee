@startuml
title UML sequence behaviour — Complete the second factor
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Verification team member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "SignInPage" as signin
  participant "SecondFactorPage" as page
  participant "AccountApi" as client
  participant "VerifierGuard" as guard
end box
box "Backend — Jubilee API" #D1FADF
  participant "AuthController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "VerifySecondFactorCommandHandler" as handler
  participant "Session" as session
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Cache" as cache
  database "Jubilee database" as db
end box
actor -> signin : Sign in with e-mail and password
signin -> client : signIn(credentials)
client -> controller : POST /api/auth/sign-in
controller --> client : 200 with role verifier and secondFactorRequired
client --> signin : Session without second factor
signin -> page : Navigate to the second factor step
actor -> page : Enter TOTP code or use passkey
page -> client : verifySecondFactor(proof)
client -> controller : POST /api/auth/second-factor
controller -> handler : Send VerifySecondFactorCommand
handler -> db : Load the member's second factor credential
db --> handler : Credential
alt proof is valid
  handler -> session : MarkSecondFactorVerified(now) (L2-098)
  session --> handler : Updated session
  handler -> cache : Save session
  cache --> handler : Saved
  handler --> controller : Success
  controller --> client : 204
  client --> page : Verified
  page -> guard : Navigate to /admin/verifications
  guard --> actor : Admin routes available
else proof is invalid
  handler --> controller : Failure
  controller --> client : 422 ProblemDetails
  client --> page : Invalid proof
  page --> actor : Show the field error and keep admin routes closed
end
@enduml
