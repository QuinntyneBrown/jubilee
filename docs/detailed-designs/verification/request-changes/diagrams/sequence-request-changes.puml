@startuml
title UML sequence behaviour — Request changes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Verification team member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "VerificationReviewPage" as page
  participant "RequestChangesDialog" as dialog
  participant "AdminApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AdminVerificationsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "RequestChangesCommandHandler" as handler
  participant "Listing" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as job
end box
participant "E-mail provider" as email
actor -> page : Press "Request changes"
page -> dialog : Open "Ask {owner} for changes"
actor -> dialog : Tick areas, write the message and send
alt message is empty
  dialog --> actor : Show "Tell the owner exactly what to change." (L2-102)
else message present
  dialog -> client : requestChanges(id, areas, message)
  client -> controller : POST /api/admin/verifications/{id}/change-requests
  controller -> controller : Authenticate, apply VerifierPolicy and refuse the listing's owner (L2-098)
  controller -> handler : Send RequestChangesCommand
  handler -> db : Load listing
  db --> handler : Current state
  handler -> entity : RequestChanges(areas, message, verifier, now)
  entity --> handler : Stage ChangesRequested and ChangeRequest with snapshot (L2-102)
  handler -> db : Save listing, AuditEntry (L2-180) and OutboxMessage in one unit of work
  db --> handler : Commit result
  handler --> controller : Typed result
  controller --> client : 201 with change request
  client --> dialog : Sent
  dialog --> page : Close
  page --> actor : Show "Waiting on the owner." with the count of changes and the time
  job -> db : Read ChangesRequested from the outbox
  db --> job : Outbox message
  job -> email : Send the message to the owner
  email --> job : Accepted
  job -> db : Create the owner notification and mark dispatched
  db --> job : Commit result
end
opt send fails
  controller --> client : 5xx ProblemDetails
  client --> dialog : Failure
  dialog --> actor : Keep the message and show "We couldn't send the request."
end
@enduml
