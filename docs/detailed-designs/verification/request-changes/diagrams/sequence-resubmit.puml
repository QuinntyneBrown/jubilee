@startuml
title UML sequence behaviour — Resubmit a listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "MyBusinessPage" as page
  participant "ListingsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ListingsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ResubmitListingCommandHandler" as handler
  participant "Listing" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Read the requested changes, edit and press "Resubmit"
page -> client : resubmit(listingId)
client -> controller : POST /api/listings/{id}/resubmit
controller -> controller : Authenticate and check the caller owns the listing (L2-133)
controller -> handler : Send ResubmitListingCommand
handler -> db : Load listing with its open ChangeRequest
db --> handler : Current state
handler -> entity : Resubmit(now)
entity --> handler : Stage ReadyToReview, SubmittedAt unchanged (L2-103)
handler -> db : Save listing in one unit of work
db --> handler : Commit result
handler --> controller : Typed result
controller --> client : 200 with stage
client --> page : Resubmitted
page --> actor : Show the listing as back with the verification team
@enduml
