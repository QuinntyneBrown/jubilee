@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Request changes
Container_Boundary(web, "Jubilee Web") {
  Component(review, "VerificationReviewPage", "Angular page", "Opens the dialogs and highlights changed fields")
  Component(rdialog, "RequestChangesDialog", "Angular dialog", "Collects change areas and the message to the owner")
  Component(ddialog, "DeclineListingDialog", "Angular dialog", "Collects the decline reason for the owner")
  Component(mybiz, "MyBusinessPage", "Angular page", "Shows requested changes and the Resubmit action")
}
Container_Boundary(api, "Jubilee API") {
  Component(actrl, "AdminVerificationsController", "ASP.NET Core controller", "Exposes change-requests and decline endpoints")
  Component(lctrl, "ListingsController", "ASP.NET Core controller", "Exposes POST /api/listings/id/resubmit")
  Component(rh, "RequestChangesCommandHandler", "MediatR handler", "Records the change request")
  Component(sh, "ResubmitListingCommandHandler", "MediatR handler", "Returns the listing to the queue")
  Component(dh, "DeclineListingCommandHandler", "MediatR handler", "Closes the listing with a reason")
  Component(listing, "Listing", "Domain entity", "Owns the stage transitions")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(outbox, "OutboxDispatcherJob", "Hosted job", "Sends owner e-mail and notification")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Listings and change requests and outbox")

Rel(review, rdialog, "Opens")
Rel(review, ddialog, "Opens")
Rel(rdialog, actrl, "Posts the change request to", "JSON/HTTPS")
Rel(ddialog, actrl, "Posts the decline to", "JSON/HTTPS")
Rel(mybiz, lctrl, "Posts the resubmission to", "JSON/HTTPS")
Rel(actrl, rh, "Sends RequestChangesCommand")
Rel(actrl, dh, "Sends DeclineListingCommand")
Rel(lctrl, sh, "Sends ResubmitListingCommand")
Rel(rh, listing, "Calls RequestChanges on")
Rel(sh, listing, "Calls Resubmit on")
Rel(dh, listing, "Calls Decline on")
Rel(listing, db, "Is persisted in", "EF Core")
Rel(outbox, db, "Reads outbox", "EF Core")
@enduml
