@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Request changes
Person(verifier, "Verification team member", "Requests changes or declines")
Person(owner, "Owner", "Resubmits the listing")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Review page and dialogs and My business page")
  Container(api, "Jubilee API", "ASP.NET Core", "Change request and decline and resubmit endpoints")
  Container(worker, "Jubilee Worker", ".NET worker service", "Outbox dispatch")
  ContainerDb(db, "Jubilee database", "SQL Server", "Listings and change requests and audit and outbox")
}
System_Ext(email, "E-mail provider", "Delivers e-mail")

Rel(verifier, web, "Uses", "HTTPS")
Rel(owner, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(worker, db, "Reads outbox", "EF Core")
Rel(worker, email, "Sends e-mail", "HTTPS")
@enduml
