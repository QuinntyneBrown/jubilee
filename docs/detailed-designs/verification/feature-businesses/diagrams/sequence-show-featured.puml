@startuml
title UML sequence behaviour — Show featured businesses
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "BrowsePage" as page
  participant "FeaturedStrip" as strip
  participant "DirectoryApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "DirectoryController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetFeaturedListingsQueryHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Cache" as cache
  database "Jubilee database" as db
end box
actor -> page : Open the browse page or the welcome page
page -> strip : Render
strip -> client : getFeatured()
client -> controller : GET /api/featured
controller -> handler : Send GetFeaturedListingsQuery(today)
handler -> cache : Read the cached featured list
alt cache hit
  cache --> handler : Featured list
else cache miss
  cache --> handler : Nothing
  handler -> db : Read the week active today: start date <= today < start date + 7 days
  db --> handler : Slots joined to listings
  handler -> handler : Skip listings that are paused or removed (L2-106)
  handler -> cache : Store the list for a short time
  cache --> handler : Stored
end
handler --> controller : FeaturedBusinessDto list
controller --> client : 200 with zero to five businesses
client --> strip : Featured businesses
alt at least one business
  strip --> actor : Show "Featured this week" with the businesses in slot order
else none
  strip --> actor : Render nothing
end
@enduml
