@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Queue messages offline

Container_Boundary(web, "Jubilee Web") {
  Component(page, "ConversationPage", "Angular page", "Composer. Gives each message a key with newKey(). Sends or queues")
  Component(queue, "OutgoingMessageQueue", "IndexedDB store", "jubilee-outbox. Messages in sequence order. Requests Background Sync")
  Component(drainer, "QueueDrainer", "Angular service", "Drains on start and when the connection returns. Expires every 60 s")
  Component(conn, "ConnectionService", "Angular service", "cannotDeliver, returned, announceSent")
  Component(banner, "ConnectionBanner", "components library", "back-online kind reports how many saved messages were sent")
  Component(mapi, "HttpMessagesApi", "MESSAGES_API", "POST /api/conversations/{conversationId}/messages with body and idempotencyKey")
}
Container_Boundary(sw, "Jubilee service worker") {
  Component(sync, "sync handler", "jubilee-sw.js", "Drains jubilee-outbox on the sync event. Rejects to be tried again")
}
ContainerDb(idb, "jubilee-outbox", "IndexedDB on the device", "Store messages keyed by sequence")
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "ConversationsController", "ASP.NET Core controller", "Send action. RequiresConfirmedEmail. 201 Created")
  Component(handler, "SendMessageCommandHandler", "MediatR handler", "Returns the earlier message for a repeated key, or adds the message")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Messages unique on SenderSubject and IdempotencyKey")

Rel(page, conn, "Reads cannotDeliver from")
Rel(page, queue, "Enqueues when it cannot deliver")
Rel(page, mapi, "Sends through when it can")
Rel(page, drainer, "Refreshes on delivered from")
Rel(drainer, conn, "Drains on returned. Announces the count to")
Rel(drainer, queue, "Reads, removes and marks")
Rel(drainer, mapi, "Posts each message through")
Rel(banner, conn, "Reads backOnline from")
Rel(queue, idb, "Reads and writes")
Rel(queue, sync, "Registers the sync tag jubilee-outbox for", "SyncManager")
Rel(sync, idb, "Reads, removes and marks")
Rel(sync, drainer, "Posts jubilee-outbox-sent with the count to", "postMessage")
Rel(mapi, ctrl, "Calls", "JSON/HTTPS")
Rel(sync, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, handler, "Sends SendMessageCommand")
Rel(handler, db, "Looks up the key and saves", "EF Core")
@enduml
