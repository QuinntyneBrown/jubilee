@startuml
title UML sequence behaviour — Expire a message after 24 hours
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ConversationPage" as page
  participant "QueueDrainer" as drainer
  participant "OutgoingMessageQueue" as queue
end box
drainer -> queue : expire(now), every 60 s and before each drain
queue -> queue : Find 'waiting' messages with queuedAt more than 24 hours ago
queue -> queue : Mark each 'not-sent' (L2-120 AC3)
queue --> drainer : Number marked
queue --> page : items changed
page --> actor : Show "Not sent" with "Try again" and "Delete"
alt Member presses "Try again"
  actor -> page : Press "Try again"
  page -> queue : retry(message): state 'waiting', new queuedAt, same idempotencyKey
  queue --> page : items changed
  page -> drainer : drain(false)
  drainer --> page : delivered + 1 when it was sent
  page --> actor : Show the message as sent, or "Waiting to send"
else Member presses "Delete"
  actor -> page : Press "Delete"
  page -> queue : remove(message)
  queue --> page : items changed
  page --> actor : Remove the message from the thread
end
@enduml
