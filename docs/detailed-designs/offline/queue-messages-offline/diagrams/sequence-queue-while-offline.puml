@startuml
title UML sequence behaviour — Queue a message while offline
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ConversationPage" as page
  participant "ConnectionService" as conn
  participant "OutgoingMessageQueue" as queue
end box
box "Frontend — Device" #E0F2FE
  database "jubilee-outbox" as idb
end box
box "Frontend — Jubilee service worker" #E0F2FE
  participant "ServiceWorkerRegistration.sync" as sync
end box
actor -> page : Write a message and press "Send"
page -> page : key = newKey() (L2-132)
page -> conn : cannotDeliver()
conn --> page : true (offline or unreachable)
alt Text message
  page -> queue : enqueue(conversationId, body, key)
  queue -> idb : add { conversationId, body, idempotencyKey, queuedAt in UTC, state 'waiting' }
  idb --> queue : Next sequence assigned
  queue -> queue : Reload items in sequence order
  opt Browser has SyncManager
    queue -> sync : register('jubilee-outbox') (L2-120 AC5)
    sync --> queue : Registered
  end
  queue --> page : items changed
  page --> actor : Show the message marked "Waiting to send" (L2-120 AC1)
else Message with a photo
  page -> page : Not queued; the send fails with no answer
  page --> actor : "Not sent. Check your connection." with "Try again" and "Delete" (L2-120 AC4)
end
@enduml
