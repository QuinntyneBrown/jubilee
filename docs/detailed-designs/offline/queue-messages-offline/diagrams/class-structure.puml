@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Queue messages offline

class QueuedMessage {
  +sequence: number
  +conversationId: string
  +body: string
  +idempotencyKey: string
  +queuedAt: string
  +state: 'waiting' | 'not-sent'
}

class OutgoingMessageQueue {
  +items: Signal<QueuedMessage[]>
  +ready: Promise<void>
  +enqueue(conversationId: string, body: string, idempotencyKey: string): Promise<void>
  +nextWaiting(): QueuedMessage | undefined
  +markSent(message: QueuedMessage): Promise<void>
  +markNotSent(message: QueuedMessage): Promise<void>
  +retry(message: QueuedMessage): Promise<void>
  +remove(message: QueuedMessage): Promise<void>
  +expire(now: Date): Promise<number>
  +clear(): Promise<void>
}

class QueueDrainer {
  +delivered: Signal<number>
  +start(): void
  +drain(announce: boolean): Promise<void>
}

class ConnectionService {
  +cannotDeliver: Signal<boolean>
  +returned: Signal<number>
  +backOnline: Signal<number | null>
  +announceSent(count: number): void
}

class ConversationPage {
  #send(): void
  #retryQueued(queued: QueuedMessage): void
  #discardQueued(queued: QueuedMessage): void
}

class HttpMessagesApi {
  +send(id: string, body: string, idempotencyKey: string, attachmentId?: string): Observable<ChatMessage>
}

class "jubilee-sw.js sync handler" as SyncHandler <<service worker>> {
  +tag: 'jubilee-outbox'
}

class SendMessageCommand <<record>> {
  +ConversationId: Guid
  +Subject: string
  +Name: string
  +Body: string?
  +IdempotencyKey: string?
  +AttachmentId: Guid?
}

class SendMessageCommandHandler {
  +Handle(request: SendMessageCommand, ct: CancellationToken): Task<MessageDto>
}

class Conversation {
  +Id: Guid
  +LastMessageAt: DateTimeOffset
  +NextMessageTime(now: DateTimeOffset): DateTimeOffset
  +Touch(now: DateTimeOffset): void
}

class Message {
  +Id: Guid
  +ConversationId: Guid
  +SenderSubject: string
  +Body: string
  +IdempotencyKey: string
  +CreatedAt: DateTimeOffset
  +{static} Send(...): Message
}

OutgoingMessageQueue "1" *-- "*" QueuedMessage : stores
ConversationPage ..> OutgoingMessageQueue : enqueues / retries / removes
ConversationPage ..> HttpMessagesApi : sends
ConversationPage ..> ConnectionService : reads cannotDeliver
ConversationPage ..> QueueDrainer : refreshes on delivered
QueueDrainer ..> OutgoingMessageQueue : reads / removes / marks
QueueDrainer ..> HttpMessagesApi : posts
QueueDrainer ..> ConnectionService : drains on returned, announces
SyncHandler ..> QueuedMessage : sends / removes / marks
SyncHandler ..> QueueDrainer : posts jubilee-outbox-sent
HttpMessagesApi ..> SendMessageCommand : request becomes
SendMessageCommandHandler ..> SendMessageCommand : handles
SendMessageCommandHandler ..> Conversation : loads / touches
SendMessageCommandHandler ..> Message : finds by key or creates
Conversation "1" -- "*" Message : contains
@enduml
