@startuml
title UML sequence behaviour — Send queued messages on reconnect
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ConnectionBanner" as banner
  participant "ConnectionService" as conn
  participant "QueueDrainer" as drainer
  participant "OutgoingMessageQueue" as queue
  participant "HttpMessagesApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ConversationsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SendMessageCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
conn -> drainer : returned + 1 (the connection came back)
drainer -> queue : expire(now)
drainer -> conn : cannotDeliver()
conn --> drainer : false
drainer -> drainer : Acquire Web Lock jubilee-outbox-drain
drainer -> queue : Re-read the queue from IndexedDB
loop Each waiting message in sequence order (L2-120 AC1)
  drainer -> queue : nextWaiting()
  queue --> drainer : QueuedMessage
  drainer -> client : send(conversationId, body, idempotencyKey)
  client -> controller : POST /api/conversations/{conversationId}/messages { body, idempotencyKey }
  controller -> handler : Send SendMessageCommand
  handler -> db : Find the conversation of the caller
  handler -> db : Find a Message of this sender with this IdempotencyKey (L2-132)
  alt Key not used before
    db --> handler : None
    handler -> handler : Message.Send, notification, e-mail queued
    handler -> db : Save in one unit of work
    db --> handler : Saved
  else Key already used
    db --> handler : Earlier Message
  end
  handler --> controller : MessageDto
  controller --> client : 201 Created
  alt Delivered
    client --> drainer : ChatMessage
    drainer -> queue : markSent(message), removed from the queue
    drainer -> drainer : sent + 1, delivered + 1
  else Refused (4xx other than 408 and 429)
    client --> drainer : Error
    drainer -> queue : markNotSent(message)
  else No answer, 5xx, 408 or 429
    client --> drainer : Error
    drainer -> drainer : Stop the pass; the message keeps waiting
  end
end
drainer -> conn : announceSent(sent)
conn --> banner : back-online with the count
banner --> actor : "You're back online. {n} saved message(s) was/were sent." (L2-120 AC2)
@enduml
