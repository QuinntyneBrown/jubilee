@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Queue messages offline

Person(member, "Member", "Writes a message while offline")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Conversation page, outgoing queue, QueueDrainer and connection banner")
  Container(sw, "Jubilee service worker", "jubilee-sw.js", "Drains the outgoing queue on the Background Sync event jubilee-outbox, also when no page is open")
  ContainerDb(idb, "jubilee-outbox", "IndexedDB on the device", "Messages waiting to send, in sequence order, each with its idempotency key")
  Container(api, "Jubilee API", "ASP.NET Core", "Accepts messages under /api and returns the original message for a repeated idempotency key")
  ContainerDb(db, "Jubilee database", "SQL Server", "Conversations and messages, unique on sender and idempotency key")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, idb, "Enqueues, drains and marks", "IndexedDB")
Rel(web, sw, "Requests a sync with the tag jubilee-outbox", "SyncManager")
Rel(sw, idb, "Drains and marks", "IndexedDB")
Rel(sw, web, "Posts jubilee-outbox-sent with the count to open pages", "postMessage")
Rel(web, api, "Posts queued messages to", "JSON/HTTPS")
Rel(sw, api, "Posts queued messages to", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
