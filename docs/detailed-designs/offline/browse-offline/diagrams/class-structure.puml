@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Browse offline

enum ConnectionState {
  online
  offline
  unreachable
  slow
}

class ConnectionService {
  +state: Signal<ConnectionState>
  +isOffline: Signal<boolean>
  +returned: Signal<number>
  +detail: WritableSignal<string | null>
  +check(): Promise<void>
}

class "Snapshot<T>" as Snapshot {
  +key: string
  +savedAt: string
  +touchedAt: number
  +data: T
}

class OfflineSnapshotStore {
  +save(key: string, data: T): Promise<void>
  +read(key: string): Promise<Snapshot<T> | null>
  +clear(): Promise<void>
  -keepLastConversations(db: IDBDatabase): Promise<void>
}

class DirectoryStore {
  +state: Signal<LoadState<BrowseHome>>
  +savedAt: Signal<string | null>
  +load(): void
  -failed(error: unknown): Promise<void>
}

class BrowsePage {
  #offline: Signal<boolean>
  #needsConnection: string
}

class ConversationPage {
  #open(): void
  -showSaved(): Promise<void>
}

class OfflineNavigation {
  +show(returnUrl: string): void
}

class OfflinePage {
  -returnUrl: string
  #tryAgain(): Promise<void>
  -leave(): void
}

class RequiresConnection <<directive jbRequiresConnection>> {
}

class connectionInterceptor <<HttpInterceptorFn>> {
}

class SessionService {
  +signOut(): Observable<void>
}

class OutgoingMessageQueue {
  +clear(): Promise<void>
}

class GetBrowseHomeQueryHandler {
  +Handle(query: GetBrowseHomeQuery, ct: CancellationToken): Task<BrowseHomeDto>
}

class BrowseHomeDto {
  +LiveBusinessCount: int
  +Categories: IReadOnlyList<CategoryLinkDto>
  +Featured: IReadOnlyList<BusinessCardDto>
  +Products: IReadOnlyList<ProductCardDto>
  +Groups: IReadOnlyList<CategoryGroupDto>
  +Rooms: RoomsShelfDto
}

ConnectionService --> ConnectionState : holds
OfflineSnapshotStore "1" *-- "*" Snapshot : stores
BrowsePage *-- DirectoryStore : provides
BrowsePage ..> ConnectionService : writes detail
DirectoryStore ..> OfflineSnapshotStore : saves / reads browse-home
DirectoryStore ..> ConnectionService : reads isOffline
DirectoryStore ..> OfflineNavigation : shows offline page
ConversationPage ..> OfflineSnapshotStore : saves / reads conversation:{id}
ConversationPage ..> OfflineNavigation : shows offline page
connectionInterceptor ..> OfflineNavigation : shows offline page
connectionInterceptor ..> ConnectionService : reads isOffline
OfflineNavigation ..> OfflinePage : navigates to
OfflinePage ..> ConnectionService : waits for returned
RequiresConnection ..> ConnectionService : reads isOffline
SessionService ..> OfflineSnapshotStore : clears
SessionService ..> OutgoingMessageQueue : clears
GetBrowseHomeQueryHandler ..> BrowseHomeDto : returns
@enduml
