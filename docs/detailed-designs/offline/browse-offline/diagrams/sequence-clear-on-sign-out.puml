@startuml
title UML sequence behaviour — Clear the device on sign-out
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "SignOutDialog" as dialog
  participant "DraftRegistry" as drafts
  participant "SessionService" as session
  participant "OfflineSnapshotStore" as snap
  participant "OutgoingMessageQueue" as queue
end box
box "Backend — Jubilee API" #D1FADF
  participant "SessionController" as controller
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> dialog : Confirm sign out
dialog -> drafts : saveAll(), drafts stay keyed by member (L2-011 AC3)
dialog -> session : signOut()
session -> controller : DELETE /api/session
controller -> db : End the session (DatabaseTicketStore)
db --> controller : Removed
controller --> session : 204 No Content
session -> session : Member becomes a visitor
session -> snap : clear() (L2-119)
snap --> session : jubilee-offline emptied
session -> queue : clear() (L2-119)
queue --> session : jubilee-outbox emptied
note over session : The service worker's caches hold only the public app shell and are kept
session --> dialog : Signed out
dialog --> actor : Show /welcome
@enduml
