@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Browse offline

Container_Boundary(web, "Jubilee Web") {
  Component(browse, "BrowsePage", "Angular page", "Shows the saved directory and writes the saved time into the banner")
  Component(store, "DirectoryStore", "Angular store", "Loads the browse home. Saves it, or reads the saved copy offline")
  Component(dapi, "HttpDirectoryApi", "DIRECTORY_API", "GET /api/directory/home")
  Component(convo, "ConversationPage", "Angular page", "Saves each opened conversation. Shows the saved copy offline")
  Component(mapi, "HttpMessagesApi", "MESSAGES_API", "GET /api/conversations/{conversationId}")
  Component(snap, "OfflineSnapshotStore", "IndexedDB store", "browse-home and conversation:{id} snapshots. Keeps the last 20 conversations")
  Component(icpt, "connectionInterceptor", "HTTP interceptor", "Opens the offline page for a read with no answer while offline")
  Component(nav, "OfflineNavigation", "Angular service", "Navigates to /offline with skipLocationChange and returnUrl")
  Component(offline, "OfflinePage", "Angular page", "Opens the original page when the connection returns")
  Component(conn, "ConnectionService", "Angular service", "isOffline, returned and detail signals")
  Component(banner, "ConnectionBanner", "components library", "Persistent offline banner with Try again")
  Component(dir, "RequiresConnection", "Angular directive", "jbRequiresConnection disables a control offline and says why")
  Component(session, "SessionService", "Angular service", "Signs out, then clears the device")
  Component(queue, "OutgoingMessageQueue", "IndexedDB store", "Messages waiting to send")
}
Container(sw, "Jubilee service worker", "Angular service worker", "Caches the app shell only")
ContainerDb(idb, "IndexedDB", "Device", "jubilee-offline and jubilee-outbox databases")
Container_Boundary(api, "Jubilee API") {
  Component(dctrl, "DirectoryController", "ASP.NET Core controller", "GET /api/directory/home")
  Component(dhandler, "GetBrowseHomeQueryHandler", "MediatR handler", "Builds the BrowseHomeDto")
  Component(cctrl, "ConversationsController", "ASP.NET Core controller", "GET /api/conversations/{conversationId}")
  Component(chandler, "GetConversationQueryHandler", "MediatR handler", "Builds the ConversationDto for a participant")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Listings, categories and conversations")

Rel(sw, browse, "Starts Jubilee Web from the app shell for")
Rel(browse, store, "Reads directory and savedAt from")
Rel(browse, conn, "Writes detail and reads returned on")
Rel(banner, conn, "Reads state and detail from")
Rel(store, dapi, "Loads browse home through")
Rel(store, snap, "Saves and reads browse-home in")
Rel(store, nav, "Opens the offline page through")
Rel(convo, mapi, "Opens a conversation through")
Rel(convo, snap, "Saves and reads conversation:{id} in")
Rel(dir, conn, "Reads isOffline from")
Rel(icpt, nav, "Opens the offline page through")
Rel(nav, offline, "Navigates to with returnUrl")
Rel(offline, conn, "Waits for returned on")
Rel(session, snap, "Clears")
Rel(session, queue, "Clears")
Rel(snap, idb, "Reads and writes")
Rel(queue, idb, "Reads and writes")
Rel(dapi, dctrl, "Calls", "JSON/HTTPS")
Rel(mapi, cctrl, "Calls", "JSON/HTTPS")
Rel(dctrl, dhandler, "Sends GetBrowseHomeQuery")
Rel(cctrl, chandler, "Sends GetConversationQuery")
Rel(dhandler, db, "Reads", "EF Core")
Rel(chandler, db, "Reads", "EF Core")
@enduml
