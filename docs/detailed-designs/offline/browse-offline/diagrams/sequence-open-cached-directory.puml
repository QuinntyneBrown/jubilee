@startuml
title UML sequence behaviour — Open the saved directory
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee service worker" #E0F2FE
  participant "jubilee-sw.js and ngsw-worker.js" as sw
end box
box "Frontend — Jubilee Web" #E0F2FE
  participant "BrowsePage" as page
  participant "DirectoryStore" as store
  participant "HttpDirectoryApi" as client
  participant "OfflineSnapshotStore" as snap
  participant "ConnectionService" as conn
  participant "ConnectionBanner" as banner
end box
box "Backend — Jubilee API" #D1FADF
  participant "DirectoryController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetBrowseHomeQueryHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> sw : Open /browse
sw -> sw : Navigation request, freshness: network first
alt Network answers
  sw --> page : index.html from the network
else Network fails
  sw --> page : Cached index.html, Jubilee opens with no connection (L2-119)
end
page -> store : load()
store -> client : getHome()
note right of client : The service worker leaves /api/ requests to the network and caches no answer
alt Device is online
  client -> controller : GET /api/directory/home
  controller -> handler : Send GetBrowseHomeQuery
  handler -> db : Read listings and categories
  db --> handler : Rows
  handler --> controller : BrowseHomeDto
  controller --> client : 200 OK
  client --> store : BrowseHome
  store -> snap : save("browse-home", value), savedAt in UTC
  store -> store : savedAt = null
  store --> page : Directory
  page --> actor : Show the directory
else Device is offline and the browse home was opened before
  client --> store : No answer (status 0)
  store -> snap : read("browse-home")
  snap --> store : Snapshot with data and savedAt
  store -> store : savedAt = snapshot.savedAt
  store --> page : Saved directory
  page -> conn : detail = "Showing the directory saved at {time}. ..." (America/Toronto, L2-131)
  conn --> banner : offline with detail
  banner --> actor : Persistent banner "You're offline. Showing the directory saved at {time}. Search and messages will work again when you're connected." with "Try again" (L2-119)
  page --> actor : Saved directory, search disabled with "Needs a connection. It works again when you're back online."
else Device is offline and nothing is saved
  snap --> store : null
  store -> store : OfflineNavigation.show() (L2-122)
end
@enduml
