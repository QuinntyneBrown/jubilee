@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show connection state

Container_Boundary(web, "Jubilee Web") {
  Component(app, "App", "Application shell", "Maps the state to a banner kind. Mounts the banner once")
  Component(banner, "ConnectionBanner", "components library", "offline, unreachable, slow and back-online kinds. Polite live region")
  Component(conn, "ConnectionService", "Angular service", "State machine, probe, back-off countdown and latency mean")
  Component(timings, "timings()", "TypeScript function", "The waits: 5 s probe, 5 s to 60 s back-off, 30 s window, 3 s mean")
  Component(icpt, "connectionInterceptor", "HTTP interceptor", "Reports every request. Retries a write for 60 s. Toast at 5 s")
  Component(toast, "ToastService", "components library", "Shows the warning toast")
  Component(sse, "SseEventsApi", "EVENTS_API", "Event stream. Reopens on the online event")
}
Container_Boundary(api, "Jubilee API") {
  Component(health, "HealthController", "ASP.NET Core controller", "GET /api/health/ping returns 204")
  Component(events, "EventsController", "ASP.NET Core controller", "GET /api/events as server-sent events")
}
System_Ext(status, "Status page", "Public service status")

Rel(app, conn, "Reads state, countdown, detail and backOnline from")
Rel(app, banner, "Renders")
Rel(banner, status, "Links to", "HTTPS")
Rel(conn, timings, "Reads waits from")
Rel(conn, health, "Probes", "HTTPS")
Rel(icpt, conn, "Reports latency, success and no answer to")
Rel(icpt, toast, "Raises the slow-request warning through")
Rel(icpt, timings, "Reads waits from")
Rel(sse, events, "Connects to", "Server-sent events")
@enduml
