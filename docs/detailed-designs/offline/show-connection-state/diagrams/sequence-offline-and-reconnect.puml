@startuml
title UML sequence behaviour — Go offline and reconnect
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
participant "Browser" as browser
box "Frontend — Jubilee Web" #E0F2FE
  participant "ConnectionBanner" as banner
  participant "ConnectionService" as conn
  participant "BackoffSchedule" as backoff
  participant "ReachabilityProbe" as probe
end box
box "Backend — Jubilee API" #D1FADF
  participant "HealthController" as health
end box
browser -> conn : offline event
conn -> conn : Set state Offline
conn --> banner : Offline
banner --> actor : Persistent banner "You're offline." within 2 seconds (L2-121)
browser -> conn : online event
loop Until a probe succeeds
  conn -> probe : check()
  probe -> health : GET /api/health/ping
  alt Probe fails
    health --> probe : No response
    probe --> conn : ServiceUnreachable or NoNetwork
    conn -> backoff : nextDelaySeconds()
    backoff --> conn : 5 s, then 10 s, 20 s, 40 s, 60 s (L2-121)
    conn -> conn : Set state Reconnecting, count down each second
    conn --> banner : Reconnecting, seconds to retry
    banner --> actor : "Reconnecting… Trying again in {n} seconds."
  else Probe succeeds
    health --> probe : 204 No Content
    probe --> conn : Reachable
    conn -> backoff : reset()
    backoff --> conn : Schedule reset
    conn -> conn : Set state Online
    conn --> banner : Online
    banner --> actor : Dismissible success banner "You're back online." (L2-067)
  end
end
@enduml
