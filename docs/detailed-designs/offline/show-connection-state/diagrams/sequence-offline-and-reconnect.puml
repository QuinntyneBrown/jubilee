@startuml
title UML sequence behaviour — Go offline and reconnect
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
participant "Browser" as browser
box "Frontend — Jubilee Web" #E0F2FE
  participant "ConnectionBanner" as banner
  participant "ConnectionService" as conn
  participant "QueueDrainer" as drainer
  participant "SseEventsApi" as sse
end box
box "Backend — Jubilee API" #D1FADF
  participant "HealthController" as health
  participant "EventsController" as events
end box
browser -> conn : offline event
conn -> conn : state offline, stop waiting, forget latencies
conn --> banner : offline
banner --> actor : Persistent banner "You're offline." with "Try again", at once (L2-121 AC1)
browser -> conn : online event
conn -> health : GET /api/health/ping (5 s timeout)
alt Probe answers
  health --> conn : 204 No Content
  conn -> conn : state online, reset back-off, backOnline = 0, returned + 1
  conn --> banner : back-online
  banner --> actor : Dismissible success banner "You're back online." (L2-067 AC2)
  conn --> drainer : returned changed
  drainer -> drainer : drain(true), see the queue messages offline design
else Probe fails
  health --> conn : No answer, 502, 503 or 504
  conn -> conn : state unreachable, see "Detect an unreachable API"
end
browser -> sse : online event
opt The EventSource was closed
  sse -> events : GET /api/events?lastEventId={id} (ADR 0053)
  events --> sse : Stream open, missed events sent
end
@enduml
