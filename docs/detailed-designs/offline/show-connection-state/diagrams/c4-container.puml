@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Show connection state

Person(member, "Member", "Uses Jubilee on a mobile network")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Detects the connection state. Shows the banner and the slow-request toast")
  Container(api, "Jubilee API", "ASP.NET Core", "Probe endpoint /api/health/ping and real-time hub")
}
System_Ext(status, "Status page", "Public service status. Hosted apart from the API; address in ADR 0032")
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Probes reachability of", "JSON/HTTPS")
Rel(web, api, "Holds a persistent connection to", "WebSocket or server-sent events")
Rel(web, status, "Links to", "HTTPS")
@enduml
