@startuml
title UML sequence behaviour — Handle a slow request
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "Request dialog" as dialog
  participant "connectionInterceptor" as icpt
  participant "ToastService" as toast
  participant "ConnectionService" as conn
  participant "ConnectionBanner" as banner
end box
box "Backend — Jubilee API" #D1FADF
  participant "Jubilee API" as api
end box
actor -> dialog : Submit a request
dialog -> icpt : POST with its idempotency key, not OWN_RETRY
icpt -> api : First attempt
icpt -> icpt : 5 seconds pass without a response
icpt -> toast : show warning (L2-121 AC5)
toast --> actor : "Still sending your request. Your connection is slow. We'll keep trying for a minute."
loop No answer and less than 60 seconds since the first attempt
  icpt -> icpt : Wait 2 seconds
  icpt -> api : Same request, same idempotency key (L2-132 AC2)
end
alt Response arrives within 60 seconds
  api --> icpt : 201 Created
  icpt -> conn : recordLatency(ms), reportSuccess()
  icpt --> dialog : Response
  dialog --> actor : Show success state
else No answer after 60 seconds
  icpt -> conn : reportNetworkFailure()
  icpt --> dialog : Error
  dialog --> actor : Show failed state with input kept
end
conn -> conn : Mean over the last 30 seconds above 3 seconds
conn -> conn : state slow
conn --> banner : slow
banner --> actor : Warning banner "Your connection is slow. Pages may take longer to load." (L2-121 AC4)
@enduml
