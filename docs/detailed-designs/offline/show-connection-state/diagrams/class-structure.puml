@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Show connection state

enum ConnectionState {
  online
  offline
  unreachable
  slow
}

enum ConnectionBannerKind {
  offline
  unreachable
  slow
  back-online
}

class ConnectionService {
  +state: Signal<ConnectionState>
  +isOffline: Signal<boolean>
  +cannotDeliver: Signal<boolean>
  +countdown: Signal<number | null>
  +detail: Signal<string | null>
  +backOnline: Signal<number | null>
  +returned: Signal<number>
  +check(): Promise<void>
  +reportNetworkFailure(): void
  +reportSuccess(): void
  +recordLatency(ms: number): void
  +announceSent(count: number): void
  +dismissBackOnline(): void
  -probe(): Promise<'reached' | 'unreachable' | 'no-network'>
  -goOffline(): void
  -unreachable(): void
  -reached(): void
}

class Timings <<interface>> {
  +probeTimeout: number
  +backoff: number[]
  +latencyWindow: number
  +slowMean: number
  +slowRequest: number
  +retryWindow: number
  +retryEvery: number
  +expiryEvery: number
  +queueLifetime: number
}

class connectionInterceptor <<HttpInterceptorFn>> {
  -isNoAnswer(error: unknown): boolean
}

class ConnectionBanner {
  +kind: InputSignal<ConnectionBannerKind>
  +detail: InputSignal<string | null>
  +countdown: InputSignal<number | null>
  +sent: InputSignal<number>
  +statusUrl: InputSignal<string>
  +retry: OutputEmitterRef<void>
  +dismiss: OutputEmitterRef<void>
}

class App {
  #connection: ConnectionService
  #statusUrl: string
  #banner: Signal<ConnectionBannerKind | null>
}

class ToastService {
  +show(toast): void
}

class HealthController {
  +Ping(): IActionResult
}

ConnectionService --> ConnectionState : holds
ConnectionService ..> Timings : reads
ConnectionService ..> HealthController : probes
connectionInterceptor ..> ConnectionService : reports
connectionInterceptor ..> ToastService : warns
connectionInterceptor ..> Timings : reads
App ..> ConnectionService : reads
App "1" --> "0..1" ConnectionBanner : renders
ConnectionBanner --> ConnectionBannerKind : shows
@enduml
