@startuml
title UML sequence behaviour — Detect an unreachable API
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "App and ConnectionBanner" as banner
  participant "connectionInterceptor" as icpt
  participant "ConnectionService" as conn
end box
box "Backend — Jubilee API" #D1FADF
  participant "Jubilee API" as api
  participant "HealthController" as health
end box
participant "Status page" as status
icpt -> api : API request
api --> icpt : No answer (status 0, 502, 504, or 503 that is not MAINTENANCE)
icpt -> conn : reportNetworkFailure()
conn -> conn : navigator.onLine is true, state is not unreachable
conn -> health : check(): GET /api/health/ping
alt API does not answer
  health --> conn : Network error, timeout after 5 s, or 502, 503, 504
  conn -> conn : state unreachable, wait 5 s, then 10, 20, 40, 60 s (L2-121 AC3)
  conn --> banner : unreachable, countdown = n
  banner --> actor : "We can't reach Jubilee. This is on our side. Your messages are kept and will send when we're back." "Reconnecting… Trying again in {n} seconds." with "Check status" (L2-121 AC2)
  loop Each second
    conn --> banner : countdown - 1
  end
  conn -> health : check() when the wait ends
  opt Member presses "Check status"
    actor -> banner : Press "Check status"
    banner -> status : Open STATUS_URL in a new tab
    status --> actor : Current service status
  end
else API answers
  health --> conn : 204 No Content
  conn -> conn : state online
  conn --> banner : No connection banner
end
@enduml
