@startuml
title UML sequence behaviour — Delete a product
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "MyProductsPage" as page
  participant "DeleteItemDialog" as dialog
  participant "CatalogueApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "CatalogueController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "DeleteProductCommandHandler" as handler
  participant "Product" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Press "Delete {name}"
page -> dialog : Open with name and past request count
dialog --> actor : "Delete “{name}”?" with "Keep product" focused (L2-129)
actor -> dialog : Press "Delete product"
dialog -> client : deleteProduct(id)
client -> controller : DELETE /api/my-business/products/{id}
controller -> handler : Send DeleteProductCommand
handler -> db : Find the owner's product (404 otherwise)
handler -> entity : Delete(now)
handler -> db : Save; requests and saved items untouched
alt Save fails
  controller --> client : Error
  dialog --> actor : "We couldn't delete it. The product is still listed. Try again."
else Saved
  controller --> client : DeletedItemDto
  dialog --> page : Deleted
  page --> actor : Reload the list; toast "Product deleted"
  note over db : Public pages filter deleted products; a member's saved list reads it as "No longer available" (L2-092)
end
@enduml
