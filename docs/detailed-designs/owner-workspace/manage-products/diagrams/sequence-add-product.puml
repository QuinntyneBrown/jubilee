@startuml
title UML sequence behaviour — Add a product
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ProductEditorDialog" as dialog
  participant "CatalogueApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "CatalogueController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "UploadProductPhotoCommandHandler" as upload
  participant "SaveProductCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "IMalwareScanner" as scanner
  participant "IMediaStore" as media
  database "Jubilee database" as db
end box
actor -> dialog : Choose a photo
alt File over 5 MB
  dialog --> actor : "Photos can be 5 MB at most."
else
  dialog -> client : uploadProductPhoto(file)
  dialog --> actor : "Adding photo…", primary button waits
  client -> controller : POST /api/my-business/products/photos
  controller -> upload : Send UploadProductPhotoCommand
  upload -> db : Count the owner's uploads in the last hour
  upload -> upload : IImageProcessor checks and re-encodes (L2-138)
  upload -> scanner : Scan
  alt Refused, infected or scanner unavailable
    upload --> controller : 422 code or 503 SCAN_UNAVAILABLE
    controller --> client : ProblemDetails
    client --> dialog : Refusal
    dialog --> actor : Say why beside the photo, keep the tile
  else Clean
    upload -> media : Save renditions under a random key
    upload -> db : Add ProductPhoto
    upload --> controller : ProductPhotoDto
    controller --> client : 201
    client --> dialog : Photo
    dialog --> actor : Show the photo, "Change photo" and "Remove photo"
  end
end
actor -> dialog : Fill name, price, stock, options, minimum and press "Add product"
dialog -> dialog : Check the fields (L2-091)
dialog -> client : saveProduct(null, input with photoId and idempotencyKey)
client -> controller : POST /api/my-business/products
controller -> handler : Send SaveProductCommand
handler -> db : Find the owner's listing (403 when none)
handler -> handler : Validate fields (422 per field)
handler -> db : Look up the key in the last 24 hours (L2-132)
alt Key already used
  handler --> controller : The first product
else New
  handler -> db : Count products (409 PRODUCT_LIMIT at 100)
  handler -> db : Find the ProductPhoto of this listing (photo INVALID otherwise)
  handler -> db : Save the product with its photo
  handler --> controller : ProductRowDto
end
controller --> client : 201
client --> dialog : Saved
dialog --> actor : Close; toast "Product added" with "View in shop"
@enduml
