@startuml
title UML sequence behaviour — Reorder products
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "MyProductsPage" as page
  participant "CatalogueApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "CatalogueController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "MoveProductCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
alt Drag by the handle (pointer or touch)
  actor -> page : Drop a row in another place
  page -> page : drop: show the new order at once
else Keyboard
  actor -> page : Press "Move {name} up" or "Move {name} down"
end
page -> client : moveProduct(id, position)
client -> controller : PUT /api/my-business/products/{id}/position
controller -> handler : Send MoveProductCommand
handler -> db : Load the owner's products in order
handler -> handler : Insert at the position, renumber from 1 (L2-090)
handler -> db : Save
alt Refused
  controller --> client : Error
  page --> actor : Put the row back; toast "Couldn’t move the product"
else Saved
  controller --> client : ProductsDto
  page --> actor : Show the list; announce the new position
end
@enduml
