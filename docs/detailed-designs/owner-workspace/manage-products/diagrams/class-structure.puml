@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Manage products

class Product {
  +Guid Id
  +Guid ListingId
  +string Slug
  +string Name
  +int PriceCents
  +int? Stock
  +string? Description
  +int MinimumQuantity
  +string? OptionName
  +int Position
  +string? IdempotencyKey
  +Guid? PhotoId
  +bool IsDeleted
  +DateTimeOffset? DeletedAt
  +bool IsSoldOut
  +Revise(name, priceCents, description): void
  +SetMinimumQuantity(minimum): void
  +SetOptions(optionName, options): void
  +SetStock(stock): StockChange
  +ShowPhoto(photo: ProductPhoto?): void
  +Place(position, idempotencyKey): void
  +MoveTo(position): void
  +Delete(now): void
}

class ProductOption {
  +string Label
  +int? Stock
  +int Position
}

class ProductPhoto {
  +Guid Id
  +Guid ListingId
  +string Key
  +int Width
  +int Height
  +DateTimeOffset UploadedAt
  +{static} Upload(listingId, key, width, height, now): ProductPhoto
}

class SaveProductCommand {
  +string Subject
  +Guid? Id
  +string? Name
  +string? Price
  +int? Stock
  +string? Description
  +int? MinimumQuantity
  +string? OptionName
  +IReadOnlyList<OwnerProductOptionDto>? Options
  +Guid? PhotoId
  +string? IdempotencyKey
}

class SaveProductCommandHandler {
  +Handle(command): Task<ProductRowDto>
}

class UploadProductPhotoCommandHandler {
  +Handle(command: UploadProductPhotoCommand): Task<ProductPhotoDto>
}

class CatalogueRules {
  +int MaxOptions = 10
  +int MaxOptionLabel = 40
  +int PhotosPerHour = 30
  +TimeSpan IdempotencyWindow = 24h
  +Cents(price): int?
  +Ordered(products): List<Product>
}

class ProductRowDto {
  +Guid Id
  +string Name
  +int PriceCents
  +bool SoldOut
  +int MinimumQuantity
  +IReadOnlyList<OwnerProductOptionDto> Options
  +int Requests
  +ProductPhotoDto? Photo
}

class ProductPhotoDto {
  +Guid Id
  +string Key
  +int Width
  +int Height
}

Product "1" *-- "0..10" ProductOption
Product "0..1" --> "0..1" ProductPhoto : Photo
SaveProductCommandHandler ..> SaveProductCommand : handles
SaveProductCommandHandler ..> CatalogueRules : uses
SaveProductCommandHandler --> Product : adds or revises
UploadProductPhotoCommandHandler --> ProductPhoto : records
ProductRowDto ..> Product : projects
ProductRowDto *-- ProductPhotoDto
@enduml
