@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage products

Container_Boundary(web, "Jubilee Web") {
  Component(page, "MyProductsPage", "Angular page", "Product table, drag handle and move buttons")
  Component(editor, "ProductEditorDialog", "Angular CDK dialog", "Adds or edits one product, its photo, options and minimum")
  Component(del, "DeleteItemDialog", "Angular CDK dialog", "Confirms a delete")
  Component(client, "CatalogueApi", "Service contract and HttpCatalogueApi", "Calls the owner catalogue endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "CatalogueController", "ASP.NET Core controller", "Exposes /api/my-business/products")
  Component(list, "ListProductsQueryHandler", "MediatR handler", "Lists products in their order")
  Component(save, "SaveProductCommandHandler", "MediatR handler", "Validates and saves a product once per key")
  Component(upload, "UploadProductPhotoCommandHandler", "MediatR handler", "Checks, scans and stores a photo")
  Component(remove, "DeleteProductCommandHandler", "MediatR handler", "Soft-deletes a product")
  Component(move, "MoveProductCommandHandler", "MediatR handler", "Renumbers the positions")
  Component(product, "Product and ProductPhoto", "Domain entities", "Price, stock, options, minimum, photo")
}
ContainerDb(db, "Jubilee database", "SQL Server", "System of record")
ContainerDb(media, "Media store", "IMediaStore", "Renditions")

Rel(page, editor, "Opens")
Rel(page, del, "Opens")
Rel(page, client, "Lists and moves through")
Rel(editor, client, "Uploads photos and saves through")
Rel(del, client, "Deletes through")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, list, "Sends ListProductsQuery")
Rel(ctrl, save, "Sends SaveProductCommand")
Rel(ctrl, upload, "Sends UploadProductPhotoCommand")
Rel(ctrl, remove, "Sends DeleteProductCommand")
Rel(ctrl, move, "Sends MoveProductCommand")
Rel(save, product, "Revises")
Rel(save, db, "Saves", "EF Core")
Rel(upload, media, "Saves renditions")
Rel(upload, db, "Records ProductPhoto", "EF Core")
Rel(remove, db, "Saves", "EF Core")
Rel(move, db, "Saves", "EF Core")
@enduml
