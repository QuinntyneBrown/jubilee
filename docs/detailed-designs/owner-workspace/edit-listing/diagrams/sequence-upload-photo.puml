@startuml
title UML sequence behaviour — Upload a listing photo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "EditListingPage" as page
  participant "MyBusinessApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "MyBusinessController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "AddPhotoCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "SkiaImageProcessor" as image
  participant "FileMediaStore" as media
  database "Jubilee database" as db
end box
actor -> page : Press "Add photo" and choose a file
alt Six photos already, or the file is over 5 MB
  page --> actor : Show the rule and send nothing (L2-088 AC2)
else
  page -> client : addPhoto(file)
  client -> controller : POST /api/my-business/photos (multipart file)
  controller -> handler : Send AddPhotoCommand(subject, content)
  handler -> db : Workspace.Owned, then count the listing's photos (L2-133)
  db --> handler : Listing and count
  alt Six photos already
    handler --> controller : ConflictException TOO_MANY_PHOTOS
    controller --> client : 409 ProblemDetails
    client --> page : HttpErrorResponse
    page --> actor : Show "A listing can have 6 photos. Remove one to add another."
  else
    handler -> image : Process(upload)
    alt Over 5 MB, not a JPEG or PNG by its bytes, or over 8,000 pixels a side (L2-138 AC1)
      image --> handler : InvalidPhotoException TOO_LARGE, NOT_AN_IMAGE or TOO_BIG_IN_PIXELS
      handler --> controller : InvalidPhotoException
      controller --> client : 422 ProblemDetails with the code
      client --> page : HttpErrorResponse
      page --> actor : Show the message naming the rule (L2-088 AC2)
    else Accepted
      image -> image : Decode and encode again without metadata at 320, 640 and 1280 px in JPEG and WebP (L2-088 AC4)
      image --> handler : ProcessedImage with 6 renditions
      handler -> media : Save each rendition under a random 32-digit hex key
      media --> handler : Stored
      handler -> db : Add ListingPhoto at the last position and save
      db --> handler : Commit result
      handler --> controller : ListingEditorDto
      controller --> client : 201 Created
      client --> page : ListingEditor
      page --> actor : Show the photo with the default description "{business} photo {n}" (L2-088 AC5)
    end
  end
end
@enduml
