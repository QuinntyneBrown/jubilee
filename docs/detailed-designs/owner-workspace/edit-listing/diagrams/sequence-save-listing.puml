@startuml
title UML sequence behaviour — Save listing changes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "EditListingPage" as page
  participant "MyBusinessApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "MyBusinessController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SaveListingCommandHandler" as handler
  participant "Listing" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as outbox
end box
actor "Verification team" as team
actor -> page : Press "Save listing"
page -> page : check(): name, line, hours and website
alt Browser finds problems
  page --> actor : Show "Fix {n} things to continue" in jb-form-summary and keep typed values (L2-126)
else Draft passes
  page -> page : Make fields read-only and the button busy (L2-127)
  page -> client : save(ListingChanges with listingId and version)
  client -> controller : PUT /api/my-business/listing
  controller -> controller : Read the subject; SaveListingBody refuses unknown fields (L2-133 AC4)
  controller -> handler : Send SaveListingCommand
  handler -> db : Workspace.Owned: load the owner's listing, or 403 FORBIDDEN (L2-133 AC3)
  db --> handler : Listing
  handler -> handler : Check each field
  alt Invalid fields
    handler --> controller : ValidationFailedException with a code per field
    controller --> client : 422 ProblemDetails
    client --> page : HttpErrorResponse
    page --> actor : Show the fields in the summary
  else Version differs, or ListingId names another listing
    handler --> controller : ConflictException LISTING_CHANGED
    controller --> client : 409 ProblemDetails
    client --> page : HttpErrorResponse
    page --> actor : Show "This listing changed since you opened it. Reload to see the latest." with "Reload" (L2-087 AC8)
  else Valid and current
    handler -> entity : Edit(name, tagline, category, about, where, hours, website, highlight, now)
    entity --> handler : Version + 1; true when the name or category changed
    opt Name or category changed on a live listing (L2-087 AC6)
      entity -> entity : Stamp RecheckRequestedAt
      handler -> handler : Add AuditRecord listing.recheck-requested with the old and new values
      handler -> handler : TellOfRecheck: Notification and e-mail to the owner, e-mail to VerificationSettings.TeamEmail
    end
    handler -> db : Save listing, audit record, Notification and OutboxMessages in one SaveChangesAsync
    db --> handler : Commit result
    handler --> controller : ListingEditorDto
    controller --> client : 200 OK
    client --> page : ListingEditor
    page --> actor : Show "Listing updated": "Your changes are live now." with "View public listing" (L2-087 AC5)
    opt A re-check was asked
      page --> actor : Add "the verification team will take another look within two business days. Your listing stays live."
      outbox -> db : Read due outbox messages
      db --> outbox : Messages
      outbox --> actor : E-mail "We’ll re-check {Business}"
      outbox --> team : E-mail "Re-check: {Business} changed its name or category" with the old and new values and the admin link
    end
  end
end
@enduml
