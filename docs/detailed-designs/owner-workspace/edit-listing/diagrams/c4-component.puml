@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Edit a listing

Container_Boundary(web, "Jubilee Web") {
  Component(page, "EditListingPage", "Angular page", "Form with summary and live preview and photos reordered with CDK drag-drop")
  Component(client, "MyBusinessApi", "Service contract (MY_BUSINESS_API)", "Calls the listing and photo endpoints")
  Component(tile, "MediaTile", "jb-media-tile", "Draws a picture with srcset from a photo key")
  Component(public, "BusinessPage", "Angular page", "Shows the cover and the other photos under Photos")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "MyBusinessController", "ASP.NET Core controller", "Exposes /api/my-business/listing and /photos and refuses unknown fields")
  Component(rules, "Workspace", "Application rules", "Owned finds the owner's listing or refuses with 403")
  Component(save, "SaveListingCommandHandler", "MediatR handler", "Checks fields and version and calls Edit and audits a new name or category")
  Component(photo, "Photo command handlers", "MediatR handlers", "AddPhoto and MovePhoto and DescribePhoto and RemovePhoto")
  Component(listing, "Listing", "Domain entity", "Edit counts the version and reports a changed name or category")
  Component(image, "SkiaImageProcessor", "IImageProcessor", "Checks content and re-encodes into renditions")
  Component(store, "FileMediaStore", "IMediaStore", "Keeps renditions under random keys")
  Component(mediactrl, "MediaController", "ASP.NET Core controller", "Serves /media/{key}/{width}.{jpg|webp}")
  Component(pageq, "GetListingPageQueryHandler", "MediatR handler", "Adds Photos to the public listing page")
}
ContainerDb(db, "Jubilee database", "SQL Server", "System of record")
ContainerDb(media, "Media store", "Files under Media:Root", "Photo renditions")

Rel(page, client, "Loads and saves and changes photos through")
Rel(page, tile, "Draws each thumbnail with")
Rel(public, tile, "Draws the cover and the gallery with")
Rel(client, ctrl, "Calls", "JSON and multipart/HTTPS")
Rel(tile, mediactrl, "Loads renditions from", "HTTPS")
Rel(ctrl, save, "Sends SaveListingCommand")
Rel(ctrl, photo, "Sends the photo commands")
Rel(save, rules, "Finds the listing with")
Rel(photo, rules, "Finds the listing with")
Rel(save, listing, "Calls Edit on")
Rel(save, db, "Saves listing and audit record", "EF Core")
Rel(photo, image, "Processes an upload with")
Rel(photo, store, "Saves and deletes renditions through")
Rel(photo, db, "Saves ListingPhoto rows", "EF Core")
Rel(store, media, "Writes files")
Rel(mediactrl, store, "Reads a rendition through")
Rel(pageq, db, "Reads the photos in order", "EF Core")
@enduml
