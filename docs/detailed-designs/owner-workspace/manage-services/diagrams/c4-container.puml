@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage services

Person(owner, "Owner", "Manages the services of a listing")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Services page with editor, delete and meeting hours dialogs")
  Container(api, "Jubilee API", "ASP.NET Core", "Owner catalogue endpoints and rules")
  ContainerDb(db, "Jubilee database", "SQL Server", "Services, meeting hours and requests")
}
Rel(owner, web, "Uses", "HTTPS")
Rel(web, api, "Calls /api/my-business/services", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
