@startuml
title UML sequence behaviour — Delete a service
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "MyServicesPage" as page
  participant "DeleteItemDialog" as dialog
  participant "CatalogueApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "CatalogueController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "DeleteServiceCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Press "Delete {name}"
page -> dialog : Open
dialog --> actor : "Delete “{name}”?" with "Keep service" focused (L2-129)
actor -> dialog : Press "Delete service"
dialog -> client : deleteService(id)
client -> controller : DELETE /api/my-business/services/{id}
controller -> handler : Send DeleteServiceCommand
handler -> db : Find the owner's service (404 otherwise)
handler -> db : Remove it and renumber the rest; requests keep the service name
alt Save fails
  controller --> client : Error
  dialog --> actor : "We couldn't delete it. The service is still listed. Try again."
else Saved
  controller --> client : DeletedItemDto
  dialog --> page : Deleted
  page --> actor : Reload the list; toast "Service deleted"; open requests stay open (L2-095)
end
@enduml
