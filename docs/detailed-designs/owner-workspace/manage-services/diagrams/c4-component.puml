@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage services

Container_Boundary(web, "Jubilee Web") {
  Component(page, "MyServicesPage", "Angular page", "Service rows, drag handle and move buttons")
  Component(editor, "ServiceEditorDialog", "Angular CDK dialog", "Adds or edits one service")
  Component(del, "DeleteItemDialog", "Angular CDK dialog", "Confirms a delete")
  Component(hours, "MeetingHoursDialog", "Angular CDK dialog", "Sets the meeting hours")
  Component(client, "CatalogueApi", "Service contract and HttpCatalogueApi", "Calls the owner catalogue endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "CatalogueController", "ASP.NET Core controller", "Exposes /api/my-business/services")
  Component(list, "ListServicesQueryHandler", "MediatR handler", "Lists services with the meeting hours")
  Component(save, "SaveServiceCommandHandler", "MediatR handler", "Validates and saves a service once per key")
  Component(remove, "DeleteServiceCommandHandler", "MediatR handler", "Removes a service and renumbers the rest")
  Component(move, "MoveServiceCommandHandler", "MediatR handler", "Renumbers the positions")
  Component(service, "Service", "Domain entity", "Pricing, action, length and modes")
}
ContainerDb(db, "Jubilee database", "SQL Server", "System of record")

Rel(page, editor, "Opens")
Rel(page, del, "Opens")
Rel(page, hours, "Opens")
Rel(page, client, "Lists and moves through")
Rel(editor, client, "Saves through")
Rel(del, client, "Deletes through")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, list, "Sends ListServicesQuery")
Rel(ctrl, save, "Sends SaveServiceCommand")
Rel(ctrl, remove, "Sends DeleteServiceCommand")
Rel(ctrl, move, "Sends MoveServiceCommand")
Rel(save, service, "Creates or revises")
Rel(save, db, "Saves", "EF Core")
Rel(remove, db, "Saves", "EF Core")
Rel(move, db, "Saves", "EF Core")
@enduml
