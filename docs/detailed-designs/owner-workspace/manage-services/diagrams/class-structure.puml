  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Manage services

enum ServicePriceKind {
  Free
  Amount
  Ask
}

enum ServiceAction {
  Book
  Ask
}

class Service {
  +Guid Id
  +Guid ListingId
  +int Position
  +string Name
  +string Detail
  +ServicePriceKind PriceKind
  +int? PriceCents
  +ServiceAction Action
  +int? DurationMinutes
  +bool OffersVideo
  +bool OffersInPerson
  +string? InPersonPlace
  +string? IdempotencyKey
  +int MaxPerListing = 50
  +{static} Create(listingId, position, name, detail, price, action): Service
  +Revise(name, detail, price, action, duration, video, inPerson, place): void
  +Remember(idempotencyKey): void
  +MoveTo(position): void
}

class ServicePrice {
  +ServicePriceKind Kind
  +int? Cents
}

class SaveServiceCommand {
  +string Subject
  +Guid? Id
  +string? Name
  +string? Detail
  +string? Pricing
  +string? Price
  +string? Action
  +int? DurationMinutes
  +bool OffersVideo
  +bool OffersInPerson
  +string? Place
  +string? IdempotencyKey
}

class SaveServiceCommandHandler {
  +Handle(command): Task<OwnerServiceRowDto>
}

class DeleteServiceCommandHandler {
  +Handle(command: DeleteServiceCommand): Task<DeletedItemDto>
}

class MoveServiceCommandHandler {
  +Handle(command: MoveServiceCommand): Task<ServicesDto>
}

Service --> ServicePriceKind : has
Service --> ServiceAction : has
SaveServiceCommandHandler ..> SaveServiceCommand : handles
SaveServiceCommandHandler ..> ServicePrice : builds
SaveServiceCommandHandler --> Service : creates or revises
DeleteServiceCommandHandler --> Service : removes
MoveServiceCommandHandler --> Service : renumbers
@enduml
