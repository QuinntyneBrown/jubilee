@startuml
title UML sequence behaviour — Add a service
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "MyServicesPage" as page
  participant "ServiceEditorDialog" as dialog
  participant "ServicesApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "OwnerServicesController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ServiceCommandValidator" as validator
  participant "AddServiceCommandHandler" as handler
  participant "Listing" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Press "Add service"
page -> dialog : Open "Add a service"
actor -> dialog : Choose pricing and what members can do
alt Pricing is "Fixed price"
  dialog -> dialog : Show and require "Price (CAD)" (L2-094)
else Pricing is "Free" or "Ask for a quote"
  dialog -> dialog : Hide and clear "Price (CAD)" (L2-094)
end
opt Members can "Book a time"
  dialog -> dialog : Show duration and meeting modes (L2-094)
end
actor -> dialog : Press "Add service"
dialog -> client : Build typed request with idempotency key (L2-132)
client -> controller : POST /api/owner/listings/{listingId}/services
controller -> controller : Authenticate and apply ListingOwnerPolicy (L2-133)
controller -> validator : Validate AddServiceCommand
alt Invalid fields
  validator --> controller : SERVICE_NAME_REQUIRED or PRICE_INVALID or DURATION_INVALID
  controller --> client : 422 ProblemDetails with per-field codes
  client --> dialog : Validation errors
  dialog --> actor : Show "Enter a name for the service." under the field
else Valid fields
  validator --> controller : Valid
  controller -> handler : Send AddServiceCommand
  handler -> db : Load listing with services
  db --> handler : Listing
  handler -> entity : AddService with 50 service limit (L2-093)
  alt Limit reached
    entity --> handler : Rule violated
    handler --> controller : SERVICE_LIMIT_REACHED
    controller --> client : 422 ProblemDetails
    client --> dialog : Refusal
    dialog --> actor : Show "You can list up to 50 services."
  else Accepted
    entity --> handler : Service
    handler -> db : Save service and ServiceChanged outbox message
    db --> handler : Commit result
    handler --> controller : ServiceDto
    controller --> client : 201 service
    client --> dialog : Saved
    dialog --> page : Close with service
    page --> actor : Show the service in the list
  end
end
@enduml
