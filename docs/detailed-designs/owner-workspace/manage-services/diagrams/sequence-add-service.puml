@startuml
title UML sequence behaviour — Add a service
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "MyServicesPage" as page
  participant "ServiceEditorDialog" as dialog
  participant "CatalogueApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "CatalogueController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SaveServiceCommandHandler" as handler
  participant "Service" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Press "Add service"
page -> dialog : Open "Add a service"
actor -> dialog : Choose pricing and what members can do
alt Fixed price
  dialog -> dialog : Show and require "Price (CAD)" (L2-094)
else Free or Ask for a quote
  dialog -> dialog : Hide and clear "Price (CAD)" (L2-094)
end
opt Book a time
  dialog -> dialog : Show length and meeting modes (L2-094)
end
actor -> dialog : Press "Add service"
dialog -> client : saveService(null, input with idempotencyKey) (L2-132)
client -> controller : POST /api/my-business/services
controller -> handler : Send SaveServiceCommand
handler -> db : Find the owner's listing (403 when none)
handler -> handler : Validate fields
alt Invalid
  handler --> controller : 422 with a code per field
  controller --> client : ProblemDetails
  client --> dialog : Validation errors
  dialog --> actor : Show "Enter a name for the service." under the field
else Key already used
  handler --> controller : The first service
else New
  handler -> db : Count services (409 SERVICE_LIMIT at 50, L2-093)
  handler -> entity : Create and Revise
  handler -> db : Save
  handler --> controller : OwnerServiceRowDto
  controller --> client : 201
  client --> dialog : Saved
  dialog --> page : Close with service
  page --> actor : Show the service in the list; toast "Service added"
end
@enduml
