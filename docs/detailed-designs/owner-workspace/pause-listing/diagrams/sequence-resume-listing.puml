@startuml
title UML sequence behaviour — Resume a listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "MyBusinessPage" as page
  participant "MyBusinessApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "MyBusinessController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ResumeListingCommandHandler" as handler
  participant "Listing" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "DirectoryCacheInvalidationInterceptor" as interceptor
  database "Jubilee database" as db
  database "Directory read cache" as cache
end box
actor -> page : Press "Resume listing" on the paused banner
page -> page : Make the button busy; a second press sends nothing
page -> client : resume()
client -> controller : POST /api/my-business/resume
controller -> handler : Send ResumeListingCommand(subject)
handler -> db : Workspace.Owned: load the owner's listing, or 403 FORBIDDEN (L2-133)
db --> handler : Listing with PausedAt
alt Listing is not paused
  handler --> controller : ConflictException NOT_PAUSED
  controller --> client : 409 ProblemDetails
  client --> page : HttpErrorResponse
  page --> actor : Show "We couldn’t resume it": "Your listing is still paused. Try again."
else Listing is paused
  handler -> entity : Resume(now)
  entity --> handler : IsPaused false, PausedAt cleared; Stage stays Live however long it was paused (L2-096 AC3)
  handler -> db : SaveChangesAsync
  db --> handler : Commit result
  interceptor -> cache : InvalidateAsync
  handler --> controller : PauseResultDto(state live)
  controller --> client : 200 OK
  client --> page : PauseResult
  page -> client : overview()
  client --> page : MyBusiness with paused false
  page --> actor : Toast "Listing resumed": "Members can find you again within a minute."; the banner clears
end
@enduml
