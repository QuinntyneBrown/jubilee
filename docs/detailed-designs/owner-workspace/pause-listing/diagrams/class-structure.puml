' --------------------------
title Class structure — Pause and resume a listing

enum ListingStage {
  Draft
  Live
}

class Listing {
  +Guid Id
  +string Slug
  +string Name
  +string? OwnerId
  +ListingStage Stage
  +bool IsPaused
  +DateTimeOffset? PausedAt
  +DateTimeOffset? PublishedAt
  +DateTimeOffset? DeletedAt
  +bool IsUnderModerationHold
  +Pause(now: DateTimeOffset?): void
  +Resume(now: DateTimeOffset?): void
  +IsPublic(): bool
}

class PublicListingFilter <<static>> {
  +{static} Expression<Func<Listing, bool>> Criteria
  +{static} IsSatisfiedBy(listing: Listing): bool
  +{static} WherePublic(listings: IQueryable<Listing>): IQueryable<Listing>
}

class PauseListingCommand {
  +string Subject
}

class ResumeListingCommand {
  +string Subject
}

class PauseListingCommandHandler {
  +Handle(request: PauseListingCommand): Task<PauseResultDto>
}

class ResumeListingCommandHandler {
  +Handle(request: ResumeListingCommand): Task<PauseResultDto>
}

class PauseResultDto {
  +bool Paused
  +DateTimeOffset? PausedAt
  +string State
}

class Workspace <<static>> {
  +{static} Owned(db: IAppDbContext, subject: string): Task<Listing>
  +{static} State(listing: Listing): string
}

class ConflictException {
  +string Code
}

class ForbiddenException {
  +string Code
}

interface IDirectoryReadCache {
  +{static} TimeSpan TimeToLive = 60 seconds
  +GetOrCreateAsync<T>(key: string, build: Func<CancellationToken, Task<T>>): Task<T>
  +Invalidate(): void
  +InvalidateAsync(): Task
}

class DistributedDirectoryReadCache

class DirectoryCacheInvalidationInterceptor {
  +SavingChangesAsync(...): ValueTask<InterceptionResult<int>>
  +SavedChangesAsync(...): ValueTask<int>
}

class PublicDirectoryCacheAttribute {
  +{static} int MaxAgeSeconds = 60
}

class SessionAwareCacheAttribute

Listing --> ListingStage : has
PublicListingFilter ..> Listing : reads Stage, PublishedAt, IsPaused, DeletedAt and the hold
PauseListingCommandHandler ..> PauseListingCommand : handles
ResumeListingCommandHandler ..> ResumeListingCommand : handles
PauseListingCommandHandler ..> Workspace : finds the listing with
ResumeListingCommandHandler ..> Workspace : finds the listing with
PauseListingCommandHandler --> Listing : calls Pause
ResumeListingCommandHandler --> Listing : calls Resume
PauseListingCommandHandler ..> ConflictException : throws NOT_LIVE or ALREADY_PAUSED
ResumeListingCommandHandler ..> ConflictException : throws NOT_PAUSED
PauseListingCommandHandler ..> PauseResultDto : returns
ResumeListingCommandHandler ..> PauseResultDto : returns
Workspace ..> ForbiddenException : throws for no listing
DistributedDirectoryReadCache ..|> IDirectoryReadCache
DirectoryCacheInvalidationInterceptor ..> IDirectoryReadCache : invalidates after a save of a Listing
SessionAwareCacheAttribute ..> PublicDirectoryCacheAttribute : reads MaxAgeSeconds
@enduml
