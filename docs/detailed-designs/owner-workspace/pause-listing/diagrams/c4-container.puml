@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Pause and resume a listing

Person(owner, "Owner", "Pauses and resumes a listing")
Person(member, "Member or visitor", "Reads the public lists and listing pages")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Pause dialog and paused banner on My business")
  Container(api, "Jubilee API", "ASP.NET Core", "Pause and resume endpoints and the public reads")
  ContainerDb(db, "Jubilee database", "SQL Server", "Listings with IsPaused and PausedAt")
  ContainerDb(cache, "Directory read cache", "IDistributedCache - Redis or memory", "Public directory answers for at most 60 seconds")
}
Rel(owner, web, "Uses", "HTTPS")
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Posts pause and resume and reads public pages", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, cache, "Reads and stores public answers and replaces the version on a save")
@enduml
