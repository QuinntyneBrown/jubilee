@startuml
title UML sequence behaviour — Pause a listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "MyBusinessOverviewPage" as page
  participant "PauseListingDialog" as dialog
  participant "ListingsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "OwnerListingController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "PauseListingCommandHandler" as handler
  participant "Listing" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
  database "Cache" as cache
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcher" as outbox
end box
participant "Search index" as search
actor -> page : Press "Pause listing"
page -> dialog : Open "Pause {business}?" with the open request count
dialog --> actor : Focus "Keep it live" (L2-129)
actor -> dialog : Press "Pause listing"
dialog -> client : Build typed request
client -> controller : POST /api/owner/listings/{listingId}/pause
controller -> controller : Authenticate and apply ListingOwnerPolicy (L2-133)
controller -> handler : Send PauseListingCommand
handler -> db : Load listing
db --> handler : Listing
handler -> entity : Pause(now) keeps ApprovedAt (L2-096)
entity --> handler : Stage Paused
handler -> db : Save stage and ListingVisibilityChanged outbox message
alt Save succeeds
  db --> handler : Commit result
  handler -> cache : Remove the listing's public cache entries
  cache --> handler : Removed
  handler --> controller : ListingStageDto
  controller --> client : 200 stage Paused
  client --> dialog : Paused
  dialog --> page : Close and update the stage
  page --> actor : Show persistent banner "Your listing is paused." with "Resume listing" (L2-067)
  outbox -> db : Read ListingVisibilityChanged
  db --> outbox : Pending message
  outbox -> search : Remove listing and its products and services within 60 seconds (L2-096)
  search --> outbox : Removed
else Save fails
  db --> handler : Error
  handler --> controller : Failure
  controller --> client : ProblemDetails with error reference
  client --> dialog : Failed
  dialog --> actor : Show "We couldn't pause it. Your listing is still live. Try again."
end
@enduml
