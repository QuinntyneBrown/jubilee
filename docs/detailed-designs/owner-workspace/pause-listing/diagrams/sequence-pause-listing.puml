@startuml
title UML sequence behaviour — Pause a listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "MyBusinessPage" as page
  participant "PauseListingDialog" as dialog
  participant "MyBusinessApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "MyBusinessController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "PauseListingCommandHandler" as handler
  participant "Listing" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "DirectoryCacheInvalidationInterceptor" as interceptor
  database "Jubilee database" as db
  database "Directory read cache" as cache
end box
actor "Visitor" as visitor
actor -> page : Press "Pause listing"
page -> dialog : Open with PauseListingData: business name and count of new requests
dialog --> actor : Ask "Pause {business}?" and focus "Keep it live" (L2-129)
actor -> dialog : Press "Pause listing"
dialog -> client : pause()
client -> controller : POST /api/my-business/pause
controller -> controller : Read the subject of the session cookie
controller -> handler : Send PauseListingCommand(subject)
handler -> db : Workspace.Owned: load the owner's listing, or 403 FORBIDDEN (L2-133)
db --> handler : Listing
alt Listing is not live, or is already paused
  handler --> controller : ConflictException NOT_LIVE or ALREADY_PAUSED
  controller --> client : 409 ProblemDetails
  client --> dialog : HttpErrorResponse
  dialog --> actor : Show "We couldn’t pause it": "Your listing is still live. Try again." (L2-096 AC5)
else Listing is live and not paused
  handler -> entity : Pause(now)
  entity --> handler : IsPaused true, PausedAt recorded; Stage and PublishedAt kept (L2-096)
  handler -> db : SaveChangesAsync
  db --> handler : Commit result
  interceptor -> cache : InvalidateAsync: replace the version of every entry
  handler --> controller : PauseResultDto(paused, pausedAt, state paused)
  controller --> client : 200 OK
  client --> dialog : PauseResult
  dialog --> page : Close with the result
  page -> client : overview()
  client --> page : MyBusiness with paused true
  page --> actor : Toast "Listing paused" and the persistent banner "Your listing is paused." with "Resume listing" (L2-067)
  visitor -> controller : Next public read: a list, search or GET /api/listings/{slug}
  controller -> db : Build the answer with WherePublic (L2-028)
  db --> controller : Public listings without the paused one
  controller --> visitor : Lists without the listing; 404 for its URL; Cache-Control of at most 60 seconds (L2-096 AC2)
end
opt Any other failure of the pause
  client --> dialog : HttpErrorResponse
  dialog --> actor : Show "We couldn’t pause it" with "Try again" (L2-128)
end
@enduml
