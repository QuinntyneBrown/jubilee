@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Pause and resume a listing

Container_Boundary(web, "Jubilee Web") {
  Component(page, "MyBusinessPage", "Angular page", "Pause listing and the persistent paused banner with Resume listing")
  Component(dialog, "PauseListingDialog", "Angular CDK dialog", "Confirms the pause")
  Component(toast, "ToastService", "Angular service", "Shows Listing paused and Listing resumed")
  Component(client, "MyBusinessApi", "Service contract (MY_BUSINESS_API)", "Calls pause and resume")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "MyBusinessController", "ASP.NET Core controller", "Exposes /api/my-business/pause and /resume")
  Component(rules, "Workspace", "Application rules", "Owned finds the owner's listing or refuses with 403")
  Component(pause, "PauseListingCommandHandler", "MediatR handler", "Refuses NOT_LIVE and ALREADY_PAUSED and pauses")
  Component(resume, "ResumeListingCommandHandler", "MediatR handler", "Refuses NOT_PAUSED and resumes")
  Component(listing, "Listing", "Domain entity", "Owns Pause and Resume")
  Component(interceptor, "DirectoryCacheInvalidationInterceptor", "EF Core interceptor", "Drops the cached reads after a save of a listing")
  Component(readcache, "DistributedDirectoryReadCache", "IDirectoryReadCache", "Keeps public answers for at most 60 seconds")
  Component(reads, "Public reads", "MediatR handlers and DatabaseSearchIndex", "Apply PublicListingFilter with WherePublic")
  Component(filters, "PublicDirectoryCacheAttribute and SessionAwareCacheAttribute", "Result filters", "Set Cache-Control to at most 60 seconds")
}
ContainerDb(db, "Jubilee database", "SQL Server", "System of record")
ContainerDb(cache, "Directory read cache", "IDistributedCache - Redis or memory", "Versioned entries")

Rel(page, dialog, "Opens with PauseListingData")
Rel(dialog, client, "Pauses through")
Rel(page, client, "Resumes and reads the overview again through")
Rel(page, toast, "Shows the result with")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, pause, "Sends PauseListingCommand")
Rel(ctrl, resume, "Sends ResumeListingCommand")
Rel(pause, rules, "Finds the listing with")
Rel(resume, rules, "Finds the listing with")
Rel(pause, listing, "Calls Pause")
Rel(resume, listing, "Calls Resume")
Rel(pause, db, "Saves", "EF Core")
Rel(resume, db, "Saves", "EF Core")
Rel(interceptor, readcache, "Invalidates after the save")
Rel(readcache, cache, "Reads and stores and replaces the version")
Rel(reads, readcache, "Build cached answers through")
Rel(reads, db, "Read public listings", "EF Core")
Rel(filters, reads, "Bound the answers of")
@enduml
