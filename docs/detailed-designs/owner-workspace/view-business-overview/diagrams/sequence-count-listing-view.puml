@startuml
title UML sequence behaviour — Count a listing view
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "BusinessPage" as page
  participant "ListingsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ListingsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "RecordListingViewCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Open /b/:slug
page -> client : getListing(slug)
client --> page : ListingPage
page --> actor : Show the listing page
page -> client : recordView(slug)
client -> controller : POST /api/listings/{slug}/views
controller -> handler : Send RecordListingViewCommand(slug, viewer, client address, user agent)
handler -> db : Load the id and OwnerId of the public listing
db --> handler : Listing, or none (404 listing_not_found)
alt Caller is the owner, or the user agent matches KnownBot
  handler -> handler : Count nothing (L2-085 AC5, L2-037 AC3)
else Any other caller
  handler -> handler : Visitor key: member:{subject}, or a SHA-256 hash of address and user agent
  handler -> db : Any ListingView of this key in the last 30 minutes (ListingView.RepeatWindow)
  db --> handler : Seen or not
  opt Not seen
    handler -> db : Add ListingView.Record(listingId, visitorKey, now) and save
    db --> handler : Commit result
  end
end
handler --> controller : Done
controller --> client : 204 No Content
@enduml
