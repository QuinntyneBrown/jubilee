@startuml
title UML sequence behaviour — Load the business overview
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "MyBusinessPage" as page
  participant "MyBusinessApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "MyBusinessController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetMyBusinessQueryHandler" as handler
  participant "Workspace" as rules
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Open /my-business (memberGuard passes a signed-in member)
page -> client : overview()
client -> controller : GET /api/my-business
controller -> controller : Read the subject of the session cookie
controller -> handler : Send GetMyBusinessQuery(subject)
handler -> rules : OwnedBy(subject), then Current(owned)
rules -> db : Read the caller's listings that are not deleted
db --> rules : Listings, oldest first
rules --> handler : Listing chosen last, else the live one, else the oldest (L2-079 AC5)
alt Caller owns nothing
  handler --> controller : MyBusinessDto with State none
  controller --> client : 200 OK
  client --> page : MyBusiness
  page --> actor : Show "List your business free" with "List your business" (L2-086 AC1)
else Caller owns a listing
  handler -> db : Read the owner's drafts, the submission and the listing's requests
  db --> handler : Rows
  opt Listing is live
    handler -> db : Read ListingView of 14 days, unread conversations, saved items, products and services
    db --> handler : Rows
    handler -> handler : Build MyBusinessStatsDto and MyBusinessSummaryDto (L2-085 AC2 and AC6)
  end
  opt Stage is ChangesRequested or Declined
    handler -> handler : Send GetOwnerVerificationQuery for the reviewer's words
  end
  handler -> rules : State and Subtitle (L2-097 AC3)
  handler --> controller : MyBusinessDto with Businesses
  controller --> client : 200 OK
  client --> page : MyBusiness
  alt Stats present
    page --> actor : Show the header, four stats, "Needs your reply" and "Your listing" (L2-085)
  else Listing not live
    page --> actor : Show the alert of the stage, "Verification progress" and "How members see you" (L2-086)
  end
  opt More than one entry in Businesses
    page --> actor : Show the select "Business" with the one shown selected (L2-079 AC4)
  end
end
opt The API answers 403
  client --> page : HttpErrorResponse 403
  page --> actor : Navigate to /forbidden (L2-097 AC1)
end
opt Any other failure
  client --> page : HttpErrorResponse
  page --> actor : Show "We couldn’t load your business" with the reference and "Try again" (L2-118)
end
@enduml
