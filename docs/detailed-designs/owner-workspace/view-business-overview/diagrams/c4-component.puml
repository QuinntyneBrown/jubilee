@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View the business overview

Container_Boundary(web, "Jubilee Web") {
  Component(page, "MyBusinessPage", "Angular page", "Renders the view for the state and the switcher")
  Component(header, "WorkspaceHeader", "jb-workspace-header", "Business name and subtitle and tabs with aria-current")
  Component(client, "MyBusinessApi", "Service contract (MY_BUSINESS_API)", "Calls GET /api/my-business and PUT /api/my-business/current")
  Component(nav, "NavigationStore", "Angular service", "Holds the counts of the chrome")
  Component(toast, "ToastService", "Angular service", "Shows We couldn't switch businesses")
  Component(public, "BusinessPage", "Angular page", "Public listing page that reports a view")
  Component(listings, "ListingsApi", "Service contract (LISTINGS_API)", "Calls POST /api/listings/{slug}/views")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "MyBusinessController", "ASP.NET Core controller", "Exposes /api/my-business and refuses unknown fields")
  Component(query, "GetMyBusinessQueryHandler", "MediatR handler", "Builds MyBusinessDto with statistics and the businesses")
  Component(choose, "ChooseBusinessCommandHandler", "MediatR handler", "Stamps the owner's choice on their own listing")
  Component(rules, "Workspace", "Application rules", "Current picks the listing chosen last, else the live one, else the oldest")
  Component(lctrl, "ListingsController", "ASP.NET Core controller", "Exposes /api/listings/{slug}/views")
  Component(rec, "RecordListingViewCommandHandler", "MediatR handler", "Counts a view with the L2-085 exclusions")
}
ContainerDb(db, "Jubilee database", "SQL Server", "System of record")

Rel(page, header, "Composes")
Rel(page, client, "Loads and chooses through")
Rel(page, nav, "Reloads after a switch")
Rel(page, toast, "Reports a failed switch with")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, query, "Sends GetMyBusinessQuery")
Rel(ctrl, choose, "Sends ChooseBusinessCommand")
Rel(query, rules, "Finds the listing shown with")
Rel(query, db, "Reads", "EF Core")
Rel(choose, db, "Saves WorkspaceChosenAt", "EF Core")
Rel(public, listings, "Reports the view through")
Rel(listings, lctrl, "Calls", "JSON/HTTPS")
Rel(lctrl, rec, "Sends RecordListingViewCommand")
Rel(rec, db, "Adds ListingView", "EF Core")
@enduml
