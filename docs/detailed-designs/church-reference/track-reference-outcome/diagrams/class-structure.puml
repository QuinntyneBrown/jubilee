@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Track the reference outcome

enum ListingStage {
  Draft
  WaitingOnReference
  ReadyToReview
  NeedsDecision
  ChangesRequested
  Live
  Paused
  OnHold
  Removed
  Declined
}

class Listing {
  +Guid Id
  +Guid OwnerId
  +string Name
  +ListingStage Stage
  +ChurchReference Reference
  +ApplyReferenceOutcome(kind: ReferenceAnswerKind): void
  +ChangeReference(church: string, email: EmailAddress, now: DateTimeOffset): void
}

class ChurchReference {
  +Guid Id
  +string ChurchName
  +EmailAddress Email
  +ChurchReferenceStatus Status
  +DateTimeOffset RequestedAt
  +DateTimeOffset? LastReminderAt
  +DateTimeOffset? LinkExpiresAt
  +CanRemind(now: DateTimeOffset): bool
  +MarkReminded(now: DateTimeOffset): void
}

enum ChurchReferenceStatus {
  Waiting
  Confirmed
  CantVouch
  DoesntKnow
}

enum ReferenceAnswerKind {
  KnowsAndVouches
  KnowsCannotVouch
  DoesNotKnow
}

class ReferenceOutcomePolicy {
  +StageFor(kind: ReferenceAnswerKind): ListingStage
  +StatusFor(kind: ReferenceAnswerKind): ChurchReferenceStatus
}

enum VerificationBannerState {
  WaitingForReference
  ReferenceAnswered
  ReferenceSilent7Days
  ReferenceLinkExpired
  ReferenceDoesNotKnow
}

class VerificationStatusDto {
  +Guid ListingId
  +string BusinessName
  +ListingStage Stage
  +VerificationBannerState Banner
  +string ReferenceLabel
  +string ChurchName
  +DateTimeOffset RequestedAt
}

class SendReferenceReminderCommand {
  +Guid ListingId
}

class ChangeReferenceCommand {
  +Guid ListingId
  +string ChurchName
  +string ReferenceEmail
}

class ReferenceFollowUpJob {
  +int SilentDays = 7
  +int LinkLifetimeDays = 14
  +RunAsync(now: DateTimeOffset): Task
}

Listing --> ListingStage : has
Listing "1" *-- "0..1" ChurchReference : names
ChurchReference --> ChurchReferenceStatus : has
Listing ..> ReferenceOutcomePolicy : asks
ReferenceOutcomePolicy ..> ReferenceAnswerKind : maps
ReferenceOutcomePolicy ..> ListingStage : to
VerificationStatusDto --> VerificationBannerState : has
VerificationStatusDto ..> Listing : projects
SendReferenceReminderCommand ..> ChurchReference : reminds
ChangeReferenceCommand ..> Listing : changes
ReferenceFollowUpJob --> "*" ChurchReference : follows up
@enduml
