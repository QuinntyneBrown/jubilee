@startuml
title UML sequence behaviour — Follow up on a silent reference
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "VerificationBanner" as banner
  participant "ListingsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ListingsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SendReferenceReminderCommandHandler" as handler
  participant "ChurchReference" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "ReferenceFollowUpJob" as job
  participant "OutboxDispatcherJob" as dispatcher
end box
participant "E-mail provider" as provider
job -> job : Start on schedule and take the single-run lock (L2-182)
job -> db : Select references in Waiting with a request 7 days old
db --> job : Silent references
job -> db : Set banner ReferenceSilent7Days and write the owner notification
db --> job : Commit result
job -> db : Select references in Waiting whose link expired after 14 days
db --> job : Expired references
job -> db : Set banner ReferenceLinkExpired and write the ReferenceLinkExpired outbox message (L2-084)
db --> job : Commit result
dispatcher -> provider : Send the expiry notice to the owner
provider --> dispatcher : Accepted
banner --> actor : Show "Your reference hasn't answered in 7 days." with "Send reminder" and "Change reference"
actor -> banner : Press "Send reminder"
banner -> client : sendReferenceReminder(listingId)
client -> controller : POST /api/listings/{listingId}/reference/reminder
controller -> controller : Authenticate and check the caller owns the listing
controller -> handler : Send SendReferenceReminderCommand
handler -> db : Load the reference and its open token
db --> handler : Reference
handler -> entity : CanRemind(now)
alt Reminder sent within the last 72 hours (L2-084)
  entity --> handler : Refused
  handler --> controller : REFERENCE_REMINDER_LIMIT
  controller --> client : 429 ProblemDetails
  client --> banner : Limit reached
  banner --> actor : Say when the next reminder is allowed
else Allowed
  entity --> handler : Allowed
  handler -> entity : MarkReminded(now)
  handler -> db : Save reference and ReferenceReminderRequested outbox message
  db --> handler : Commit result
  handler --> controller : Accepted
  controller --> client : 202 Accepted
  client --> banner : Reminder queued
  banner --> actor : Confirm the reminder
  dispatcher -> db : Read ReferenceReminderRequested
  db --> dispatcher : Reference and link state
  dispatcher -> provider : Send the reminder with the valid link or a new link (L2-084)
  provider --> dispatcher : Accepted
end
@enduml
