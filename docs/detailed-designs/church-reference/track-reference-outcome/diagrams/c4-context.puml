@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Track the reference outcome

Person(owner, "Owner", "Waits for the reference and may remind or change the reference")
Person_Ext(reference, "Church reference", "Pastor or elder who answers or is reminded")
Person(verifier, "Verification team member", "Reviews listings that are ready or need a decision")
System(jubilee, "Jubilee", "Toronto's Christian marketplace of verified Christian-owned businesses")
System_Ext(email, "E-mail provider", "Delivers reminders and owner notices")

Rel(reference, jubilee, "Sends an answer to")
Rel(owner, jubilee, "Sees the outcome banner and sends a reminder or changes the reference")
Rel(jubilee, verifier, "Queues the listing for")
Rel(jubilee, email, "Sends reminders and expiry notices via")
Rel(email, reference, "Delivers the reminder to")
Rel(email, owner, "Delivers the expiry notice to")
@enduml
