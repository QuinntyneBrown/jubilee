@startuml
title UML sequence behaviour — Apply the reference answer to the listing stage
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "MyBusinessPage" as page
  participant "ListingsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ListingsController" as controller
  participant "EventsHub" as hub
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ReferenceAnsweredHandler" as handler
  participant "Listing" as entity
  participant "GetVerificationStatusQueryHandler" as query
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as dispatcher
end box
note over handler
  Runs inside the transaction that stores
  the ReferenceAnswer (L2-081).
end note
handler -> db : Load the listing of the answered reference
db --> handler : Listing in stage WaitingOnReference
handler -> entity : ApplyReferenceOutcome(kind)
alt "I know her and can vouch for her"
  entity --> handler : Stage ReadyToReview and reference Confirmed (L2-083)
else "I know her, but I can't vouch for her business"
  entity --> handler : Stage NeedsDecision and reference CantVouch (L2-083)
else "I don't know this person"
  entity --> handler : Stage NeedsDecision and reference DoesntKnow and not published (L2-083)
end
handler -> db : Save listing and ListingStageChanged outbox message
db --> handler : Commit result
dispatcher -> db : Read ListingStageChanged
db --> dispatcher : Stage change without answer text
dispatcher -> hub : Publish to the owner and the verification team
hub --> page : Stage changed
page -> client : getVerificationStatus(listingId)
client -> controller : GET /api/listings/{listingId}/verification-status
controller -> controller : Authenticate and check the caller owns the listing
controller -> query : Send GetVerificationStatusQuery
query -> db : Read stage and reference status only
db --> query : Stage and status
query --> controller : VerificationStatusDto without answer or note (L2-083)
controller --> client : 200 OK
client --> page : Status
alt Banner ReferenceAnswered
  page --> actor : Show "Your church reference answered. We're reviewing {business} now"
else Banner ReferenceDoesNotKnow
  page --> actor : Show the danger banner "We couldn't verify {business}." with "Change reference"
else Stage NeedsDecision after a can't-vouch answer
  page --> actor : Keep the pending state without the answer
end
@enduml
