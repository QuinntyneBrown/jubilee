@startuml
title UML sequence behaviour — Send or resend the reference request
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "MyBusinessPage" as page
  participant "ListingsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ListingsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ResendReferenceRequestCommandHandler" as handler
  participant "LinkTokenService" as tokens
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
  participant "IEmailSender" as sender
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as dispatcher
end box
participant "E-mail provider" as provider
actor "Church reference" as reference
opt Owner presses "Send the request again"
  actor -> page : Press "Send the request again"
  page -> client : resendReferenceRequest(listingId)
  client -> controller : POST /api/listings/{listingId}/reference/resend
  controller -> controller : Authenticate and check the caller owns the listing
  controller -> handler : Send ResendReferenceRequestCommand
  handler -> db : Count resends in the last 24 hours
  db --> handler : Count
  alt 3 resends already made (L2-080)
    handler --> controller : REFERENCE_RESEND_LIMIT
    controller --> client : 429 ProblemDetails
    client --> page : Limit reached
    page --> actor : Say when the next resend is allowed
  else Under the limit
    handler -> tokens : Revoke the open token so the old link stops working
    handler -> db : Save ReferenceRequested outbox message in one transaction
    db --> handler : Commit result
    handler --> controller : Accepted
    controller --> client : 202 Accepted
    client --> page : Request queued
    page --> actor : Confirm that a fresh request was sent
  end
end
dispatcher -> db : Read ReferenceRequested (from submission or resend)
db --> dispatcher : Listing and owner and church and reference e-mail
dispatcher -> tokens : Issue(ChurchReference, listingId, email)
tokens -> tokens : Generate 256 random bits and compute the SHA-256 hash (L2-140)
tokens -> db : Store the hash with a 14-day expiry (L2-080)
db --> tokens : Stored
tokens --> dispatcher : Raw token for the link only
dispatcher -> sender : Send ReferenceRequestEmail with /reference/:token
sender -> provider : Submit e-mail
provider --> sender : Accepted
provider -> reference : Deliver the request naming owner and business and church
sender --> dispatcher : Sent
dispatcher -> db : Mark dispatched
db --> dispatcher : Commit result
@enduml
