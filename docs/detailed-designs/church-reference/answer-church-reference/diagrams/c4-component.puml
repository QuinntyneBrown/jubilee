@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Answer a church reference request

Container_Boundary(web, "Jubilee Web") {
  Component(page, "ReferenceLinkPage", "Angular page", "Form and thank-you and closed and error states at /reference/:token")
  Component(client, "ReferenceApi", "Typed HTTP client", "Calls /api/reference-requests")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "ReferenceRequestsController", "ASP.NET Core controller", "Anonymous endpoints that take the token in the request body")
  Component(lctrl, "ListingsController", "ASP.NET Core controller", "Owner endpoint for Send the request again")
  Component(open, "OpenReferenceRequestQueryHandler", "MediatR handler", "Resolves the token and returns the wording for the form")
  Component(answer, "SubmitReferenceAnswerCommandHandler", "MediatR handler", "Stores the answer and consumes the token")
  Component(resend, "ResendReferenceRequestCommandHandler", "MediatR handler", "Replaces the token at most 3 times per 24 hours")
  Component(tokens, "LinkTokenService", "Application service", "Issues and hashes and redeems single-use tokens")
  Component(wording, "OwnerWordingFormatter", "Application service", "Pronouns or first name for copy about the owner")
  Component(ref, "ChurchReference", "Domain entity", "Owns the answer and the token binding")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(outbox, "OutboxDispatcherJob", "Hosted job", "Builds and sends ReferenceRequestEmail")
}
ContainerDb(db, "Jubilee database", "SQL Server", "References and tokens and outbox")
System_Ext(email, "E-mail provider", "Delivers e-mail")

Rel(page, client, "Opens and answers through")
Rel(client, ctrl, "POST open and answer and report", "JSON/HTTPS")
Rel(ctrl, open, "Sends OpenReferenceRequestQuery")
Rel(ctrl, answer, "Sends SubmitReferenceAnswerCommand")
Rel(lctrl, resend, "Sends ResendReferenceRequestCommand")
Rel(open, tokens, "Finds the token by hash")
Rel(open, wording, "Asks for owner wording")
Rel(answer, tokens, "Redeems the token")
Rel(answer, ref, "Records the answer on")
Rel(resend, tokens, "Revokes and issues")
Rel(tokens, db, "Reads and writes hashes", "EF Core")
Rel(answer, db, "Persists", "EF Core")
Rel(outbox, db, "Reads outbox", "EF Core")
Rel(outbox, wording, "Words the e-mail with")
Rel(outbox, email, "Sends the request")
@enduml
