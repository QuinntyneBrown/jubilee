@startuml
title UML sequence behaviour — Open a closed or unknown link
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Church reference" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ReferenceLinkPage" as page
  participant "ReferenceApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ReferenceRequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "OpenReferenceRequestQueryHandler" as query
  participant "LinkToken" as token
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Open /reference/:token
page -> client : open(token)
client -> controller : POST /api/reference-requests/open
controller -> query : Send OpenReferenceRequestQuery
query -> db : Find the LinkToken by SHA-256 hash
alt Token unknown (L2-082)
  db --> query : No row
  query --> controller : Not found
  controller --> client : 404 REFERENCE_LINK_CLOSED with no listing data
  client --> page : Closed
  page --> actor : Show "This request is closed." without naming anyone
else Token found
  db --> query : LinkToken
  query -> token : IsOpen(now)
  alt Older than 14 days or already answered or replaced (L2-082)
    token --> query : Closed
    query --> controller : Closed with the owner wording
    controller --> client : 410 REFERENCE_LINK_CLOSED
    client --> page : Closed
    page --> actor : Show "This request is closed." with "About Jubilee"
  else Open
    token --> query : Open
    query --> controller : ReferenceRequestView
    controller --> client : 200 OK
    client --> page : View
    page --> actor : Show the reference form
  end
else Dependency failure
  db --> query : Failure
  query --> controller : Error
  controller --> client : 502 ProblemDetails with JB-REF-502
  client --> page : Load error
  page --> actor : Show "We couldn't load the reference request" with JB-REF-502
end
@enduml
