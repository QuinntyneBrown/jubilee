@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Keep memories and files

Person(member, "Member", "Keeps their own contacts")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular", "The Contacts screens under /contacts")
  
  Container(api, "Jubilee API", "ASP.NET Core", "/api/contacts endpoints, scoped to the caller")
  
  ContainerDb(db, "Jubilee database", "SQL Server", "Contacts records, one member's rows apart from every other's")
  ContainerDb(media, "Media storage", "Private object storage", "Contact photos and files under random names")
  Container_Ext(scanner, "Malware scanner", "<TO SUPPLY>", "Scans uploads before they are stored")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")


Rel(api, media, "Stores and signs links to", "HTTPS")
Rel(api, scanner, "Scans with", "HTTPS")
@enduml
