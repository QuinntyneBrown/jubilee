@startuml
title UML sequence behaviour — Log a conversation
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web application" #E0F2FE
  participant "ContactLogPage" as page
  participant "HttpContactsApi" as client
end box
box "Backend — Jubilee API application" #D1FADF
  participant "ContactTimelineController" as ctrl
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "LogConversationCommandHandler" as handler
  participant "Contact" as contact
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box

actor -> page : Choose how and when, write, add promises and dates; press "Save"
page -> page : Empty text: "Write a line about what you talked about." (L2-308 AC2)
page -> client : logConversation(id, via, at, text, promises, dates)
client -> ctrl : POST /api/contacts/{id}/timeline/conversations
ctrl -> handler : Send LogConversationCommand(caller)
handler -> db : Load the contact among the caller's own (404 otherwise)
handler -> handler : Refuse a time later than now (L2-308 AC1)
handler -> db : Add the entry
handler -> db : Add each promise as a follow-up, From "{how}, {date}" (L2-308 AC5)
handler -> db : Add each date as a key date
handler -> contact : Set LastTalkedOn to the conversation's date (L2-305 AC6)
handler -> db : Commit in one unit of work
db --> handler : Saved
handler --> ctrl : TimelineEntryDto
ctrl --> client : 201
client --> page : Profile on Timeline, toast "Saved to {first name}’s timeline." (L2-307 AC2)
@enduml
