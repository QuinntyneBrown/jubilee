@startuml
title UML sequence behaviour — Choose the featured businesses
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Jubilee team member" as actor
box "Frontend — Admin application" #E0F2FE
  participant "AdminFeaturedPage" as page
  participant "AdminApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AdminFeaturedController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SetFeaturedWeekCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "DirectoryCacheInvalidationInterceptor" as icpt
  database "Jubilee database" as db
  database "Cache" as cache
end box
actor -> page : Choose listings and a start date for "Featured this week"
page -> page : Stop the selection at five listings (L2-106)
page -> client : setFeaturedWeek(startDate, listingIds)
client -> controller : PUT /api/admin/featured-weeks/{startDate}
controller -> controller : RequiresModerator (L2-191)
controller -> handler : Send SetFeaturedWeekCommand
handler -> db : Read the stages of the chosen listings and the other weeks
alt more than five, a duplicate, not live, in the past or overlapping
  handler --> client : 422 ProblemDetails with the field code
  client --> page : Field error
  page --> actor : Say what cannot be saved
else valid selection
  handler -> db : Replace the week's FeaturedSlot rows and add featured.set (L2-180) in one save
  db -> icpt : Saved changed FeaturedSlot rows
  icpt -> cache : Drop the directory read cache (ADR 0003)
  handler --> client : 200 with the week
  client --> page : Saved week
  page --> actor : Show the saved selection and its dates
end
@enduml
