@startuml
title UML sequence behaviour — Choose the featured businesses
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Jubilee team member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "FeaturedBusinessesPage" as page
  participant "AdminApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AdminFeaturedController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SetFeaturedWeekCommandValidator" as validator
  participant "SetFeaturedWeekCommandHandler" as handler
  participant "FeaturedWeek" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
  database "Cache" as cache
end box
actor -> page : Choose listings and a start date for "Featured this week"
page -> page : Stop the selection at five listings (L2-106)
page -> client : setFeaturedWeek(startDate, listingIds)
client -> controller : PUT /api/admin/featured-weeks/{startDate}
controller -> controller : Authenticate session and apply ModeratorPolicy (L2-133)
controller -> validator : Validate SetFeaturedWeekCommand
validator -> db : Read the stages of the chosen listings
db --> validator : Stages
alt more than five listings or a listing is not live
  validator --> controller : Validation failure
  controller --> client : 422 ProblemDetails with per-field codes
  client --> page : Field errors
  page --> actor : Show which listing cannot be featured
else valid selection
  validator --> controller : Valid
  controller -> handler : Send SetFeaturedWeekCommand
  handler -> db : Load the week for the start date when present
  db --> handler : Existing week or none
  handler -> entity : SetSlots(listingIds) for start date + 7 days (L2-106)
  entity --> handler : Week with ordered slots
  handler -> db : Save week and AuditEntry (L2-180) in one unit of work
  db --> handler : Commit result
  handler -> cache : Remove the cached featured list
  cache --> handler : Removed
  handler --> controller : Typed result
  controller --> client : 200 with week
  client --> page : Saved week
  page --> actor : Show the saved selection and its dates
end
@enduml
