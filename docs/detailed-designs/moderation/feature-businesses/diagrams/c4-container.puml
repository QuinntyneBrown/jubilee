@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Feature businesses
Person(moderator, "Jubilee team member", "Selects featured businesses")
Person(member, "Member", "Views featured businesses")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Featured admin page and the featured strip on welcome and browse")
  Container(api, "Jubilee API", "ASP.NET Core", "Admin featured endpoints and the public featured query")
  ContainerDb(db, "Jubilee database", "SQL Server", "Featured weeks and slots and listings and audit entries")
  ContainerDb(cache, "Cache", "Redis", "Short-lived cache of the current featured list")
}
Rel(moderator, web, "Uses", "HTTPS")
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, cache, "Reads and invalidates", "Redis protocol")
@enduml
