@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Feature businesses
Person(moderator, "Jubilee team member", "Selects featured businesses")
Person(member, "Member or visitor", "Views featured businesses")
System_Boundary(jubilee, "Jubilee") {
  Container(admin, "Admin application", "Angular single-page application", "The featured weeks page")
  Container(web, "Jubilee app", "Angular single-page application", "Featured this week on welcome and Browse")
  Container(api, "Jubilee API", "ASP.NET Core", "Admin featured endpoints and the public directory reads")
  ContainerDb(db, "Jubilee database", "SQL Server", "Featured slots, listings and audit entries")
  ContainerDb(cache, "Cache", "Redis", "Directory read cache, at most 60 seconds")
}
Rel(moderator, admin, "Uses", "HTTPS")
Rel(member, web, "Uses", "HTTPS")
Rel(admin, api, "Calls", "JSON/HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, cache, "Reads, fills and drops on a save", "Redis protocol")
@enduml
