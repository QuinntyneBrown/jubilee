@startuml
title UML sequence behaviour — Receive and open a report
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Jubilee team member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "AdminReportsPage" as list
  participant "AdminReportPage" as page
  participant "AdminApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AdminReportsController" as controller
  participant "EventsHub" as hub
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetReportsQueryHandler" as lh
  participant "OpenReportCommandHandler" as oh
  participant "Report" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as job
end box
job -> db : Read ReportCreated from the outbox
db --> job : Outbox message
job -> db : Create a notification for each moderator (L2-105)
db --> job : Commit result
job -> hub : Publish report.created
hub --> list : Push the new report
actor -> list : Open the admin reports list
list -> client : getReports()
client -> controller : GET /api/admin/reports
controller -> controller : Authenticate session and apply ModeratorPolicy (L2-133)
controller -> lh : Send GetReportsQuery
lh -> db : Read reports with listing, reason, reporter, time and status
db --> lh : Rows
lh -> lh : Mark reports open more than one business day overdue (L2-105)
lh --> controller : ReportListItem list
controller --> client : 200 with reports
client --> list : Reports
list --> actor : Show the list with status and overdue marks
actor -> page : Open one report
page -> client : openReport(id)
client -> controller : POST /api/admin/reports/{id}/open
controller -> oh : Send OpenReportCommand
oh -> db : Load report
db --> oh : Report
oh -> entity : StartReview(moderator, now)
entity --> oh : Status InReview
oh -> db : Save report and AuditEntry with the report ID as reason (L2-150)
db --> oh : Commit result
oh --> controller : ReportDetailDto
controller --> client : 200 with report and attached conversation when present
client --> page : Report
page --> actor : Show the report and the five actions
@enduml
