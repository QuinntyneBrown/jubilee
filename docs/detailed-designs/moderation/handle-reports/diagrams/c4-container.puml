@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Handle reports
Person(moderator, "Jubilee team member", "Reviews and resolves reports")
System_Boundary(jubilee, "Jubilee") {
  Container(admin, "Admin application", "Angular single-page application", "Reports list, report page and the admin bar count")
  Container(api, "Jubilee API", "ASP.NET Core", "Admin report endpoints and the staff session")
  Container(worker, "Jubilee Worker", ".NET worker service", "Outbox dispatch: e-mail")
  ContainerDb(db, "Jubilee database", "SQL Server", "Reports, listings, audit entries and outbox")
  ContainerDb(cache, "Cache", "Redis", "Directory read cache of public lists")
}
System_Ext(email, "E-mail provider", "Delivers e-mail")

Rel(moderator, admin, "Uses", "HTTPS")
Rel(admin, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes; searches", "EF Core")
Rel(api, cache, "Drops on a save that changes a listing")
Rel(worker, db, "Reads outbox messages", "EF Core")
Rel(worker, email, "Sends the team's e-mail", "HTTPS")
@enduml
