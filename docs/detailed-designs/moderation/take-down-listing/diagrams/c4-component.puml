@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Take down a listing
Container_Boundary(web, "Jubilee Admin Web") {
  Component(page, "AdminListingPage", "Angular page", "Shows the owner card and flags and preview")
  Component(dialog, "TakeDownListingDialog", "Angular CDK dialog", "Confirms the takedown and collects the reason for the owner")
  Component(client, "AdminApi", "Typed HTTP client", "Calls the /api/admin/listings endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "AdminListingsController", "ASP.NET Core controller", "Exposes the listing and take-down endpoints under RequiresModerator")
  Component(qh, "GetAdminListingQueryHandler", "MediatR handler", "Assembles AdminListingDto")
  Component(th, "TakeDownListingCommandHandler", "MediatR handler", "Takes down, notifies, queues the e-mail and audits in one save")
  Component(listing, "Listing", "Domain entity", "Records the takedown and deletes the listing from public")
  Component(interceptor, "DirectoryCacheInvalidationInterceptor", "EF Core save interceptor", "Drops the directory read cache after a listing changes")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(outbox, "OutboxDispatcherJob", "Hosted job", "Sends outbox e-mails")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Listings and notifications and audit and outbox")
ContainerDb(cache, "Cache", "Redis", "Directory read cache")
System_Ext(email, "E-mail provider", "Delivers the takedown e-mail")

Rel(page, dialog, "Opens")
Rel(page, client, "Loads the listing through")
Rel(dialog, client, "Takes down through")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, qh, "Sends GetAdminListingQuery")
Rel(ctrl, th, "Sends TakeDownListingCommand")
Rel(th, listing, "Calls TakeDown on")
Rel(th, db, "Saves listing and notification and outbox e-mail and audit record", "EF Core")
Rel(qh, db, "Reads listing and owner and flags", "EF Core")
Rel(interceptor, cache, "Invalidates")
Rel(outbox, db, "Reads outbox", "EF Core")
Rel(outbox, email, "Sends the e-mail via", "HTTPS")
@enduml
