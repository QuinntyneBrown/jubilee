@startuml
title UML sequence behaviour — Send a promotional e-mail to opted-in members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

box "Backend — Jubilee Worker" #D1FADF
  participant "PromotionalEmailJob" as job
  participant "OutboxDispatcherJob" as dispatcher
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "PromotionalAudienceQuery" as audience
  participant "PromotionalEmailComposer" as composer
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
participant "E-mail provider" as email
job -> audience : List recipients for the category
audience -> db : Select confirmed, deliverable members with the category on (L2-149 opt-in only)
db --> audience : Member IDs
audience --> job : Recipients
loop each recipient
  job -> composer : Compose(memberId, category)
  composer -> composer : Add Jubilee sender identity and mailing address (L2-149)
  composer -> composer : Add unsubscribe link and List-Unsubscribe headers (L2-068)
  composer -> composer : Refuse a message missing any of the three
  composer --> job : EmailMessage
  job -> db : Write OutboxMessage
  db --> job : Committed
end
dispatcher -> db : Read the next OutboxMessage
db --> dispatcher : Pending e-mail
dispatcher -> db : Recheck that the category is still on for the member
alt consent was withdrawn since composition
  db --> dispatcher : Off
  dispatcher -> db : Mark the message cancelled
else consent still holds
  db --> dispatcher : On
  dispatcher -> email : Send the e-mail
  email --> dispatcher : Accepted
  dispatcher -> db : Mark the message sent
end
@enduml
