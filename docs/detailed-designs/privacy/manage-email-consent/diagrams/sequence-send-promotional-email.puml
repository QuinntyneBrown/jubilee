@startuml
title UML sequence behaviour — Send a promotional e-mail to opted-in members
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Backend — Jubilee Worker" #ECFDF3
  participant "NewBusinessNoteJob" as job
  participant "SendNewBusinessNotesCommandHandler" as handler
  participant "ScheduledJobs" as jobs
  participant "EmailPolicy" as policy
  participant "OutboxDispatcher" as dispatcher
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
participant "E-mail provider" as provider
job -> handler : Send SendNewBusinessNotesCommand
handler -> jobs : RunOnceAtAsync("new-business-note", Monday 7:00 a.m. Toronto, work)
jobs -> db : Insert JobRun (Job, Occurrence)
alt the occurrence was already claimed
  jobs --> handler : false
else claimed
  jobs -> handler : Run the work
  alt EmailSettings.CanSendPromotional is false
    handler -> handler : Queue nothing (L2-149 AC1)
  else
    handler -> db : Select members with EmailNewBusinesses on and a confirmed address
    db --> handler : Opted-in members
    loop each member
      handler -> db : Listings first approved in 7 days in the categories the member browsed
      opt at least one listing
        handler -> policy : Queue(member, "new-businesses", "New on Jubilee this week", body with the mailing address)
        policy -> db : Add OutboxMessage when WantsEmail holds, never held for the summary
      end
    end
    handler -> db : Save changes
  end
  jobs -> db : Set SucceededAt
end
dispatcher -> db : Select due rows at its next pass
db --> dispatcher : Promotional row
dispatcher -> dispatcher : Sign the unsubscribe token for member and "new-businesses"
dispatcher -> provider : Send with the footer link and List-Unsubscribe headers
provider --> member : E-mail that identifies Jubilee with its mailing address and includes an unsubscribe
@enduml
