@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Manage e-mail consent

class Consent <<static>> {
  +{static} TrySet(db, member, category, on, method, now): bool
}
class Member {
  +bool EmailNewBusinesses = false
  +bool EmailTips = false
  +bool EmailBounced
  +EmailPreference(category): bool?
  +SetEmailPreference(category, on): bool
  +WantsEmail(category): bool
}
class ConsentRecord {
  +Guid Id
  +Guid MemberId
  +string Category
  +bool Given
  +ConsentMethod Method
  +DateTimeOffset OccurredAt
  +{static} Of(memberId, category, given, method, now): ConsentRecord
}
enum ConsentMethod {
  SettingsSwitch
  UnsubscribeLink
  OneClickUnsubscribe
  MarketingSiteForm
}
class EmailCategories <<static>> {
  +NewBusinesses = "new-businesses"
  +Tips = "tips"
  +Summary = "summary"
  +{static} IsPromotional(category): bool
}
class UpdateNotificationPreferenceCommandHandler {
  +Handle(command): Task
}
class UnsubscribeCommand <<record>> {
  +string Token
}
class UnsubscribeCommandHandler {
  +Handle(command: UnsubscribeCommand): Task<string>
}
interface IUnsubscribeLinks {
  +For(memberId: Guid, category: string): string
  +TryRead(token, out memberId, out category): bool
}
class HmacUnsubscribeLinks {
  -byte[] key
}
class UnsubscribeController {
  +Unsubscribe(token: string): Task<IActionResult>
}
class EmailSettings <<record>> {
  +string? MailingAddress
  +bool CanSendPromotional
}
class EmailPolicy <<static>> {
  +{static} Queue(db, member, category, subject, body, now, ...): bool
}
class SendNewBusinessNotesCommandHandler
class SendOwnerTipsCommandHandler

UpdateNotificationPreferenceCommandHandler ..> Consent : TrySet with SettingsSwitch
UnsubscribeCommandHandler ..> Consent : TrySet with OneClickUnsubscribe
UnsubscribeCommandHandler ..> UnsubscribeCommand : handles
UnsubscribeCommandHandler ..> IUnsubscribeLinks : TryRead
UnsubscribeController ..> UnsubscribeCommand : sends
HmacUnsubscribeLinks ..|> IUnsubscribeLinks
Consent ..> Member : SetEmailPreference
Consent ..> EmailCategories : IsPromotional
Consent "1" --> "*" ConsentRecord : appends
ConsentRecord --> ConsentMethod : has
Member "1" o-- "*" ConsentRecord : history
SendNewBusinessNotesCommandHandler ..> EmailSettings : needs MailingAddress
SendOwnerTipsCommandHandler ..> EmailSettings : needs MailingAddress
SendNewBusinessNotesCommandHandler ..> EmailPolicy : Queue
SendOwnerTipsCommandHandler ..> EmailPolicy : Queue
EmailPolicy ..> Member : WantsEmail
@enduml
