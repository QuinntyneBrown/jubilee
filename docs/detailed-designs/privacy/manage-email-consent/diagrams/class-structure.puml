@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Manage e-mail consent

enum EmailCategory {
  NewMessages
  RequestUpdates
  MeetingReminders
  NewBusinesses
  TipsForBusinessOwners
}

enum ConsentAction {
  Given
  Withdrawn
}

enum ConsentMethod {
  SettingsSwitch
  UnsubscribeLink
  OneClickUnsubscribe
}

class NotificationPreferences {
  +Guid MemberId
  +bool NewMessages
  +bool RequestUpdates
  +bool MeetingReminders
  +bool NewBusinesses
  +bool TipsForBusinessOwners
  +Set(category: EmailCategory, enabled: bool): bool
  +Allows(category: EmailCategory): bool
}

class ConsentRecord {
  +Guid Id
  +Guid MemberId
  +EmailCategory Category
  +ConsentAction Action
  +ConsentMethod Method
  +DateTimeOffset OccurredAt
}

class SetEmailConsentCommand {
  +Guid MemberId
  +EmailCategory Category
  +bool Enabled
  +ConsentMethod Method
}

class SetEmailConsentCommandHandler {
  +Handle(command: SetEmailConsentCommand, ct: CancellationToken): Task<Result>
}

class LinkToken {
  +Guid Id
  +byte[] TokenHash
  +LinkTokenPurpose Purpose
  +Guid MemberId
  +EmailCategory? Category
}

class PromotionalAudienceQuery {
  +ListAsync(category: EmailCategory, ct: CancellationToken): Task<IReadOnlyList<Guid>>
}

class PromotionalEmailComposer {
  +Compose(memberId: Guid, category: EmailCategory): EmailMessage
  -AddListUnsubscribeHeaders(message: EmailMessage, token: string): void
  -AssertCompliant(message: EmailMessage): void
}

class EmailMessage {
  +string To
  +string Subject
  +string HtmlBody
  +string TextBody
  +IDictionary<string, string> Headers
}

SetEmailConsentCommandHandler ..> SetEmailConsentCommand : handles
SetEmailConsentCommandHandler --> NotificationPreferences : loads / mutates
SetEmailConsentCommandHandler ..> ConsentRecord : appends
SetEmailConsentCommand --> EmailCategory : names
SetEmailConsentCommand --> ConsentMethod : carries
ConsentRecord --> ConsentAction : has
ConsentRecord --> ConsentMethod : has
ConsentRecord --> EmailCategory : for
NotificationPreferences "1" <-- "*" ConsentRecord : history of
LinkToken --> EmailCategory : scoped to
PromotionalAudienceQuery ..> NotificationPreferences : filters on
PromotionalEmailComposer ..> EmailMessage : builds
PromotionalEmailComposer ..> LinkToken : issues
@enduml
