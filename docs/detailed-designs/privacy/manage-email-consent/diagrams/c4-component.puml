@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage e-mail consent

Container_Boundary(web, "Jubilee Web") {
  Component(settings, "NotificationSettingsPage", "Angular page", "Switches for the two promotional categories")
  Component(unsubpage, "UnsubscribePage", "Angular page", "Posts the token and says what stops")
}
Container_Boundary(api, "Jubilee API") {
  Component(account, "AccountController", "ASP.NET Core controller", "PATCH /api/account/notification-preferences")
  Component(unsub, "UnsubscribeController", "ASP.NET Core controller", "POST /api/email/unsubscribe/{token}, anonymous")
  Component(update, "UpdateNotificationPreferenceCommandHandler", "MediatR handler", "Method SettingsSwitch")
  Component(unsubh, "UnsubscribeCommandHandler", "MediatR handler", "Method OneClickUnsubscribe")
  Component(consent, "Consent", "Static rule", "Sets the switch and appends a ConsentRecord")
  Component(links, "HmacUnsubscribeLinks", "IUnsubscribeLinks", "Signs and reads the token")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(note, "SendNewBusinessNotesCommandHandler", "MediatR handler", "Weekly note to opted-in members")
  Component(tips, "SendOwnerTipsCommandHandler", "MediatR handler", "Monthly tip to opted-in owners")
  Component(settingsCfg, "EmailSettings", "Configuration", "MailingAddress; empty stops promotional e-mail")
  Component(policy, "EmailPolicy", "Static policy", "Adds a row only when the member wants the category")
  Component(dispatcher, "OutboxDispatcher", "Application service", "Adds the unsubscribe link and sends")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Members and ConsentRecords and OutboxMessages")
System_Ext(email, "E-mail provider", "Azure Communication Services Email")

Rel(settings, account, "Saves a switch through", "JSON/HTTPS")
Rel(unsubpage, unsub, "Posts the token to", "JSON/HTTPS")
Rel(account, update, "Sends UpdateNotificationPreferenceCommand")
Rel(unsub, unsubh, "Sends UnsubscribeCommand")
Rel(update, consent, "Calls TrySet")
Rel(unsubh, consent, "Calls TrySet")
Rel(unsubh, links, "Reads the token with")
Rel(consent, db, "Sets the switch and adds ConsentRecord", "EF Core")
Rel(note, settingsCfg, "Reads the mailing address from")
Rel(tips, settingsCfg, "Reads the mailing address from")
Rel(note, policy, "Calls Queue with new-businesses")
Rel(tips, policy, "Calls Queue with tips")
Rel(policy, db, "Adds OutboxMessage", "EF Core")
Rel(dispatcher, db, "Reads due rows", "EF Core")
Rel(dispatcher, links, "Signs the link with")
Rel(dispatcher, email, "Sends through IEmailSender", "HTTPS")
@enduml
