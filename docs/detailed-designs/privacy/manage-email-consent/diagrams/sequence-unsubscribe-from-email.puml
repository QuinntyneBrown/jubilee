@startuml
title UML sequence behaviour — Unsubscribe from an e-mail
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
participant "Mail client" as client
box "Frontend — Jubilee Web" #E0F2FE
  participant "UnsubscribePage" as page
end box
box "Backend — Jubilee API" #D1FADF
  participant "UnsubscribeController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "UnsubscribeCommandHandler" as handler
  participant "HmacUnsubscribeLinks" as links
  participant "Consent" as consent
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
alt one-click unsubscribe (RFC 8058)
  member -> client : Press "Unsubscribe" in the mail client
  client -> controller : POST /api/email/unsubscribe/{token}, body List-Unsubscribe=One-Click
else link in the e-mail footer
  member -> page : Open /unsubscribe/{token} without sign-in
  page --> member : Loading state
  page -> controller : POST /api/email/unsubscribe/{token}
  page -> page : Remove the token from the address bar
end
controller -> handler : Send UnsubscribeCommand
handler -> links : TryRead(token)
links -> links : Compare the HMAC-SHA256 signature in constant time
alt the token does not verify
  handler --> controller : NotFoundException UNSUBSCRIBE_LINK_INVALID
  controller --> page : 404 Not Found
  page --> member : "This link doesn't work", nothing changes (L2-224 AC3)
else verified
  links --> handler : Member ID and category
  handler -> db : Load the member
  handler -> consent : TrySet(member, category, false, OneClickUnsubscribe, now)
  opt the switch was on and the category is promotional
    consent -> db : Add ConsentRecord (withdrawn, OccurredAt) (L2-149 AC3)
  end
  handler -> db : Save changes
  handler --> controller : Category
  controller --> page : 200 OK { unsubscribed: true, category }
  page --> member : "You're unsubscribed" and what stops (L2-224 AC1)
  note over handler, db : A second call finds the switch off:\nnothing changes and no record is added (L2-224 AC5)
end
@enduml
