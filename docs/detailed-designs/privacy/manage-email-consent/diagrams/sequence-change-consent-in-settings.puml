@startuml
title UML sequence behaviour — Give or withdraw consent in notification settings
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "NotificationSettingsPage" as page
  participant "HttpProfileApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AccountController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "UpdateNotificationPreferenceCommandHandler" as handler
  participant "Consent" as consent
  participant "Member" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
member -> page : Turn "New businesses" on
page --> member : Row shows "Saving…"
page -> client : setSwitch("new-businesses", true)
client -> controller : PATCH /api/account/notification-preferences
controller -> handler : Send UpdateNotificationPreferenceCommand
handler -> db : Load the member of the session
db --> handler : Member
handler -> consent : TrySet(member, "new-businesses", true, SettingsSwitch, now)
consent -> entity : SetEmailPreference("new-businesses", true)
opt the value changed and the category is promotional
  consent -> db : Add ConsentRecord (Given, SettingsSwitch, OccurredAt) (L2-149 AC3)
end
handler -> db : Save the switch and the record in one unit of work
alt saved
  db --> handler : Commit result
  controller --> client : 200 OK with the settings
  page --> member : "Saved at {time}"
else the save fails
  controller --> client : 503 with JB-PREF-503
  page --> member : Switch back in its previous position and an error toast with "Try again"
end
@enduml
