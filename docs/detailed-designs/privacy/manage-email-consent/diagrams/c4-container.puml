@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage e-mail consent

Person(member, "Member", "Gives and withdraws consent to promotional e-mail")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Notification settings page and unsubscribe page")
  Container(api, "Jubilee API", "ASP.NET Core", "Preference and unsubscribe endpoints")
  Container(worker, "Jubilee Worker", ".NET worker service", "Queues the weekly note and the tips and sends the outbox")
  ContainerDb(db, "Jubilee database", "SQL Server", "Members with their switches, ConsentRecords, OutboxMessages, JobRuns")
}
System_Ext(email, "E-mail provider", "Azure Communication Services Email")

Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "PATCH preferences and POST /api/email/unsubscribe/{token}", "JSON/HTTPS")
Rel(member, api, "Mail client posts the one-click unsubscribe to", "HTTPS")
Rel(api, db, "Writes switches and consent records", "EF Core")
Rel(worker, db, "Reads opted-in members and adds outbox rows", "EF Core")
Rel(worker, email, "Sends promotional e-mail through", "HTTPS")
Rel(email, member, "Delivers e-mail to", "SMTP")
@enduml
