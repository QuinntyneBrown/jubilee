@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Protect reference answers

Container_Boundary(web, "Jubilee Web") {
  Component(review, "VerificationReviewPage", "Angular page", "Hosts the church reference panel at /admin/verifications/:id")
  Component(panel, "ChurchReferencePanel", "Angular component", "Shows church and name and role and answer and note with the privacy notice")
  Component(mybiz, "MyBusinessPage", "Angular page", "Shows the listing stage and the confirmed label only")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "AdminVerificationsController", "ASP.NET Core controller", "Verifier-only review endpoint")
  Component(handler, "GetListingReviewQueryHandler", "MediatR handler", "Loads the listing with its reference and answer")
  Component(ownerh, "GetMyBusinessQueryHandler", "MediatR handler", "Projects OwnerListingDto without reference fields")
  Component(policy, "VerifierPolicy", "Authorization policy", "Admits the Verifier and Admin roles only")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(rule, "ReferenceRetentionRule", "Retention rule", "Deletes reference data 90 days after a decision")
  Component(export, "DataExportBuilder", "Application service", "Builds the owner archive without reference types")
  Component(sender, "ReferenceEmailSender", "Application service", "Only reader of the reference e-mail address")
}
ContainerDb(db, "Jubilee database", "SQL Server", "ChurchReference and ReferenceAnswer and Listing")

Rel(review, panel, "Renders")
Rel(review, ctrl, "Gets the review from", "JSON/HTTPS")
Rel(mybiz, ownerh, "Gets the owner view from", "JSON/HTTPS")
Rel(ctrl, policy, "Applies")
Rel(ctrl, handler, "Sends GetListingReviewQuery")
Rel(handler, db, "Reads reference and answer", "EF Core")
Rel(ownerh, db, "Reads listing stage", "EF Core")
Rel(rule, db, "Deletes reference rows and keeps the confirmed month", "EF Core")
Rel(export, db, "Reads owner data except references", "EF Core")
Rel(sender, db, "Reads the reference e-mail address", "EF Core")
@enduml
