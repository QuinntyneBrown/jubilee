@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Protect reference answers

Person(verifier, "Verification team member", "Reads the answer on the review screen")
Person(owner, "Owner", "Sees the listing stage but never the answer")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Review screen for verifiers and My business for owners")
  Container(api, "Jubilee API", "ASP.NET Core", "Returns reference details to verifiers only")
  Container(worker, "Jubilee Worker", ".NET worker service", "Runs the daily retention job and builds data downloads")
  ContainerDb(db, "Jubilee database", "SQL Server", "Church references and answers and listings")
}
System_Ext(email, "E-mail provider", "Transactional e-mail - vendor TO SUPPLY")

Rel(verifier, web, "Uses", "HTTPS")
Rel(owner, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core over TLS")
Rel(worker, db, "Deletes reference data 90 days after a decision in", "EF Core over TLS")
Rel(worker, email, "Sends reference request and reminders via", "HTTPS")
@enduml
