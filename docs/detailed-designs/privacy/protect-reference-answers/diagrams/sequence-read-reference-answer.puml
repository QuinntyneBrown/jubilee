@startuml
title UML sequence behaviour — Read a reference answer on the review screen
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Verification team member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "VerificationReviewPage" as page
  participant "AdminApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AdminVerificationsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "StaffAccessAuditBehavior" as behavior
  participant "GetListingReviewQueryHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Open /admin/verifications/:id
page -> client : Request the listing review
client -> controller : GET /api/admin/verifications/{listingId}
controller -> controller : Authenticate and apply L2-133 VerifierPolicy
alt caller is not a verifier (owner, member or visitor)
  controller --> client : 403 ProblemDetails without reference data (L2-146)
  client --> page : Forbidden result
  page --> actor : Show the forbidden page
else caller is a verifier
  controller -> behavior : Send GetListingReviewQuery with reason ListingId
  behavior -> db : Append AuditEntry StaffViewedPersonalData (L2-150)
  db --> behavior : Committed
  behavior -> handler : Continue to the handler
  handler -> db : Load listing, ChurchReference and ReferenceAnswer
  db --> handler : Review state
  handler --> behavior : ListingReviewDto with ReferencePanelDto
  behavior --> controller : ListingReviewDto
  controller --> client : 200 with Cache-Control: no-store
  client --> page : Typed review
  page --> actor : Show the Church reference panel with the private notice
end
@enduml
