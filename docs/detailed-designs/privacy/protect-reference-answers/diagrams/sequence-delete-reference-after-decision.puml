@startuml
title UML sequence behaviour — Delete reference data 90 days after a decision
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

box "Backend — Jubilee Worker" #D1FADF
  participant "RetentionJob" as job
  participant "ReferenceRetentionRule" as rule
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "Listing" as listing
  participant "IClock" as clock
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
job -> clock : Read the current time
clock --> job : Now
job -> rule : ApplyAsync(now)
rule -> db : Select references whose listing DecidedAt is 90 days old or older (L2-146)
db --> rule : Due references
loop each due reference
  rule -> listing : Keep ReferenceConfirmedOn month and year
  listing --> rule : Label Reference confirmed {month YYYY}
  rule -> db : Delete ReferenceAnswer row (answer and note)
  rule -> db : Delete ChurchReference row (name and e-mail)
  rule -> db : Save changes in one unit of work
  db --> rule : Committed
end
rule --> job : Deleted count
job -> db : Insert RetentionRun with rule name and count only (L2-148)
db --> job : Committed
@enduml
