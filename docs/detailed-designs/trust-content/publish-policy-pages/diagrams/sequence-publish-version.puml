@startuml
title UML sequence behaviour — Publish a new content version
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Jubilee administrator" as actor
box "Frontend — Admin application" #E0F2FE
  participant "AdminPolicyPage" as page
  participant "PublishPolicyDialog" as dialog
  participant "HttpAdminContentApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AdminContentController" as controller
end box
box "Backend — Jubilee Application" #ECFDF3
  participant "PublishContentVersionCommandHandler" as handler
  participant "ContentReader" as reader
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
  database "Cache" as cache
end box
actor -> page : Open /policies/privacy
page -> client : GET /api/admin/content/privacy
client --> page : Published text (version 2) and kept versions
actor -> page : Edit the fields, choose Preview
page --> actor : The draft rendered by jb-policy-document, dated today
actor -> page : Publish version 3
page -> page : Check title, headings and texts (L2-241 AC4)
page -> dialog : Open "Publish version 3 of Privacy?"
actor -> dialog : Publish version 3
dialog -> client : POST /api/admin/content/privacy/versions with basedOn 2
client -> controller : RequiresAdmin (L2-133)
alt Not an administrator
  controller --> client : 403
else Administrator
  controller -> handler : PublishContentVersionCommand
  handler -> reader : Published("privacy")
  reader --> handler : Version 2
  alt basedOn is older than the published version
    handler --> controller : 409 VERSION_CHANGED
    controller --> dialog : "Version 3 was published while you were editing" with Reload
  else Current
    handler -> handler : Validate (422 with codes)
    handler -> db : Add ContentVersion 3 and AuditRecord content.published in one save
    db --> handler : Saved; versions 1 and 2 unchanged
    handler -> cache : Remove the privacy entry
    handler --> controller : ContentDto version 3
    controller --> dialog : 201
    dialog --> page : Published
    page --> actor : Toast "Version 3 published"; version 3 above the kept versions
  end
end
@enduml
