@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Publish policy pages

class ContentVersion {
  +{static} string[] Slugs
  +Guid Id
  +string Slug
  +int Number
  +string Title
  +string Lead
  +string SectionsJson
  +DateTimeOffset PublishedAt
  +string PublishedBy
  +{static} Publish(slug, number, title, lead, sectionsJson, now, publishedBy): ContentVersion
}

class ContentSectionDto {
  +string Heading
  +string Anchor
  +string Body
}

class ContentDto {
  +string Slug
  +string Title
  +string Lead
  +int Version
  +DateTimeOffset PublishedAt
  +IReadOnlyList<ContentSectionDto> Sections
}

class AdminContentRow {
  +string Slug
  +string Title
  +int Version
  +DateTimeOffset PublishedAt
  +string PublishedBy
  +int KeptVersions
}

class AdminContentDto {
  +ContentDto Published
  +string PublishedBy
  +IReadOnlyList<ContentVersionDto> Versions
}

class ContentVersionDto {
  +int Number
  +string Title
  +DateTimeOffset PublishedAt
  +string PublishedBy
  +bool Published
}

class ContentDefaults {
  +{static} For(slug): ContentDto
}

class ContentReader {
  +Published(slug): Task<ContentDto?>
  +TermsVersion(): Task<int>
}

interface IContentReadCache {
  +GetOrCreateAsync(slug, build): Task<ContentDto?>
  +RemoveAsync(slug): Task
}

class DistributedContentReadCache

class PublishContentVersionCommand {
  +Reviewer Admin
  +string Slug
  +string? Title
  +string? Lead
  +IReadOnlyList<ContentSectionDto>? Sections
  +int? BasedOn
}

class PublishContentVersionCommandHandler {
  +Handle(command): Task<ContentDto>
}

class AuditRecord

class Member {
  +int? TermsVersionNumber
}

ContentVersion ..> ContentSectionDto : sections as JSON
ContentDto *-- ContentSectionDto
AdminContentDto *-- ContentDto
AdminContentDto *-- ContentVersionDto
ContentReader --> IContentReadCache
ContentReader ..> ContentVersion : reads highest number
ContentReader ..> ContentDefaults : before the first publish
DistributedContentReadCache ..|> IContentReadCache
PublishContentVersionCommandHandler ..> PublishContentVersionCommand : handles
PublishContentVersionCommandHandler ..> ContentVersion : appends
PublishContentVersionCommandHandler ..> AuditRecord : content.published
PublishContentVersionCommandHandler --> IContentReadCache : removes slug
Member ..> ContentVersion : terms version agreed to
@enduml
