@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Publish policy pages

Person(visitor, "Visitor or member", "Reads policy pages")
Person(admin, "Jubilee administrator", "Publishes policy text")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee app", "Angular", "Statement of faith, terms, privacy and help pages")
  Container(adminApp, "Admin application", "Angular", "Policies list, editor with preview, publish")
  Container(api, "Jubilee API", "ASP.NET Core", "Content read and admin endpoints")
  ContainerDb(db, "Jubilee database", "SQL Server", "Content versions, audit log, members' terms version")
  ContainerDb(cache, "Cache", "Redis", "Published content read cache")
}
Rel(visitor, web, "Uses", "HTTPS")
Rel(admin, adminApp, "Uses", "HTTPS")
Rel(web, api, "Reads content", "JSON/HTTPS")
Rel(adminApp, api, "Reads and publishes content", "JSON/HTTPS")
Rel(api, cache, "Reads and clears published content", "Redis protocol")
Rel(api, db, "Reads and appends versions", "EF Core")
@enduml
