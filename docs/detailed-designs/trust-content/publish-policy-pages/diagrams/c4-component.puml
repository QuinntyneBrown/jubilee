@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Publish policy pages

Container_Boundary(web, "Jubilee app") {
  Component(pages, "PolicyPage", "Angular page", "Statement of faith, terms and privacy")
  Component(help, "HelpPage", "Angular page", "Accordion of questions; opens the anchored one")
  Component(client, "HttpContentApi", "CONTENT_API", "GET /api/content/{slug}")
}
Container_Boundary(admin, "Admin application") {
  Component(list, "AdminPoliciesPage", "Angular page", "/policies")
  Component(editor, "AdminPolicyPage", "Angular page", "/policies/{slug}: edit, preview, kept versions")
  Component(dialog, "PublishPolicyDialog", "CDK dialog", "Confirms the publish")
  Component(adminClient, "HttpAdminContentApi", "ADMIN_CONTENT_API", "/api/admin/content")
}
Component(doc, "jb-policy-document", "components", "Renders a policy page")
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "ContentController", "ASP.NET Core controller", "Anonymous read")
  Component(actrl, "AdminContentController", "ASP.NET Core controller", "RequiresAdmin: list, read, versions, publish")
  Component(reader, "ContentReader", "Application service", "Published text or ContentDefaults")
  Component(pub, "PublishContentVersionCommandHandler", "MediatR handler", "Validates, checks basedOn, appends, audits")
  Component(cacheSvc, "DistributedContentReadCache", "IContentReadCache", "Per slug, 10 minutes")
}
ContainerDb(db, "Jubilee database", "SQL Server", "ContentVersions, AuditRecords")
ContainerDb(cache, "Cache", "Redis", "Published content")

Rel(pages, doc, "Renders with")
Rel(editor, doc, "Previews with")
Rel(pages, client, "Loads through")
Rel(help, client, "Loads through")
Rel(list, adminClient, "Loads through")
Rel(editor, dialog, "Opens")
Rel(editor, adminClient, "Loads through")
Rel(dialog, adminClient, "Publishes through")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(adminClient, actrl, "Calls", "JSON/HTTPS")
Rel(ctrl, reader, "Reads published")
Rel(actrl, reader, "Reads published")
Rel(actrl, pub, "Sends PublishContentVersionCommand")
Rel(reader, cacheSvc, "Reads and fills")
Rel(cacheSvc, cache, "Get, set, remove")
Rel(reader, db, "Reads on a miss", "EF Core")
Rel(pub, db, "Appends version and audit record", "EF Core")
Rel(pub, cacheSvc, "Removes the slug after saving")
@enduml
