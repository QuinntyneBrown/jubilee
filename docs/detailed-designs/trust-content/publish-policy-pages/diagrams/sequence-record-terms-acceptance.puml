@startuml
title UML sequence behaviour — Record the terms version at joining
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Visitor" as actor
box "Frontend — Jubilee app" #E0F2FE
  participant "JoinPage" as page
end box
box "Backend — Jubilee API" #D1FADF
  participant "AccountController" as controller
end box
box "Backend — Jubilee Application" #ECFDF3
  participant "JoinWithEmailCommandHandler" as handler
  participant "ContentReader" as terms
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Tick "I am 18 or older and I agree to..." and join
page -> controller : POST /api/account
controller -> handler : JoinWithEmailCommand
alt Agreement not accepted
  handler --> controller : 422 AGREEMENT_REQUIRED
  controller --> page : The error on the agreement
else Accepted
  handler -> terms : TermsVersion (through the read cache)
  terms --> handler : Published terms version
  handler -> db : Save Member with TermsVersionNumber (L2-108)
  handler --> controller : Created
  controller --> page : 201
end
@enduml
