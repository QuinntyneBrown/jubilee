@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Show the verified mark

Person(member, "Member", "Browses listings")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Renders the mark on cards and listing pages")
  Container(api, "Jubilee API", "ASP.NET Core", "Derives the Verified flag on every listing read model")
  ContainerDb(db, "Jubilee database", "SQL Server", "Listing stage and approval time")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Reads listings with the Verified flag", "JSON/HTTPS")
Rel(api, db, "Reads stage and approval", "EF Core")
@enduml
