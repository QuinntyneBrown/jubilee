@startuml
title UML sequence behaviour — Open the verification answer from a listing page
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "BusinessPage" as page
  participant "VerifiedBusinessLabel" as label
  participant "ListingsApi" as client
  participant "HelpPage" as help
end box
box "Backend — Jubilee API" #D1FADF
  participant "ListingsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetPublicListingQueryHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Open /b/:slug
page -> client : Load public listing
client -> controller : GET /api/listings/{slug}
controller -> handler : Send GetPublicListingQuery
handler -> db : Load listing and project Verified (L2-111)
db --> handler : ListingPageDto
handler --> controller : ListingPageDto
controller --> client : 200 listing
client --> page : Listing
page -> label : Render with Verified and the category
label --> actor : Show "Verified Christian business" as a link (L2-111)
actor -> label : Follow the link
label -> help : Navigate to /help#how-does-a-business-get-verified
help -> help : Open the disclosure "How does a business get verified?"
help --> actor : Show the verification answer
@enduml
