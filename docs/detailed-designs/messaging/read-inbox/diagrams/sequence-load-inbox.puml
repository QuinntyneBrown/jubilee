@startuml
title UML sequence behaviour — Load the inbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member or Owner" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "MessagesPage" as page
  participant "InboxList" as list
  participant "MessagesStore" as store
  participant "RealtimeService" as rt
  participant "MessagesApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ConversationsController" as controller
  participant "EventsController" as events
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetInboxQueryHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
member -> page : Open /messages
page -> store : load('')
store -> client : inbox()
client -> controller : GET /api/conversations
controller -> controller : Authenticate
controller -> handler : Send GetInboxQuery
handler -> db : Select conversations where caller is the member or owns the listing (L2-056)
db --> handler : Counts of the whole inbox and the first 50 rows by LastMessageAt then Id
handler -> handler : Build previews and HasMore (L2-056)
handler --> controller : InboxDto
controller --> client : 200 OK
client --> store : Rows and counts and hasMore
store --> page : State
alt no conversations
  page --> member : Show "Start a conversation." with "Browse businesses"
else conversations exist
  page --> member : Show "4 conversations · 2 unread"
  list --> member : Rows marked "Unread." and "Muted."
  opt viewport 1024 px or wider and none open
    page --> member : Show "Pick a conversation." in the right pane
  end
end
opt hasMore and the member presses "Show more conversations"
  list -> store : loadMore()
  list --> member : Button busy and "Loading more conversations…" announced
  store -> client : inbox(search, id of the last row shown)
  client -> controller : GET /api/conversations?before={conversationId}
  controller -> handler : Send GetInboxQuery with Before
  handler -> db : The 50 rows after that conversation in the same order
  db --> handler : Rows
  handler --> controller : InboxDto
  controller --> client : 200 OK
  client --> store : Next rows and hasMore
  store --> list : Rows added below what is shown
  list --> member : "{n} more conversations shown." announced (L2-056)
end
opt a message arrives while the inbox is open
  events -> rt : notification event of kind message (L2-070)
  rt -> list : Publish notification
  list -> store : load()
  store -> client : inbox()
  client -> controller : GET /api/conversations
  controller --> client : 200 OK
  client --> store : First page and counts
  store --> list : First page refreshed and rows loaded below it kept
  events -> rt : counts event
  rt --> member : Unread count in the navigation updated
end
@enduml
