@startuml
title UML sequence behaviour — Mute a conversation
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "ConversationPage" as page
  participant "jb-menu" as menu
  participant "MessagesApi" as client
  participant "ToastService" as toast
end box
box "Backend — Jubilee API" #D1FADF
  participant "ConversationsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SetConversationMutedCommandHandler" as handler
  participant "Conversation" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
member -> page : Press "More" in the conversation header
page -> menu : Open with "Mute" and "Report conversation" (L2-061)
member -> menu : Choose "Mute"
menu -> page : Mute chosen
page -> client : mute(id, true)
client -> controller : PUT /api/conversations/{id}/mute { muted: true }
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send SetConversationMutedCommand
handler -> db : Load conversation for a participant (L2-133)
alt caller is not a participant
  db --> handler : No row
  handler --> controller : Not found
  controller --> client : 404 ProblemDetails
  client --> page : Error
  page -> toast : Error toast "We couldn't mute this conversation. Try again."
else participant
  db --> handler : Conversation
  handler -> entity : Mute(asOwner, true) (L2-061)
  entity --> handler : Mute flag of the caller's side set
  handler -> db : Save changes in one unit of work
  db --> handler : Commit result
  handler --> controller : Done
  controller --> client : 204 No Content
  client --> page : Muted
  page --> member : Header says "Muted" and the inbox row is announced "Muted."
  page -> toast : Show "Conversation muted." with "Undo"
  toast --> member : Toast
  opt member presses "Undo" or later chooses "Unmute"
    member -> toast : Press "Undo"
    toast -> page : Undo
    page -> client : mute(id, false)
    client -> controller : PUT /api/conversations/{id}/mute { muted: false }
    controller --> client : 204 No Content
    client --> page : E-mails resume (L2-061)
  end
end
@enduml
