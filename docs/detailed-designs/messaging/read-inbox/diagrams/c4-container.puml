@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Read the inbox

Person(member, "Member", "Reads the inbox")
Person(owner, "Owner", "Reads business conversations")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Messages page with list and search")
  Container(api, "Jubilee API", "ASP.NET Core", "Conversation list and mute endpoints and the event stream")
  ContainerDb(db, "Jubilee database", "SQL Server", "Conversations and messages and notifications")
}

Rel(member, web, "Uses", "HTTPS")
Rel(owner, web, "Uses", "HTTPS")
Rel(web, api, "GET /api/conversations and PUT mute", "JSON/HTTPS")
Rel(api, web, "Sends notification and counts events on GET /api/events", "Server-sent events")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
