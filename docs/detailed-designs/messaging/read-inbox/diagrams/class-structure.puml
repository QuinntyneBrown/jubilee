@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Read the inbox

class MessagesStore <<signal store>> {
  +rows: Signal<InboxRowDto[]>
  +total: Signal<number>
  +unread: Signal<number>
  +term: Signal<string>
  +load(): void
  +search(term: string): void
  +setMuted(id: string, muted: boolean): void
}
class RealtimeService <<Angular service>> {
  +received: Observable<NotificationItem>
}
class MessagesApi <<service contract>> {
  +inbox(term: string): Observable<InboxDto>
  +mute(id: string, muted: boolean): Observable<void>
}
class GetInboxQuery {
  +string Subject
  +string Search
}
class GetInboxQueryHandler {
  +Handle(query: GetInboxQuery): Task<InboxDto>
}
class InboxDto {
  +int TotalCount
  +int UnreadCount
  +IReadOnlyList<InboxRowDto> Conversations
}
class InboxRowDto {
  +Guid Id
  +string Title
  +string BusinessName
  +string Preview
  +DateTimeOffset LastMessageAt
  +bool Unread
  +bool Muted
}
class SetConversationMutedCommand {
  +string Subject
  +Guid ConversationId
  +bool Muted
}
class SetConversationMutedCommandHandler {
  +Handle(command: SetConversationMutedCommand): Task
}
class Conversation {
  +Guid Id
  +Guid ListingId
  +string MemberSubject
  +DateTimeOffset LastMessageAt
  +DateTimeOffset? MemberReadAt
  +DateTimeOffset? OwnerReadAt
  +bool MemberMuted
  +bool OwnerMuted
  +MarkRead(asOwner: bool, now: DateTimeOffset): void
  +Mute(asOwner: bool, muted: bool): void
}

MessagesStore ..> MessagesApi : calls
InboxList ..> RealtimeService : reads again on message notifications
MessagesStore "1" o-- "*" InboxRowDto : holds
MessagesApi ..> GetInboxQuery : GET /api/conversations
MessagesApi ..> SetConversationMutedCommand : PUT mute
GetInboxQueryHandler ..> GetInboxQuery : handles
GetInboxQueryHandler ..> InboxDto : returns
InboxDto "1" *-- "*" InboxRowDto : contains
SetConversationMutedCommandHandler ..> SetConversationMutedCommand : handles
SetConversationMutedCommandHandler --> Conversation : loads / mutates
@enduml
