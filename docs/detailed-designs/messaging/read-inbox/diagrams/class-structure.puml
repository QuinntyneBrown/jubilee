@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Read the inbox

class InboxList <<Angular container>> {
  +selectedId: string?
  +typed(value: string): void
  +searchNow(): void
  +clear(): void
}
class MessagesStore <<Angular service>> {
  +state: Signal<LoadState<Inbox>>
  +search: Signal<string>
  +load(search: string): void
  +loadMore(): void
}
class RealtimeService <<Angular service>> {
  +received: Observable<NotificationItem>
}
class MessagesApi <<service contract>> {
  +inbox(search?: string, before?: string): Observable<Inbox>
  +mute(id: string, muted: boolean): Observable<void>
}
class GetInboxQuery {
  +string Subject
  +string? Search
  +Guid? Before
}
class GetInboxQueryHandler {
  +Handle(query: GetInboxQuery): Task<InboxDto>
}
class ConversationRules <<static>> {
  +const int InboxPageSize = 50
  +RowsFor(db: IAppDbContext, subject: string): IQueryable<ConversationRow>
}
class InboxDto {
  +int TotalCount
  +int UnreadCount
  +IReadOnlyList<InboxRowDto> Conversations
}
class InboxRowDto {
  +Guid Id
  +string Title
  +string BusinessName
  +string BusinessSlug
  +string Preview
  +DateTimeOffset LastMessageAt
  +bool Unread
  +bool Muted
}
class SetConversationMutedCommand {
  +string Subject
  +Guid ConversationId
  +bool Muted
}
class SetConversationMutedCommandHandler {
  +Handle(command: SetConversationMutedCommand): Task
}
class Conversation {
  +Guid Id
  +Guid ListingId
  +string MemberSubject
  +DateTimeOffset LastMessageAt
  +DateTimeOffset? MemberReadAt
  +DateTimeOffset? OwnerReadAt
  +bool MemberMuted
  +bool OwnerMuted
  +MarkRead(asOwner: bool, now: DateTimeOffset): void
  +Mute(asOwner: bool, muted: bool): void
}

InboxList ..> MessagesStore : reads and loads
InboxList ..> RealtimeService : reads again on message notifications
MessagesStore ..> MessagesApi : calls
MessagesApi ..> GetInboxQuery : GET /api/conversations
MessagesApi ..> SetConversationMutedCommand : PUT mute
GetInboxQueryHandler ..> GetInboxQuery : handles
GetInboxQueryHandler ..> ConversationRules : scopes and pages with
GetInboxQueryHandler ..> InboxDto : returns
InboxDto "1" *-- "*" InboxRowDto : contains
SetConversationMutedCommandHandler ..> SetConversationMutedCommand : handles
SetConversationMutedCommandHandler --> Conversation : loads / mutates
@enduml
