@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Read the inbox

Container_Boundary(web, "Jubilee Web") {
  Component(page, "MessagesPage", "Angular page", "Route /messages with list pane and reading pane")
  Component(search, "InboxSearchBox", "Angular component", "Search messages field with 300 ms debounce")
  Component(row, "ConversationRow", "Angular component", "One conversation with preview and Unread and Muted marks")
  Component(store, "MessagesStore", "Signal store", "Holds rows and counts and search term")
  Component(client, "MessagesApi", "Service contract", "Calls the conversation endpoints")
  Component(rt, "RealtimeService", "Angular service", "Reads the event stream and publishes each notification")
  Component(nav, "NavigationStore", "Signal store", "Holds the unread count of the navigation badge")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "ConversationsController", "ASP.NET Core controller", "Exposes /api/conversations and the mute sub-resource")
  Component(list, "GetInboxQueryHandler", "MediatR handler", "Returns the caller's conversations and optional search matches")
  Component(mute, "SetConversationMutedCommandHandler", "MediatR handler", "Mutes or unmutes for one side")
  Component(conv, "Conversation", "Domain entity", "Read mark and mute flag of each side")
  Component(events, "EventsController", "ASP.NET Core controller", "Streams notification and counts events on /api/events")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Conversations and messages and notifications")

Rel(page, search, "Hosts")
Rel(page, row, "Renders one per conversation")
Rel(page, store, "Reads state from")
Rel(search, store, "Sets search term")
Rel(store, client, "Loads and mutes through")
Rel(rt, store, "Publishes message notifications to")
Rel(rt, nav, "Applies counts events to")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(events, rt, "Sends notification and counts events", "Server-sent events")
Rel(ctrl, list, "Sends GetInboxQuery")
Rel(ctrl, mute, "Sends SetConversationMutedCommand")
Rel(mute, conv, "Loads and mutates")
Rel(list, db, "Queries participant-scoped rows", "EF Core")
Rel(mute, db, "Persists", "EF Core")
@enduml
