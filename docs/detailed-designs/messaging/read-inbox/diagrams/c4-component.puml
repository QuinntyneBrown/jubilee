@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Read the inbox

Container_Boundary(web, "Jubilee Web") {
  Component(page, "MessagesPage", "Angular page", "Route /messages with list pane and reading pane")
  Component(search, "InboxSearchBox", "Angular component", "Search messages field with 300 ms debounce")
  Component(row, "ConversationRow", "Angular component", "One conversation with preview and unread mark and mute menu")
  Component(store, "MessagesStore", "Signal store", "Holds rows and counts and search term")
  Component(client, "MessagesApi", "Typed HTTP client", "Calls the conversation endpoints")
  Component(rt, "RealtimeClient", "Angular service", "Receives message events")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "ConversationsController", "ASP.NET Core controller", "Exposes /api/conversations and the mute sub-resource")
  Component(list, "ListConversationsQueryHandler", "MediatR handler", "Returns the caller's conversations and optional search matches")
  Component(mute, "SetConversationMuteCommandHandler", "MediatR handler", "Mutes or unmutes for one participant")
  Component(part, "ConversationParticipant", "Domain entity", "Read position and mute flag of one side")
  Component(hub, "EventsHub", "SignalR hub", "Pushes events to the signed-in user")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Conversations and participants and messages")

Rel(page, search, "Hosts")
Rel(page, row, "Renders one per conversation")
Rel(page, store, "Reads state from")
Rel(search, store, "Sets search term")
Rel(row, store, "Requests mute or unmute")
Rel(store, client, "Loads and mutates through")
Rel(rt, store, "Applies message events to")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(hub, rt, "Pushes events", "WebSocket or server-sent events")
Rel(ctrl, list, "Sends ListConversationsQuery")
Rel(ctrl, mute, "Sends SetConversationMuteCommand")
Rel(mute, part, "Loads and mutates")
Rel(list, db, "Queries participant-scoped rows", "EF Core")
Rel(mute, db, "Persists", "EF Core")
@enduml
