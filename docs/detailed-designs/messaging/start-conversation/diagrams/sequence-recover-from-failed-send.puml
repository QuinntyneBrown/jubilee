@startuml
title UML sequence behaviour — Recover from a failed send
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "NewMessageDialog" as dialog
  participant "MessagesApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ConversationsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "StartConversationCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
member -> dialog : Press "Send message"
dialog -> client : start(listingSlug, body, key)
client -x controller : Request lost or response lost
client --> dialog : Network error
dialog --> member : Show "We couldn't send that." and keep the text (L2-055)
member -> dialog : Press "Send message" again
dialog -> client : start with the same key
client -> controller : POST /api/conversations with the same idempotencyKey
controller -> handler : Send StartConversationCommand
handler -> db : Look up (SenderSubject, IdempotencyKey) (L2-132)
alt first attempt reached the server
  db --> handler : Original message
  handler --> controller : Original StartedConversationDto and nothing written
else first attempt never arrived
  db --> handler : No row
  handler -> db : Save conversation and message and the owner's notification
  db --> handler : Commit result
  handler --> controller : StartedConversationDto
end
controller --> client : 201 Created
client --> dialog : Conversation ID
dialog --> member : Close dialog and open /messages/:id
@enduml
