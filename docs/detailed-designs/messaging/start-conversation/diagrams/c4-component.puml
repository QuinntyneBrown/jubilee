@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Start a conversation

Container_Boundary(web, "Jubilee Web") {
  Component(page, "BusinessPage", "Angular page", "Shows the listing and the Message action")
  Component(dialog, "NewMessageDialog", "Angular dialog", "Collects the first message and shows field and send errors")
  Component(client, "MessagesApi", "Service contract", "Builds the conversation request with an idempotency key")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "ConversationsController", "ASP.NET Core controller", "Exposes POST /api/conversations")
  Component(validator, "StartConversationCommandValidator", "FluentValidation validator", "Requires text of 1 to 4000 characters")
  Component(handler, "StartConversationCommandHandler", "MediatR handler", "Answers the original result for a repeated key or finds or creates the conversation and adds the message")
  Component(conv, "Conversation", "Domain entity", "Owns the read marks and message order")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Conversations and messages with a unique sender and idempotency key")

Rel(page, dialog, "Opens")
Rel(dialog, client, "Calls start")
Rel(client, ctrl, "POST /api/conversations", "JSON/HTTPS")
Rel(ctrl, validator, "Validates through MediatR pipeline")
Rel(ctrl, handler, "Sends StartConversationCommand")
Rel(handler, conv, "Creates or loads and mutates")
Rel(handler, db, "Looks up the key and persists with the owner's notification", "EF Core")
@enduml
