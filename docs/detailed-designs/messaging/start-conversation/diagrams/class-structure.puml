@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Start a conversation

class NewMessageDialog <<Angular dialog>> {
  +listing: ListingSummary
  +text: FormControl<string>
  +state: DialogState
  -idempotencyKey: string
  +send(): void
  +remaining(): number
}
enum DialogState {
  Default
  Invalid
  Busy
  Failed
}
class MessagesApi <<service contract>> {
  +start(listingSlug: string, body: string, idempotencyKey: string): Observable<StartedConversationDto>
}
class ConversationsController {
  +Start(request: StartConversationRequest): Task<IActionResult>
}
class StartConversationCommand {
  +string Subject
  +string ListingSlug
  +string Body
  +string IdempotencyKey
}
class StartConversationCommandValidator {
  +const int MaxLength = 4000
  +Validate(command: StartConversationCommand): ValidationResult
}
class StartConversationCommandHandler {
  +Handle(command: StartConversationCommand): Task<StartedConversationDto>
}
class StartedConversationDto {
  +Guid ConversationId
  +Guid MessageId
}
class Conversation {
  +Guid Id
  +Guid ListingId
  +string MemberSubject
  +DateTimeOffset LastMessageAt
  +{static} Start(listingId: Guid, memberSubject: string, memberName: string, now: DateTimeOffset): Conversation
  +NextMessageTime(now: DateTimeOffset): DateTimeOffset
}
class Message {
  +Guid Id
  +string SenderSubject
  +string Body
  +DateTimeOffset CreatedAt
  +string IdempotencyKey
}

NewMessageDialog --> DialogState : has
NewMessageDialog ..> MessagesApi : calls
MessagesApi ..> ConversationsController : POST /api/conversations
ConversationsController ..> StartConversationCommand : sends
StartConversationCommandValidator ..> StartConversationCommand : validates
StartConversationCommandHandler ..> StartConversationCommand : handles
StartConversationCommandHandler ..> StartedConversationDto : returns
StartConversationCommandHandler --> Conversation : finds or creates
StartConversationCommandHandler ..> Message : looks up by sender and idempotency key
Conversation "1" *-- "1..*" Message : contains
@enduml
