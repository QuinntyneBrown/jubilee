@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Start a conversation

class NewMessageDialog <<CDK dialog>> {
  +data: NewMessageData
  +text: Signal<string>
  +view: Signal<View>
  -key: string
  +send(): void
  +close(): void
}
class NewMessageData <<TypeScript>> {
  +slug: string
  +businessName: string
  +ownerFirstName: string
  +intro: string
}
enum View {
  form
  invalid
  busy
  failed
}
class MessagesApi <<service contract>> {
  +start(listingSlug: string, body: string, idempotencyKey: string): Observable<StartedConversation>
}
class ConversationsController {
  +Start(request: StartConversationRequest): Task<IActionResult>
}
class StartConversationCommand {
  +string Subject
  +string Name
  +string ListingSlug
  +string Body
  +string IdempotencyKey
}
class ConversationRules <<static>> {
  +const int MessagesPerWindow = 30
  +const int NewConversationsPerDay = 10
  +CleanBody(body: string, hasPhoto: bool): string
  +EnsureMessageBudget(db: IAppDbContext, sender: string, now: DateTimeOffset): Task
}
class StartConversationCommandHandler {
  +Handle(command: StartConversationCommand): Task<StartedConversationDto>
}
class StartedConversationDto {
  +Guid ConversationId
  +Guid MessageId
}
class Conversation {
  +Guid Id
  +Guid ListingId
  +string MemberSubject
  +DateTimeOffset LastMessageAt
  +{static} Start(listingId: Guid, memberSubject: string, memberName: string, now: DateTimeOffset): Conversation
  +NextMessageTime(now: DateTimeOffset): DateTimeOffset
}
class Message {
  +const int MaxBodyLength = 4000
  +Guid Id
  +string SenderSubject
  +string Body
  +DateTimeOffset CreatedAt
  +string IdempotencyKey
}

NewMessageDialog --> NewMessageData : opened with
NewMessageDialog --> View : has
NewMessageDialog ..> MessagesApi : calls
MessagesApi ..> ConversationsController : POST /api/conversations
ConversationsController ..> StartConversationCommand : sends
StartConversationCommandHandler ..> StartConversationCommand : handles
StartConversationCommandHandler ..> ConversationRules : checks text and limits
StartConversationCommandHandler ..> StartedConversationDto : returns
StartConversationCommandHandler --> Conversation : finds or creates
StartConversationCommandHandler ..> Message : looks up by sender and idempotency key
Conversation "1" *-- "1..*" Message : contains
@enduml
