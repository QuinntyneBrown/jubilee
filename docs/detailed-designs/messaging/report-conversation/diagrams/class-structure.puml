@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Report a conversation

class ReportConversationDialog <<CDK dialog>> {
  +business: string
  +canBlock: boolean
  +reason: FormControl<string>
  +block: FormControl<boolean>
  +submit(): void
}
class MessageTextComponent <<Angular component>> {
  +text: string
  +segments(): TextSegment[]
}
class ReportConversationCommand {
  +string Subject
  +Guid ConversationId
  +string Reason
  +bool Block
}
class ReportConversationCommandHandler {
  +Handle(command: ReportConversationCommand): Task
}
class ConversationReport {
  +Guid Id
  +Guid ConversationId
  +string ReporterSubject
  +string Reason
  +ReportStatus Status
  +DateTimeOffset CreatedAt
  +{static} File(conversationId: Guid, reporterSubject: string, reason: string, now: DateTimeOffset): ConversationReport
}
enum ReportStatus {
  Open
  InReview
  Resolved
}
class Conversation {
  +Guid Id
  +bool MemberMuted
  +bool OwnerMuted
  +bool BlockedByMember
  +Mute(asOwner: bool, muted: bool): void
  +Block(): void
}
class Message {
  +Guid Id
  +bool FromOwner
  +bool HiddenFromMember
}
class ReportedConversationAccessPolicy {
  +Authorize(staff: Member, conversationId: Guid): Task<bool>
}
class AuditEntry {
  +Guid Id
  +Guid ActorMemberId
  +string Action
  +string Target
  +DateTimeOffset OccurredAt
  +string Reason
}

ReportConversationDialog ..> ReportConversationCommand : POST report
ReportConversationCommandHandler ..> ReportConversationCommand : handles
ReportConversationCommandHandler --> ConversationReport : files at most one unresolved
ReportConversationCommandHandler --> Conversation : blocks when the member chose it
ConversationReport --> ReportStatus : has
ConversationReport "*" --> "1" Conversation : attaches
Conversation "1" *-- "*" Message : contains
ReportedConversationAccessPolicy ..> ConversationReport : requires an open
ReportedConversationAccessPolicy ..> AuditEntry : records
@enduml
