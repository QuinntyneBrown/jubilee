@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Report a conversation

class ReportConversationDialog <<CDK dialog>> {
  +data: ReportConversationData
  +what: Signal<string>
  +block: Signal<boolean>
  +send(): void
  +close(): void
}
class ReportConversationData <<TypeScript>> {
  +conversationId: string
  +businessName: string
  +canBlock: boolean
}
class ReportConversationCommand {
  +string Subject
  +Guid ConversationId
  +string Reason
  +bool Block
}
class ReportConversationCommandHandler {
  +Handle(command: ReportConversationCommand): Task
}
class ConversationRules <<static>> {
  +const int ReportsPerDay = 10
}
class ConversationReport {
  +Guid Id
  +Guid ConversationId
  +string ReporterSubject
  +string Reason
  +ReportStatus Status
  +DateTimeOffset CreatedAt
  +{static} File(conversationId: Guid, reporterSubject: string, reason: string, now: DateTimeOffset): ConversationReport
  +StartReview(): void
  +Resolve(note: string, now: DateTimeOffset): void
}
enum ReportStatus {
  Open
  InReview
  Resolved
}
class Conversation {
  +Guid Id
  +bool MemberMuted
  +bool OwnerMuted
  +bool BlockedByMember
  +Mute(asOwner: bool, muted: bool): void
  +Block(): void
}
class Message {
  +Guid Id
  +bool FromOwner
  +bool HiddenFromMember
}
class OpenReportCommand {
  +Reviewer Reviewer
  +Guid ReportId
}
class OpenReportCommandHandler {
  +Handle(command: OpenReportCommand): Task<ReportDetailDto>
}
class ReportDetailDto {
  +Guid Id
  +string Status
  +ReportedConversationDto? Conversation
}
class ReportedConversationDto {
  +string MemberName
  +IReadOnlyList<ReportedMessageDto> Messages
}
class AuditRecord {
  +Guid Id
  +string Actor
  +string ActorName
  +string Action
  +string TargetType
  +string TargetId
  +string Reason
}

ReportConversationDialog --> ReportConversationData : opened with
ReportConversationDialog ..> ReportConversationCommand : POST report
ReportConversationCommandHandler ..> ReportConversationCommand : handles
ReportConversationCommandHandler ..> ConversationRules : counts the day's reports
ReportConversationCommandHandler --> ConversationReport : files at most one unresolved
ReportConversationCommandHandler --> Conversation : blocks when the member chose it
ConversationReport --> ReportStatus : has
ConversationReport "*" --> "1" Conversation : attaches
Conversation "1" *-- "*" Message : contains
OpenReportCommandHandler ..> OpenReportCommand : handles
OpenReportCommandHandler ..> ConversationReport : requires an unresolved
OpenReportCommandHandler ..> ReportDetailDto : returns
ReportDetailDto --> "0..1" ReportedConversationDto : carries while open
OpenReportCommandHandler ..> AuditRecord : records conversation.viewed
@enduml
