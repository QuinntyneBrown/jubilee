@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Report a conversation

Container_Boundary(web, "Jubilee Web") {
  Component(page, "ConversationPage", "Angular page", "Header with More and the Muted label")
  Component(menu, "jb-menu", "Library component on CDK Menu", "Mute or Unmute and Report conversation")
  Component(dialog, "ReportConversationDialog", "CDK dialog", "Collects what happened and the member-only block choice")
  Component(bubble, "jb-message-bubble", "Library component", "Binds message text as text and never as HTML")
  Component(client, "MessagesApi", "Service contract", "Calls mute and report endpoints")
}
Container_Boundary(adminapp, "Jubilee Admin") {
  Component(adminpage, "AdminReportPage", "Angular page", "Shows a report and its conversation while the report is open")
  Component(adminapi, "AdminApi", "Service contract", "Calls the admin report endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "ConversationsController", "ASP.NET Core controller", "Exposes mute and report under /api/conversations/{id}")
  Component(admin, "AdminReportsController", "ASP.NET Core controller", "Exposes /api/admin/reports to a staff session of the Jubilee team")
  Component(mute, "SetConversationMutedCommandHandler", "MediatR handler", "Mutes or unmutes for one side")
  Component(report, "ReportConversationCommandHandler", "MediatR handler", "Files at most one unresolved report and 10 a day and the optional block")
  Component(send, "SendMessageCommandHandler", "MediatR handler", "Stores a blocked business's message hidden from the member")
  Component(open, "OpenReportCommandHandler", "MediatR handler", "Returns the conversation only while its report is not resolved")
  Component(audit, "AuditLog", "Application rules", "Appends a record of each staff read")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Conversations and reports and audit records")

Rel(page, menu, "Opens from More")
Rel(page, bubble, "Renders one per message")
Rel(menu, dialog, "Opens on Report conversation")
Rel(page, client, "Calls mute")
Rel(dialog, client, "Calls report")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(adminpage, adminapi, "Opens a report through")
Rel(adminapi, admin, "POST /api/admin/reports/{id}/open", "JSON/HTTPS")
Rel(ctrl, mute, "Sends SetConversationMutedCommand")
Rel(ctrl, report, "Sends ReportConversationCommand")
Rel(ctrl, send, "Sends SendMessageCommand")
Rel(admin, open, "Sends OpenReportCommand")
Rel(open, audit, "Records conversation.viewed")
Rel(mute, db, "Persists mute flag", "EF Core")
Rel(report, db, "Persists report and block", "EF Core")
Rel(send, db, "Reads block state", "EF Core")
Rel(open, db, "Reads the report and its messages", "EF Core")
Rel(audit, db, "Appends AuditRecord", "EF Core")
@enduml
