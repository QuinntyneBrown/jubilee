@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Report a conversation

Person(member, "Member", "Mutes and reports and blocks")
Person(verifier, "Verification team member", "Reviews reports")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Conversation page with menu and report dialog and admin report view")
  Container(api, "Jubilee API", "ASP.NET Core", "Mute and report endpoints and staff access policy")
  ContainerDb(db, "Jubilee database", "SQL Server", "Conversations and reports and audit entries")
}

Rel(member, web, "Uses", "HTTPS")
Rel(verifier, web, "Uses", "HTTPS")
Rel(web, api, "Calls mute and report and admin endpoints", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
