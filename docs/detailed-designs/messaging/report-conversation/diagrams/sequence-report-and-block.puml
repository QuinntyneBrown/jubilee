@startuml
title UML sequence behaviour — Report a conversation and block the business
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member or Owner" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "ConversationPage" as page
  participant "jb-menu" as menu
  participant "ReportConversationDialog" as dialog
  participant "MessagesApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ConversationsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ReportConversationCommandHandler" as handler
  participant "Conversation" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor "Verification team member" as verifier
member -> page : Press "More" in the conversation header
page -> menu : Open with "Mute" and "Report conversation" (L2-061)
member -> menu : Choose "Report conversation"
menu -> page : Report chosen
page -> dialog : Open "Report this conversation" with canBlock
member -> dialog : Fill "Tell us what happened" and press "Send report"
alt description is empty
  dialog --> member : Show "Add a sentence or two so we know what to check." (L2-063)
else description given
  dialog -> client : report(id, reason, block)
  client -> controller : POST /api/conversations/{id}/report { reason, block }
  controller -> controller : Authenticate
  controller -> handler : Send ReportConversationCommand
  handler -> db : Load conversation for a participant (L2-133)
  alt caller is not a participant
    db --> handler : No row
    handler --> controller : Not found
    controller --> client : 404 ProblemDetails
    client --> dialog : Failed
    dialog --> member : Keep what was typed and let "Send report" try again
  else participant
    db --> handler : Conversation
    handler -> db : Find the caller's unresolved report on the conversation
    db --> handler : Report or none
    opt no unresolved report
      handler -> db : Count the caller's reports of the last 24 hours
      db --> handler : Count
      alt 10 already filed
        handler --> controller : Rate limited
        controller --> client : 429 with Retry-After (L2-137)
        client --> dialog : Failed
        dialog --> member : "You’re doing that a lot. Try again in {n} minutes."
      else under the limit
        handler -> handler : File ConversationReport with the reason (L2-063)
      end
    end
    opt report filed or already open
      opt block is true and the caller is the member
        handler -> entity : Block() (L2-063)
        entity --> handler : BlockedByMember set
      end
      handler -> db : Save report and block in one unit of work
      db --> handler : Commit result
      handler --> controller : Done
      controller --> client : 204 No Content
      client --> dialog : Report sent
      dialog --> member : Show "Thanks for telling us." and "{Business} is blocked." when blocked
      verifier -> db : Sees the report in the reports list (L2-105)
    end
  end
end
@enduml
