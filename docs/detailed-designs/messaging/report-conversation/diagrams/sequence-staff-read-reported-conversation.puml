@startuml
title UML sequence behaviour — Staff read of a reported conversation
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Jubilee team member" as moderator
box "Frontend — Jubilee Admin" #E0F2FE
  participant "AdminReportPage" as page
  participant "AdminApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AdminReportsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "OpenReportCommandHandler" as handler
  participant "AuditLog" as audit
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
moderator -> page : Open a report
page -> client : openReport(id)
client -> controller : POST /api/admin/reports/{id}/open
controller -> controller : RequiresModerator checks the staff session (L2-133)
alt no staff session of the Jubilee team
  controller --> client : 403 STAFF_SESSION_REQUIRED
  client --> page : Refused
else moderator
  controller -> handler : Send OpenReportCommand
  handler -> db : Load the report by its id
  alt the id is not a report
    db --> handler : No row
    handler --> controller : Not found
    controller --> client : 404 and nothing recorded (L2-063)
  else report found
    db --> handler : Report and its listing
    handler -> handler : Move an open report to InReview
    alt conversation report that is not resolved
      handler -> audit : Record conversation.viewed with "Report {id}" as the reason (L2-150, L2-180)
      audit -> db : Append AuditRecord
      handler -> db : Save and load the conversation's messages
      db --> handler : Messages
      handler --> controller : ReportDetailDto with ReportedConversationDto
      controller --> client : 200 OK
      client --> page : Report and conversation
      page --> moderator : Show the messages as text in jb-message-bubble
    else report resolved
      handler --> controller : ReportDetailDto with no conversation
      controller --> client : 200 OK
      client --> page : Report only
      page --> moderator : Show the report without the conversation (L2-063)
    end
  end
end
@enduml
