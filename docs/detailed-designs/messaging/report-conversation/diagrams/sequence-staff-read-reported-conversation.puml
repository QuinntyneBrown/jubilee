@startuml
title UML sequence behaviour — Staff read of a reported conversation
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Verification team member" as verifier
box "Frontend — Jubilee Web" #E0F2FE
  participant "AdminReportPage" as page
  participant "AdminApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AdminReportsController" as controller
  participant "ReportedConversationAccessPolicy" as policy
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetReportedConversationQueryHandler" as handler
  participant "IAuditLog" as audit
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
verifier -> page : Open a report
page -> client : getReportedConversation(reportId)
client -> controller : GET /api/admin/reports/{reportId}/conversation
controller -> controller : Authenticate and require Verifier or Admin role (L2-133)
controller -> policy : Authorize(staff, conversationId)
policy -> db : Find open report on the conversation
db --> policy : Report or none
alt no open report
  policy --> controller : Denied
  controller -> audit : Record refused access (L2-180)
  audit -> db : Append AuditEntry
  db --> audit : Stored
  controller --> client : 403 ProblemDetails (L2-063)
  client --> page : Forbidden
else open report exists
  policy --> controller : Allowed
  controller -> audit : Record staff access to personal data (L2-180)
  audit -> db : Append AuditEntry
  db --> audit : Stored
  controller -> handler : Send GetReportedConversationQuery
  handler -> db : Load conversation and messages
  db --> handler : Conversation
  handler --> controller : ConversationDto
  controller --> client : 200 OK
  client --> page : Conversation
  page --> verifier : Show messages as plain text with safe links
end
@enduml
