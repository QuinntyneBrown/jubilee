@startuml
title UML sequence behaviour — Refuse a message from a blocked business
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as owner
box "Frontend — Jubilee Web" #E0F2FE
  participant "ConversationPage" as composer
  participant "MessagesApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ConversationsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SendMessageCommandHandler" as handler
  participant "Conversation" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
owner -> composer : Send a message to the member
composer -> client : send(id, text, key)
client -> controller : POST /api/conversations/{id}/messages
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send SendMessageCommand
handler -> db : Load conversation for a participant
db --> handler : Conversation
handler -> entity : Read BlockedByMember (L2-063)
alt member blocked the business
  entity --> handler : true
  handler -> db : Save message with HiddenFromMember and no notification for the member
  db --> handler : Commit result
  handler --> controller : MessageDto
  controller --> client : 201 Created with no mention of a block
  client --> composer : Confirmed message
  composer --> owner : Show the sent time
  note over handler, db : The member never sees the message and it is not counted as unread
else not blocked
  entity --> handler : false
  handler -> db : Save message and the member's notification
  db --> handler : Commit result
  handler --> controller : MessageDto
  controller --> client : 201 Created
  client --> composer : Confirmed message
  composer --> owner : Show the sent time
end
@enduml
