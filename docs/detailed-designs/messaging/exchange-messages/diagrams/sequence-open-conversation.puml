@startuml
title UML sequence behaviour — Open a conversation
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "ConversationPage" as page
  participant "RealtimeService" as rt
  participant "MessagesApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ConversationsController" as controller
  participant "EventsController" as events
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetConversationQueryHandler" as handler
  participant "Conversation" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
member -> page : Open /messages/:id
page -> client : open(id)
client -> controller : GET /api/conversations/{id}
controller -> controller : Authenticate
controller -> handler : Send GetConversationQuery
handler -> db : Load conversation for a participant (L2-133)
alt caller is not a participant
  db --> handler : No row
  handler --> controller : Not found
  controller --> client : 404 conversation_not_found, logged at Warning (L2-057)
  client --> page : Not found
  page --> member : Not-found screen
else participant
  db --> handler : Header and latest 50 messages and away date
  handler -> db : Load requests of the same member and listing (L2-057)
  db --> handler : Requests
  handler -> entity : MarkRead(asOwner, now) (L2-057)
  entity --> handler : MemberReadAt or OwnerReadAt advanced
  handler -> db : Save read mark
  db --> handler : Commit result
  handler --> controller : ConversationDto with messages and requests
  controller --> client : 200 OK
  client --> page : Header and messages and request cards
  page --> member : Timeline grouped by day with cards at the time sent
  opt awayUntil is later than the clock
    page -> page : awayDay(awayUntil, now)
    page --> member : Line above the messages and info toast "{Owner first name} is away until {day}" (L2-062)
  end
  opt member presses "Show earlier messages"
    page -> client : open(id, before)
    client -> controller : GET /api/conversations/{id}?before={messageId}
    controller --> client : Older page and no read mark
    client --> page : Older messages
    page --> member : Add them above and bring the message that was at the top back to the top (L2-057)
  end
  opt reply or request change arrives while open
    events -> rt : notification event of kind message or request (L2-070)
    rt -> page : Publish notification
    page -> page : Kind message targets /messages/{id} or kind request
    page -> client : open(id)
    client -> controller : GET /api/conversations/{id}
    controller --> client : 200 OK and conversation marked read
    client --> page : Messages and request cards
    page --> member : Show within 2 seconds and announce "New message from {first name}" with no toast (L2-057)
    events -> rt : counts event
    rt --> member : Unread badge corrected
  end
end
@enduml
