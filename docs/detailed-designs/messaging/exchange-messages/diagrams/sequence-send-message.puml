@startuml
title UML sequence behaviour — Send a message and retry
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "ConversationPage" as page
  participant "MessagesApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ConversationsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SendMessageCommandHandler" as handler
  participant "Conversation" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
member -> page : Press Enter or the send button
page -> page : Ignore empty or whitespace-only text with no photo (L2-058)
page -> page : Create an Outgoing item with a new idempotency key
page --> member : Clear composer and show "Sending…" (L2-058)
page -> client : send(id, text, key)
client -> controller : POST /api/conversations/{id}/messages with idempotencyKey
controller -> controller : Authenticate and check RequiresConfirmedEmail
controller -> handler : Send SendMessageCommand
handler -> db : Load conversation for a participant (L2-133)
db --> handler : Conversation and listing
handler -> db : Look up (SenderSubject, IdempotencyKey) (L2-132)
alt key already stored
  db --> handler : Original message
else new key
  db --> handler : No row
  handler -> handler : ConversationRules.CleanBody and 30 messages in 10 minutes (L2-137)
  handler -> entity : NextMessageTime(now)
  entity --> handler : Time never before the last message
  handler -> db : Save message and the other side's notification
  db --> handler : Commit result
end
handler --> controller : MessageDto
controller --> client : 201 Created
alt response received
  client --> page : Confirmed message
  page --> member : Replace "Sending…" with the time
  opt awayUntil is later than the clock and that day was not said in this visit
    page --> member : Info toast "{Owner first name} is away until {day}" (L2-062)
  end
else request fails
  client --> page : Network or server error
  page --> member : Show "Not sent. Check your connection." with "Try again" and "Delete"
  member -> page : Press "Try again"
  page -> client : send with the same key (L2-058)
  client -> controller : POST with the same idempotencyKey
  controller --> client : Original or new 201 result and never a duplicate
  client --> page : Confirmed message
end
@enduml
