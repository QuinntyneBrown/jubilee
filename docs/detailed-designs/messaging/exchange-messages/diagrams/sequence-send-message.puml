@startuml
title UML sequence behaviour — Send a message and retry
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "MessageComposer" as composer
  participant "ConversationStore" as store
  participant "MessagesApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "IdempotencyMiddleware" as idem
  participant "ConversationsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SendMessageCommandHandler" as handler
  participant "Conversation" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
member -> composer : Press Enter or the send button
composer -> composer : Ignore empty or whitespace-only text (L2-058)
composer -> store : send(text, attachmentIds)
store -> store : Create OutgoingMessage with a new idempotency key
store --> composer : Clear composer and show "Sending…" (L2-058)
store -> client : sendMessage(id, text, key)
client -> idem : POST /api/conversations/{id}/messages with Idempotency-Key
idem -> idem : Look up key (L2-132)
idem -> controller : Forward new request
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send SendMessageCommand
handler -> db : Load conversation for a participant (L2-133)
db --> handler : Conversation and listing away period
handler -> entity : AddMessage(sender, text, now)
entity --> handler : Message with next sequence
handler -> db : Save message and outbox row in one unit of work
db --> handler : Commit result
handler --> controller : MessageDto with awayUntil
controller --> idem : 201 Created
idem --> client : Response stored under the key
alt response received
  client --> store : Confirmed message
  store --> composer : Replace "Sending…" with the time
  opt owner away period is active
    store --> member : Toast "{Owner} is away until {day}." (L2-062)
  end
else request fails
  client --> store : Network or server error
  store --> member : Show "Not sent. Check your connection." with "Try again" and "Delete"
  member -> store : Press "Try again"
  store -> client : sendMessage with the same key (L2-058)
  client -> idem : POST with the same Idempotency-Key
  idem --> client : Original or new 201 result and never a duplicate
  client --> store : Confirmed message
end
@enduml
