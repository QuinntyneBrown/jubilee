@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Exchange messages

Container_Boundary(web, "Jubilee Web") {
  Component(page, "ConversationPage", "Angular page", "Route /messages/:id with header and timeline and composer and pending sends and the away toast")
  Component(bubble, "jb-message-bubble", "Library component", "One message with text and at most one photo and delivery status")
  Component(card, "jb-request-card", "Library component", "One request with kind and detail and status and View request")
  Component(attach, "jb-attach-photo", "Library component", "Attach a photo button and preview with Remove photo")
  Component(photo, "PhotoAttachmentService", "Angular service", "Checks magic bytes and shrinks photos on a canvas to 5 MB")
  Component(rt, "RealtimeService", "Angular service", "Reads the event stream and publishes each notification")
  Component(client, "MessagesApi", "Service contract", "Calls conversation and message and attachment endpoints")
  Component(away, "AwayPeriodDialog", "CDK dialog", "Back on date on My business")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "ConversationsController", "ASP.NET Core controller", "Exposes /api/conversations/{id} and its messages and attachments")
  Component(get, "GetConversationQueryHandler", "MediatR handler", "Returns header and 50 messages and request cards and marks the newest page read")
  Component(send, "SendMessageCommandHandler", "MediatR handler", "Adds a message once per idempotency key")
  Component(upload, "UploadAttachmentCommandHandler", "MediatR handler", "Checks and scans and stores a photo and stops at the first failure")
  Component(renew, "RenewAttachmentLinkQueryHandler", "MediatR handler", "Answers a new signed link to a participant")
  Component(sanitizer, "ImageSanitizer", "Application rules", "Decides the type from the bytes and removes metadata")
  Component(scan, "IMalwareScanner", "Application service", "Answers Clean or Infected or Unavailable")
  Component(store, "IMediaStore", "Application service", "Keeps photo bytes under a random key")
  Component(conv, "Conversation", "Domain entity", "Owns the read marks and message order")
  Component(events, "EventsController", "ASP.NET Core controller", "Streams notification and counts events on /api/events")
  Component(mybiz, "MyBusinessController", "ASP.NET Core controller", "Exposes PUT /api/my-business/away")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Conversations and messages and attachment rows and requests and listings")
ContainerDb(media, "Media store", "Folder outside the web root", "Photo bytes")
System_Ext(clamd, "Malware scanner", "clamd daemon")

Rel(page, bubble, "Renders one per message")
Rel(page, card, "Renders one per request")
Rel(page, attach, "Hosts in the composer")
Rel(page, photo, "Prepares the chosen photo with")
Rel(page, client, "Loads and sends through")
Rel(rt, page, "Publishes message and request notifications to")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(events, rt, "Sends notification and counts events", "Server-sent events")
Rel(away, mybiz, "Saves the return date", "JSON/HTTPS")
Rel(ctrl, get, "Sends GetConversationQuery")
Rel(ctrl, send, "Sends SendMessageCommand")
Rel(ctrl, upload, "Sends UploadAttachmentCommand")
Rel(ctrl, renew, "Sends RenewAttachmentLinkQuery")
Rel(get, conv, "Marks read")
Rel(send, conv, "Loads and mutates")
Rel(get, db, "Queries messages and requests and away date", "EF Core")
Rel(send, db, "Persists message and notification", "EF Core")
Rel(upload, sanitizer, "1. Checks with")
Rel(upload, scan, "2. Scans through")
Rel(upload, store, "3. Saves bytes through")
Rel(upload, db, "4. Stores the MessageAttachment row", "EF Core")
Rel(scan, clamd, "Sends the bytes", "INSTREAM/TCP")
Rel(store, media, "Writes and reads")
Rel(mybiz, db, "Sets Listing.AwayUntil", "EF Core")
@enduml
