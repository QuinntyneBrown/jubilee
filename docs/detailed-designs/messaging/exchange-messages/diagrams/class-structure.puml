@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Exchange messages

class ConversationPage <<Angular page>> {
  +messages: Signal<ChatMessage[]>
  +requests: Signal<RequestCard[]>
  +outgoing: Signal<OutgoingMessage[]>
  +load(id: string): void
  +loadEarlier(): void
  +send(): void
  +retry(clientId: string): void
  +discard(clientId: string): void
  +renewPhoto(attachmentId: string): void
}
class OutgoingMessage <<TypeScript>> {
  +clientId: string
  +idempotencyKey: string
  +text: string
  +photo: Blob?
  +attachmentId: string?
  +status: SendStatus
}
enum SendStatus {
  Sending
  WaitingToSend
  Failed
}
class PhotoAttachmentService <<Angular service>> {
  +maxBytes: number = 5 MB
  +maxSide: number = 4096
  +prepare(file: File): Promise<Blob>
}
class RealtimeService <<Angular service>> {
  +received: Observable<NotificationItem>
  +start(): void
  +stop(): void
}
class SendMessageCommand {
  +Guid ConversationId
  +string Subject
  +string Body
  +string IdempotencyKey
  +Guid? AttachmentId
}
class SendMessageCommandHandler {
  +Handle(command: SendMessageCommand): Task<MessageDto>
}
class GetConversationQueryHandler {
  +Handle(query: GetConversationQuery): Task<ConversationDto>
}
class ConversationDto {
  +bool Muted
  +bool CanBlock
  +DateTimeOffset? AwayUntil
  +bool HasMore
  +IReadOnlyList<MessageDto> Messages
  +IReadOnlyList<RequestCardDto> Requests
}
class RequestCardDto {
  +string Kind
  +string Title
  +string Detail
  +string Status
  +DateTimeOffset SentAt
  +string Link
}
class Conversation {
  +Guid Id
  +Guid ListingId
  +string MemberSubject
  +DateTimeOffset LastMessageAt
  +DateTimeOffset? MemberReadAt
  +DateTimeOffset? OwnerReadAt
  +NextMessageTime(now: DateTimeOffset): DateTimeOffset
  +MarkRead(asOwner: bool, now: DateTimeOffset): void
}
class Message {
  +Guid Id
  +string SenderSubject
  +bool FromOwner
  +string Body
  +DateTimeOffset CreatedAt
  +string IdempotencyKey
  +Guid? AttachmentId
}
class MessageAttachment {
  +Guid Id
  +Guid ConversationId
  +string ContentType
  +byte[] Content
}
class Listing {
  +Guid Id
  +DateTimeOffset? AwayUntil
  +SetAway(until: DateTimeOffset?): void
}

ConversationPage "1" o-- "*" OutgoingMessage : tracks
OutgoingMessage --> SendStatus : has
ConversationPage ..> PhotoAttachmentService : uses
ConversationPage ..> RealtimeService : listens to
ConversationPage ..> SendMessageCommand : POST messages
SendMessageCommandHandler ..> SendMessageCommand : handles
SendMessageCommandHandler --> Conversation : loads / mutates
GetConversationQueryHandler --> Conversation : loads / marks read
GetConversationQueryHandler ..> ConversationDto : returns
ConversationDto "1" *-- "*" RequestCardDto : carries
Conversation "1" *-- "*" Message : contains
Message "1" --> "0..1" MessageAttachment : carries
Conversation "*" --> "1" Listing : addressed to
@enduml
