@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Exchange messages

class ConversationPage <<Angular page>> {
  +messages: Signal<ChatMessage[]>
  +cards: Signal<RequestCard[]>
  +outgoing: Signal<Outgoing[]>
  +open(): void
  +loadEarlier(): void
  +send(): void
  +retry(outgoing: Outgoing): void
  +discard(outgoing: Outgoing): void
  +renewPhoto(message: ChatMessage): void
}
class Outgoing <<TypeScript>> {
  +key: string
  +body: string
  +status: 'sending' | 'failed'
  +problem: string
  +photo: OutgoingPhoto?
}
class OutgoingPhoto <<TypeScript>> {
  +blob: Blob
  +preview: string
  +attachmentId: string?
}
class PhotoAttachmentService <<Angular service>> {
  +typeOf(file: Blob): Promise<string?>
  +needsShrinking(file: Blob): boolean
  +prepare(file: Blob): Promise<PreparedPhoto?>
}
class RealtimeService <<Angular service>> {
  +received: Observable<NotificationItem>
  +start(): void
  +stop(): void
}
class SendMessageCommand {
  +Guid ConversationId
  +string Subject
  +string Body
  +string IdempotencyKey
  +Guid? AttachmentId
}
class SendMessageCommandHandler {
  +Handle(command: SendMessageCommand): Task<MessageDto>
}
class GetConversationQueryHandler {
  +Handle(query: GetConversationQuery): Task<ConversationDto>
}
class UploadAttachmentCommandHandler {
  +Handle(command: UploadAttachmentCommand): Task<Guid>
}
class ImageSanitizer <<static>> {
  +const int MaxBytes = 5 MB
  +const int MaxWidth = 8000
  +Sanitize(bytes: byte[]): SanitizedImage
}
interface IMalwareScanner {
  +Scan(content: byte[], cancellationToken: CancellationToken): Task<ScanVerdict>
}
enum ScanVerdict {
  Clean
  Infected
  Unavailable
}
interface IMediaStore {
  +Save(key: string, width: int, format: string, data: byte[]): Task
  +Read(key: string, width: int, format: string): Task<byte[]?>
  +Delete(key: string): Task
}
class ConversationDto {
  +bool Muted
  +bool CanBlock
  +DateTimeOffset? AwayUntil
  +bool HasMore
  +IReadOnlyList<MessageDto> Messages
  +IReadOnlyList<RequestCardDto> Requests
}
class RequestCardDto {
  +string Kind
  +string Title
  +string Detail
  +string Status
  +DateTimeOffset SentAt
  +string Link
}
class Conversation {
  +Guid Id
  +Guid ListingId
  +string MemberSubject
  +DateTimeOffset LastMessageAt
  +DateTimeOffset? MemberReadAt
  +DateTimeOffset? OwnerReadAt
  +NextMessageTime(now: DateTimeOffset): DateTimeOffset
  +MarkRead(asOwner: bool, now: DateTimeOffset): void
}
class Message {
  +Guid Id
  +string SenderSubject
  +bool FromOwner
  +string Body
  +DateTimeOffset CreatedAt
  +string IdempotencyKey
  +Guid? AttachmentId
}
class MessageAttachment {
  +Guid Id
  +Guid ConversationId
  +string UploaderSubject
  +string Key
  +string ContentType
  +byte[]? Content
}
class Listing {
  +Guid Id
  +DateTimeOffset? AwayUntil
  +SetAway(until: DateTimeOffset?): void
}

ConversationPage "1" o-- "*" Outgoing : tracks
Outgoing --> "0..1" OutgoingPhoto : carries
ConversationPage ..> PhotoAttachmentService : uses
ConversationPage ..> RealtimeService : listens to
ConversationPage ..> SendMessageCommand : POST messages
SendMessageCommandHandler ..> SendMessageCommand : handles
SendMessageCommandHandler --> Conversation : loads / mutates
GetConversationQueryHandler --> Conversation : loads / marks read
GetConversationQueryHandler ..> ConversationDto : returns
UploadAttachmentCommandHandler ..> ImageSanitizer : 1. checks
UploadAttachmentCommandHandler ..> IMalwareScanner : 2. scans
UploadAttachmentCommandHandler ..> IMediaStore : 3. saves bytes
UploadAttachmentCommandHandler --> MessageAttachment : 4. stores
IMalwareScanner ..> ScanVerdict : answers
MessageAttachment ..> IMediaStore : bytes named by Key
ConversationDto "1" *-- "*" RequestCardDto : carries
Conversation "1" *-- "*" Message : contains
Message "1" --> "0..1" MessageAttachment : carries
Conversation "*" --> "1" Listing : addressed to
@enduml
