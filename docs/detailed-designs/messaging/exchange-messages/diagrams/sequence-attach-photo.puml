@startuml
title UML sequence behaviour — Attach a photo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "ConversationPage" as page
  participant "jb-attach-photo" as attach
  participant "PhotoAttachmentService" as photo
  participant "MessagesApi" as client
  participant "ToastService" as toast
end box
box "Backend — Jubilee API" #D1FADF
  participant "ConversationsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "UploadAttachmentCommandHandler" as handler
  participant "SendMessageCommandHandler" as sender
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
member -> attach : Press "Attach a photo" and choose a file
attach -> page : File chosen
page -> photo : prepare(file)
photo -> photo : Read the first bytes
alt not a JPEG or PNG
  photo --> page : Rejected
  page -> toast : Error toast "Photo couldn't be attached. Use a JPG or PNG under 5 MB." (L2-060)
else over 5 MB or over 4,096 pixels on a side
  photo -> toast : Warning toast "Photo is large. Shrinking it to 5 MB before sending."
  photo -> photo : Draw to a canvas of at most 4,096 pixels and encode JPEG at 0.85 down to 0.5 then smaller
  alt cannot be decoded or brought under 5 MB
    photo --> page : Rejected
    page -> toast : Error toast "Photo couldn't be attached. Use a JPG or PNG under 5 MB."
  else shrunk
    photo --> page : Blob of 5 MB or less
  end
else JPEG or PNG within the limits
  photo --> page : Blob
end
opt photo accepted
  page -> attach : Show preview with "Remove photo"
  member -> page : Send with or without text
  page --> member : Bubble with the photo and "Sending…" (L2-060)
  page -> client : attach(id, blob)
  client -> controller : POST /api/conversations/{id}/attachments
  controller -> controller : Authenticate and apply endpoint policy
  controller -> handler : Send UploadAttachmentCommand
  handler -> db : Load conversation for a participant (L2-133)
  db --> handler : Conversation
  handler -> handler : Check bytes and size and width then remove metadata (L2-138)
  handler -> db : Save MessageAttachment
  db --> handler : Commit result
  handler --> controller : Attachment ID
  controller --> client : 201 Created or 422 or 429 past 30 uploads in 10 minutes
  client --> page : Attachment ID kept for a retry
  page -> client : send(id, text, key, attachmentId)
  client -> controller : POST /api/conversations/{id}/messages
  controller -> sender : Send SendMessageCommand
  sender -> db : Save message once per (SenderSubject, IdempotencyKey)
  db --> sender : Commit result
  sender --> controller : MessageDto with a signed link
  controller --> client : 201 Created
  client --> page : Confirmed message
  page --> member : Replace "Sending…" with the time
end
opt image fails to load or "View photo" is pressed
  page -> client : attachmentLink(id, attachmentId)
  client -> controller : GET /api/conversations/{id}/attachments/{attachmentId}
  alt participant
    controller --> client : 200 OK { url } valid for 5 minutes (L2-060)
    client --> page : New signed link
    page --> member : Show the photo
  else not a participant or renewal fails
    controller --> client : 404 ProblemDetails
    client --> page : Error
    page --> member : Bubble says "Photo unavailable"
  end
end
@enduml
