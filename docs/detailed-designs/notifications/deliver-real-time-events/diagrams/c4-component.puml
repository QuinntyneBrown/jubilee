@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Deliver real-time events

Container_Boundary(web, "Jubilee Web") {
  Component(app, "App", "Angular root component", "Starts the stream for a signed-in member and stops it at sign-out")
  Component(rt, "RealtimeService", "Angular service", "Only subscriber of the stream; drops event IDs already shown")
  Component(sse, "SseEventsApi", "EVENTS_API", "EventSource that is opened again when the browser gives up")
  Component(toasts, "ToastService", "Angular service", "Shows one toast per notification")
  Component(nav, "NavigationStore", "Signal store", "Badge counts")
  Component(pages, "Pages", "Angular pages", "Read arrivals and received and connected")
}
Container_Boundary(api, "Jubilee API") {
  Component(events, "EventsController", "ASP.NET Core controller", "Writes the stream from a polling loop")
  Component(rules, "NotificationRules", "Static rules", "Visible notifications of one member")
  Component(counts, "GetNavigationSummaryQueryHandler", "MediatR handler", "Navigation summary of the member")
  Component(handlers, "Command handlers", "MediatR handlers", "Save a state change and its notification")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Notifications")

Rel(app, rt, "Calls start and stop")
Rel(rt, sse, "Subscribes to stream()")
Rel(sse, events, "Opens GET /api/events", "Server-sent events")
Rel(rt, toasts, "Calls show")
Rel(rt, nav, "Applies counts to")
Rel(pages, rt, "Read signals of")
Rel(events, rules, "Selects notifications past the cursor through")
Rel(events, counts, "Sends GetNavigationSummaryQuery")
Rel(rules, db, "Queries", "EF Core")
Rel(counts, db, "Counts", "EF Core")
Rel(handlers, db, "Insert notifications", "EF Core")
@enduml
