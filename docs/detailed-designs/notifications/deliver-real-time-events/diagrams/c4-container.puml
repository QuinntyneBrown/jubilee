@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Deliver real-time events

Person(member, "Member", "Keeps a signed-in page open")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Holds one event stream and passes events to pages")
  Container(api, "Jubilee API", "ASP.NET Core", "Event stream GET /api/events, one database reader per connection")
  Container(worker, "Jubilee Worker", ".NET worker service", "Creates the notifications of scheduled work")
  ContainerDb(db, "Jubilee database", "SQL Server", "Notifications, the log the stream reads")
}

Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Opens GET /api/events with the session cookie", "HTTPS")
Rel(api, web, "Sends notification and counts events", "Server-sent events")
Rel(api, db, "Writes notifications and reads them once a second per connection", "EF Core")
Rel(worker, db, "Writes notifications", "EF Core")
@enduml
