@startuml
title UML sequence behaviour — Deliver an event to an open page
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Sender" as sender
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "RealtimeService" as rt
  participant "SseEventsApi" as sse
  participant "ToastService" as toasts
end box
box "Backend — Jubilee API" #D1FADF
  participant "EventsController" as events
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "Command handler" as handler
  participant "NotificationRules" as rules
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
member -> rt : Signed in, App calls start()
rt -> sse : stream()
sse -> events : GET /api/events with the session cookie
events -> events : Take the subject from the session (L2-070 AC3)
events --> sse : ": connected" and "retry: 3000"
sse --> rt : connection, connected true
sender -> handler : Send a message or change a request
handler -> rules : Tell(recipient, kind, title, detail, target)
handler -> db : Save the state change and the notification in one save
db --> handler : Commit result
loop every Events:PollMilliseconds (1000 ms)
  events -> rules : Visible(subject) created after the cursor
  rules -> db : Select at most 100, oldest first
  db --> rules : New notification
  events --> sse : id: CreatedAt ticks, event: notification
  events -> events : Advance the cursor
  events --> sse : event: counts when the summary changed
end
sse --> rt : notification with id and item
alt the id was shown before
  rt -> rt : Drop the event
else new id
  rt -> rt : Remember the id and increment arrivals
  rt -> toasts : show(info toast with the action of the kind)
  toasts --> member : Toast within 2 seconds at the 95th percentile (L2-070 AC1)
end
@enduml
