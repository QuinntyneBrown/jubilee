@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Deliver real-time events

class RealtimeService <<Angular service>> {
  -seen: Set<string>
  +connected: Signal<boolean>
  +arrivals: Signal<number>
  +received: Observable<NotificationItem>
  +start(): void
  +stop(): void
}
interface EventsApi {
  +stream(): Observable<MemberEvent>
}
class SseEventsApi {
  +stream(): Observable<MemberEvent>
}
class ConnectionEvent <<MemberEvent>> {
  +type: 'connection'
  +connected: boolean
}
class NotificationEvent <<MemberEvent>> {
  +type: 'notification'
  +id: string
  +item: NotificationItem
}
class CountsEvent <<MemberEvent>> {
  +type: 'counts'
  +counts: NavigationSummary
}
class EventsController {
  +{static} EventId(n: Notification): string
  +Stream(lastEventId: string?): Task
}
class NotificationRules <<static>> {
  +{static} Visible(db, subject, now): IQueryable<Notification>
  +{static} Row(n: Notification): NotificationDto
}
class Notification {
  +Guid Id
  +string MemberSubject
  +string Kind
  +DateTimeOffset CreatedAt
}
class NavigationSummary <<record>> {
  +int UnreadConversationCount
  +int UnreadNotificationCount
  +int NewRequestCount
  +bool OwnsListing
}
class EventStreamTests <<test>> {
  20 notifications at the production interval
  95th percentile under 2 seconds
}

SseEventsApi ..|> EventsApi
RealtimeService ..> EventsApi : subscribes
SseEventsApi ..> ConnectionEvent : emits
SseEventsApi ..> NotificationEvent : emits
SseEventsApi ..> CountsEvent : emits
SseEventsApi ..> EventsController : GET /api/events
EventsController ..> NotificationRules : reads past the cursor
NotificationRules "1" --> "*" Notification : selects
EventsController ..> NavigationSummary : writes as counts
CountsEvent --> NavigationSummary : carries
EventStreamTests ..> EventsController : measures
@enduml
