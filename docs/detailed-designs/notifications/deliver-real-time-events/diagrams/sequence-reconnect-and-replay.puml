@startuml
title UML sequence behaviour — Reconnect and replay missed events
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "RealtimeService" as rt
  participant "SseEventsApi" as sse
  participant "EventSource" as source
end box
box "Backend — Jubilee API" #D1FADF
  participant "EventsController" as events
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
source -> source : The connection drops
alt the browser reconnects by itself
  source -> events : GET /api/events with Last-Event-ID after 3000 ms
else the browser gave up (readyState CLOSED)
  source --> sse : error without having opened
  sse --> rt : connection, connected false
  rt -> rt : connected is false, pages read on a timer
  sse -> sse : Wait 5 seconds, doubling to at most 60 seconds, or until the online event (L2-070 AC4)
  sse -> source : Open a new EventSource
  source -> events : GET /api/events?lastEventId={id}
end
events -> events : Set the cursor from Last-Event-ID or lastEventId
events -> db : Select the member's notifications created after the cursor
db --> events : Missed notifications
events --> source : One notification event per row, oldest first (L2-070 AC2)
source --> sse : open and notification events
sse --> rt : connection, connected true
loop each notification event
  sse --> rt : notification with id and item
  alt the id is in the seen set
    rt -> rt : Drop the event, nothing is shown twice
  else new id
    rt --> member : Toast and updated lists
  end
end
@enduml
