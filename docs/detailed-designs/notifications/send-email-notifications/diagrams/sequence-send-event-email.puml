@startuml
title UML sequence behaviour — Send an e-mail for an event
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Sender" as actor
actor "Recipient" as recipient
box "Backend — Jubilee API" #D1FADF
  participant "Message handler" as handler
  participant "MessageMail" as mail
  participant "EmailPolicy" as policy
end box
box "Backend — Jubilee Worker" #ECFDF3
  participant "OutboxDispatcherJob" as job
  participant "OutboxDispatcher" as dispatcher
  participant "EmailLayout" as layout
  participant "IEmailSender" as sender
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
participant "E-mail provider" as provider
actor -> handler : Send a message
handler -> mail : QueueAsync(conversation, recipient)
alt muted, or read within 2 minutes, or a row is waiting (L2-061, L2-068)
  mail --> handler : Queue nothing
else
  mail -> db : Read when the last e-mail of the conversation was sent
  mail -> mail : Due in 2 minutes, or 10 minutes after the last e-mail
  mail -> policy : Queue(member, "messages", subject, body, notBefore)
  alt switch off or address bounced
    policy --> mail : false, no row (L2-068 AC2)
  else "One daily summary"
    policy -> db : Add OutboxMessage with HeldForSummary (L2-016 AC6)
  else "As it happens"
    policy -> db : Add OutboxMessage
  end
end
handler -> db : Save the message and the notification and the row in one save
loop every 10 seconds
  job -> dispatcher : DispatchDueAsync()
  dispatcher -> db : Select at most 50 due rows, held rows are not due
  db --> dispatcher : Rows
  dispatcher -> dispatcher : Sign the unsubscribe token for member and category
  dispatcher -> layout : Render(to, subject, text, unsubscribe link)
  layout --> dispatcher : EmailMessage with the footer link /unsubscribe/{token}
  dispatcher -> sender : SendAsync(message)
  sender -> provider : Send with List-Unsubscribe and List-Unsubscribe-Post (L2-068 AC3)
  provider --> recipient : E-mail
  alt accepted
    dispatcher -> db : MarkSent and clear the body
  else failed
    dispatcher -> db : MarkAttemptFailed, try again with back-off for 24 hours
  end
end
@enduml
