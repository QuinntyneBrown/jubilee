@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Send e-mail notifications

Container_Boundary(web, "Jubilee Web") {
  Component(page, "UnsubscribePage", "Angular page", "Posts the token and says what stops")
}
Container_Boundary(api, "Jubilee API") {
  Component(handlers, "Command handlers", "MediatR handlers", "Queue the e-mail of a message or a request update")
  Component(mail, "MessageMail", "Static rule", "Mute and reading and one e-mail per burst")
  Component(policy, "EmailPolicy", "Static policy", "Checks the switch and marks a row held for the summary")
  Component(unsub, "UnsubscribeController", "ASP.NET Core controller", "POST /api/email/unsubscribe/{token}")
  Component(unsubh, "UnsubscribeCommandHandler", "MediatR handler", "Verifies the token and turns the category off")
  Component(links, "HmacUnsubscribeLinks", "IUnsubscribeLinks", "Signs member and category with HMAC-SHA256")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(outboxjob, "OutboxDispatcherJob", "Hosted job", "Every 10 seconds")
  Component(dispatcher, "OutboxDispatcher", "Application service", "Sends at most 50 due rows and skips held rows")
  Component(layout, "EmailLayout", "Renderer", "HTML part and footer with the unsubscribe link")
  Component(sender, "AzureCommunicationEmailSender", "IEmailSender", "Adds the RFC 8058 headers")
  Component(remjob, "MeetingReminderJob", "Hosted job", "Every minute")
  Component(reminders, "MeetingReminders", "Application service", "Reminds confirmed bookings that start within the hour")
  Component(sumjob, "DailySummaryJob", "Hosted job", "Every 5 minutes")
  Component(sum, "SendDailySummariesCommandHandler", "MediatR handler", "One e-mail per member from the held rows")
  Component(notejob, "NewBusinessNoteJob", "Hosted job", "Weekly note, Monday 7:00 a.m. Toronto")
  Component(note, "SendNewBusinessNotesCommandHandler", "MediatR handler", "Listings published in 7 days in browsed categories")
  Component(tipjob, "OwnerTipJob", "Hosted job", "Monthly tip, first day 7:00 a.m. Toronto")
  Component(tips, "SendOwnerTipsCommandHandler", "MediatR handler", "Next tip of OwnerTips.Series")
  Component(jobs, "ScheduledJobs", "Application service", "Runs work once per occurrence through JobRun")
}
ContainerDb(db, "Jubilee database", "SQL Server", "OutboxMessages and Members and JobRuns")
System_Ext(email, "E-mail provider", "Azure Communication Services Email")

Rel(handlers, mail, "Queue a message e-mail through")
Rel(handlers, policy, "Queue a request e-mail through")
Rel(mail, policy, "Calls Queue")
Rel(policy, db, "Adds OutboxMessage", "EF Core")
Rel(page, unsub, "Posts the token to", "JSON/HTTPS")
Rel(unsub, unsubh, "Sends UnsubscribeCommand")
Rel(unsubh, links, "Reads the token with")
Rel(unsubh, db, "Turns the switch off", "EF Core")
Rel(outboxjob, dispatcher, "Calls DispatchDueAsync")
Rel(dispatcher, db, "Reads due rows and marks them sent", "EF Core")
Rel(dispatcher, links, "Signs the link with")
Rel(dispatcher, layout, "Renders through")
Rel(dispatcher, sender, "Sends through")
Rel(sender, email, "Submits e-mail", "HTTPS")
Rel(remjob, reminders, "Calls SendDueAsync")
Rel(reminders, policy, "Calls Queue with reminders")
Rel(sumjob, sum, "Sends SendDailySummariesCommand")
Rel(notejob, note, "Sends SendNewBusinessNotesCommand")
Rel(tipjob, tips, "Sends SendOwnerTipsCommand")
Rel(sum, jobs, "Runs once at today's 7:00 through")
Rel(note, jobs, "Runs once at Monday's 7:00 through")
Rel(tips, jobs, "Runs once at the month's first 7:00 through")
Rel(sum, db, "Replaces held rows by one summary row", "EF Core")
Rel(note, policy, "Calls Queue with new-businesses")
Rel(tips, policy, "Calls Queue with tips")
Rel(jobs, db, "Claims JobRun", "EF Core")
@enduml
