@startuml
title UML sequence behaviour — Send a meeting reminder
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as owner
actor "Member" as member
box "Backend — Jubilee API" #D1FADF
  participant "ConfirmRequestCommandHandler" as confirm
end box
box "Backend — Jubilee Worker" #ECFDF3
  participant "MeetingReminderJob" as job
end box
box "Backend — Jubilee Application and Domain" #E0F2FE
  participant "MeetingReminders" as reminders
  participant "NotificationRules" as rules
  participant "EmailPolicy" as policy
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
owner -> confirm : Confirm a booking
confirm -> reminders : RemindIfSoonAsync(request)
opt the booking starts within 1 hour (L2-069 AC3)
  reminders -> reminders : Remind now, as below
end
confirm -> db : Save changes
loop every minute
  job -> reminders : SendDueAsync()
  reminders -> db : Select confirmed bookings that start within 1 hour with RemindedAt null
  note right of db : A cancelled booking is not confirmed and is not selected (L2-069 AC2)
  db --> reminders : Due bookings
  loop each due booking
    reminders -> db : Set Request.RemindedAt
    reminders -> rules : Tell(member, "reminder", "Your meeting starts in 1 hour")
    reminders -> rules : Tell(owner, "reminder", "Your meeting starts in 1 hour")
    reminders -> policy : Queue(member, "reminders", ...)
    reminders -> policy : Queue(owner, "reminders", ...)
    note right of policy : No row when "Meeting reminders" is off; never held for the summary
  end
  reminders -> db : Save the notifications and the outbox rows in one save
end
db --> member : Notification and toast through the event stream, e-mail through the outbox (L2-069 AC1)
@enduml
