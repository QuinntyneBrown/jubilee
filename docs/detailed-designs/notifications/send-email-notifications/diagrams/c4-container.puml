@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Send e-mail notifications

Person(member, "Member", "Receives e-mail and unsubscribes")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Unsubscribe page at /unsubscribe/{token}")
  Container(api, "Jubilee API", "ASP.NET Core", "Queues e-mail with each event and receives unsubscribe requests")
  Container(worker, "Jubilee Worker", ".NET worker service", "Sends the outbox and runs reminders and the summary and the note and the tips")
  ContainerDb(db, "Jubilee database", "SQL Server", "OutboxMessages and Members and JobRuns and Requests")
}
System_Ext(email, "E-mail provider", "Azure Communication Services Email")

Rel(member, web, "Opens the footer link in", "HTTPS")
Rel(web, api, "Posts /api/email/unsubscribe/{token}", "JSON/HTTPS")
Rel(member, api, "Mail client posts the one-click unsubscribe to", "HTTPS")
Rel(api, db, "Adds outbox rows and updates switches", "EF Core")
Rel(worker, db, "Reads due rows and held rows and claims job runs", "EF Core")
Rel(worker, email, "Sends e-mail through", "HTTPS")
Rel(email, member, "Delivers e-mail to", "SMTP")
@enduml
