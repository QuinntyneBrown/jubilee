@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View the notification centre

Person(member, "Member", "Reads notifications")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Notifications page and unread badges")
  Container(api, "Jubilee API", "ASP.NET Core", "Notification and navigation endpoints and the event stream")
  Container(worker, "Jubilee Worker", ".NET worker service", "Creates the notifications of scheduled work such as meeting reminders")
  ContainerDb(db, "Jubilee database", "SQL Server", "Notifications and conversations and requests")
}

Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Calls /api/notifications and /api/me/navigation", "JSON/HTTPS")
Rel(api, web, "Sends notification and counts events", "Server-sent events")
Rel(api, db, "Reads and writes notifications", "EF Core")
Rel(worker, db, "Writes notifications", "EF Core")
@enduml
