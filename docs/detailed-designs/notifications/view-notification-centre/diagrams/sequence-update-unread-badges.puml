@startuml
title UML sequence behaviour — Update unread badges
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "App" as app
  participant "NavigationStore" as nav
  participant "RealtimeService" as rt
  participant "Badge" as badge
end box
box "Backend — Jubilee API" #D1FADF
  participant "NavigationController" as navctrl
  participant "EventsController" as events
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetNavigationSummaryQueryHandler" as counts
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
member -> app : Sign in or open a page with a session
app -> nav : load()
nav -> navctrl : GET /api/me/navigation
navctrl -> counts : Send GetNavigationSummaryQuery
counts -> db : Count unread conversations and unread notifications and new requests
db --> counts : Counts
counts --> navctrl : NavigationSummary
navctrl --> nav : 200 OK
nav --> badge : Counts
badge --> member : Show the count or "99+" above 99 (L2-065)
app -> rt : start()
rt -> events : GET /api/events
loop each second while the stream is open
  events -> counts : Send GetNavigationSummaryQuery
  counts -> db : Count again
  db --> counts : Counts
  counts --> events : NavigationSummary
  opt the summary differs from the last one sent
    events --> rt : event: counts
    rt -> nav : apply(counts)
    nav --> badge : New counts
    badge --> member : Follow a change made on another device within 5 seconds (L2-065)
  end
end
@enduml
