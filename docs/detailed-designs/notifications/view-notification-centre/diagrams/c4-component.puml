@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View the notification centre

Container_Boundary(web, "Jubilee Web") {
  Component(page, "NotificationsPage", "Angular page", "Route /notifications with subtitle and actions and list")
  Component(item, "NotificationItem", "jb-notification-item", "Icon and title and detail and time and unread mark")
  Component(badge, "Badge", "jb component", "Count badge that reads 99+ above 99")
  Component(nav, "NavigationStore", "Signal store", "Unread conversations and notifications and new requests")
  Component(client, "HttpNotificationsApi", "NOTIFICATIONS_API", "Calls the notification endpoints")
  Component(rt, "RealtimeService", "Angular service", "Receives notification and counts events")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "NotificationsController", "ASP.NET Core controller", "Exposes /api/notifications")
  Component(navctrl, "NavigationController", "ASP.NET Core controller", "Exposes /api/me/navigation")
  Component(events, "EventsController", "ASP.NET Core controller", "Stream GET /api/events")
  Component(list, "ListNotificationsQueryHandler", "MediatR handler", "Returns the newest 100 notifications of the last 90 days")
  Component(mark, "MarkNotificationReadCommandHandler", "MediatR handler", "Marks one notification of the caller read")
  Component(markall, "MarkAllNotificationsReadCommandHandler", "MediatR handler", "Marks every unread notification of the caller read")
  Component(counts, "GetNavigationSummaryQueryHandler", "MediatR handler", "Counts unread conversations and notifications and new requests")
  Component(rules, "NotificationRules", "Static rules", "Tell and Visible and UnreadCount")
  Component(newbiz, "NewBusinessNotifier", "Static rule", "Tells members who browsed the category of a published listing")
  Component(handlers, "Command handlers", "MediatR handlers", "Save a state change and its notification together")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(reminders, "MeetingReminderJob", "Hosted job", "Runs MeetingReminders each minute")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Notifications")

Rel(page, item, "Renders one per notification")
Rel(page, client, "Loads and marks through")
Rel(page, rt, "Reads arrivals from")
Rel(page, nav, "Sets the unread count on")
Rel(badge, nav, "Shows a count of")
Rel(rt, nav, "Applies counts events to")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(nav, navctrl, "Loads the summary from", "JSON/HTTPS")
Rel(events, rt, "Sends events to", "Server-sent events")
Rel(ctrl, list, "Sends ListNotificationsQuery")
Rel(ctrl, mark, "Sends MarkNotificationReadCommand")
Rel(ctrl, markall, "Sends MarkAllNotificationsReadCommand")
Rel(navctrl, counts, "Sends GetNavigationSummaryQuery")
Rel(events, counts, "Sends GetNavigationSummaryQuery")
Rel(list, rules, "Selects through Visible")
Rel(mark, rules, "Counts through UnreadCount")
Rel(markall, rules, "Selects through Visible")
Rel(events, rules, "Selects through Visible")
Rel(handlers, rules, "Creates through Tell")
Rel(handlers, newbiz, "PublishListingCommandHandler calls")
Rel(newbiz, rules, "Creates through Tell")
Rel(reminders, rules, "Creates through Tell")
Rel(rules, db, "Reads and adds notifications", "EF Core")
@enduml
