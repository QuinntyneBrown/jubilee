@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — View the notification centre

class NotificationsPage <<Angular page>> {
  #state: Signal<LoadState<NotificationList>>
  #subtitle: Signal<string>
  #load(): void
  #open(event: Event, item: NotificationItem): void
  #markAll(): void
}
interface NotificationsApi {
  +list(): Observable<NotificationList>
  +markRead(id: string): Observable<UnreadCount>
  +markAllRead(): Observable<UnreadCount>
}
class NavigationStore <<signal store>> {
  +summary: Signal<NavigationSummary>
  +load(): void
  +apply(summary: NavigationSummary): void
}
class NavigationSummary <<record>> {
  +int UnreadConversationCount
  +int UnreadNotificationCount
  +int NewRequestCount
  +bool OwnsListing
}
class NotificationsController {
  +List(): Task<NotificationListDto>
  +Read(id: Guid): Task<UnreadDto>
  +ReadAll(): Task<UnreadDto>
}
class NotificationRules <<static>> {
  +{static} TimeSpan Window = 90 days
  +{static} int PageSize = 100
  +{static} Tell(db, memberSubject, kind, title, detail, target, now, correlationId): void
  +{static} Visible(db, subject, now): IQueryable<Notification>
  +{static} UnreadCount(db, subject, now): Task<int>
  +{static} Row(n: Notification): NotificationDto
}
class ListNotificationsQueryHandler {
  +Handle(query: ListNotificationsQuery): Task<NotificationListDto>
}
class MarkNotificationReadCommandHandler {
  +Handle(command: MarkNotificationReadCommand): Task<UnreadDto>
}
class MarkAllNotificationsReadCommandHandler {
  +Handle(command: MarkAllNotificationsReadCommand): Task<UnreadDto>
}
class NotificationListDto <<record>> {
  +int Unread
  +IReadOnlyList<NotificationDto> Items
}
class NotificationDto <<record>> {
  +Guid Id
  +string Kind
  +string Title
  +string Detail
  +string Target
  +DateTimeOffset At
  +bool Read
}
class UnreadDto <<record>> {
  +int Unread
}
class Notification {
  +Guid Id
  +string MemberSubject
  +string Kind
  +string Title
  +string Detail
  +string Target
  +DateTimeOffset CreatedAt
  +DateTimeOffset? ReadAt
  +Guid? CorrelationId
  +{static} Create(...): Notification
  +MarkRead(now: DateTimeOffset): void
}
class NewBusinessNotifier <<static>> {
  +{static} Kind = "business"
  +{static} TellAsync(db, listing: Listing, now): Task<int>
}
class BrowsedCategories <<static>> {
  +{static} TimeSpan Within = 90 days
  +{static} OfAsync(db, memberId, now): Task<List<string>>
  +{static} MembersAsync(db, categorySlug, now): Task<List<Guid>>
}

NotificationsPage ..> NotificationsApi : loads and marks through
NotificationsPage ..> NavigationStore : sets the unread count
NavigationStore --> NavigationSummary : holds
NotificationsApi ..> NotificationsController : calls over HTTPS
NotificationsController ..> ListNotificationsQueryHandler : sends query
NotificationsController ..> MarkNotificationReadCommandHandler : sends command
NotificationsController ..> MarkAllNotificationsReadCommandHandler : sends command
ListNotificationsQueryHandler ..> NotificationRules : Visible
ListNotificationsQueryHandler ..> NotificationListDto : returns
NotificationListDto "1" *-- "*" NotificationDto : lists
MarkNotificationReadCommandHandler ..> UnreadDto : returns
MarkAllNotificationsReadCommandHandler ..> UnreadDto : returns
MarkNotificationReadCommandHandler ..> Notification : MarkRead
NotificationRules "1" --> "*" Notification : creates and selects
NewBusinessNotifier ..> NotificationRules : Tell with kind business
NewBusinessNotifier ..> BrowsedCategories : MembersAsync
@enduml
