@startuml
title UML sequence behaviour — Create a notification from an event
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Verifier" as verifier
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "RealtimeService" as rt
  participant "NotificationsPage" as page
end box
box "Backend — Jubilee API" #D1FADF
  participant "EventsController" as events
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ApproveListingCommandHandler" as handler
  participant "NewBusinessNotifier" as notifier
  participant "NotificationRules" as rules
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
verifier -> handler : ApproveListingCommand
handler -> rules : Tell(owner, "listing", ...) for the owner (L2-064)
opt first approval of the listing
  handler -> notifier : TellAsync(listing)
  notifier -> db : BrowsedCategories.MembersAsync, then members with EmailNewBusinesses on, except the owner (L2-222)
  db --> notifier : Members
  loop each member
    notifier -> rules : Tell(member, "business", "New in {category}: {business}", tagline, business page)
  end
end
rules -> db : Add Notification rows
handler -> db : Save the state change and the notifications in one save
db --> handler : Commit result
events -> db : Read the member's notifications newer than the cursor
db --> events : New notification
events --> rt : event: notification with its id (L2-070)
rt -> rt : Count the arrival and raise a toast
rt --> page : arrivals grows
page -> page : Read the list again through GET /api/notifications
page --> member : Show the new item at the top, marked "Unread."
@enduml
