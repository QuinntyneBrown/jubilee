@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Show toasts and banners

Person(member, "Member", "Sees toasts and banners")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Toast region and banners in the application shell")
  Container(api, "Jubilee API", "ASP.NET Core", "Session and listing state and the event stream")
  ContainerDb(db, "Jubilee database", "SQL Server", "Members and listings and notifications")
}

Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Reads /api/session and listing state", "JSON/HTTPS")
Rel(api, web, "Sends notification events", "Server-sent events")
Rel(api, db, "Reads", "EF Core")
@enduml
