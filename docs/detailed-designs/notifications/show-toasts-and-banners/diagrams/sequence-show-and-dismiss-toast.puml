@startuml
title UML sequence behaviour — Show and dismiss a toast
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "Caller (page or RealtimeService)" as caller
  participant "ToastService" as service
  participant "ToastRegion" as region
  participant "Toast" as toast
end box
caller -> service : show(spec)
service -> service : Append the toast and remove the oldest non-danger toast above three (L2-066)
alt tone is danger
  service -> service : Duration 0 and no timer
  region -> toast : Render with role="alert"
  toast --> member : Announced assertively and stays until dismissed
else info or success or warning
  service -> service : Start a timer of 8000 ms
  region -> toast : Render in the polite live region
  toast --> member : Announced politely
end
opt pointer hovers or focus enters the toast
  member -> toast : Hover or focus
  toast -> region : hold
  region -> service : pause(id)
  service -> service : Stop the timer and keep the remaining time
  member -> toast : Leave
  toast -> region : release
  region -> service : resume(id)
  service -> service : Start the timer with the remaining time
end
alt member presses the action
  member -> toast : Press "Undo" or "Open conversation"
  toast -> region : action
  region -> service : act(id)
  service -> service : Remove the toast
  service -> caller : Run the action
else member presses "Dismiss"
  member -> toast : Press the dismiss button
  toast -> region : dismiss
  region -> service : dismiss(id)
else the timer ends
  service -> service : dismiss(id)
end
service --> region : Toast list without the toast
region --> member : Toast removed
@enduml
