@startuml
title UML sequence behaviour — Show and resolve a persistent banner
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "App" as app
  participant "SessionService" as session
  participant "VerifyEmailBanner" as banner
end box
box "Backend — Jubilee API" #D1FADF
  participant "Session endpoint" as api
end box
member -> app : Open a signed-in page
app -> session : Read the member
session -> api : GET /api/session
api --> session : Member with emailConfirmed false
session --> app : Unconfirmed member
app -> banner : Render with state persistent
banner --> member : "Confirm your e-mail to message businesses." with "Send it again" and "Change e-mail" and no dismiss button (L2-005, L2-067)
member -> member : Confirm the e-mail in another tab
member -> app : Return to the original tab
session -> session : The window regains focus while unconfirmed
session -> api : GET /api/session
api --> session : Member with emailConfirmed true
session --> app : Confirmed member
app -> app : Set confirmedBanner because the state changed
app -> banner : Render with state confirmed
banner --> member : "E-mail confirmed." announced politely without moving focus (L2-067)
opt member dismisses the success banner
  member -> banner : Press the dismiss button
  banner -> app : dismiss
  app -> app : Clear confirmedBanner
  app --> member : Banner removed
end
@enduml
