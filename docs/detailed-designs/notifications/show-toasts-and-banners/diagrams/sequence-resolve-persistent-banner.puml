@startuml
title UML sequence behaviour — Show and resolve a persistent banner
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "BannerHost" as host
  participant "BannerService" as svc
  participant "SessionService" as session
end box
box "Backend — Jubilee API" #D1FADF
  participant "SessionController" as controller
  participant "EventsHub" as hub
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetSessionQueryHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
member -> host : Open a signed-in page
session -> controller : GET /api/session
controller -> handler : Send GetSessionQuery
handler -> db : Load member
db --> handler : Member with e-mail unconfirmed
handler --> controller : SessionDto
controller --> session : 200 OK
session -> svc : setCondition(EmailUnconfirmed, true)
svc -> host : Publish persistent banner without a dismiss button (L2-067)
host --> member : "Confirm your e-mail to message businesses." announced politely
... member confirms the e-mail in another tab ...
alt page is open with a real-time connection
  hub -> session : account.email-confirmed
else tab regains focus
  session -> controller : GET /api/session
  controller --> session : 200 OK with e-mail confirmed
end
session -> svc : setCondition(EmailUnconfirmed, false)
svc -> svc : Replace with a dismissible success banner shown once (L2-067)
svc -> host : Publish success banner
host --> member : "E-mail confirmed." announced politely without moving focus (L2-067)
opt member dismisses the success banner
  member -> host : Press dismiss
  host -> svc : dismiss(id)
  svc --> host : Banner removed
end
@enduml
