@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Show toasts and banners

class ToastService <<Angular service>> {
  +toasts: Signal<ShownToast[]>
  +show(spec: ToastSpec): number
  +dismiss(id: number): void
  +act(id: number): void
  +pause(id: number): void
  +resume(id: number): void
}
interface ToastSpec {
  +tone: ToastTone
  +title: string
  +text?: string
  +action?: ToastAction
  +durationMs?: number
}
interface ShownToast {
  +id: number
  +durationMs: number
  +paused: boolean
}
interface ToastAction {
  +label: string
  +run(): void
}
enum ToastTone {
  info
  success
  warning
  danger
}
class ToastRegion <<jb-toast-region>> {
  #toasts: ToastService
}
class Toast <<jb-toast>> {
  +tone: ToastTone
  +heading: string
  +text: string
  +actionLabel: string
  +duration: number
  +paused: boolean
  +action: output
  +dismiss: output
  +hold: output
  +release: output
}
class VerifyEmailBanner <<jb-verify-email-banner>> {
  +state: VerifyEmailBannerState
  +email: string
  +busy: boolean
  +wait: string
  +resend: output
  +changeEmail: output
  +dismiss: output
}
enum VerifyEmailBannerState {
  persistent
  sent
  limited
  bounced
  expired
  confirmed
}
class ConnectionBanner <<jb-connection-banner>> {
  +kind: ConnectionBannerKind
  +detail: string
  +countdown: number
  +sent: number
  +statusUrl: string
  +retry: output
  +dismiss: output
}
enum ConnectionBannerKind {
  offline
  unreachable
  slow
  back-online
}
class RealtimeService <<Angular service>> {
  +connected: Signal<boolean>
  +arrivals: Signal<number>
  +start(): void
  +stop(): void
}

ShownToast --|> ToastSpec
ToastService "1" o-- "0..3" ShownToast : lists
ToastSpec --> ToastTone : has
ToastSpec "1" o-- "0..1" ToastAction : offers
ToastRegion ..> ToastService : reads and calls
ToastRegion "1" --> "0..3" Toast : renders
Toast --> ToastTone : has
VerifyEmailBanner --> VerifyEmailBannerState : has
ConnectionBanner --> ConnectionBannerKind : has
RealtimeService ..> ToastService : show
@enduml
