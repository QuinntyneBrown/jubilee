@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show toasts and banners

Container_Boundary(web, "Jubilee Web") {
  Component(app, "App", "Angular root component", "Composes the banners and the toast region in the shell")
  Component(toasts, "ToastService", "Angular service", "Lists at most three toasts and owns their timers")
  Component(region, "ToastRegion", "jb-toast-region", "Polite live region that renders the toasts")
  Component(toast, "Toast", "jb-toast", "One toast with icon and action and Dismiss")
  Component(verify, "VerifyEmailBanner", "jb-verify-email-banner", "Asks an unconfirmed member to confirm the address")
  Component(conn, "ConnectionBanner", "jb-connection-banner", "Offline and unreachable and slow and back-online")
  Component(alert, "Alert", "jb-alert", "Banner frame also used by pages such as MyBusinessPage")
  Component(session, "SessionService", "Angular service", "E-mail confirmation state of the member")
  Component(connection, "ConnectionService", "Angular service", "Connection state")
  Component(rt, "RealtimeService", "Angular service", "Turns each notification event into a toast")
}
Container_Boundary(api, "Jubilee API") {
  Component(events, "EventsController", "ASP.NET Core controller", "Stream GET /api/events")
  Component(sessionApi, "Session endpoint", "ASP.NET Core controller", "GET /api/session")
}

Rel(app, region, "Renders once")
Rel(app, verify, "Renders while the e-mail is unconfirmed and once when confirmed")
Rel(app, conn, "Renders for the connection state")
Rel(region, toasts, "Reads toasts from")
Rel(region, toast, "Renders one per toast")
Rel(verify, alert, "Is built on")
Rel(conn, alert, "Is built on")
Rel(app, session, "Reads the member from")
Rel(app, connection, "Reads the state from")
Rel(rt, toasts, "Calls show for each event")
Rel(rt, session, "Reads the session again on an account event")
Rel(events, rt, "Sends events to", "Server-sent events")
Rel(session, sessionApi, "Reads", "JSON/HTTPS")
@enduml
