@startuml
title UML sequence behaviour — Grant and revoke a staff role
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Jubilee administrator" as actor
box "Backend — Jubilee CLI" #D1FADF
  participant "jubilee staff" as cli
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GrantStaffRoleCommandHandler" as grant
  participant "RevokeStaffRoleCommandHandler" as revoke
  participant "StaffMember" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> cli : staff grant --email esther@jubilee.to --role verifier
cli -> grant : GrantStaffRoleCommand
alt unknown role or not an e-mail address
  grant --> cli : Validation failure
  cli --> actor : Says why - exit 1 (L2-193)
else valid
  grant -> db : Find or create the StaffMember
  grant -> entity : Grant(Verifier)
  grant -> db : Save
  cli --> actor : "esther@jubilee.to: verifier" - exit 0
end
actor -> cli : staff revoke --email esther@jubilee.to --role verifier
cli -> revoke : RevokeStaffRoleCommand
revoke -> entity : Revoke(Verifier)
revoke -> db : End every open staff session of the account (L2-190)
revoke -> db : Save
cli --> actor : "esther@jubilee.to: no roles" - exit 0
@enduml
