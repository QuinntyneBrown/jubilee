@startuml
title UML sequence behaviour — Choose a new password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ResetPasswordPage" as page
  participant "AccountApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "PasswordResetController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ResetPasswordCommandValidator" as validator
  participant "ResetPasswordCommandHandler" as handler
  participant "Member" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
  database "Cache" as cache
end box
participant "Breached-password service" as breach

actor -> page : Open /reset-password/:token
page -> page : Read the token and remove it from the address bar (L2-140)
page -> client : inspectResetLink(token)
client -> controller : POST /api/account/password-resets/inspect
controller -> db : Find LinkToken by SHA-256 hash and purpose
db --> controller : Token state and e-mail
controller --> client : 200 with state and e-mail
client --> page : ResetLinkView
alt link older than 60 minutes - used - superseded or unknown
  page --> actor : Show "This link has expired. Reset links work once, for 60 minutes." with "Send a new link"
else link valid
  page --> actor : Show "Choose a new password" and "For {e-mail}"
  actor -> page : Enter the new password twice and submit
  page -> page : Check length and match (L2-009)
  page -> client : resetPassword(token, newPassword, repeatPassword)
  client -> controller : POST /api/account/password-resets
  controller -> validator : Validate ResetPasswordCommand
  validator -> breach : Range query for the password hash prefix (L2-134)
  breach --> validator : Breached or not
  alt validation fails
    validator --> controller : Field error codes
    controller --> client : 422 ProblemDetails with per-field codes
    client --> page : Field errors
    page --> actor : Show the field message - for example "This password has appeared in a data breach. Choose another."
  else command valid
    controller -> handler : Send ResetPasswordCommand
    handler -> db : Load token and member
    db --> handler : Redeemable token and member
    handler -> handler : Hash password with Argon2id (L2-134)
    handler -> entity : ChangePassword(hash, now) (L2-009)
    entity --> handler : Password changed
    handler -> db : Save member - used token - superseded reset tokens - security e-mail outbox message
    db --> handler : Commit result
    handler -> cache : End every session of the member (L2-134)
    cache --> handler : Sessions deleted
    handler --> controller : Result
    controller --> client : 204 No Content
    client --> page : Changed
    page --> actor : Show "Password changed. You're signed out everywhere else. Sign in with your new password."
  end
end
@enduml
