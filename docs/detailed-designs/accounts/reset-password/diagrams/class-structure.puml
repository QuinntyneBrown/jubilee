@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Reset password

enum LinkTokenPurpose {
  EmailConfirmation
  PasswordReset
  EmailChange
  DataDownload
}

enum ResetLinkState {
  Valid
  Expired
}

class Member {
  +Guid Id
  +string Email
  +string EmailKey
  +string PasswordHash
  +DateTimeOffset? PasswordChangedAt
  +ChangePassword(passwordHash: string, now: DateTimeOffset): void
}

class PasswordResetRequest {
  +Guid Id
  +string EmailKey
  +DateTimeOffset RequestedAt
  +DateTimeOffset? ProcessedAt
  +{static} Record(email: EmailAddress, now: DateTimeOffset): PasswordResetRequest
  +MarkProcessed(now: DateTimeOffset): void
}

class SecurityAlert {
  +Guid Id
  +string Kind
  +int Count
  +DateTimeOffset RaisedAt
  +{static} Raise(kind: string, count: int, now: DateTimeOffset): SecurityAlert
}

class LinkToken {
  +Guid Id
  +Guid MemberId
  +LinkTokenPurpose Purpose
  +string TokenHash
  +DateTimeOffset ExpiresAt
  +DateTimeOffset? UsedAt
  +DateTimeOffset? SupersededAt
  +IsRedeemable(now: DateTimeOffset): bool
  +Redeem(now: DateTimeOffset): void
  +Supersede(now: DateTimeOffset): void
}

class Session {
  +Guid Id
  +Guid MemberId
  +DateTimeOffset? EndedAt
  +End(now: DateTimeOffset): void
}

class RequestPasswordResetCommand {
  +string Email
  +string Address
}

class RequestPasswordResetCommandHandler {
  +Handle(command: RequestPasswordResetCommand): Task
}

class RateLimitedException {
  +string Code
  +TimeSpan RetryAfter
}

class PasswordResetLinks {
  +LimitPerHour = 3
  +BurstThreshold = 100
  +IssueAsync(): Task<int>
}

class SecuritySettings {
  +string OnCallEmail
}

class InspectResetLinkQueryHandler {
  +Handle(query: InspectResetLinkQuery): Task<ResetLinkView>
}

class ResetLinkView {
  +ResetLinkState State
  +string Email
}

class ResetPasswordCommand {
  +string Token
  +string NewPassword
  +string RepeatPassword
}

class ResetPasswordCommandHandler {
  +Handle(command: ResetPasswordCommand): Task
}

interface IBreachedPasswordChecker {
  +IsBreachedAsync(password: string): Task<bool>
}

class LinkTokens {
  +{static} NewValue(): string
  +{static} Hash(value: string): string
}

Member "1" --> "*" LinkToken : receives
Member "1" --> "*" Session : signs in with
LinkToken --> LinkTokenPurpose : has
RequestPasswordResetCommandHandler ..> RequestPasswordResetCommand : handles
RequestPasswordResetCommandHandler ..> PasswordResetRequest : counts and records
RequestPasswordResetCommandHandler ..> RateLimitedException : throws at the fourth in an hour
PasswordResetLinks ..> PasswordResetRequest : processes
PasswordResetLinks ..> LinkTokens : issues with
PasswordResetLinks ..> SecurityAlert : raises on a burst
PasswordResetLinks ..> SecuritySettings : alerts
InspectResetLinkQueryHandler ..> ResetLinkView : returns
ResetLinkView --> ResetLinkState : has
ResetPasswordCommandHandler ..> ResetPasswordCommand : handles
ResetPasswordCommandHandler ..> IBreachedPasswordChecker : uses
ResetPasswordCommandHandler --> Member : changes password
ResetPasswordCommandHandler --> Session : ends
@enduml
