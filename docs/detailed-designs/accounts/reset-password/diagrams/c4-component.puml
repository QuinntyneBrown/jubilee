@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Reset password

Container_Boundary(web, "Jubilee Web") {
  Component(forgot, "ForgotPasswordPage", "Angular page", "Collects the e-mail - shows the neutral success or the 429 notice")
  Component(reset, "ResetPasswordPage", "Angular page", "Collects the new password twice")
  Component(client, "PasswordResetApi", "Contract and HttpPasswordResetApi", "Calls the password reset endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "AccountController", "ASP.NET Core controller", "Exposes the password reset endpoints")
  Component(request, "RequestPasswordResetCommandHandler", "MediatR handler", "Counts the address's requests - records the request without reading the account")
  Component(apply, "ResetPasswordCommandHandler", "MediatR handler", "Checks the password - redeems the token - changes the password - ends sessions")
  Component(member, "Member", "Domain entity", "Owns the password hash")
  Component(logged, "LoggedPath", "Log redactor", "Writes a token in a path as [redacted]")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(job, "PasswordResetJob", "Hosted job, every 5 seconds", "Runs PasswordResetLinks")
  Component(links, "PasswordResetLinks", "Application service", "Applies the per-e-mail limit - issues the link - raises the burst alert")
  Component(outbox, "OutboxDispatcherJob", "Hosted job", "Sends the outbox e-mails")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Members - reset requests - link tokens - sessions - security alerts - outbox")
System_Ext(email, "E-mail provider", "Delivers e-mail")
System_Ext(breach, "Breached-password service", "k-anonymity range query")

Rel(forgot, client, "Submits through")
Rel(reset, client, "Submits through")
Rel(client, ctrl, "POST /api/account/password-reset-requests, /password-resets/inspect and /password-resets", "JSON/HTTPS")
Rel(ctrl, request, "Sends RequestPasswordResetCommand")
Rel(ctrl, apply, "Sends ResetPasswordCommand")
Rel(ctrl, logged, "Request log names the path through")
Rel(apply, breach, "Checks password through IBreachedPasswordChecker")
Rel(request, db, "Counts and writes PasswordResetRequest rows", "EF Core")
Rel(apply, member, "Calls ChangePassword on")
Rel(apply, db, "Saves member - token - ended sessions - outbox message", "EF Core")
Rel(job, links, "Calls IssueAsync")
Rel(links, db, "Reads member - writes token hash, SecurityAlert and outbox message", "EF Core")
Rel(outbox, email, "Sends reset link, security e-mail and alert")
@enduml
