@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Confirm e-mail

enum EmailStatus {
  Unconfirmed
  Confirmed
}

enum LinkTokenPurpose {
  EmailConfirmation
  PasswordReset
  ChangeEmail
}

enum ConfirmEmailOutcome {
  Confirmed
  AlreadyConfirmed
  Expired
}

class Member {
  +Guid Id
  +string Email
  +string EmailKey
  +EmailStatus EmailStatus
  +bool EmailBounced
  +ConfirmEmail(): void
  +ReplaceUnconfirmedEmail(email: EmailAddress): void
  +MarkEmailBounced(): void
  +CanTransact(): bool
}

class LinkToken {
  +Guid Id
  +Guid MemberId
  +LinkTokenPurpose Purpose
  +string TokenHash
  +DateTimeOffset ExpiresAt
  +DateTimeOffset? UsedAt
  +DateTimeOffset? SupersededAt
  +{static} Issue(memberId: Guid, purpose: LinkTokenPurpose, tokenHash: string, now: DateTimeOffset, lifetime: TimeSpan): LinkToken
  +IsRedeemable(now: DateTimeOffset): bool
  +Redeem(now: DateTimeOffset): void
  +Supersede(now: DateTimeOffset): void
}

class LinkTokens <<static>> {
  +{static} NewValue(): string
  +{static} Hash(value: string): string
}

class AccountEmails {
  +QueueConfirmationAsync(member: Member, cancellationToken: CancellationToken): Task
  +QueueAddressInUseNotice(holder: Member): void
}

class ConfirmEmailCommand <<record>> {
  +string? Token
}

class ConfirmEmailResult <<record>> {
  +ConfirmEmailOutcome Outcome
  +string? FirstName
}

class ConfirmEmailCommandHandler {
  +Handle(request: ConfirmEmailCommand, cancellationToken: CancellationToken): Task<ConfirmEmailResult>
}

class ChangeUnconfirmedEmailCommand <<record>> {
  +Guid MemberId
  +string? Email
}

class ChangeUnconfirmedEmailCommandHandler {
  +Handle(request: ChangeUnconfirmedEmailCommand, cancellationToken: CancellationToken): Task
}

class ValidationFailedException {
  +IReadOnlyDictionary<string, string> Errors
}

class RequiresConfirmedEmailAttribute <<action filter>> {
  +OnActionExecutionAsync(context: ActionExecutingContext, next: ActionExecutionDelegate): Task
}

class GetMemberAccountQueryHandler {
  +Handle(request: GetMemberAccountQuery, cancellationToken: CancellationToken): Task<MemberAccountDto?>
}

class RecordEmailBounceCommand <<record>> {
  +string Address
}

class RecordEmailBounceCommandHandler {
  +Handle(request: RecordEmailBounceCommand, cancellationToken: CancellationToken): Task
}

class LoggedPath <<static>> {
  +{static} Of(context: HttpContext): string
}

class ChangeUnconfirmedEmailDialog <<Angular>>

interface AccountApi <<TypeScript>> {
  +confirmEmail(token: string): Observable<ConfirmEmailResponse>
  +resendConfirmation(): Observable<void>
  +changeUnconfirmedEmail(email: string): Observable<void>
}

class SessionService <<Angular>> {
  +member: Signal<Member | null>
  +unconfirmed: Signal<boolean>
  +resolve(): Observable<SessionState>
}

Member --> EmailStatus : has
Member "1" --> "*" LinkToken : receives
LinkToken --> LinkTokenPurpose : has
AccountEmails ..> LinkTokens : uses
AccountEmails --> LinkToken : issues and supersedes
ConfirmEmailCommandHandler ..> ConfirmEmailCommand : handles
ConfirmEmailCommandHandler ..> LinkTokens : hashes with
ConfirmEmailCommandHandler --> LinkToken : redeems
ConfirmEmailCommandHandler --> Member : confirms
ConfirmEmailCommandHandler ..> ConfirmEmailResult : returns
ConfirmEmailResult --> ConfirmEmailOutcome : has
ChangeUnconfirmedEmailCommandHandler ..> ChangeUnconfirmedEmailCommand : handles
ChangeUnconfirmedEmailCommandHandler ..> AccountEmails : uses
ChangeUnconfirmedEmailCommandHandler ..> ValidationFailedException : throws
ChangeUnconfirmedEmailCommandHandler --> Member : mutates
RequiresConfirmedEmailAttribute ..> GetMemberAccountQueryHandler : asks
GetMemberAccountQueryHandler ..> Member : reads
RecordEmailBounceCommandHandler ..> RecordEmailBounceCommand : handles
RecordEmailBounceCommandHandler --> Member : marks bounced
ChangeUnconfirmedEmailDialog ..> AccountApi : uses
ChangeUnconfirmedEmailDialog ..> SessionService : reloads
@enduml
