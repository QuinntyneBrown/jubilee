@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Confirm e-mail

Container_Boundary(web, "Jubilee Web") {
  Component(page, "VerifyEmailPage", "Angular page", "Waiting - confirming - confirmed - expired - error states")
  Component(banner, "VerifyEmailBanner", "Angular component", "Persistent banner on signed-in pages")
  Component(session, "SessionService", "Angular service", "Holds e-mail status and refreshes it on tab focus")
  Component(client, "AccountApi", "Typed HTTP client", "Calls the confirmation endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "AccountController", "ASP.NET Core controller", "Confirmation endpoints under /api/account")
  Component(hook, "EmailEventsController", "ASP.NET Core controller", "Receives bounce events")
  Component(policy, "ConfirmedEmailRequirement", "Authorization policy", "Answers 403 EMAIL_UNCONFIRMED")
  Component(confirm, "ConfirmEmailCommandHandler", "MediatR handler", "Redeems the token and confirms the member")
  Component(change, "ChangeUnconfirmedEmailCommandHandler", "MediatR handler", "Replaces the unconfirmed address")
  Component(tokens, "ILinkTokenService", "Application service", "Finds - redeems - supersedes link tokens")
  Component(member, "Member", "Domain entity", "Owns e-mail status and the bounce flag")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Members - link tokens - outbox")
System_Ext(email, "E-mail provider", "Reports bounces")

Rel(page, client, "Confirms and resends through")
Rel(banner, client, "Resends through")
Rel(banner, session, "Reads e-mail status from")
Rel(page, session, "Refreshes")
Rel(client, ctrl, "POST /api/account/confirmation", "JSON/HTTPS")
Rel(ctrl, confirm, "Sends ConfirmEmailCommand")
Rel(ctrl, change, "Sends ChangeUnconfirmedEmailCommand")
Rel(confirm, tokens, "Redeems token with")
Rel(change, tokens, "Supersedes and issues with")
Rel(confirm, member, "Calls ConfirmEmail on")
Rel(change, member, "Calls ReplaceUnconfirmedEmail on")
Rel(policy, member, "Reads e-mail status of")
Rel(tokens, db, "Reads and writes token hashes", "EF Core")
Rel(email, hook, "Posts bounce event", "HTTPS")
Rel(hook, member, "Calls MarkEmailBounced on")
@enduml
