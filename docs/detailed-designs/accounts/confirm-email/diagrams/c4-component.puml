@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Confirm e-mail

Container_Boundary(web, "Jubilee Web") {
  Component(page, "VerifyEmailPage", "Angular page", "Waiting - confirming - confirmed - expired - error states")
  Component(root, "App", "Angular root component", "Shows the banner - resends - opens the dialog")
  Component(banner, "jb-verify-email-banner", "Component of the components library", "Persistent - sent - limited - bounced - expired - confirmed states")
  Component(dialog, "ChangeUnconfirmedEmailDialog", "CDK dialog", "Asks for the new e-mail and no password")
  Component(session, "SessionService", "Angular service", "Holds e-mail status and reloads it on window focus")
  Component(client, "AccountApi", "Service contract behind ACCOUNT_API", "Calls the confirmation endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(limit, "AccountRateLimit.Resends", "ASP.NET Core rate limiter policy", "5 resends and changes per member per hour")
  Component(ctrl, "AccountController", "ASP.NET Core controller", "Confirmation endpoints under /api/account")
  Component(sessionctrl, "SessionController", "ASP.NET Core controller", "GET /api/session with the e-mail status")
  Component(hook, "EmailEventsController", "ASP.NET Core controller", "Receives bounce events")
  Component(filter, "RequiresConfirmedEmailAttribute", "Action filter", "Answers 403 EMAIL_UNCONFIRMED")
  Component(logged, "LoggedPath", "Static helper", "Writes [redacted] for a token in a logged path")
  Component(confirm, "ConfirmEmailCommandHandler", "MediatR handler", "Redeems the token and confirms the member")
  Component(change, "ChangeUnconfirmedEmailCommandHandler", "MediatR handler", "Replaces the unconfirmed address")
  Component(bounce, "RecordEmailBounceCommandHandler", "MediatR handler", "Marks the member's e-mail as bounced")
  Component(emails, "AccountEmails", "Application service", "Supersedes and issues link tokens - queues e-mail")
  Component(member, "Member", "Domain entity", "Owns e-mail status and the bounce flag")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Members - link tokens - outbox")
System_Ext(email, "E-mail provider", "Reports bounces")

Rel(root, banner, "Renders and listens to")
Rel(root, session, "Reads e-mail status from")
Rel(root, client, "Resends through")
Rel(root, dialog, "Opens on changeEmail")
Rel(page, dialog, "Opens on Use another e-mail")
Rel(page, client, "Confirms and resends through")
Rel(page, session, "Reloads")
Rel(dialog, client, "Changes the address through")
Rel(dialog, session, "Reloads")
Rel(client, limit, "POST confirmation/resend - PUT unconfirmed-email", "JSON/HTTPS")
Rel(limit, ctrl, "Passes allowed requests to")
Rel(client, ctrl, "POST /api/account/confirmation", "JSON/HTTPS")
Rel(session, sessionctrl, "GET /api/session through SessionApi", "JSON/HTTPS")
Rel(ctrl, confirm, "Sends ConfirmEmailCommand")
Rel(ctrl, change, "Sends ChangeUnconfirmedEmailCommand")
Rel(change, emails, "Queues the confirmation or the address-in-use notice with")
Rel(confirm, member, "Calls ConfirmEmail on")
Rel(change, member, "Calls ReplaceUnconfirmedEmail on")
Rel(filter, member, "Reads e-mail status of")
Rel(confirm, db, "Finds the token by hash and saves", "EF Core")
Rel(emails, db, "Adds token hashes and outbox messages", "EF Core")
Rel(email, hook, "Posts bounce event", "HTTPS")
Rel(hook, bounce, "Sends RecordEmailBounceCommand")
Rel(bounce, member, "Calls MarkEmailBounced on")
@enduml
