@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Confirm e-mail

Person(member, "Member", "Unconfirmed account holder")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "VerifyEmailPage - jb-verify-email-banner - ChangeUnconfirmedEmailDialog")
  Container(api, "Jubilee API", "ASP.NET Core", "Confirms tokens - limits resends and changes - blocks restricted actions")
  Container(worker, "Jubilee Worker", ".NET worker service", "Sends confirmation e-mail from the outbox")
  ContainerDb(db, "Jubilee database", "SQL Server", "Members - link tokens - outbox - sessions")
}
System_Ext(email, "E-mail provider", "Delivers e-mail and reports bounces")

Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Confirms - resends - changes the address - reads the session", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(worker, db, "Reads outbox messages", "EF Core")
Rel(worker, email, "Sends confirmation e-mail", "HTTPS")
Rel(email, api, "Posts bounce events to /api/webhooks/email-events", "HTTPS")
@enduml
