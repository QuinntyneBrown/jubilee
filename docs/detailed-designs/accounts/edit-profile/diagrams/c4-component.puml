@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Edit profile


Person(member, "Member", "Signed-in account holder")
Container_Boundary(web, "Jubilee Web") {
  Component(menu, "AccountMenuDialog", "CDK dialog", "jb-menu links. My business for an owner, no admin link. Anchored from 640 px and bottom sheet below")
  Component(session, "SessionService", "Angular service", "Holds the signed-in member from GET /api/session")
  Component(page, "AccountPage", "Angular page", "Route /account behind memberGuard. Template form of jb-field and jb-input, jb-form-summary")
  Component(guard, "unsavedChangesGuard", "Angular CanDeactivate guard", "Opens LeaveUnsavedDialog when the form differs from what was saved")
  Component(client, "ProfileApi", "PROFILE_API token, HttpProfileApi", "getAccount and saveProfile")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "AccountController", "ASP.NET Core controller", "GET /api/account and PUT /api/account/profile")
  Component(query, "GetAccountQueryHandler", "MediatR handler", "Returns the AccountDto")
  Component(handler, "UpdateProfileCommandHandler", "MediatR handler", "Checks each rule, throws ValidationFailedException, applies the profile change")
  Component(validator, "Profiles", "Application helpers", "Phone to ten digits and postal code upper-case with its space")
  Component(entity, "Member", "Domain entity", "Owns the profile fields")
  Component(admin, "AdminListingOwner", "Admin answer", "Owner panel of the admin application: the only reader of Pronouns")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Members")

Rel(member, menu, "Presses the avatar")
Rel(member, page, "Edits and saves")
Rel(menu, session, "Reads initials, name and e-mail")
Rel(page, session, "Refreshes after a save")
Rel(guard, page, "Checks for unsaved changes")
Rel(page, client, "Loads and saves")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, query, "Sends GetAccountQuery")
Rel(ctrl, handler, "Sends UpdateProfileCommand")
Rel(handler, validator, "Normalizes phone and postal code with")
Rel(handler, entity, "Calls UpdateProfile")
Rel(query, db, "Reads", "EF Core")
Rel(handler, db, "Saves", "EF Core")
Rel(admin, entity, "Reads Pronouns")
@enduml
