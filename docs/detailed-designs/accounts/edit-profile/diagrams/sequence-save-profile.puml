@startuml
title UML sequence behaviour — Save the profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}


actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "AccountPage" as page
  participant "ProfileApi
(HttpProfileApi)" as client
  participant "SessionService" as session
end box
box "Backend — Jubilee API" #D1FADF
  participant "AccountController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "UpdateProfileCommandHandler" as handler
  participant "Profiles" as profiles
  participant "Member" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Press "Save profile"
page -> page : Check the template form fields (L2-126)
alt Field fails a browser rule
  page --> actor : Show jb-form-summary and the message under each field, keep typed values
else Fields pass
  page -> client : saveProfile(profile)
  client -> controller : PUT /api/account/profile
  controller -> controller : Authenticate session and check CSRF token (L2-133)
  controller -> handler : Send UpdateProfileCommand
  handler -> profiles : TryPhone and TryPostalCode
  profiles --> handler : Ten digits and upper-case postal code, or invalid
  handler -> handler : Check names, home church, home church address and pronouns lengths
  alt A field breaks a rule
    handler --> controller : ValidationFailedException (PHONE_INVALID, POSTAL_CODE_INVALID, REQUIRED or TOO_LONG)
    controller --> client : 422 ProblemDetails with per-field codes
    client --> page : Field errors
    page --> actor : Show the field message in jb-form-summary and keep typed values
  else Every field valid
    handler -> db : Load Member of the session
    db --> handler : Member
    handler -> entity : UpdateProfile (L2-013)
    entity --> handler : Profile changed and ProfileSavedAt set
    handler -> db : Save changes in one unit of work
    db --> handler : Commit result
    handler --> controller : Done
    controller -> db : Send GetAccountQuery and read the member
    db --> controller : AccountDto
    controller --> client : 200 AccountDto
    client --> page : Saved account
    page -> session : Resolve the session again
    session --> page : New name and initials
    page --> actor : Show "Profile saved" with "Saved today at {time}."
  end
end
@enduml
