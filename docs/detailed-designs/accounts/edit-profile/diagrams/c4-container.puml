@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Edit profile


Person(member, "Member", "Edits the profile and opens the account menu")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Account menu and account page")
  Container(api, "Jubilee API", "ASP.NET Core", "Account endpoints under /api/account")
  ContainerDb(db, "Jubilee database", "SQL Server", "Members, requests and MemberSession rows (ADR 0046)")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "GET /api/account and PUT /api/account/profile", "JSON/HTTPS")
Rel(api, db, "Resolves the session cookie and reads and writes the member", "EF Core")
@enduml
