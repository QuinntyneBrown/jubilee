@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Edit profile


class Member {
  +Guid Id
  +string FirstName
  +string LastName
  +string Email
  +string? Phone
  +string? PostalCode
  +string? HomeChurch
  +string? HomeChurchAddress
  +string? Pronouns
  +DateTimeOffset CreatedAt
  +DateTimeOffset? ProfileSavedAt
  +UpdateProfile(firstName: string, lastName: string, phone: string?, postalCode: string?, homeChurch: string?, homeChurchAddress: string?, pronouns: string?, now: DateTimeOffset): void
}

class Profiles <<static helpers>> {
  +{static} TryPhone(raw: string?, out phone: string?): bool
  +{static} TryPostalCode(raw: string?, out postalCode: string?): bool
  +{static} FormatPhone(digits: string?): string?
  +{static} ToDto(member: Member): AccountDto
}

class Request {
  +Guid Id
  +Guid MemberId
  +string? Phone
  +DateTimeOffset CreatedAt
}

class UpdateProfileCommand {
  +Guid MemberId
  +string? FirstName
  +string? LastName
  +string? Phone
  +string? PostalCode
  +string? HomeChurch
  +string? HomeChurchAddress
  +string? Pronouns
}

class UpdateProfileCommandHandler {
  +Handle(command: UpdateProfileCommand): Task
}

class ValidationFailedException {
  +IReadOnlyDictionary<string, string> Errors
}

class GetAccountQueryHandler {
  +Handle(query: GetAccountQuery): Task<AccountDto>
}

class AccountDto {
  +string FirstName
  +string LastName
  +string Email
  +string EmailStatus
  +string? Phone
  +string? PostalCode
  +string? HomeChurch
  +string? HomeChurchAddress
  +string? Pronouns
  +DateTimeOffset MemberSince
  +DateTimeOffset? ProfileSavedAt
  +bool HasPassword
  +DateTimeOffset? PasswordChangedAt
}

class AdminListingOwner <<admin application>> {
  +string? Pronouns
}

class AccountMenuData <<TypeScript>> {
  +displayName: string
  +initials: string
  +email: string
  +ownsListing: boolean
}

UpdateProfileCommandHandler ..> UpdateProfileCommand : handles
UpdateProfileCommandHandler ..> Profiles : normalizes with
UpdateProfileCommandHandler ..> ValidationFailedException : throws (422, one code per field)
UpdateProfileCommandHandler --> Member : loads / mutates
GetAccountQueryHandler ..> AccountDto : returns
GetAccountQueryHandler --> Member : reads
Profiles ..> AccountDto : builds
AdminListingOwner ..> Member : reads Pronouns (Owner panel only)
Member "1" <-- "*" Request : sent by
@enduml
