@startuml
title UML sequence behaviour — Sign in with e-mail and password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "SignInPage" as page
  participant "SessionService" as session
  participant "HttpSessionApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "SessionController" as controller
  participant "DatabaseTicketStore" as tickets
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SignInCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box

actor -> page : Enter e-mail and password and press "Log in"
page -> page : Check e-mail format and set the busy state (L2-006)
page -> session : signIn(request)
session -> client : signIn(request)
client -> controller : POST /api/session
controller -> handler : Send SignInCommand with the caller's address
handler -> db : Count SignInFailure rows of the address in 15 minutes (L2-007)
db --> handler : Times of the failures
alt 20 failures from the address
  handler --> controller : Outcome AddressBlocked
  controller --> client : 429 with code rate_limited and Retry-After
  client --> page : Rate-limit error
  page --> actor : Show "You're doing that a lot. Try again in {n} minutes."
else within the address limit
  handler -> db : Count SignInFailure rows of the account key in 15 minutes
  db --> handler : Times of the failures
  alt 5 failures for the account
    handler --> controller : Outcome AccountLocked
    controller --> client : 429 with code SIGN_IN_LOCKED and Retry-After
    client --> page : Locked
    page --> actor : Show "Too many tries. Wait 15 minutes or reset your password." (L2-007)
  else not locked
    handler -> db : Load member by normalised e-mail
    db --> handler : Member or nothing
    handler -> handler : Verify password with Argon2id - or a dummy hash when no member (L2-141)
    alt wrong password or no account
      handler -> db : Add a SignInFailure row
      opt fifth failure within 15 minutes for an existing account
        handler -> db : Add the lock-out e-mail OutboxMessage (L2-007)
      end
      handler -> db : Save changes in one unit of work
      db --> handler : Commit result
      handler --> controller : Outcome InvalidCredentials
      controller --> client : 401 with code INVALID_CREDENTIALS
      client --> page : Invalid credentials
      page --> actor : Show "That password doesn't match this e-mail. Try again or reset it." and keep the e-mail
    else password matches
      handler -> db : Remove the SignInFailure rows of the account (L2-007)
      db --> handler : Commit result
      handler --> controller : Outcome SignedIn with the member
      controller -> tickets : SignInMemberAsync - StoreAsync(ticket)
      tickets -> db : Add a MemberSession row with a new identifier (L2-010)
      db --> tickets : Commit result
      tickets --> controller : New random key for the cookie
      controller --> client : 200 with session cookie - XSRF-TOKEN cookie and SessionDto
      client --> session : SessionDto
      session --> page : Member set
      page --> actor : Show "Welcome back, {first name}" and go to the return path or /
    end
  end
end
@enduml
