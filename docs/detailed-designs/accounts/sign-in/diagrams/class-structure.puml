@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Sign in

enum SignInOutcome {
  SignedIn
  InvalidCredentials
  AccountLocked
  AddressBlocked
}

class SignInRequest {
  +string? Email
  +string? Password
  +bool KeepSignedIn
}

class SignInCommand {
  +string? Email
  +string? Password
  +string Address
}

class SignInCommandHandler {
  +Handle(request: SignInCommand): Task<SignInResult>
}

class SignInResult {
  +SignInOutcome Outcome
  +Member? Member
  +TimeSpan? RetryAfter
}

class SignInFailure {
  +{static} TimeSpan Window = 15 minutes
  +{static} int AccountLimit = 5
  +{static} int AddressLimit = 20
  +Guid Id
  +string AccountKey
  +string Address
  +DateTimeOffset At
  +{static} Record(accountKey: string, address: string, at: DateTimeOffset): SignInFailure
}

interface IPasswordHasher {
  +Hash(password: string): string
  +Verify(hash: string, password: string): bool
}

class Member {
  +Guid Id
  +string FirstName
  +string Email
  +string EmailKey
  +string? PasswordHash
}

class SessionController {
  +SignIn(request: SignInRequest): Task<IActionResult>
}

class SessionSignIn <<static>> {
  +SignInMemberAsync(context: HttpContext, member: Member, keepSignedIn: bool): Task
}

class SignInRequiredData <<TypeScript>> {
  +title: string
  +returnUrl: string
}

class SignInRequiredDialog <<TypeScript>> {
  #data: SignInRequiredData
  #close(): void
}

class "sanitiseReturnUrl" as sanitise <<TypeScript function>> {
  +sanitiseReturnUrl(value: string | null): string
}

class SignInPage <<TypeScript>> {
  #returnUrl: string
  #submit(): void
}

class PendingAction <<TypeScript>> {
  +kind: 'stock-alert'
  +returnPath: string
}

class PendingActionService <<TypeScript>> {
  +remember(action: PendingAction): void
  +take(kind: string, path: string): boolean
}

SessionController ..> SignInRequest : receives
SessionController ..> SignInCommand : sends
SessionController ..> SessionSignIn : starts the session with
SignInCommandHandler ..> SignInCommand : handles
SignInCommandHandler ..> SignInResult : returns
SignInResult --> SignInOutcome : has
SignInResult --> Member : carries
SignInCommandHandler ..> SignInFailure : counts and records
SignInCommandHandler ..> IPasswordHasher : uses
SignInCommandHandler --> Member : loads
SignInRequiredDialog --> SignInRequiredData : has
SignInPage ..> sanitise : uses
PendingActionService "1" o-- "0..1" PendingAction : holds
@enduml
