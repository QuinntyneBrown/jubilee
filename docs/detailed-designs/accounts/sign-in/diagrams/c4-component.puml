@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Sign in

Container_Boundary(web, "Jubilee Web") {
  Component(origin, "BusinessPage", "Angular page", "Listing page - opens the dialog of the action its address names")
  Component(dialog, "SignInRequiredDialog", "Angular dialog", "Prompts a visitor who starts a member action")
  Component(page, "SignInPage", "Angular page", "Sign-in form with busy and invalid states")
  Component(sanitise, "sanitiseReturnUrl", "Function", "Accepts same-origin relative paths only")
  Component(pending, "PendingActionService", "Angular service", "Remembers the one action that has no address")
  Component(session, "SessionService", "Angular service", "Holds the signed-in member")
  Component(client, "HttpSessionApi", "Typed HTTP client behind SESSION_API", "Calls POST /api/session")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "SessionController", "ASP.NET Core controller", "Exposes /api/session")
  Component(handler, "SignInCommandHandler", "MediatR handler", "Verifies credentials and applies both limits")
  Component(hasher, "IPasswordHasher", "Application service", "Argon2id verification")
  Component(tickets, "DatabaseTicketStore", "ASP.NET Core ITicketStore", "Stores the session under a new identifier")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Members - Sessions - SignInFailures - outbox")

Rel(origin, dialog, "Opens with the return path of the started action")
Rel(origin, pending, "Remembers and takes a stock alert in")
Rel(dialog, page, "Links to with returnUrl")
Rel(page, sanitise, "Reads returnUrl through")
Rel(page, session, "Signs in through")
Rel(page, origin, "Navigates to the return path")
Rel(session, client, "Calls")
Rel(client, ctrl, "POST /api/session", "JSON/HTTPS")
Rel(ctrl, handler, "Sends SignInCommand")
Rel(ctrl, tickets, "Starts the session through the cookie scheme")
Rel(handler, hasher, "Verifies password with")
Rel(handler, db, "Loads member - counts and records SignInFailure rows - writes lockout outbox message", "EF Core")
Rel(tickets, db, "Adds a MemberSession row", "EF Core")
@enduml
