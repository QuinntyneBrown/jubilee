@startuml
title UML sequence behaviour — Sign-in prompt and return to origin
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "BusinessPage" as origin
  participant "SignInRequiredDialog" as dialog
  participant "SignInPage" as page
  participant "SessionService" as session
  participant "SavedStore" as saved
end box
box "Backend — Jubilee API" #D1FADF
  participant "SessionController" as controller
  participant "SavedController" as savedCtrl
end box

actor -> origin : Press "Message" on Legacy Financial
origin -> origin : Navigate to /b/legacy-financial/message
origin -> session : member()
session --> origin : No member
origin -> dialog : Open with returnUrl /b/legacy-financial/message
dialog --> actor : Show "Join to message Legacy Financial" with "Sign in" and "Join free" (L2-012)
actor -> dialog : Press "Sign in"
dialog -> page : Navigate to /sign-in?returnUrl=/b/legacy-financial/message
page -> page : sanitiseReturnUrl - accept only a same-origin relative path - otherwise use / (L2-012)
actor -> page : Sign in
page -> session : signIn(request)
session -> controller : POST /api/session
controller --> session : 200 with session cookie and SessionDto
session --> page : Member set
page -> origin : Navigate to the return path
alt return path ends in ?save=1
  origin -> saved : save(target) unless already saved
  saved -> savedCtrl : PUT /api/saved/businesses/{slug}
  savedCtrl --> saved : 204 No Content
  saved --> origin : Saved
  origin -> origin : Remove save from the address
  origin --> actor : Show the item as saved (L2-012)
else return path names message - book - quote or request
  origin --> actor : Open the dialog of the started action (L2-012)
end
@enduml
