@startuml
title UML sequence behaviour — Sign-in prompt and return to origin
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "BusinessPage" as origin
  participant "SignInRequiredDialog" as dialog
  participant "PendingActionService" as pending
  participant "SignInPage" as page
  participant "SessionService" as session
  participant "SavedApi" as saved
end box
box "Backend — Jubilee API" #D1FADF
  participant "SessionController" as controller
  participant "SavedController" as savedCtrl
end box

actor -> origin : Press "Message" on Legacy Financial
origin -> session : Read signed-in state
session --> origin : Not signed in
origin -> dialog : Open for action Message
dialog --> actor : Show "Join to message Legacy Financial" with "Sign in" and "Join free" (L2-012)
actor -> dialog : Press "Sign in"
dialog -> pending : remember(kind - targetId - returnPath)
pending --> dialog : Stored for this tab
dialog -> page : Navigate to /sign-in?returnUrl=/b/legacy-financial
actor -> page : Sign in
page -> controller : POST /api/session
controller --> page : 200 with session cookie
page -> session : Set signed-in member
session --> page : Member set
page -> pending : resume()
pending -> pending : Accept only a same-origin relative path - otherwise use / (L2-012)
pending -> origin : Navigate to the return path
alt action is Save
  origin -> saved : save(targetId)
  saved -> savedCtrl : PUT /api/saved/{targetId}
  savedCtrl --> saved : 204 No Content
  saved --> origin : Saved
  origin --> actor : Show the item as saved (L2-012)
else action is Message - Book - Ask or Order
  origin --> actor : Open the dialog for the started action (L2-012)
end
@enduml
