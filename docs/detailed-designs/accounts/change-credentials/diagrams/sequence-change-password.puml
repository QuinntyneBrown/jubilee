@startuml
title UML sequence behaviour — Change the password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}


actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ChangePasswordDialog" as dialog
  participant "ProfileApi\n(HttpProfileApi)" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AccountController" as controller
  participant "DatabaseTicketStore" as store
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ChangePasswordCommandHandler" as handler
  participant "IPasswordHasher" as hasher
  participant "IBreachedPasswordChecker" as checker
  participant "Member" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
participant "Breached-password service" as breach
actor -> dialog : Enter current password and new password twice
dialog -> client : changePassword(current, new, repeat)
client -> controller : PUT /api/account/password
controller -> controller : Authenticate session and check CSRF token
controller -> handler : Send ChangePasswordCommand (KeepSessionId, Address)
handler -> db : Load Member of the session
db --> handler : Member
opt Member has a password
  handler -> hasher : Verify current password
  hasher --> handler : Match or no match
  opt No match
    handler -> handler : SecurityLog: PasswordChange refused (L2-143)
  end
end
handler -> checker : IsBreachedAsync(new password) when 10 to 128 characters
checker -> breach : Range query with hash prefix
breach --> checker : Matching suffixes
checker --> handler : Breached or not
alt Current password wrong, or new password too short, too long, breached or not repeated (L2-015)
  handler --> controller : ValidationFailedException (CURRENT_PASSWORD_INCORRECT, PASSWORD_TOO_SHORT, PASSWORD_BREACHED, PASSWORDS_DIFFER)
  controller --> client : 422 ProblemDetails with per-field codes
  client --> dialog : Field errors
  dialog --> actor : Show "That isn't your current password." or the field messages and clear password fields
else Every rule passes
  handler -> hasher : Hash with Argon2id (L2-134)
  hasher --> handler : Password hash
  handler -> entity : ChangePassword(hash, now)
  entity --> handler : PasswordChangedAt set
  handler -> db : End every other MemberSession, supersede reset tokens, save Member and security e-mail outbox message
  db --> handler : Commit result
  handler -> handler : SecurityLog: PasswordChange succeeded (L2-143)
  handler --> controller : Member
  controller -> store : Start this session again
  store -> db : Save new MemberSession with Device and Network
  db --> store : Stored
  controller --> client : 204 No Content
  client --> dialog : Changed
  dialog --> actor : Close and show "Changed {date}"
end
@enduml
