@startuml
title UML sequence behaviour — Confirm the new e-mail
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}


actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ConfirmEmailChangePage" as page
  participant "ProfileApi\n(HttpProfileApi)" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AccountController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ConfirmEmailChangeCommandHandler" as handler
  participant "LinkToken" as token
  participant "Member" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Open the confirmation link
page -> page : Read the token and remove it from the address bar (L2-140)
page -> client : confirmEmailChange(token)
client -> controller : POST /api/account/email-change/confirm (no session needed)
controller -> handler : Send ConfirmEmailChangeCommand (Address)
handler -> db : Load ChangeEmail LinkToken by SHA-256 hash of the token
db --> handler : LinkToken or none
handler -> token : IsRedeemable(now)
token --> handler : Redeemable or not
alt Token unknown, used, superseded or older than 24 hours
  handler --> controller : EmailChangeOutcome.Expired
  controller --> client : 200 outcome "expired"
  client --> page : expired
  page --> actor : Show that the link no longer works. The old address stays in use
else Target address taken by another account in the meantime
  handler -> db : Check that no other account uses the target address
  db --> handler : Taken
  handler --> controller : EmailChangeOutcome.EmailInUse
  controller --> client : 200 outcome "email-in-use"
  client --> page : email-in-use
  page --> actor : Say another account uses the address. The old address stays in use
else Token redeemable and address free
  handler -> db : Check that no other account uses the target address
  db --> handler : Free
  handler -> entity : ChangeEmail(TargetEmail) (L2-014)
  entity --> handler : Address replaced and marked confirmed
  handler -> token : Redeem(now)
  token --> handler : Used
  handler -> db : Save changes in one unit of work
  db --> handler : Commit result
  handler -> handler : SecurityLog: EmailChange succeeded (L2-143)
  handler --> controller : EmailChangeOutcome.Confirmed
  controller --> client : 200 outcome "confirmed"
  client --> page : confirmed
  page --> actor : Show the new address with "Confirmed."
end
@enduml
