@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage session

Container_Boundary(web, "Jubilee Web") {
  Component(interceptor, "SessionExpiredInterceptor", "Angular HTTP interceptor", "Reacts to 401 by saving the draft and redirecting")
  Component(drafts, "DraftStore", "Angular service", "Keeps form and message drafts on the device per member")
  Component(expired, "SessionExpiredPage", "Angular page", "Explains the sign-out and offers Sign in")
  Component(dialog, "SignOutDialog", "Angular dialog", "Confirms sign-out")
  Component(session, "SessionService", "Angular service", "Holds the signed-in member and the session count")
  Component(client, "AccountApi", "Typed HTTP client", "Calls /api/session")
}
Container_Boundary(api, "Jubilee API") {
  Component(auth, "SessionAuthenticationMiddleware", "ASP.NET Core middleware", "Resolves the cookie to a Session and applies the lifetime")
  Component(csrf, "CsrfMiddleware", "ASP.NET Core middleware", "Checks the anti-CSRF token on state-changing requests")
  Component(ctrl, "SessionController", "ASP.NET Core controller", "Exposes /api/session")
  Component(store, "ISessionStore", "Application service", "Creates - reads - renews and ends sessions")
  Component(policy, "SessionPolicy", "Domain service", "30-day and 12-hour rules")
}
ContainerDb(cache, "Cache", "Redis", "Sessions and the per-member session index")

Rel(interceptor, drafts, "Saves the current draft in")
Rel(interceptor, expired, "Navigates to")
Rel(dialog, client, "Signs out through")
Rel(dialog, session, "Clears")
Rel(session, client, "Loads the session through")
Rel(client, auth, "Calls /api/session", "JSON/HTTPS")
Rel(auth, store, "Reads and renews the session through")
Rel(auth, policy, "Evaluates expiry with")
Rel(auth, csrf, "Passes authenticated requests to")
Rel(csrf, ctrl, "Passes valid requests to")
Rel(ctrl, store, "Ends sessions through")
Rel(store, cache, "Stores", "Redis protocol")
@enduml
