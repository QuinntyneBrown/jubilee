@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage session

Container_Boundary(web, "Jubilee Web") {
  Component(interceptor, "sessionExpiredInterceptor", "Angular HTTP interceptor", "Reacts to 401 SESSION_EXPIRED by saving drafts and redirecting")
  Component(registry, "DraftRegistry", "Angular service", "Saves the drafts of the page on screen through DraftStore")
  Component(expired, "SessionExpiredPage", "Angular page", "Explains the sign-out and offers Sign in")
  Component(account, "AccountPage", "Angular page", "Row Sign out with the count of other devices")
  Component(dialog, "SignOutDialog", "Angular dialog", "Confirms sign-out")
  Component(others, "SignOutOthersDialog", "Angular dialog", "Confirms sign-out of other devices")
  Component(session, "SessionService", "Angular service", "Holds the signed-in member and otherSessionCount")
  Component(client, "HttpSessionApi", "Typed HTTP client behind SESSION_API", "Calls /api/session")
}
Container_Boundary(api, "Jubilee API") {
  Component(auth, "Cookie authentication", "ASP.NET Core cookie scheme", "Resolves the cookie and answers 401 SESSION_EXPIRED")
  Component(cookie, "MemberSessionCookie", "Singleton", "Names the cookie __Host-jubilee.session")
  Component(store, "DatabaseTicketStore", "ASP.NET Core ITicketStore", "Stores - finds - renews and ends sessions")
  Component(policy, "SessionPolicy", "Domain class", "30-day and 12-hour rules")
  Component(csrf, "CsrfMiddleware", "ASP.NET Core middleware", "Checks X-XSRF-TOKEN on state-changing requests")
  Component(ctrl, "SessionController", "ASP.NET Core controller", "Exposes /api/session")
  Component(handlers, "OtherSessionCountQuery and EndOtherSessionsCommand handlers", "MediatR handlers", "Count and end the member's other sessions")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Sessions table")

Rel(interceptor, registry, "Saves the current drafts through")
Rel(interceptor, session, "Expires the member in")
Rel(interceptor, expired, "Navigates to")
Rel(account, dialog, "Opens")
Rel(account, others, "Opens")
Rel(account, session, "Reads otherSessionCount from")
Rel(dialog, registry, "Saves the current drafts through")
Rel(dialog, session, "Signs out through")
Rel(others, session, "Signs out other devices through")
Rel(session, client, "Calls")
Rel(client, auth, "Calls /api/session", "JSON/HTTPS")
Rel(auth, cookie, "Reads the cookie name from")
Rel(auth, store, "Retrieves and removes the session through")
Rel(store, policy, "Evaluates expiry with")
Rel(auth, csrf, "Passes requests to")
Rel(csrf, ctrl, "Passes valid requests to")
Rel(ctrl, handlers, "Sends requests to")
Rel(store, db, "Reads and writes MemberSession rows", "EF Core")
Rel(handlers, db, "Counts and ends MemberSession rows", "EF Core")
@enduml
