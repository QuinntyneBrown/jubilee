@startuml
title UML sequence behaviour — Sign out of the current session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "SignOutDialog" as dialog
  participant "DraftRegistry" as drafts
  participant "SessionService" as session
  participant "HttpSessionApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "CsrfMiddleware" as csrf
  participant "SessionController" as controller
  participant "DatabaseTicketStore" as store
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box

actor -> dialog : Choose "Sign out" in the account menu
dialog --> actor : Ask "Sign out of Jubilee?" with "Stay signed in" and "Sign out" (L2-011)
alt member presses "Stay signed in"
  dialog --> actor : Close the dialog and return focus
else member presses "Sign out"
  dialog -> drafts : saveAll() - keep unsent drafts on the device (L2-011)
  drafts --> dialog : Saved
  dialog -> session : signOut()
  session -> client : signOut()
  client -> csrf : DELETE /api/session
  csrf -> csrf : Compare the X-XSRF-TOKEN header with the XSRF-TOKEN cookie (L2-135)
  csrf -> controller : Forward request
  controller -> store : SignOutAsync - RemoveAsync(key)
  store -> db : End this session only (L2-011)
  db --> store : Commit result
  store --> controller : Ended
  controller --> client : 204 No Content with removed cookie
  client --> session : Signed out
  session -> session : Clear the signed-in member
  session --> dialog : Signed out
  dialog --> actor : Navigate to /welcome
end
@enduml
