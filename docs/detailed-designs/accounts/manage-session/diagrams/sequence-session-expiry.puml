@startuml
title UML sequence behaviour — Expire a session and restore the draft
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "Page with a draft" as page
  participant "SessionExpiredInterceptor" as interceptor
  participant "DraftStore" as drafts
  participant "SessionExpiredPage" as expired
end box
box "Backend — Jubilee API" #D1FADF
  participant "SessionAuthenticationMiddleware" as auth
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SessionPolicy" as policy
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Cache" as cache
end box

actor -> page : Submit a form or message
page -> interceptor : HTTP request with the session cookie
interceptor -> auth : Request to /api
auth -> cache : Find Session by cookie value
cache --> auth : Session or nothing
auth -> policy : IsExpired(session, now)
policy --> auth : Older than 30 days or idle for 12 hours (L2-010)
alt session valid
  auth -> cache : Touch last activity
  cache --> auth : Renewed
  auth --> interceptor : Response from the endpoint
  interceptor --> page : Response
else session ended or missing
  auth -> cache : Delete the session
  cache --> auth : Deleted
  auth --> interceptor : 401 with code SESSION_EXPIRED and cleared cookie
  interceptor -> drafts : save(memberId, route, draft) (L2-116)
  drafts --> interceptor : Stored on the device
  interceptor -> expired : Navigate to /session-expired with the return path
  expired --> actor : Show "You've been signed out" and "Sign in"
  actor -> expired : Press "Sign in" and sign in
  expired -> page : Navigate to the return path (L2-116)
  page -> drafts : restore(memberId, route)
  drafts --> page : Draft of the same member (L2-010)
  page --> actor : Show the page with the draft restored
end
@enduml
