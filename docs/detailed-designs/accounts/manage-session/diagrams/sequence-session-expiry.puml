@startuml
title UML sequence behaviour — Expire a session and restore the draft
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "Page with a draft" as page
  participant "sessionExpiredInterceptor" as interceptor
  participant "DraftRegistry" as drafts
  participant "SessionService" as session
  participant "SessionExpiredPage" as expired
end box
box "Backend — Jubilee API" #D1FADF
  participant "Cookie authentication" as auth
  participant "DatabaseTicketStore" as store
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SessionPolicy" as policy
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box

actor -> page : Submit a form or message
page -> interceptor : HTTP request with the session cookie
interceptor -> auth : Request to /api
auth -> store : RetrieveAsync(key)
store -> db : Find the MemberSession by the hash of the key
db --> store : Row or nothing
store -> policy : IsExpired(session, now)
policy --> store : Ended - older than 30 days - or idle for 12 hours (L2-010)
alt session valid
  store -> db : Touch last activity - at most once a minute
  db --> store : Commit result
  store --> auth : Ticket
  auth --> interceptor : Response from the endpoint
  interceptor --> page : Response
else session ended or missing
  store -> db : End the session
  db --> store : Commit result
  store --> auth : Nothing
  auth --> interceptor : 401 with code SESSION_EXPIRED and removed cookie
  interceptor -> drafts : saveAll() (L2-116)
  drafts --> interceptor : Drafts stored on the device
  interceptor -> session : expire()
  session --> interceptor : Member cleared
  interceptor -> expired : Navigate to /session-expired?returnUrl={Router.url}
  expired --> actor : Show "You've been signed out" and "Sign in"
  actor -> expired : Press "Sign in" and sign in
  expired -> page : Navigate to the return path (L2-116)
  page -> drafts : register(source)
  drafts --> page : restore(values) for the same member (L2-010)
  page --> actor : Show the page with the draft restored and the toast "We kept what you typed"
end
@enduml
