@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Manage session

enum SessionKind {
  Member
  Staff
}

class MemberSession {
  +Guid Id
  +string KeyHash
  +SessionKind Kind
  +Guid? MemberId
  +byte[] Ticket
  +bool Persistent
  +DateTimeOffset CreatedAt
  +DateTimeOffset LastActivityAt
  +DateTimeOffset? EndedAt
  +{static} Start(id, memberId, keyHash, ticket, persistent, now): MemberSession
  +Touch(now: DateTimeOffset): void
  +End(now: DateTimeOffset): void
  +Replace(ticket: byte[]): void
}

class SessionPolicy <<static>> {
  +TimeSpan AbsoluteLifetime = 30 days
  +TimeSpan IdleTimeout = 12 hours
  +IsExpired(session: MemberSession, now: DateTimeOffset): bool
}

interface ITicketStore {
  +StoreAsync(ticket: AuthenticationTicket): Task<string>
  +RenewAsync(key: string, ticket: AuthenticationTicket): Task
  +RetrieveAsync(key: string): Task<AuthenticationTicket?>
  +RemoveAsync(key: string): Task
}

class DatabaseTicketStore {
  +{static} string SessionIdClaim = "sid"
}

class MemberSessionCookie {
  +{static} string PrefixedName = "__Host-jubilee.session"
  +{static} string DevelopmentName = "jubilee.session"
  +bool HostPrefix
  +string Name
  +CookieSecurePolicy SecurePolicy
}

class CsrfToken <<static>> {
  +string Cookie = "XSRF-TOKEN"
  +string Header = "X-XSRF-TOKEN"
  +Issue(context: HttpContext): void
}

class CsrfMiddleware {
  +InvokeAsync(context: HttpContext): Task
}

class SessionController {
  +Get(): Task<SessionDto>
  +SignIn(request: SignInRequest): Task<IActionResult>
  +EndSession(): Task<IActionResult>
  +SignOutOthers(): Task<IActionResult>
}

class SessionDto {
  +bool SignedIn
  +string? FirstName
  +string? DisplayName
  +string? Initials
  +string? Email
  +string? EmailStatus
  +int? OtherSessionCount
}

class OtherSessionCountQuery {
  +Guid MemberId
  +Guid? CurrentSessionId
}

class EndOtherSessionsCommand {
  +Guid MemberId
  +Guid? CurrentSessionId
}

interface SessionApi <<TypeScript>> {
  +getSession(): Observable<SessionDto>
  +signIn(request: SignInRequest): Observable<SessionDto>
  +signOut(): Observable<void>
  +signOutOthers(): Observable<void>
}

class HttpSessionApi <<TypeScript>>

class SessionService <<TypeScript>> {
  +member: Signal<Member | null>
  +otherSessionCount: Signal<number>
  +resolve(): Observable<SessionState>
  +signIn(request: SignInRequest): Observable<SessionState>
  +signOut(): Observable<void>
  +signOutOthers(): Observable<void>
  +expire(): void
}

class SignOutDialog <<TypeScript>> {
  #confirm(): void
}

class SignOutOthersDialog <<TypeScript>> {
  #confirm(): void
}

class DraftRegistry <<TypeScript>> {
  +saveAll(): void
}

class "sessionExpiredInterceptor" as interceptor <<TypeScript function>>

DatabaseTicketStore ..|> ITicketStore
DatabaseTicketStore --> "*" MemberSession : stores
DatabaseTicketStore ..> SessionPolicy : uses
SessionPolicy ..> MemberSession : evaluates
MemberSession --> SessionKind : has
CsrfMiddleware ..> CsrfToken : reads cookie and header names
CsrfMiddleware ..> MemberSessionCookie : reads the cookie name
SessionController ..> SessionDto : returns
SessionController ..> OtherSessionCountQuery : sends
SessionController ..> EndOtherSessionsCommand : sends
SessionController ..> CsrfToken : issues
HttpSessionApi ..|> SessionApi
SessionService ..> SessionApi : uses
SignOutDialog ..> SessionService : signOut
SignOutDialog ..> DraftRegistry : saveAll
SignOutOthersDialog ..> SessionService : signOutOthers
interceptor ..> DraftRegistry : saveAll
interceptor ..> SessionService : expire
@enduml
