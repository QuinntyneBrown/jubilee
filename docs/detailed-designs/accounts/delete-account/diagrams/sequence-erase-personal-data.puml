@startuml
title UML sequence behaviour — Erase personal data after 30 days, and after a restore
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

box "Backend — Jubilee Worker" #ECFDF3
  participant "AccountErasureJob" as job
  participant "DeletionLedgerReplay" as replay
  participant "AccountDeletion" as deletion
  participant "AccountErasure" as erasure
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "IDeletionLedger" as ledger
  database "Jubilee database" as db
  participant "IMediaStore and IExportStore" as stores
end box
job -> replay : ReapplyAsync() at start and every hour
replay -> ledger : ReadAll()
ledger --> replay : Account ids and deletion times
replay -> db : Members by id
loop Each entry whose member is not deleted (a restored backup)
  replay -> deletion : ApplyAsync(member, original time): no e-mail to anyone
  deletion -> db : Delete again; audit record account.deletion-reapplied
end
loop Each deleted member missing from the ledger
  replay -> ledger : Record(member id, deleted at)
end
job -> erasure : EraseDueAsync()
erasure -> db : Members deleted 30 days ago or more, not yet erased
loop Each due member
  erasure -> db : "Former member" in conversations, messages, requests and reports; phone and delivery address cleared
  erasure -> db : Exports, notifications, consents, agreements, sessions, reset requests and queued e-mails removed
  erasure -> stores : Archives and the photos of the member's listings and products deleted
  erasure -> db : Member.Erase(now) and SaveChanges
end
erasure --> job : Count, logged as a count only
@enduml
