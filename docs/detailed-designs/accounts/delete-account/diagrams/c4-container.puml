@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Delete account


Person(member, "Member", "Deletes the account")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Account page and delete dialog")
  Container(api, "Jubilee API", "ASP.NET Core", "Deletion endpoints under /api/account")
  Container(worker, "Jubilee Worker", ".NET worker service", "Outbox dispatch and the daily erasure job")
  ContainerDb(db, "Jubilee database", "SQL Server", "Members and requests and listings and audit log")
  ContainerDb(cache, "Cache", "Redis", "Server-side sessions")
  ContainerDb(search, "Search index", "Query-time analysis over SQL Server", "Public listings and products")
}
System_Ext(email, "E-mail provider", "Transactional e-mail. Vendor <TO SUPPLY>")

Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "GET deletion-impact and POST deletion", "JSON/HTTPS")
Rel(api, db, "Closes the account in one transaction", "EF Core")
Rel(api, cache, "Ends every session", "Redis protocol")
Rel(worker, db, "Reads the outbox and erases after 30 days", "EF Core")
Rel(worker, search, "Removes the unpublished listing")
Rel(worker, email, "Sends the confirmation e-mail", "HTTPS")
@enduml
