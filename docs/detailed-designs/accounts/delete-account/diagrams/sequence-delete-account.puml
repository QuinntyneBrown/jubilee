@startuml
title UML sequence behaviour — Delete the account
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "DeleteAccountDialog" as dialog
  participant "AccountDataApi" as client
  participant "SessionService" as session
end box
box "Backend — Jubilee API" #D1FADF
  participant "AccountController" as controller
  participant "DeleteAccountCommandHandler" as handler
  participant "AccountDeletion" as deletion
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
  participant "IDeletionLedger" as ledger
end box
actor -> dialog : Press "Delete my account"
dialog -> client : deletionSummary()
client -> controller : GET /api/account/deletion-summary
controller --> client : Name, e-mail, conversations, open requests
dialog --> actor : Counts, "This can't be undone.", focus on "Keep my account"
actor -> dialog : Type DELETE and press "Delete account"
alt Not exactly DELETE
  dialog --> actor : "Type DELETE in capital letters to confirm." Nothing is sent
else DELETE
  dialog -> client : deleteAccount("DELETE")
  client -> controller : DELETE /api/account
  controller -> handler : Send DeleteAccountCommand with the caller's address
  handler -> db : Cancel each open request and queue the business e-mails
  handler -> deletion : ApplyAsync(member, now)
  deletion -> db : Listings, saved list, drafts, alerts, sessions ended, Member.Delete, audit record
  handler -> db : Confirmation e-mail in the outbox; SaveChanges in one unit of work
  alt Committed
    handler -> ledger : Record(member id, now)
    handler -> handler : Security event AccountDeletion succeeded (L2-143)
    controller --> client : 204, session cookie signed out
    dialog --> session : accountDeleted(): saved pages, queue and drafts cleared
    session --> actor : /welcome with "Your account was deleted"
  else Failed
    controller --> client : Error, nothing removed
    dialog --> actor : "We couldn't delete your account", or the dropped-connection copy; DELETE kept (L2-128)
  end
end
@enduml
