@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Delete account

class DeleteAccountCommandHandler {
  +Handle(command: DeleteAccountCommand): Task
}

class AccountDeletion <<static>> {
  +ApplyAsync(db, exports, member, now, ct): Task
}

class DeletionLedgerReplay {
  +ReapplyAsync(ct): Task<int>
}

class AccountErasure {
  +EraseDueAsync(ct): Task<int>
}

interface IDeletionLedger {
  +Record(entry: DeletedAccount, ct): Task
  +ReadAll(ct): Task<IReadOnlyList<DeletedAccount>>
}

class FileDeletionLedger {
  -string path
}

class DeletedAccount <<record>> {
  +Guid MemberId
  +DateTimeOffset DeletedAt
}

class Member {
  +Guid Id
  +DateTimeOffset? DeletedAt
  +DateTimeOffset? ErasedAt
  +Delete(now): void
  +Erase(now): void
}

class Request {
  +RequestStatus Status
  +Cancel(actor, now): void
  +ForgetMember(): void
}

class Listing {
  +string? OwnerId
  +DateTimeOffset? DeletedAt
  +Delete(now): void
}

class MemberSession {
  +string? Device
  +string? Network
  +End(now): void
}

class AuditRecord {
  +string Action
  +string TargetId
  +DateTimeOffset At
}

DeleteAccountCommandHandler ..> AccountDeletion : deletes with
DeleteAccountCommandHandler ..> IDeletionLedger : records
DeleteAccountCommandHandler --> Request : cancels open and tells the business
DeletionLedgerReplay ..> IDeletionLedger : reads and completes
DeletionLedgerReplay ..> AccountDeletion : deletes again with
AccountDeletion --> Member : Delete
AccountDeletion --> Request : cancels open
AccountDeletion --> Listing : Delete
AccountDeletion --> MemberSession : End
AccountDeletion --> AuditRecord : writes
AccountErasure --> Member : Erase
AccountErasure --> Request : ForgetMember
IDeletionLedger <|.. FileDeletionLedger
IDeletionLedger "1" o-- "*" DeletedAccount
@enduml
