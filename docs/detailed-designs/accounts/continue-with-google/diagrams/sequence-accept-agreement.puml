@startuml
title UML sequence behaviour — Accept the agreement after joining with Google
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "App" as guard
  participant "JoinAgreementPage" as page
  participant "AccountApi" as client
  participant "SessionService" as session
end box
box "Backend — Jubilee API" #D1FADF
  participant "CsrfMiddleware" as csrf
  participant "AccountController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "AcceptAgreementCommandHandler" as handler
  participant "Member" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box

actor -> guard : Open any route after joining with Google
guard -> session : Read agreementRequired
session --> guard : Agreement not accepted
guard --> actor : Navigate to /join/agreement with the return URL (L2-003)
actor -> page : Tick the agreement and press "Continue"
alt agreement not ticked
  page --> actor : Show "Agree to the statement of faith to join."
else agreement ticked
  page -> client : acceptAgreement()
  client -> csrf : POST /api/account/agreement with cookie __Host-jubilee.session
  csrf -> csrf : Check the anti-CSRF token (L2-135)
  csrf -> controller : Forward request
  controller -> handler : Send AcceptAgreementCommand
  handler -> db : Load member
  db --> handler : Member
  handler -> entity : AcceptAgreement(now, termsVersion)
  entity --> handler : Account usable
  handler -> db : Save changes in one unit of work
  db --> handler : Commit result
  handler --> controller : Done
  controller --> client : 204 No Content
  client --> page : Accepted
  page -> session : resolve()
  session --> page : Agreement accepted
  page --> actor : Navigate to the return URL or /
end
@enduml
