@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Continue with Google

Container_Boundary(web, "Jubilee Web") {
  Component(pages, "JoinPage and SignInPage", "Angular pages", "Offer the Google buttons when googleSignIn is true and word the ?error notice")
  Component(agree, "JoinAgreementPage", "Angular page", "Collects the statement-of-faith and terms agreement")
  Component(root, "App", "Angular root component", "Sends a member who has not agreed to /join/agreement")
  Component(client, "AccountApi", "Service contract behind ACCOUNT_API", "Posts the agreement")
  Component(session, "SessionService", "Angular service", "Holds the signed-in member - agreementRequired - googleSignIn")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "GoogleSignInController", "ASP.NET Core controller", "Start and callback endpoints - redirects for every outcome")
  Component(sessionctrl, "SessionController", "ASP.NET Core controller", "GET /api/session with googleSignIn and agreementRequired")
  Component(account, "AccountController", "ASP.NET Core controller", "POST /api/account/agreement")
  Component(gate, "AgreementRequiredMiddleware", "ASP.NET Core middleware", "Answers 403 AGREEMENT_REQUIRED until the agreement is accepted")
  Component(oidc, "IGoogleIdentityClient", "Infrastructure adapter", "IsConfigured - builds the authorization URL - exchanges the code - validates the ID token")
  Component(txn, "IOidcTransactionStore", "Infrastructure adapter", "Keeps state - nonce - code verifier - return URL - starting page")
  Component(handler, "CompleteGoogleSignInCommandHandler", "MediatR handler", "Signs in - links - creates the member - or refuses")
  Component(accept, "AcceptAgreementCommandHandler", "MediatR handler", "Records the agreement")
  Component(member, "Member", "Domain entity", "Owns the Google identity and the agreement")
  Component(tickets, "DatabaseTicketStore", "Session store", "Keeps the session behind the cookie __Host-jubilee.session")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Members - sessions")
ContainerDb(cache, "Cache", "Redis or in-process", "Pending sign-in transactions")
System_Ext(google, "Google Identity", "OpenID Connect provider")

Rel(pages, session, "Reads googleSignIn from")
Rel(session, sessionctrl, "GET /api/session", "JSON/HTTPS")
Rel(sessionctrl, oidc, "Reads IsConfigured from")
Rel(pages, ctrl, "Navigates to GET /api/auth/google/start", "HTTPS")
Rel(ctrl, pages, "Redirects back with ?error=google - google-email - google-cancelled", "HTTPS")
Rel(ctrl, txn, "Saves and consumes the transaction in")
Rel(txn, cache, "Stores")
Rel(ctrl, oidc, "Uses")
Rel(oidc, google, "Token request and signing keys", "HTTPS")
Rel(ctrl, handler, "Sends CompleteGoogleSignInCommand")
Rel(handler, member, "Creates or links")
Rel(handler, db, "Loads and saves", "EF Core")
Rel(ctrl, tickets, "Starts the session through SignInMemberAsync")
Rel(tickets, db, "Stores the session", "EF Core")
Rel(root, session, "Reads agreementRequired from")
Rel(root, agree, "Navigates to")
Rel(agree, client, "Submits through")
Rel(agree, session, "Reloads")
Rel(client, account, "POST /api/account/agreement", "JSON/HTTPS")
Rel(account, accept, "Sends AcceptAgreementCommand")
Rel(accept, member, "Calls AcceptAgreement on")
@enduml
