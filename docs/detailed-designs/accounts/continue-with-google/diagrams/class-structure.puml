@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Continue with Google

enum EmailStatus {
  Unconfirmed
  Confirmed
}

enum GoogleSignInOutcome {
  SignedIn
  Linked
  CreatedAwaitingAgreement
  EmailNotVerified
}

class Member {
  +Guid Id
  +string Email
  +string EmailKey
  +EmailStatus EmailStatus
  +string? GoogleSubject
  +string? PasswordHash
  +DateTimeOffset? AgreementAcceptedAt
  +{static} JoinWithGoogle(email: EmailAddress, firstName: string, lastName: string, googleSubject: string, now: DateTimeOffset): Member
  +LinkGoogle(googleSubject: string): void
  +AcceptAgreement(now: DateTimeOffset, termsVersion: int): void
  +IsUsable(): bool
}

class GoogleIdentity <<record>> {
  +string Subject
  +string Email
  +bool EmailVerified
  +string GivenName
  +string FamilyName
}

class OidcTransaction <<record>> {
  +string State
  +string Nonce
  +string CodeVerifier
  +string ReturnUrl
  +string From
}

class ReturnUrl <<static>> {
  +{static} Parse(value: string?): string
}

interface IOidcTransactionStore {
  +SaveAsync(transaction: OidcTransaction, cancellationToken: CancellationToken): Task
  +ConsumeAsync(state: string, cancellationToken: CancellationToken): Task<OidcTransaction?>
}

interface IGoogleIdentityClient {
  +bool IsConfigured
  +BuildAuthorizationUrl(redirectUri: string, state: string, nonce: string, codeChallenge: string): Uri
  +RedeemAsync(redirectUri: string, code: string, codeVerifier: string, nonce: string, cancellationToken: CancellationToken): Task<GoogleIdentity>
}

class CompleteGoogleSignInCommand <<record>> {
  +GoogleIdentity Identity
}

class GoogleSignInResult <<record>> {
  +GoogleSignInOutcome Outcome
  +Member? Member
}

class CompleteGoogleSignInCommandHandler {
  +Handle(request: CompleteGoogleSignInCommand, cancellationToken: CancellationToken): Task<GoogleSignInResult>
}

class AcceptAgreementCommand <<record>> {
  +Guid MemberId
}

class AcceptAgreementCommandHandler {
  +Handle(request: AcceptAgreementCommand, cancellationToken: CancellationToken): Task
}

class GoogleSignInController {
  +Start(returnUrl: string?, from: string?, cancellationToken: CancellationToken): Task<IActionResult>
  +Callback(code: string?, state: string?, error: string?, cancellationToken: CancellationToken): Task<IActionResult>
  -{static} Failure(transaction: OidcTransaction, error: string): string
  -RedirectUri(): string
}

class SessionDto <<record>> {
  +bool SignedIn
  +bool? AgreementRequired
  +bool GoogleSignIn
}

class SessionController {
  +Get(cancellationToken: CancellationToken): Task<SessionDto>
}

class AgreementRequiredMiddleware {
  +InvokeAsync(context: HttpContext, sender: ISender): Task
}

GoogleSignInController ..> IOidcTransactionStore : uses
GoogleSignInController ..> IGoogleIdentityClient : uses
GoogleSignInController ..> CompleteGoogleSignInCommand : sends
GoogleSignInController ..> ReturnUrl : parses with
IOidcTransactionStore --> OidcTransaction : stores
IGoogleIdentityClient ..> GoogleIdentity : returns
CompleteGoogleSignInCommand --> GoogleIdentity : carries
CompleteGoogleSignInCommandHandler ..> CompleteGoogleSignInCommand : handles
CompleteGoogleSignInCommandHandler --> Member : creates or links
CompleteGoogleSignInCommandHandler ..> GoogleSignInResult : returns
GoogleSignInResult --> GoogleSignInOutcome : has
AcceptAgreementCommandHandler ..> AcceptAgreementCommand : handles
AcceptAgreementCommandHandler --> Member : mutates
SessionController ..> IGoogleIdentityClient : reads IsConfigured
SessionController ..> SessionDto : returns
AgreementRequiredMiddleware ..> Member : reads the agreement of
Member --> EmailStatus : has
@enduml
