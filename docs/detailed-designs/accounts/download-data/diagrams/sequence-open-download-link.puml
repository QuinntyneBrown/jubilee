@startuml
title UML sequence behaviour — Open the download link
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "memberGuard" as guard
  participant "DataDownloadPage" as page
  participant "AccountDataApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AccountController" as controller
  participant "DownloadDataExportQueryHandler" as handler
  participant "DataExport" as export
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "IExportStore" as store
  database "Jubilee database" as db
end box
actor -> guard : Open the e-mailed link /account/data/{token}
alt Not signed in
  guard --> actor : Send to sign-in and return to the same link afterwards
else Signed in
  guard --> page : Activate
  page -> client : downloadDataExport(token)
  page -> page : Replace the address with /account/data
  client -> controller : GET /api/account/data-exports/{token}
  controller -> handler : Send DownloadDataExportQuery
  handler -> db : Load the DataExport by the token's SHA-256 hash
  db --> handler : DataExport or none
  handler -> export : IsDownloadableBy(session member, now)
  export --> handler : Allowed or refused
  alt Unknown, older than 7 days or another member's (L2-018 AC2)
    handler --> controller : Not found, logged as a security event (L2-133)
    controller --> client : 404 DATA_LINK_UNAVAILABLE
    page --> actor : "This link has expired or isn't yours"
  else Same member within 7 days
    handler -> store : Read(archive key)
    store --> handler : Archive
    controller --> client : 200 application/json attachment, no-store, no-referrer
    page --> actor : Save jubilee-data.json
  end
end
@enduml
