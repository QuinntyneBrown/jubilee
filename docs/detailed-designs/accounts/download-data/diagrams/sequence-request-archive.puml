@startuml
title UML sequence behaviour — Request and build the archive
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "AccountPage" as page
  participant "AccountDataApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AccountController" as controller
  participant "RequestDataExportCommandHandler" as handler
end box
box "Backend — Jubilee Worker" #ECFDF3
  participant "DataExportJob" as job
  participant "DataExportBuilder" as builder
  participant "DataArchive" as archive
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "IExportStore" as store
  database "Jubilee database" as db
end box
participant "E-mail provider" as email
actor -> page : Press "Download my data"
page -> client : requestDataExport()
client -> controller : POST /api/account/data-exports
controller -> handler : Send RequestDataExportCommand
handler -> db : The waiting export, or a new DataExport (Requested); 429 after 3 in 24 hours
db --> handler : Saved
handler --> controller : DataExportStatusDto
controller --> client : 202 Accepted
client --> page : requested
page --> actor : "We're preparing your data" (L2-018)
job -> builder : BuildDueAsync() every 10 seconds
builder -> db : Exports that are Requested and due
db --> builder : DataExport
builder -> archive : BuildAsync(member)
archive -> db : The member's own rows, section by section
db --> archive : Member data, and owner data for an owner
archive --> builder : JSON archive
alt Built
  builder -> store : Save(random key, archive)
  builder -> db : MarkReady(key, SHA-256 of a 256-bit token) and the link e-mail in the outbox (L2-140)
  db --> builder : Committed
else Failed (L2-182)
  builder -> db : RecordFailedAttempt: try again after 1, 2, 4, 8 minutes
  opt Fifth failure: the dead letter
    builder -> db : Status Failed and "Job alert: a data export failed" to the on-call contact, no personal data
  end
end
db -> email : OutboxDispatcherJob sends the link (and the alert)
email --> actor : "Your Jubilee data is ready to download", no unsubscribe link (L2-068 AC6)
@enduml
