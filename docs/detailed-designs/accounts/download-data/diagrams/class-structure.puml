@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Download data

enum DataExportStatus {
  Requested
  Ready
  Expired
  Failed
}

class DataExport {
  +Guid Id
  +Guid MemberId
  +DataExportStatus Status
  +DateTimeOffset RequestedAt
  +DateTimeOffset? ReadyAt
  +DateTimeOffset? ExpiresAt
  +int Attempts
  +DateTimeOffset? NextAttemptAt
  +string? TokenHash
  +string? ArchiveKey
  +{static} Request(memberId, now): DataExport
  +IsDue(now): bool
  +MarkReady(archiveKey, tokenHash, now): void
  +RecordFailedAttempt(now): bool
  +Expire(): void
  +IsDownloadableBy(memberId, now): bool
}

class Member {
  +Guid Id
  +string Email
  +DateTimeOffset? DeletedAt
}

class RequestDataExportCommandHandler {
  +Handle(command): Task<DataExportStatusDto>
}

class GetDataExportStatusQueryHandler {
  +Handle(query): Task<DataExportStatusDto>
}

class DownloadDataExportQueryHandler {
  +Handle(query): Task<string>
}

class DataExportBuilder {
  +BuildDueAsync(ct): Task<int>
  +ExpireAsync(ct): Task<int>
}

class DataArchive <<static>> {
  +BuildAsync(db, member, now, ct): Task<string>
}

interface IExportStore {
  +Save(key, archive, ct): Task
  +Read(key, ct): Task<string?>
  +Delete(key, ct): Task
}

class FileExportStore {
  -string root
}

class SecuritySettings {
  +string? OnCallEmail
}

RequestDataExportCommandHandler --> DataExport : creates
GetDataExportStatusQueryHandler --> DataExport : reads latest
DownloadDataExportQueryHandler --> DataExport : finds by token hash
DownloadDataExportQueryHandler ..> IExportStore : reads
DataExportBuilder --> DataExport : marks ready or failed
DataExportBuilder ..> DataArchive : builds with
DataExportBuilder ..> IExportStore : saves and deletes
DataExportBuilder ..> SecuritySettings : alerts on-call
IExportStore <|.. FileExportStore
Member "1" --> "*" DataExport : requests
DataExport --> DataExportStatus : has
@enduml
