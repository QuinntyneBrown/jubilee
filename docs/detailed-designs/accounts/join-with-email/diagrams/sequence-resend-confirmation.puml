@startuml
title UML sequence behaviour — Send the confirmation e-mail again
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "JoinPage" as page
  participant "AccountApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ASP.NET Core rate limiter" as limit
  participant "CsrfMiddleware" as csrf
  participant "AccountController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ResendConfirmationCommandHandler" as handler
  participant "AccountEmails" as emails
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as job
end box
participant "E-mail provider" as email

actor -> page : Press "Send it again"
page -> client : resendConfirmation()
client -> limit : POST /api/account/confirmation/resend with cookie __Host-jubilee.session
limit -> limit : Count the request for the member under AccountRateLimit.Resends (L2-137)
alt more than 5 resends and changes of address in the hour
  limit --> client : 429 with Retry-After
  client --> page : Rate-limit error
  page --> actor : Show "We couldn’t send it. Try again in a moment."
else within the limit
  limit -> csrf : Forward request
  csrf -> csrf : Check the anti-CSRF token (L2-135)
  csrf -> controller : Forward request
  controller -> handler : Send ResendConfirmationCommand
  handler -> db : Load member
  db --> handler : Unconfirmed member
  handler -> emails : QueueConfirmationAsync(member)
  emails -> db : Load outstanding confirmation tokens
  db --> emails : Tokens
  emails -> emails : Supersede each earlier token (L2-001)
  emails -> emails : LinkTokens.NewValue and LinkTokens.Hash - LinkToken for 24 hours (L2-140)
  emails --> handler : LinkToken and OutboxMessage added
  handler -> db : Save token hash and outbox message in one unit of work
  db --> handler : Commit result
  handler --> controller : Done
  controller --> client : 202 Accepted
  client --> page : Resent
  page --> actor : Show "We sent a new link to {address}."
  job -> db : Read due outbox messages through OutboxDispatcher
  db --> job : Confirmation e-mail
  job -> email : Send confirmation e-mail with the new link through IEmailSender
  email --> job : Accepted
end
@enduml
