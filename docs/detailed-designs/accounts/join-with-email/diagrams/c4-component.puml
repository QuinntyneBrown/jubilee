@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Join with e-mail

Container_Boundary(web, "Jubilee Web") {
  Component(page, "JoinPage", "Angular page", "Join form - success state - resend action")
  Component(summary, "FormSummary", "jb-form-summary component", "Lists every invalid field as a link")
  Component(client, "AccountApi", "Service contract behind ACCOUNT_API", "Calls the account endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(limit, "AccountRateLimit.Joins", "ASP.NET Core rate limiter policy", "5 joins per IP address per hour")
  Component(ctrl, "AccountController", "ASP.NET Core controller", "Exposes /api/account endpoints and starts the session")
  Component(errors, "ExceptionHandlingMiddleware", "ASP.NET Core middleware", "Maps ValidationFailedException to 422 with field codes")
  Component(botcheck, "IBotChallengeVerifier", "Application service", "Verifies the challenge token")
  Component(handler, "JoinWithEmailCommandHandler", "MediatR handler", "Validates the command and creates the member")
  Component(emails, "AccountEmails", "Application service", "Issues the confirmation link token and queues the e-mail")
  Component(member, "Member", "Domain entity", "Owns e-mail status and credentials")
  Component(hasher, "IPasswordHasher", "Application service", "Argon2id hashing")
  Component(breaches, "IBreachedPasswordChecker", "Application service", "Checks the password against a breached-password list")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(job, "OutboxDispatcherJob", "Hosted job", "Sends queued e-mail through OutboxDispatcher")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Members - link tokens - outbox - sessions")
System_Ext(bot, "Bot challenge provider", "Verifies challenge tokens")
System_Ext(breach, "Breached-password service", "k-anonymity range query")
System_Ext(email, "E-mail provider", "Delivers e-mail")

Rel(page, summary, "Shows field errors in")
Rel(page, client, "Submits the form through")
Rel(client, limit, "POST /api/account/join", "JSON/HTTPS")
Rel(limit, ctrl, "Passes allowed requests to")
Rel(ctrl, botcheck, "Verifies challenge token with")
Rel(botcheck, bot, "Verifies challenge token", "HTTPS")
Rel(ctrl, handler, "Sends JoinWithEmailCommand")
Rel(handler, errors, "Throws ValidationFailedException to")
Rel(handler, breaches, "Checks password with")
Rel(breaches, breach, "Range query", "HTTPS")
Rel(handler, member, "Creates")
Rel(handler, hasher, "Hashes password with")
Rel(handler, emails, "Queues the confirmation e-mail with")
Rel(handler, db, "Saves member - token hash - outbox message", "EF Core")
Rel(ctrl, db, "Stores the session", "EF Core")
Rel(job, db, "Reads outbox")
Rel(job, email, "Sends confirmation e-mail")
@enduml
