@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Join with e-mail

enum EmailStatus {
  Unconfirmed
  Confirmed
}

enum LinkTokenPurpose {
  EmailConfirmation
  PasswordReset
  ChangeEmail
}

class EmailAddress <<record>> {
  +string Value
  +string Key
  +{static} TryParse(raw: string?): EmailAddress?
}

class Member {
  +Guid Id
  +string Email
  +string EmailKey
  +string FirstName
  +string LastName
  +EmailStatus EmailStatus
  +string? PasswordHash
  +string? HomeChurch
  +string? HomeChurchAddress
  +DateTimeOffset? AgreementAcceptedAt
  +DateTimeOffset CreatedAt
  +{static} Join(email: EmailAddress, firstName: string, lastName: string, homeChurch: string?, passwordHash: string, now: DateTimeOffset, termsVersion: int, homeChurchAddress: string?): Member
}

class LinkToken {
  +Guid Id
  +Guid MemberId
  +LinkTokenPurpose Purpose
  +string TokenHash
  +DateTimeOffset ExpiresAt
  +DateTimeOffset? UsedAt
  +DateTimeOffset? SupersededAt
  +{static} Issue(memberId: Guid, purpose: LinkTokenPurpose, tokenHash: string, now: DateTimeOffset, lifetime: TimeSpan): LinkToken
  +Supersede(now: DateTimeOffset): void
}

class LinkTokens <<static>> {
  +{static} NewValue(): string
  +{static} Hash(value: string): string
}

class OutboxMessage {
  +string ToAddress
  +string Subject
  +string TextBody
  +{static} Email(...): OutboxMessage
}

class AccountEmails {
  +QueueConfirmationAsync(member: Member, cancellationToken: CancellationToken): Task
  +QueueAddressInUseNotice(holder: Member): void
}

class JoinWithEmailCommand <<record>> {
  +string? FirstName
  +string? LastName
  +string? Email
  +string? Password
  +string? HomeChurch
  +string? HomeChurchAddress
  +bool AgreementAccepted
}

class JoinWithEmailCommandHandler {
  +Handle(request: JoinWithEmailCommand, cancellationToken: CancellationToken): Task<Member>
}

class ResendConfirmationCommand <<record>> {
  +Guid MemberId
}

class ResendConfirmationCommandHandler {
  +Handle(request: ResendConfirmationCommand, cancellationToken: CancellationToken): Task
}

class ValidationFailedException {
  +IReadOnlyDictionary<string, string> Errors
}

interface IPasswordHasher {
  +Hash(password: string): string
  +Verify(hash: string, password: string): bool
}

interface IBreachedPasswordChecker {
  +IsBreachedAsync(password: string, cancellationToken: CancellationToken): Task<bool>
}

interface IBotChallengeVerifier {
  +VerifyAsync(token: string?, remoteIp: string?, cancellationToken: CancellationToken): Task<bool>
}

class AccountController {
  +Join(request: JoinRequest, cancellationToken: CancellationToken): Task<ActionResult<JoinResponse>>
  +ResendConfirmation(cancellationToken: CancellationToken): Task<IActionResult>
}

Member --> EmailStatus : has
Member ..> EmailAddress : created from
Member "1" --> "*" LinkToken : receives
LinkToken --> LinkTokenPurpose : has
AccountController ..> IBotChallengeVerifier : uses
AccountController ..> JoinWithEmailCommand : sends
AccountController ..> ResendConfirmationCommand : sends
JoinWithEmailCommandHandler ..> JoinWithEmailCommand : handles
JoinWithEmailCommandHandler ..> IBreachedPasswordChecker : uses
JoinWithEmailCommandHandler ..> IPasswordHasher : uses
JoinWithEmailCommandHandler ..> AccountEmails : uses
JoinWithEmailCommandHandler ..> ValidationFailedException : throws
JoinWithEmailCommandHandler --> Member : creates
ResendConfirmationCommandHandler ..> ResendConfirmationCommand : handles
ResendConfirmationCommandHandler ..> AccountEmails : uses
AccountEmails ..> LinkTokens : uses
AccountEmails --> LinkToken : issues and supersedes
AccountEmails --> OutboxMessage : queues
@enduml
