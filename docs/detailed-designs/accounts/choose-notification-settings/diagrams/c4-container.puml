@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Choose notification settings

Person(member, "Member", "Chooses which e-mails to get and how often")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Notification settings page")
  Container(api, "Jubilee API", "ASP.NET Core", "Notification preference endpoints; queues e-mail by the settings")
  Container(worker, "Jubilee Worker", ".NET worker service", "Sends the outbox and the daily summary")
  ContainerDb(db, "Jubilee database", "SQL Server", "Members with their switches, OutboxMessages, ConsentRecords, JobRuns")
}
System_Ext(email, "E-mail provider", "Azure Communication Services Email")

Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "GET and PATCH /api/account/notification-preferences", "JSON/HTTPS")
Rel(api, db, "Reads and writes the settings and adds outbox rows", "EF Core")
Rel(worker, db, "Reads the settings and due rows and held rows", "EF Core")
Rel(worker, email, "Sends e-mail through", "HTTPS")
Rel(email, member, "Delivers e-mail to", "SMTP")
@enduml
