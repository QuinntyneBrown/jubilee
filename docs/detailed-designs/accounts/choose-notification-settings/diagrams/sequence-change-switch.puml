@startuml
title UML sequence behaviour — Change one switch
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Frontend — Jubilee Web" #E0F2FE
  participant "NotificationSettingsPage" as page
  participant "HttpProfileApi" as client
  participant "ToastService" as toasts
end box
box "Backend — Jubilee API" #D1FADF
  participant "AccountController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "UpdateNotificationPreferenceCommandHandler" as handler
  participant "Consent" as consent
  participant "Member" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
member -> page : Turn "New messages" off
page -> page : Apply the change and add the row to waiting
page --> member : Row shows "Saving…", the other rows stay usable (L2-016 AC2)
page -> client : setSwitch("messages", false)
client -> controller : PATCH /api/account/notification-preferences { setting, enabled }
controller -> controller : Take the member from the session (L2-133)
controller -> handler : Send UpdateNotificationPreferenceCommand
handler -> db : Load the member
db --> handler : Member
alt setting is frequency
  handler -> entity : SetEmailFrequency(dailySummary)
else setting is a switch
  handler -> consent : TrySet(member, category, enabled, SettingsSwitch)
  consent -> entity : SetEmailPreference(category, enabled)
  opt a promotional category changed
    consent -> db : Add ConsentRecord with time and method (L2-149)
  end
end
handler -> db : Save changes
alt saved
  db --> handler : Commit result
  controller --> client : 200 OK with the settings as they now are
  client --> page : NotificationPreferences
  page --> member : "Saved at {time}"
else the save fails
  controller --> client : 503 with JB-PREF-503
  client --> page : Error
  page -> page : Return the switch to its previous position (L2-016 AC3)
  page -> toasts : show(danger toast with "Try again")
  toasts --> member : "We couldn't save "New messages"" with "Try again"
end
@enduml
