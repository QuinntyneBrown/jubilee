@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Choose notification settings

Container_Boundary(web, "Jubilee Web") {
  Component(page, "NotificationSettingsPage", "Angular page", "Five switches and How often; saves each change alone")
  Component(sw, "Switch", "jb component", "One switch row")
  Component(client, "HttpProfileApi", "PROFILE_API", "getPreferences and setSwitch and setFrequency")
  Component(toasts, "ToastService", "Angular service", "Error toast with Try again")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "AccountController", "ASP.NET Core controller", "GET and PATCH /api/account/notification-preferences")
  Component(get, "GetNotificationPreferencesQueryHandler", "MediatR handler", "Returns the five switches and the frequency")
  Component(update, "UpdateNotificationPreferenceCommandHandler", "MediatR handler", "Changes one setting")
  Component(consent, "Consent", "Static rule", "Switches a category and records promotional consent")
  Component(policy, "EmailPolicy", "Static policy", "Queues or holds or drops an e-mail by the settings")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(outbox, "OutboxDispatcherJob", "Hosted job", "Sends due rows every 10 seconds and skips held rows")
  Component(sumjob, "DailySummaryJob", "Hosted job", "Ticks every 5 minutes")
  Component(sum, "SendDailySummariesCommandHandler", "MediatR handler", "One summary per member after 7:00 a.m. Toronto")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Members and OutboxMessages")

Rel(page, sw, "Renders five")
Rel(page, client, "Loads and saves through")
Rel(page, toasts, "Shows a failed save through")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, get, "Sends GetNotificationPreferencesQuery")
Rel(ctrl, update, "Sends UpdateNotificationPreferenceCommand")
Rel(update, consent, "Calls TrySet")
Rel(get, db, "Reads the member", "EF Core")
Rel(update, db, "Saves the member", "EF Core")
Rel(policy, db, "Reads the switches and adds OutboxMessage", "EF Core")
Rel(outbox, db, "Reads due rows", "EF Core")
Rel(sumjob, sum, "Sends SendDailySummariesCommand")
Rel(sum, db, "Replaces held rows by one summary row", "EF Core")
@enduml
