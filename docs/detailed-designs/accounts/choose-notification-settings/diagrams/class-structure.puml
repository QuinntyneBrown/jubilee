@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Choose notification settings

class NotificationSettingsPage <<Angular page>> {
  #state: Signal<LoadState<NotificationPreferences>>
  #waiting: Signal<ReadonlySet<string>>
  #status: Signal<idle | saving | saved>
  #load(): void
  #toggle(row, enabled: boolean): void
  #setFrequency(frequency: PreferenceFrequency): void
}
interface ProfileApi {
  +getPreferences(): Observable<NotificationPreferences>
  +setSwitch(setting, enabled): Observable<NotificationPreferences>
  +setFrequency(frequency): Observable<NotificationPreferences>
}
class AccountController {
  +GetPreferences(): Task<NotificationPreferencesDto>
  +SetPreference(body: PreferenceBody): Task<NotificationPreferencesDto>
}
class PreferenceBody <<record>> {
  +string? Setting
  +bool? Enabled
  +string? Frequency
}
class NotificationPreferencesDto <<record>> {
  +bool Messages
  +bool Requests
  +bool Reminders
  +bool NewBusinesses
  +bool Tips
  +string Frequency
}
class UpdateNotificationPreferenceCommand <<record>> {
  +Guid MemberId
  +string? Setting
  +bool? Enabled
  +string? Frequency
}
class UpdateNotificationPreferenceCommandHandler {
  +Handle(command): Task
}
class NotificationFrequencies <<static>> {
  +AsItHappens = "as-it-happens"
  +DailySummary = "daily-summary"
}
class Consent <<static>> {
  +{static} TrySet(db, member, category, on, method, now): bool
}
class Member {
  +bool EmailMessages = true
  +bool EmailRequests = true
  +bool EmailReminders = true
  +bool EmailNewBusinesses = false
  +bool EmailTips = false
  +bool EmailDailySummary = false
  +EmailPreference(category): bool?
  +SetEmailPreference(category, on): bool
  +SetEmailFrequency(dailySummary: bool): void
  +WantsEmail(category): bool
}
class EmailPolicy <<static>> {
  +{static} Queue(db, member, category, subject, body, now, notBefore, correlationId): bool
}
class OutboxMessage {
  +string? Category
  +bool HeldForSummary
  +IsDue(now): bool
}
class SendDailySummariesCommandHandler {
  +Handle(command): Task<int?>
}

NotificationSettingsPage ..> ProfileApi : loads and saves through
ProfileApi ..> AccountController : calls over HTTPS
AccountController ..> PreferenceBody : receives
AccountController ..> NotificationPreferencesDto : returns
AccountController ..> UpdateNotificationPreferenceCommand : sends
UpdateNotificationPreferenceCommandHandler ..> UpdateNotificationPreferenceCommand : handles
UpdateNotificationPreferenceCommandHandler ..> Consent : TrySet for a switch
UpdateNotificationPreferenceCommandHandler ..> Member : SetEmailFrequency
UpdateNotificationPreferenceCommandHandler ..> NotificationFrequencies : validates
Consent ..> Member : SetEmailPreference
EmailPolicy ..> Member : WantsEmail and EmailDailySummary
EmailPolicy "1" --> "*" OutboxMessage : adds
SendDailySummariesCommandHandler "1" --> "*" OutboxMessage : replaces held rows
@enduml
