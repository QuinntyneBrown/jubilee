@startuml
title UML sequence behaviour — Deliver e-mail by the settings
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
box "Backend — Jubilee API" #D1FADF
  participant "Command handler" as handler
  participant "EmailPolicy" as policy
end box
box "Backend — Jubilee Worker" #ECFDF3
  participant "OutboxDispatcherJob" as outbox
  participant "DailySummaryJob" as sumjob
  participant "SendDailySummariesCommandHandler" as sum
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
participant "E-mail provider" as provider
handler -> policy : Queue(member, category, subject, body)
alt security or transactional e-mail
  handler -> db : Add OutboxMessage without a category, whatever the switches (L2-016 AC4)
else category off or address bounced
  policy --> handler : false, no e-mail; the notification is still created (L2-068 AC2)
else "One daily summary" and category messages or requests
  policy -> db : Add OutboxMessage with HeldForSummary (L2-016 AC6)
else every other case, meeting reminders included
  policy -> db : Add OutboxMessage
end
loop every 10 seconds
  outbox -> db : Select due rows, a held row is not due
  db --> outbox : Rows
  outbox -> provider : Send each e-mail
  provider --> member : E-mail
end
loop every 5 minutes
  sumjob -> sum : Send SendDailySummariesCommand
  opt after 7:00 a.m. America/Toronto and not yet run today (L2-182)
    sum -> db : Select held rows by member
    db --> sum : Held rows
    sum -> db : Remove the held rows and add one summary row per member
    note right of sum : A row whose category is off since is left out;\na member with no line gets no e-mail (L2-016 AC7)
  end
end
outbox -> provider : Send "Your Jubilee summary for {day}" at the next pass
provider --> member : At most one summary a day
@enduml
