@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View welcome page


Person(visitor, "Visitor", "Anyone not signed in")
Container_Boundary(web, "Jubilee Web") {
  Component(guard, "welcomeRedirectGuard", "Angular route guard", "Sends a signed-in member to /")
  Component(page, "WelcomePage", "Angular page", "Hero and categories and steps and featured and owner panel")
  Component(card, "BusinessCard", "Angular component", "One featured business")
  Component(client, "DirectoryApi", "Contract behind DIRECTORY_API", "getWelcome")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "DirectoryController", "ASP.NET Core controller", "GET /api/directory/welcome for anonymous callers")
  Component(handler, "GetWelcomeQueryHandler", "MediatR handler", "Builds the WelcomeDto")
  Component(readCache, "IDirectoryReadCache", "Application service", "60 s read cache")
  Component(filter, "PublicListingFilter", "Query filter", "Live listings that are not paused or deleted or held")
  Component(selector, "FeaturedSelector", "Domain service", "Current featured slots or most recently published")
  Component(invalidator, "DirectoryCacheInvalidationInterceptor", "EF Core SaveChangesInterceptor", "Removes cached directory entries after a save")
}
ContainerDb(cache, "Cache", "IDistributedCache: memory or Redis", "Read cache")
ContainerDb(db, "Jubilee database", "SQL Server", "Listing and Category and FeaturedSlot")

Rel(visitor, guard, "Opens /welcome")
Rel(guard, page, "Activates for a visitor")
Rel(page, card, "Renders up to 4")
Rel(page, client, "Loads")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, handler, "Sends GetWelcomeQuery")
Rel(handler, readCache, "Gets or sets")
Rel(handler, filter, "Counts with")
Rel(handler, selector, "Selects 4 with")
Rel(readCache, cache, "Stores")
Rel(filter, db, "Queries", "EF Core")
Rel(selector, db, "Queries", "EF Core")
Rel(invalidator, readCache, "Invalidates after a Listing, Product, Service or FeaturedSlot is saved")
@enduml
