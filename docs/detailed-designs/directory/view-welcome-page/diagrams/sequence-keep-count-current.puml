@startuml
title UML sequence behaviour — Keep the count current
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}


actor "Owner" as actor
box "Backend — Jubilee API" #D1FADF
  participant "MyBusinessController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "PauseListingCommandHandler" as handler
  participant "GetWelcomeQueryHandler" as welcome
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "DirectoryCacheInvalidationInterceptor" as invalidator
  participant "IDirectoryReadCache" as cache
  database "Jubilee database" as db
end box
actor -> controller : Pause the listing (POST /api/my-business/pause)
controller -> handler : Send PauseListingCommand
handler -> db : Save the paused listing through AppDbContext
db -> invalidator : SavedChangesAsync: a Listing changed
invalidator -> cache : InvalidateAsync replaces the cache version
cache --> invalidator : Every directory entry is orphaned
db --> handler : Commit result
handler --> controller : Paused
controller --> actor : 200 OK
== Next request for /welcome ==
welcome -> cache : GetOrCreateAsync("welcome")
cache --> welcome : Miss
welcome -> db : Count listings through PublicListingFilter (L2-028)
db --> welcome : Count without the paused listing
welcome -> cache : Store the welcome entry for 60 s
cache --> welcome : Stored. The count matches the directory within 5 minutes (L2-020)
@enduml
