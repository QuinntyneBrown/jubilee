@startuml
title UML sequence behaviour — Visitor presses a personal action
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}


actor "Visitor" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "BrowseHomePage" as page
  participant "BusinessPage" as business
  participant "SignInRequiredDialog" as dialog
  participant "SessionService" as session
end box
box "Backend — Jubilee API" #D1FADF
  participant "SavedController" as controller
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Open a business card or a directory row
page --> business : Navigate to /b/:slug
actor -> business : Press "Save"
business -> session : Read the signed-in state
session --> business : Not signed in
business -> dialog : Open with the save action and the current path (L2-022)
dialog --> actor : Offer "Sign in" and "Join free"
alt Visitor closes the dialog
  actor -> dialog : Escape
  dialog --> business : Closed and focus returns to "Save"
else Visitor signs in or joins
  actor -> dialog : Choose "Sign in"
  dialog -> session : Start sign-in with a same-origin return path (L2-012)
  session --> business : Signed in and returned to /b/:slug
  business -> controller : PUT /api/saved/businesses/{slug}
  controller -> db : Save the item for the member
  db --> controller : Commit result
  controller --> business : Saved
  business --> actor : Show the business as saved
end
@enduml
