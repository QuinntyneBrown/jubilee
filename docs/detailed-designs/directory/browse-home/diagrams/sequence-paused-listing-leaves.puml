@startuml
title UML sequence behaviour — Paused listing leaves the directory
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}


actor "Owner" as actor
box "Backend — Jubilee API" #D1FADF
  participant "ListingsController" as controller
  participant "DirectoryController" as directory
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "Listing" as entity
  participant "GetBrowseHomeQueryHandler" as handler
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "DirectoryCacheInvalidator" as invalidator
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "IDirectoryReadCache" as cache
  database "Jubilee database" as db
end box
actor -> controller : Confirm "Pause listing"
controller -> entity : Pause
entity --> controller : Stage paused. IsPublic is false
controller -> db : Save the listing and a ListingVisibilityChanged outbox message in one unit of work
db --> controller : Commit result
controller --> actor : 200 OK
invalidator -> db : Read the outbox message
db --> invalidator : ListingVisibilityChanged
invalidator -> cache : Remove the directory entries
cache --> invalidator : Removed
invalidator -> db : Mark the message dispatched
db --> invalidator : Commit result
== Next request for / (at most 60 s after the pause) ==
directory -> handler : Send GetBrowseHomeQuery
handler -> cache : Get the directory entry
cache --> handler : Miss or entry expired after 60 s
handler -> db : Load public listings through PublicListingFilter (L2-028)
db --> handler : Listings without the paused one
handler -> cache : Set the directory entry for 60 s
cache --> handler : Stored
handler --> directory : BrowseHomeDto with updated counts and groups
@enduml
