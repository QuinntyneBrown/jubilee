@startuml
title UML sequence behaviour — Paused listing leaves the directory
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}


actor "Owner" as actor
box "Backend — Jubilee API" #D1FADF
  participant "MyBusinessController" as controller
  participant "DirectoryController" as directory
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "PauseListingCommandHandler" as pause
  participant "Listing" as entity
  participant "GetBrowseHomeQueryHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "DirectoryCacheInvalidationInterceptor" as invalidator
  participant "IDirectoryReadCache" as cache
  database "Jubilee database" as db
end box
actor -> controller : Confirm "Pause listing" (POST /api/my-business/pause)
controller -> pause : Send PauseListingCommand
pause -> entity : Pause
entity --> pause : Paused. IsPublic is false
pause -> db : Save the listing through AppDbContext
db -> invalidator : SavedChangesAsync: a Listing changed
invalidator -> cache : InvalidateAsync replaces the cache version (L2-156)
cache --> invalidator : Every directory entry is orphaned
db --> pause : Commit result
pause --> controller : PauseResultDto
controller --> actor : 200 OK
== Next request for / ==
directory -> handler : Send GetBrowseHomeQuery
handler -> cache : GetOrCreateAsync("home")
cache --> handler : Miss
handler -> db : Load public listings through PublicListingFilter (L2-028)
db --> handler : Listings without the paused one
handler -> cache : Store the directory entry for 60 s
cache --> handler : Stored
handler --> directory : BrowseHomeDto with updated counts and groups
== A copy held by another process, a CDN or a browser ==
directory -> handler : Send GetBrowseHomeQuery
handler -> cache : GetOrCreateAsync("home")
cache --> handler : Entry expired after 60 s, so it is rebuilt (L2-028)
@enduml
