@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Browse home


Person(visitor, "Visitor", "Browses without an account")
Person(member, "Member", "Browses signed in")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Browse home at /")
  Container(api, "Jubilee API", "ASP.NET Core", "GET /api/directory/home")
  Container(worker, "Jubilee Worker", ".NET worker service", "Outbox dispatch and cache invalidation")
  ContainerDb(cache, "Cache", "Redis", "Directory response for 60 s")
  ContainerDb(db, "Jubilee database", "SQL Server", "Listings and products and categories and featured slots")
  Container(media, "Media storage", "Object storage + CDN", "Cover and product photos")
}
Rel(visitor, web, "Uses", "HTTPS")
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Requests the directory", "JSON/HTTPS")
Rel(web, media, "Loads photos", "HTTPS")
Rel(api, cache, "Reads and writes the cached response", "Redis protocol")
Rel(api, db, "Queries public listings", "EF Core")
Rel(worker, db, "Reads the outbox", "EF Core")
Rel(worker, cache, "Removes the entry on a listing change", "Redis protocol")
@enduml
