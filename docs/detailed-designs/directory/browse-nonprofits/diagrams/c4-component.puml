@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components: Browse non-profits

Container_Boundary(web, "Jubilee Web") {
  Component(browse, "BrowsePage", "Angular page", "Chips ending with Non-profits; shelf Non-profits in Toronto")
  Component(category, "CategoryPage", "Angular page", "Non-profits with Sort and no filters")
  Component(search, "SearchPage", "Angular page", "Non-profits tab only when nonprofitCount > 0")
  Component(card, "jb-business-card", "Library component", "Tile or cover, Non-profit, name, line, highlight; no rating")
  Component(tile, "categoryTile", "Library helper", "non-profits: hands icon, label Non-profit")
  Component(client, "DirectoryApi and SearchApi", "Typed HTTP clients", "Call the directory and search endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(dirctrl, "DirectoryController and CategoriesController", "ASP.NET Core controllers", "Anonymous directory reads")
  Component(searchctrl, "SearchController", "ASP.NET Core controller", "Anonymous search")
  Component(home, "GetBrowseHomeQueryHandler", "MediatR handler", "Business groups and BrowseHomeDto.Nonprofits")
  Component(spec, "WhereBusiness and WhereNonprofit", "Domain specifications", "Businesses never include non-profits")
  Component(cat, "GetCategoryListingsQueryHandler", "MediatR handler", "Ignores offers and areas for non-profits")
  Component(find, "SearchDirectoryQueryHandler", "MediatR handler", "Asks ISearchIndex, falls back to DatabaseNameSearch")
  Component(index, "DatabaseSearchIndex", "ISearchIndex", "Matches name, line, Mission, Serves, Area; hits of kind nonprofit")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Listings")

Rel(browse, card, "Renders the shelf with")
Rel(category, card, "Renders")
Rel(card, tile, "Reads the tile from")
Rel(browse, client, "Loads the home")
Rel(category, client, "Loads the category with sort and page")
Rel(search, client, "Searches")
Rel(client, dirctrl, "GET /api/directory/home, GET /api/categories/non-profits/listings", "JSON/HTTPS")
Rel(client, searchctrl, "GET /api/search?q=", "JSON/HTTPS")
Rel(dirctrl, home, "Sends GetBrowseHomeQuery")
Rel(dirctrl, cat, "Sends GetCategoryListingsQuery")
Rel(searchctrl, find, "Sends SearchDirectoryQuery")
Rel(home, spec, "Counts and groups with")
Rel(find, index, "SearchAsync")
Rel(home, db, "Reads", "EF Core")
Rel(cat, db, "Reads", "EF Core")
Rel(index, db, "Reads", "EF Core")
@enduml
