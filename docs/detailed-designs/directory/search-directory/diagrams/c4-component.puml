@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Search the directory

Container_Boundary(web, "Jubilee Web") {
  Component(box, "SearchField", "Angular component", "Query input in the top bar and the browse hero and the search page")
  Component(page, "SearchPage", "Angular page", "Results and no-results and empty states of /search")
  Component(highlight, "MatchExplanation", "Angular component", "Renders the match text with mark elements from ranges")
  Component(store, "SearchStore", "Angular service", "Holds the state of the page")
  Component(client, "SearchApi", "Typed HTTP client", "Calls the search endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(limit, "SearchRateLimit", "ASP.NET Core rate limiter policy", "Allows 60 searches a minute per IP address")
  Component(ctrl, "SearchController", "ASP.NET Core controller", "Exposes /api/search and /api/search/start and /api/search/recent")
  Component(handler, "SearchDirectoryQueryHandler", "MediatR handler", "Normalises the query and searches and records it")
  Component(text, "SearchQueryText", "Value object", "Trims and truncates to 100 characters")
  Component(isearch, "DatabaseSearchIndex", "ISearchIndex in Infrastructure", "Analyses the public listings at query time")
  Component(analyzer, "SearchAnalyzer", "Application service", "Folds case and accents and stems words")
  Component(fallback, "DatabaseNameSearch", "Application service", "Name search used when the index fails")
  Component(start, "SearchStartBuilder", "Application service", "Builds recent searches and popular categories")
  Component(recent, "Recent search handlers", "MediatR handlers", "Remove one recent search or clear them all")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Listing and Service and Product and RecentSearch rows")

Rel(box, page, "Navigates to /search?q=")
Rel(page, highlight, "Renders results with")
Rel(page, store, "Reads its state from")
Rel(store, client, "Loads through")
Rel(client, limit, "Calls", "JSON/HTTPS")
Rel(limit, ctrl, "Passes allowed requests to")
Rel(ctrl, handler, "Sends SearchDirectoryQuery")
Rel(ctrl, recent, "Deletes through")
Rel(ctrl, start, "Builds the empty search page through")
Rel(handler, text, "Normalises with")
Rel(handler, isearch, "Searches through")
Rel(handler, fallback, "Falls back to")
Rel(handler, start, "Answers an empty query through")
Rel(handler, db, "Records the query of a member in", "EF Core")
Rel(isearch, analyzer, "Analyses text with")
Rel(isearch, db, "Reads public listings and services and products from", "EF Core")
Rel(start, db, "Reads", "EF Core")
Rel(fallback, db, "Queries", "EF Core")
Rel(recent, db, "Reads and writes", "EF Core")
@enduml
