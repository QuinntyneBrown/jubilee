@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Search the directory

enum SearchResultKind {
  Business
  Service
  Product
}

class SearchQueryText {
  +{static} int MaxLength = 100
  +string Value
  +bool IsEmpty
  +{static} From(raw: string?): SearchQueryText
}

class SearchDirectoryQuery {
  +string? Raw
  +Viewer Viewer
}

class SearchDirectoryQueryHandler {
  +Handle(request: SearchDirectoryQuery): Task<SearchAnswer>
}

class SearchAnswer {
  +SearchResults? Results
  +SearchStartDto? Start
}

interface ISearchIndex {
  +SearchAsync(query: string): Task<SearchResults>
}

class DatabaseSearchIndex {
  +SearchAsync(query: string): Task<SearchResults>
}

class SearchAnalyzer <<static>> {
  +Fold(text: string): string
  +Stem(foldedWord: string): string
  +QueryStems(query: string): List<string>
  +Matches(text: string?, queryStems: IReadOnlyList<string>): bool
  +Distance(a: string, b: string): int
}

class DatabaseNameSearch {
  +SearchAsync(query: string): Task<SearchResults>
}

class SearchResults {
  +string Query
  +int BusinessCount
  +int ServiceCount
  +int ProductCount
  +bool HasMatchExplanations
  +IReadOnlyList<SearchHit> Hits
  +SearchSuggestion? Suggestion
}

class SearchHit {
  +string Kind
  +string Name
  +string Slug
  +string? ProductSlug
  +string BusinessName
  +string CategorySlug
  +MatchExplanation? Explanation
  +SpaceCardDto? Space
}

class MatchExplanation {
  +string Text
  +IReadOnlyList<HighlightRange> Highlights
}

class HighlightRange {
  +int Start
  +int Length
}

class SearchSuggestion {
  +string CloseTerm
  +string? CategorySlug
}

class RecentSearch {
  +Guid Id
  +string MemberSubject
  +string Query
  +DateTimeOffset SearchedAt
  +{static} Record(memberSubject: string, query: string, now: DateTimeOffset): RecentSearch
  +Touch(now: DateTimeOffset): void
}

class SearchStartBuilder {
  +{static} int RecentLimit = 5
  +{static} int PopularLimit = 5
  +BuildAsync(viewer: Viewer): Task<SearchStartDto>
}

class SearchStartDto {
  +IReadOnlyList<RecentSearchDto> Recent
  +IReadOnlyList<PopularCategoryDto> PopularCategories
}

class RemoveRecentSearchCommandHandler {
  +Handle(request: RemoveRecentSearchCommand): Task
}

class ClearRecentSearchesCommandHandler {
  +Handle(request: ClearRecentSearchesCommand): Task
}

SearchDirectoryQueryHandler ..> SearchDirectoryQuery : handles
SearchDirectoryQueryHandler ..> SearchQueryText : normalises with
SearchDirectoryQueryHandler ..> ISearchIndex : searches through
SearchDirectoryQueryHandler ..> DatabaseNameSearch : falls back to
SearchDirectoryQueryHandler ..> SearchStartBuilder : answers an empty query with
SearchDirectoryQueryHandler ..> RecentSearch : records
SearchDirectoryQueryHandler ..> SearchAnswer : returns
ISearchIndex <|.. DatabaseSearchIndex
DatabaseSearchIndex ..> SearchAnalyzer : analyses with
DatabaseNameSearch ..> SearchAnalyzer : folds with
SearchAnswer *-- "0..1" SearchResults
SearchAnswer *-- "0..1" SearchStartDto
SearchResults *-- "0..*" SearchHit
SearchResults *-- "0..1" SearchSuggestion
SearchHit *-- "0..1" MatchExplanation
MatchExplanation *-- "1..*" HighlightRange
SearchStartBuilder ..> SearchStartDto : builds
SearchStartBuilder ..> RecentSearch : lists
RemoveRecentSearchCommandHandler ..> RecentSearch : deletes one
ClearRecentSearchesCommandHandler ..> RecentSearch : deletes all of a member
@enduml
