@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Describe a listing

Container_Boundary(web, "Jubilee Web") {
  Component(guard, "memberGuard", "Angular route guard", "Sends a visitor to /sign-in with returnUrl=/list")
  Component(page, "ListBusinessPage", "Angular page", "Holds the form in signals and lays out the preview")
  Component(cards, "ChoiceCards", "jb-choice-cards", "Products or Services or A space")
  Component(product, "ProductEditorDialog", "Angular CDK dialog", "With data.draft it closes with a DraftItem and calls no API")
  Component(service, "ServiceEditorDialog", "Angular CDK dialog", "With data.draft it closes with a DraftItem and calls no API")
  Component(preview, "BusinessCardPreview", "jb-business-card-preview", "How members see you card with the highlight and Pending verification")
  Component(client, "ListingDraftsApi", "Service contract (LISTING_DRAFTS_API)", "Calls /api/listing-drafts")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "ListingDraftsController", "ASP.NET Core controller", "Takes the subject from the session and refuses unknown fields")
  Component(save, "SaveListingDraftCommandHandler", "MediatR handler", "Starts or loads the draft and applies the input")
  Component(rules, "Drafts", "Application rules", "KindOf and ItemsOf and Owned")
  Component(draft, "ListingDraft", "Domain entity", "Save keeps the values cut to their lengths with the DraftItem rows")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Listing drafts and draft items")

Rel(guard, page, "Lets a member through to")
Rel(page, cards, "Renders and reads the kind from")
Rel(page, product, "Opens for Add a product")
Rel(page, service, "Opens for Add a service")
Rel(page, preview, "Binds name and tagline and category tile and highlight to")
Rel(page, client, "Saves the form and the items through")
Rel(client, ctrl, "POST and PUT /api/listing-drafts", "JSON/HTTPS")
Rel(ctrl, save, "Sends SaveListingDraftCommand")
Rel(save, rules, "Maps the input with")
Rel(save, draft, "Calls Save on")
Rel(save, db, "Persists", "EF Core")
@enduml
