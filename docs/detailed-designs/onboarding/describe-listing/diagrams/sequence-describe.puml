@startuml
title UML sequence behaviour — Choose what to offer and describe the business
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "memberGuard" as guard
  participant "ListBusinessPage" as page
  participant "ChoiceCards" as cards
  participant "BusinessCardPreview" as preview
  participant "ListingDraftsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ListingDraftsController" as controller
end box
actor -> guard : Open /list
alt Visitor
  guard --> actor : Redirect to /sign-in with returnUrl=/list (L2-071)
else Signed-in member
  guard -> page : Activate
  page -> client : current()
  client -> controller : GET /api/listing-drafts/current
  controller --> client : 204 No Content when the member has no draft
  client --> page : null
  page --> actor : Show "What do you offer?" with Products and Services and A space
  opt Unconfirmed member
    page --> actor : Show "Confirm your e-mail to submit." and disable the submit button (L2-005)
  end
  actor -> cards : Choose Products or Services
  cards -> page : selected
  page -> page : setKind(kind) sets the kind signal
  page --> actor : Show the sections for the kind (L2-071)
  actor -> page : Type name or tagline or highlight or pick a category
  page -> page : Stop name at 120 and highlight at 30 and count tagline "{n} / 90" (L2-072)
  page -> preview : Bind name and tagline and tile and highlight
  preview --> actor : Redraw "How members see you" within 100 ms (L2-076)
  opt Member switches between Products and Services
    actor -> cards : Choose the other card
    cards -> page : selected
    page -> page : setKind(other) keeps each field and empties items
    page --> actor : Same values with the other sections (L2-071)
  end
end
note over page, client
  Choosing and typing send no request.
  The first save creates the ListingDraft (ADR 0018).
end note
@enduml
