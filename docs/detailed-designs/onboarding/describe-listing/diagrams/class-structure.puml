@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Describe a listing

enum ListingKind {
  Services
  Shop
  Space
}

enum ServicePriceKind {
  Free
  Amount
  Ask
}

enum ServiceAction {
  Book
  Ask
}

class ListingDraft {
  +Guid Id
  +string OwnerSubject
  +ListingKind Kind
  +string Name
  +string Tagline
  +string? CategorySlug
  +string? Highlight
  +string? Place
  +bool Agreed
  +SpaceDetails? Space
  +DateTimeOffset UpdatedAt
  +int MaxNameLength = 120
  +int MaxItems = 50
  +{static} Start(ownerSubject: string, now: DateTimeOffset): ListingDraft
  +Save(kind, name, tagline, categorySlug, highlight, place, agreed, items, now, space): void
}

class DraftItem {
  +Guid Id
  +int Position
  +string Name
  +string? Detail
  +ServicePriceKind PriceKind
  +int? PriceCents
  +string? Description
  +int? Stock
  +ServiceAction Action
  +int? DurationMinutes
  +bool OffersVideo
  +bool OffersInPerson
  +string? InPersonPlace
}

class DraftInput <<record>> {
  +string? Kind
  +string? Name
  +string? Tagline
  +string? CategorySlug
  +string? Highlight
  +string? Place
  +bool Agreed
  +IReadOnlyList<DraftItemInput>? Items
  +SpaceInput? Space
}

class DraftItemInput <<record>> {
  +string? Name
  +string? Detail
  +string? PriceKind
  +int? PriceCents
  +string? Description
  +int? Stock
  +string? Action
  +int? DurationMinutes
  +bool OffersVideo
  +bool OffersInPerson
  +string? InPersonPlace
}

class ListingDraftDto <<record>> {
  +Guid Id
  +string Kind
  +string Name
  +string Tagline
  +string? CategorySlug
  +string? Highlight
  +string? Place
  +bool Agreed
  +DateTimeOffset UpdatedAt
  +IReadOnlyList<DraftItemDto> Items
  +{static} From(draft: ListingDraft): ListingDraftDto
}

class DraftItemDto <<record>>

class Drafts <<static>> {
  +int MaxListings = 5
  +{static} KindOf(kind: string?): ListingKind
  +{static} PriceKindOf(kind: string?): ServicePriceKind
  +{static} ItemsOf(input: DraftInput): IEnumerable<DraftItem>
  +{static} Apply(draft: ListingDraft, input: DraftInput, now: DateTimeOffset): void
  +{static} Owned(db, subject: string, id: Guid): Task<ListingDraft>
}

class ListBusinessPage {
  #kind: Signal<OfferKind>
  #name: Signal<string>
  #tagline: Signal<string>
  #categorySlug: Signal<string>
  #highlight: Signal<string>
  #place: Signal<string>
  #items: Signal<DraftItem[]>
  #setKind(kind: OfferKind): void
  #addItem(): void
  #removeItem(index: number): void
}

ListingDraft --> ListingKind : has
ListingDraft "1" *-- "0..50" DraftItem : keeps
DraftItem --> ServicePriceKind : priced by
DraftItem --> ServiceAction : offers
DraftInput "1" *-- "*" DraftItemInput : carries
ListingDraftDto "1" *-- "*" DraftItemDto : carries
ListingDraftDto ..> ListingDraft : projects
Drafts ..> DraftInput : reads
Drafts ..> ListingDraft : applies to
Drafts ..> DraftItem : builds
ListBusinessPage ..> ListingDraftDto : restores from
@enduml
