@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Describe a listing

Person(member, "Member", "Describes a business on /list")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "ListBusinessPage with the form and the editor dialogs and the live preview")
  Container(api, "Jubilee API", "ASP.NET Core", "Listing draft endpoints under /api/listing-drafts")
  ContainerDb(db, "Jubilee database", "SQL Server", "Listing drafts and their draft items")
}
Rel(member, web, "Fills in the listing form", "HTTPS")
Rel(web, api, "Saves the draft with its items", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
