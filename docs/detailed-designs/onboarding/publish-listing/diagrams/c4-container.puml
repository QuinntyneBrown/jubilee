@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Publish a listing

Person(owner, "Owner", "Publishes a listing")
Person(team, "Jubilee team member", "Opens a listing")
System_Ext(email, "E-mail provider", "Delivers e-mail")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Publish button and error summary and published state and listing switcher and the statement agreement dialog")
  Container(admin, "Jubilee Admin Web", "Angular single-page application", "Listing screen with the owner's other listings and drafts")
  Container(api, "Jubilee API", "ASP.NET Core", "Endpoints under /api/listing-drafts and /api/statement-of-faith and /api/session")
  Container(worker, "Jubilee Worker", ".NET worker service", "StatementAgreementJob and outbox dispatch")
  ContainerDb(db, "Jubilee database", "SQL Server", "Listings, drafts, listing submissions with their idempotency keys, statement agreements, job runs and outbox")
  ContainerDb(cache, "Cache", "Redis", "Sessions and the directory read cache")
}
Rel(owner, web, "Presses Publish listing or I agree", "HTTPS")
Rel(team, admin, "Opens a listing", "HTTPS")
Rel(web, api, "Publishes with an idempotency key in the body", "JSON/HTTPS")
Rel(admin, api, "Reads the listing", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, cache, "Drops the directory read cache after the save")
Rel(worker, db, "Pauses listings of owners who have not agreed", "EF Core")
Rel(worker, email, "Sends the paused notice", "HTTPS")
@enduml
