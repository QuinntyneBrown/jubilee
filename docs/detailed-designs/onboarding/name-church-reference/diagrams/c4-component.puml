@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Name a church reference

Container_Boundary(web, "Jubilee Web") {
  Component(section, "ChurchReferenceSection", "Angular form group", "Church and Pastor's e-mail fields")
  Component(check, "FaithAgreementCheckbox", "Angular component", "Statement of faith checkbox")
  Component(prompt, "FaithReagreementDialog", "Angular dialog", "Asks an owner to agree to a new statement version after sign-in")
  Component(client, "ListingsApi", "Typed HTTP client", "Sends the reference with the draft and the submission")
  Component(account, "AccountApi", "Typed HTTP client", "Reads and records the faith agreement")
}
Container_Boundary(api, "Jubilee API") {
  Component(validator, "ChurchReferenceValidator", "FluentValidation validator", "Required church and well-formed e-mail")
  Component(self, "ReferenceEmailPolicy", "Domain service", "Refuses the owner's own e-mail addresses")
  Component(reuse, "ReferenceReusePolicy", "Domain service", "Flags an e-mail named by more than 5 owners in 30 days")
  Component(listing, "Listing", "Domain entity", "Owns the ChurchReference and the FaithAgreement")
  Component(agree, "RecordFaithAgreementCommandHandler", "MediatR handler", "Stores a new agreement for the current version")
  Component(versions, "StatementOfFaithVersion", "Domain entity", "Versioned statement identified by its date")
}
ContainerDb(db, "Jubilee database", "SQL Server", "References and agreements")

Rel(section, client, "Supplies church and e-mail")
Rel(check, client, "Supplies the agreement")
Rel(prompt, account, "Records the new agreement")
Rel(client, validator, "POST /api/listings/id/submission", "JSON/HTTPS")
Rel(validator, self, "Asks whether the e-mail belongs to the owner")
Rel(validator, listing, "Passes a valid reference to")
Rel(listing, reuse, "Asks for a reuse flag")
Rel(account, agree, "POST /api/account/faith-agreement", "JSON/HTTPS")
Rel(agree, versions, "Reads the current version")
Rel(listing, versions, "Stamps the agreement with")
Rel(reuse, db, "Counts recent references", "EF Core")
Rel(agree, db, "Persists", "EF Core")
@enduml
