@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Name a church reference

Person(owner, "Owner", "Names a church reference on /list")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Church reference section and statement of faith checkbox and re-agreement prompt")
  Container(api, "Jubilee API", "ASP.NET Core", "Validates the reference and records the agreement")
  ContainerDb(db, "Jubilee database", "SQL Server", "Church references and faith agreements and statement versions")
}
Rel(owner, web, "Enters church and pastor's e-mail", "HTTPS")
Rel(web, api, "Submits the reference and the agreement", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
