@startuml
title UML sequence behaviour — Validate the church reference and the agreement at submission
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ListBusinessPage" as page
  participant "ListingsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ListingsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ChurchReferenceValidator" as validator
  participant "SubmitListingCommandHandler" as handler
  participant "Listing" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Enter "Church" and "Pastor's e-mail" and tick the checkbox
actor -> page : Press "Submit for verification"
page -> page : Run the same rules in the browser (L2-126)
alt Checkbox not ticked or e-mail malformed
  page --> actor : Show "Agree to the statement of faith to submit your listing." or the e-mail message
else Form valid in the browser
  page -> client : submit(listingId, form)
  client -> controller : POST /api/listings/{listingId}/submission
  controller -> controller : Authenticate and check the caller owns the listing
  controller -> validator : Validate SubmitListingCommand
  validator -> validator : Require church and a well-formed e-mail (L2-074)
  validator -> db : Load the owner's e-mail addresses
  db --> validator : Addresses
  validator -> validator : Compare normalized addresses (L2-074)
  alt E-mail is the owner's own
    validator --> controller : REFERENCE_IS_OWNER
    controller --> client : 422 ProblemDetails
    client --> page : Field error
    page --> actor : Show "Your reference must be someone other than you."
  else Reference is someone else
    validator --> controller : Valid
    controller -> handler : Send SubmitListingCommand
    handler -> db : Load listing and current StatementOfFaithVersion
    db --> handler : Listing and version
    handler -> entity : NameReference(church, email)
    handler -> entity : RecordAgreement(version, now) (L2-075)
    handler -> db : Count listings by other owners naming this e-mail in 30 days
    db --> handler : Count
    opt Count is more than 5 (L2-074)
      handler -> entity : AddFlag(ReferenceNamedOften)
    end
    handler -> db : Save in one unit of work
    db --> handler : Commit result
    handler --> controller : Submission result
    controller --> client : 200 OK
    client --> page : Submitted
    page --> actor : Show the submitted state
  end
end
@enduml
