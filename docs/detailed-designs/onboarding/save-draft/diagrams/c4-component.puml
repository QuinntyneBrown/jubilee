@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Save a draft

Container_Boundary(web, "Jubilee Web") {
  Component(page, "ListBusinessPage", "Angular page", "Save draft and the 10-second autosave timer and the loading and error and saved states")
  Component(client, "ListingDraftsApi", "Service contract (LISTING_DRAFTS_API)", "current and get and create and save")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "ListingDraftsController", "ASP.NET Core controller", "Takes the subject from the session and refuses unknown fields")
  Component(save, "SaveListingDraftCommandHandler", "MediatR handler", "Starts or loads the draft and stores it without required-field rules")
  Component(current, "GetCurrentDraftQueryHandler", "MediatR handler", "Returns the draft the member touched last")
  Component(get, "GetDraftQueryHandler", "MediatR handler", "Returns one draft of the caller by id")
  Component(rules, "Drafts", "Application rules", "Owned answers 404 for the draft of another member")
  Component(draft, "ListingDraft", "Domain entity", "Save sets UpdatedAt and clears NoticeSentAt")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(job, "ListingDraftExpiryJob", "Hosted service", "Ticks every 24 hours")
  Component(run, "RunListingDraftExpiryJobCommandHandler", "MediatR handler", "Runs the work as job listing-draft-expiry")
  Component(jobs, "ScheduledJobs", "Application service", "RunOnceAsync claims the occurrence with a JobRun")
  Component(expire, "ExpireListingDraftsCommandHandler", "MediatR handler", "Deletes 14 days after the notice and queues the notice at 180 days")
  Component(outbox, "OutboxDispatcherJob", "Hosted service", "Sends queued e-mail")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Listing drafts and job runs and outbox")
System_Ext(email, "E-mail provider", "Delivers e-mail")

Rel(page, client, "Saves and loads through")
Rel(client, ctrl, "GET and POST and PUT /api/listing-drafts", "JSON/HTTPS")
Rel(ctrl, save, "Sends SaveListingDraftCommand")
Rel(ctrl, current, "Sends GetCurrentDraftQuery")
Rel(ctrl, get, "Sends GetDraftQuery")
Rel(save, rules, "Loads and applies with")
Rel(get, rules, "Loads with")
Rel(save, draft, "Calls Save on")
Rel(save, db, "Persists", "EF Core")
Rel(current, db, "Reads", "EF Core")
Rel(job, run, "Sends RunListingDraftExpiryJobCommand")
Rel(run, jobs, "Calls RunOnceAsync on")
Rel(jobs, db, "Inserts and completes the JobRun", "EF Core")
Rel(run, expire, "Sends ExpireListingDraftsCommand")
Rel(expire, db, "Deletes drafts and writes the outbox", "EF Core")
Rel(outbox, db, "Reads the outbox", "EF Core")
Rel(outbox, email, "Sends the expiry notice")
@enduml
