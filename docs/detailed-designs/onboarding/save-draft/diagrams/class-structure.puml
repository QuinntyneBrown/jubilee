@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Save a draft

class ListingDraft {
  +Guid Id
  +string OwnerSubject
  +ListingKind Kind
  +string Name
  +string Tagline
  +string? CategorySlug
  +string? Highlight
  +string? Place
  +bool Agreed
  +DateTimeOffset CreatedAt
  +DateTimeOffset UpdatedAt
  +DateTimeOffset? NoticeSentAt
  +TimeSpan IdleBeforeNotice = 180 days
  +TimeSpan GraceAfterNotice = 14 days
  +{static} Start(ownerSubject: string, now: DateTimeOffset): ListingDraft
  +Save(kind, name, tagline, categorySlug, highlight, place, agreed, items, now, space): void
  +NoticeSent(now: DateTimeOffset): void
}

class DraftItem {
  +int Position
  +string Name
}

enum ListingKind {
  Services
  Shop
  Space
}

class DraftInput <<record>> {
  +string? Kind
  +string? Name
  +string? Tagline
  +string? CategorySlug
  +string? Highlight
  +string? Place
  +bool Agreed
  +IReadOnlyList<DraftItemInput>? Items
  +SpaceInput? Space
}

class SaveListingDraftCommand <<record>> {
  +string Subject
  +Guid? Id
  +DraftInput Input
}

class SaveListingDraftCommandHandler {
  +Handle(command: SaveListingDraftCommand): Task<ListingDraftDto>
}

class GetCurrentDraftQuery <<record>> {
  +string Subject
}

class GetDraftQuery <<record>> {
  +string Subject
  +Guid Id
}

class ListingDraftDto <<record>> {
  +Guid Id
  +string Kind
  +string Name
  +string Tagline
  +bool Agreed
  +DateTimeOffset UpdatedAt
  +IReadOnlyList<DraftItemDto> Items
  +SpaceDraftDto? Space
}

class Drafts <<static>> {
  +int MaxListings = 5
  +{static} Apply(draft: ListingDraft, input: DraftInput, now: DateTimeOffset): void
  +{static} Owned(db, subject: string, id: Guid): Task<ListingDraft>
}

class RunListingDraftExpiryJobCommand <<record>> {
  +string Job = "listing-draft-expiry"
  +TimeSpan Every = 24 hours
}

class ExpireListingDraftsCommand <<record>>

class ExpireListingDraftsCommandHandler {
  +Handle(command: ExpireListingDraftsCommand): Task<int>
}

class ScheduledJobs {
  +RunOnceAsync(job: string, every: TimeSpan, work): Task<bool>
  +LastSuccessAsync(job: string): Task<DateTimeOffset?>
}

class JobRun {
  +string Job
  +DateTimeOffset Occurrence
  +DateTimeOffset ClaimedAt
  +DateTimeOffset? SucceededAt
  +{static} OccurrenceOf(now: DateTimeOffset, every: TimeSpan): DateTimeOffset
  +Succeed(now: DateTimeOffset): void
}

class OutboxMessage {
  +{static} Email(memberId, to, subject, text, now): OutboxMessage
}

ListingDraft --> ListingKind : has
ListingDraft "1" *-- "0..50" DraftItem : keeps
SaveListingDraftCommandHandler ..> SaveListingDraftCommand : handles
SaveListingDraftCommand *-- DraftInput : carries
SaveListingDraftCommandHandler ..> Drafts : loads / applies with
Drafts ..> ListingDraft : calls Save on
SaveListingDraftCommandHandler ..> ListingDraftDto : returns
GetCurrentDraftQuery ..> ListingDraftDto : answered with
GetDraftQuery ..> ListingDraftDto : answered with
ListingDraftDto ..> ListingDraft : projects
RunListingDraftExpiryJobCommand ..> ScheduledJobs : runs through
RunListingDraftExpiryJobCommand ..> ExpireListingDraftsCommand : sends
ScheduledJobs ..> JobRun : claims / completes
ExpireListingDraftsCommandHandler ..> ExpireListingDraftsCommand : handles
ExpireListingDraftsCommandHandler --> "*" ListingDraft : warns / deletes
ExpireListingDraftsCommandHandler ..> OutboxMessage : writes
@enduml
