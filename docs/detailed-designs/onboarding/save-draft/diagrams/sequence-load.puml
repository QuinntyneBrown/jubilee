@startuml
title UML sequence behaviour — Load a saved draft
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ListBusinessPage" as page
  participant "ListingDraftsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ListingDraftsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetCurrentDraftQueryHandler" as current
  participant "GetDraftQueryHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Return to /list or choose the draft in the My business switcher
page -> page : load() reads the query parameter draft
page --> actor : Show "Loading your draft…" over skeleton fields
alt /list
  page -> client : current()
  client -> controller : GET /api/listing-drafts/current
  controller -> current : Send GetCurrentDraftQuery(subject)
  current -> db : Read the caller's draft with the newest UpdatedAt and its items
  db --> current : Draft or none
  current --> controller : ListingDraftDto or null
  controller --> client : 200 OK or 204 No Content
else /list?draft={id}
  page -> client : get(id)
  client -> controller : GET /api/listing-drafts/{id}
  controller -> handler : Send GetDraftQuery(subject, id)
  handler -> db : Drafts.Owned(subject, id)
  db --> handler : Draft or 404 draft_not_found (L2-133)
  handler --> controller : ListingDraftDto
  controller --> client : 200 OK
else /list?draft=new
  page -> page : Start a blank form without a request
end
alt Draft read
  client --> page : ListingDraft
  page -> page : apply(draft) sets each signal
  page --> actor : Restore each value and the items (L2-077)
else No draft
  client --> page : null
  page --> actor : Show the empty form
else Request failed
  client --> page : Error
  page --> actor : Show "We couldn’t load your draft" with JB-LST-503 and "Try again" (L2-118)
end
@enduml
