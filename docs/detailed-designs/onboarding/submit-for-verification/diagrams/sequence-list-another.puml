@startuml
title UML sequence behaviour — List another business
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "MyBusinessPage" as mybiz
  participant "ListBusinessPage" as page
  participant "ListingDraftsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "MyBusinessController" as bizctrl
  participant "ListingDraftsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetMyBusinessQueryHandler" as overview
  participant "SaveListingDraftCommandHandler" as handler
  participant "ListingDraft" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> mybiz : Open /my-business
mybiz -> bizctrl : GET /api/my-business
bizctrl -> overview : Send GetMyBusinessQuery
overview -> db : Read the owner's listings and drafts
db --> overview : Listings and drafts
overview --> bizctrl : MyBusinessDto with Businesses
bizctrl --> mybiz : 200 OK
mybiz --> actor : Show the select "Business" with each stage and "List another business" (L2-079)
actor -> mybiz : Choose "List another business"
mybiz -> page : Navigate to /list?draft=new
page --> actor : Show a blank form without a request
actor -> page : Fill in and press "Save draft" or stop typing for 10 seconds
page -> client : create(body)
client -> controller : POST /api/listing-drafts
controller -> handler : Send SaveListingDraftCommand(subject, null, input)
handler -> db : Count listings not deleted and drafts of the caller
db --> handler : Count
alt Owner already has 5 (L2-079)
  handler --> controller : ConflictException LISTING_LIMIT
  controller --> client : 409 ProblemDetails
  client --> page : Error with detail
  page --> actor : Show "You can list up to 5 businesses. Write to help@jubilee.example for more."
else Fewer than 5
  handler -> entity : ListingDraft.Start(subject, now) and Save(values)
  handler -> db : Insert the draft
  db --> handler : Commit result
  handler --> controller : ListingDraftDto
  controller --> client : 201 Created
  client --> page : New draft
  page --> actor : Show "Draft saved."
end
note over mybiz
  The switcher then names the draft as "{name} · Draft".
  Choosing a listing sends PUT /api/my-business/current,
  which stamps Listing.WorkspaceChosenAt (ADR 0052).
end note
@enduml
