@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Submit for verification

enum ListingStage {
  Draft
  ReadyToReview
  ChangesRequested
  Live
  Declined
}

class Listing {
  +Guid Id
  +string Slug
  +string Name
  +string Tagline
  +string? Highlight
  +string CategorySlug
  +ListingKind Kind
  +string? OwnerId
  +ListingStage Stage
  +bool IsPaused
  +DateTimeOffset? WorkspaceChosenAt
  +DateTimeOffset? StatementLapsedAt
  +{static} Create(slug, name, tagline, categorySlug, now): Listing
  +MoveTo(stage: ListingStage): void
  +SetHighlight(highlight: string?): void
  +PauseForStatement(now: DateTimeOffset): void
}

class ListingDraft {
  +Guid Id
  +string OwnerSubject
  +IReadOnlyList<DraftItem> Items
}

class ListingSubmission {
  +Guid Id
  +Guid ListingId
  +string OwnerSubject
  +string StatementVersion
  +DateTimeOffset AgreedAt
  +DateTimeOffset SubmittedAt
  +string IdempotencyKey
  +List<string> Flags
  +DateTimeOffset? ReadyAt
  +{static} Record(listingId, ownerSubject, idempotencyKey, flags, now): ListingSubmission
  +MarkReady(now: DateTimeOffset): void
}

class StatementOfFaith <<static>> {
  +string Version
  +DateOnly UpdatedOn
  +DateOnly AgreeBy
}

class StatementAgreement {
  +string OwnerSubject
  +string Version
  +DateTimeOffset AgreedAt
}

class SubmitListingCommand <<record>> {
  +string Subject
  +string Name
  +Guid DraftId
  +DraftInput Input
  +string? IdempotencyKey
}

class SubmitListingCommandHandler {
  +int MaxTaglineLength = 90
  +Handle(command: SubmitListingCommand): Task<SubmittedListingDto>
  -UniqueSlug(name: string): Task<string>
  -AddItems(listing: Listing, input: DraftInput, now: DateTimeOffset): void
}

class SubmittedListingDto <<record>> {
  +Guid ListingId
  +string Slug
  +string Name
  +string Kind
  +string Stage
  +DateTimeOffset SubmittedAt
}

class Slugs <<static>> {
  +{static} From(text: string, fallback: string): string
  +{static} Unique(slug: string, used: HashSet<string>): string
}

class AgreeToStatementCommand <<record>> {
  +string Subject
  +string Version
}

class StatementDueDto <<record>> {
  +string Version
  +string UpdatedOn
  +string AgreeBy
  +bool Overdue
  +string Business
}

class RunStatementAgreementJobCommand <<record>> {
  +string Job = "statement-agreement"
  +TimeSpan Every = 24 hours
}

class ReviewOwner <<record>> {
  +string Name
  +string Email
  +bool EmailConfirmed
  +DateTimeOffset MemberSince
  +IReadOnlyList<ReviewOtherListing> OtherListings
}

class ReviewOtherListing <<record>> {
  +string Name
  +string StageLabel
}

class VerificationReviewDto <<record>> {
  +Guid Id
  +string StageLabel
  +ReviewOwner Owner
  +IReadOnlyList<string> Flags
  +int ItemCount
}

Listing --> ListingStage : has
SubmitListingCommandHandler ..> SubmitListingCommand : handles
SubmitListingCommandHandler ..> ListingDraft : reads / removes
SubmitListingCommandHandler ..> Listing : creates
SubmitListingCommandHandler ..> ListingSubmission : records
SubmitListingCommandHandler ..> Slugs : builds the slug with
SubmitListingCommandHandler ..> SubmittedListingDto : returns
ListingSubmission "1" --> "1" Listing : for
ListingSubmission ..> StatementOfFaith : stamps Version of
StatementAgreement ..> StatementOfFaith : names Version of
AgreeToStatementCommand ..> StatementAgreement : records
AgreeToStatementCommand ..> Listing : resumes
StatementDueDto ..> StatementOfFaith : reads
RunStatementAgreementJobCommand ..> Listing : pauses
VerificationReviewDto *-- ReviewOwner : carries
ReviewOwner "1" *-- "*" ReviewOtherListing : names
ReviewOtherListing ..> Listing : projects
@enduml
