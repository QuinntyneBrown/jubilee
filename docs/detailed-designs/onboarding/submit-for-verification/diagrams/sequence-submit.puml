@startuml
title UML sequence behaviour — Submit a listing for verification
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ListBusinessPage" as page
  participant "ListingsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "IdempotencyMiddleware" as idem
  participant "ListingsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SubmitListingCommandHandler" as handler
  participant "Listing" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Press "Submit for verification"
page -> page : Validate every field in the browser (L2-126)
alt Three fields invalid
  page --> actor : Show "Fix 3 things to continue" and move focus to the summary (L2-078)
else Form valid
  page -> page : Make fields read-only and the button busy (L2-127)
  page -> client : submit(listingId, values, idempotencyKey)
  client -> idem : POST /api/listings/{listingId}/submission
  idem -> idem : Look up the Idempotency-Key (L2-132)
  alt Key seen within 24 hours
    idem --> client : Original response
  else First request
    idem -> controller : Forward
    controller -> controller : Authenticate and check the caller owns the listing (L2-133)
    alt E-mail not confirmed
      controller --> client : 403 EMAIL_UNCONFIRMED (L2-005)
    else Validation fails on the server
      controller --> client : 422 ProblemDetails with per-field codes
    else Accepted
      controller -> handler : Send SubmitListingCommand
      handler -> db : Load listing in stage Draft
      db --> handler : Listing
      handler -> entity : Apply values and assign the slug (L2-072)
      handler -> entity : SubmitForVerification(now)
      entity --> handler : Stage WaitingOnReference (L2-078)
      handler -> db : Save listing and ReferenceRequested outbox message in one transaction
      db --> handler : Commit result
      handler --> controller : SubmissionResult
      controller --> client : 200 OK
    end
  end
  client --> page : Result or ProblemDetails
  alt Submitted
    page --> actor : Show "{Business} is in for verification." with "Go to My business"
  else Refused
    page --> actor : Restore the editable form with the field errors
  end
end
note over handler, db
  Jubilee Worker dispatches ReferenceRequested
  and sends the reference e-mail (L2-080).
end note
@enduml
