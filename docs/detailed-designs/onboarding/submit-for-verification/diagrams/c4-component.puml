@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Submit for verification

Container_Boundary(web, "Jubilee Web") {
  Component(page, "ListBusinessPage", "Angular page", "Submitting and invalid and submitted states of /list")
  Component(summary, "FormSummary", "jb-form-summary", "Fix n things to continue with a link to each field")
  Component(client, "ListingDraftsApi", "Service contract (LISTING_DRAFTS_API)", "Saves and submits the draft")
  Component(root, "App", "Angular root component", "Opens the agreement dialog once per load when the session carries statementDue")
  Component(dialog, "StatementAgreementDialog", "Angular CDK dialog", "The statement of faith has been updated with I agree")
  Component(mybiz, "MyBusinessPage", "Angular page", "Switcher and List another business and the Read and agree banner")
}
Container_Boundary(adminweb, "Jubilee Admin Web") {
  Component(review, "AdminVerificationPage", "Angular page", "No products or services yet and Other listings with stages")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "ListingDraftsController", "ASP.NET Core controller", "Submit carries RequiresConfirmedEmail")
  Component(submit, "SubmitListingCommandHandler", "MediatR handler", "Validates and creates the listing in ReadyToReview with its items")
  Component(listing, "Listing", "Domain entity", "Create and MoveTo and PauseForStatement")
  Component(submission, "ListingSubmission", "Domain entity", "Statement version and idempotency key and flags")
  Component(sofctrl, "StatementOfFaithController", "ASP.NET Core controller", "POST /api/statement-of-faith/agreement")
  Component(agree, "AgreeToStatementCommandHandler", "MediatR handler", "Records a StatementAgreement and resumes listings the job paused")
  Component(session, "SessionController", "ASP.NET Core controller", "GET /api/session with statementDue")
  Component(reviewq, "GetVerificationReviewQueryHandler", "MediatR handler", "Returns ItemCount and ReviewOwner.OtherListings")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(job, "StatementAgreementJob", "Hosted service", "Ticks once a day")
  Component(run, "RunStatementAgreementJobCommandHandler", "MediatR handler", "Pauses live listings of owners not agreed after AgreeBy")
  Component(jobs, "ScheduledJobs", "Application service", "RunOnceAsync claims the occurrence with a JobRun")
  Component(outbox, "OutboxDispatcherJob", "Hosted service", "Sends queued e-mail")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Listings and submissions and agreements and job runs and outbox")

Rel(page, summary, "Shows errors in")
Rel(page, client, "Saves and submits through")
Rel(client, ctrl, "POST /api/listing-drafts/id/submit", "JSON/HTTPS")
Rel(ctrl, submit, "Sends SubmitListingCommand")
Rel(submit, listing, "Creates")
Rel(submit, submission, "Records")
Rel(submit, db, "Saves in one unit of work", "EF Core")
Rel(root, session, "Reads statementDue from", "JSON/HTTPS")
Rel(root, dialog, "Opens")
Rel(mybiz, dialog, "Opens from Read and agree")
Rel(dialog, sofctrl, "Posts the version", "JSON/HTTPS")
Rel(sofctrl, agree, "Sends AgreeToStatementCommand")
Rel(agree, db, "Writes the agreement", "EF Core")
Rel(review, reviewq, "Reads the review through the admin endpoints", "JSON/HTTPS")
Rel(reviewq, db, "Reads", "EF Core")
Rel(job, run, "Sends RunStatementAgreementJobCommand")
Rel(run, jobs, "Calls RunOnceAsync on")
Rel(run, listing, "Calls PauseForStatement on")
Rel(run, db, "Saves listings and the outbox", "EF Core")
Rel(outbox, db, "Reads the outbox", "EF Core")
@enduml
