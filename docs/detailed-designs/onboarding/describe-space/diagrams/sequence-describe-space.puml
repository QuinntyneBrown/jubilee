@startuml
title UML sequence behaviour — Choose a space, fill it in and save a draft
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ListBusinessPage" as page
  participant "SpaceTermRules" as rules
  participant "SpacePreview" as preview
  participant "ListingDraftsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ListingDraftsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SaveListingDraftCommandHandler" as handler
  participant "ListingDraft" as draft
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Choose "A space" or open /list?kind=space
page -> rules : Labels for Long term (default)
rules --> page : "Price per month", "Move-in date", "Minimum stay"
page --> actor : "List a space", "Listing title", space fields, no Category (L2-189)
actor -> page : Type the title, line and space fields
page -> preview : Form values
preview --> actor : "How renters see it" space card, "Pending verification" (L2-076)
opt Member chooses another term
  actor -> page : Choose "Short stay"
  page -> rules : Labels for Short stay
  rules --> page : "Price per night", "Available", "Minimum nights"
  page --> actor : Same values; only labels, choices and household change (L2-190)
end
actor -> page : Press "Save draft"
page -> client : save(kind space, space)
client -> controller : PUT /api/listing-drafts/{id}
controller -> controller : Authenticate and check the caller owns the draft (L2-133)
controller -> handler : Send SaveListingDraftCommand
handler -> draft : Save kind Space in rooms-rentals with SpaceDetails, no validation (L2-190)
handler -> db : Save
db --> handler : Commit result
handler --> controller : ListingDraftDto with space
controller --> client : 200 OK
client --> page : Saved
page --> actor : Draft saved; reopening restores the term and fields (L2-189)
@enduml
