@startuml
title UML sequence behaviour — open the dialog and estimate the total
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ProductPage" as page
  participant "RequestItemDialog" as dialog
  participant "RequestsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ListingBookingController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetOrderOptionsQueryHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Choose option and quantity, press "Request this item"
page -> dialog : Open at /b/{shop}/p/{product}/request?option=&quantity=
dialog -> client : orderOptions(shopSlug, productSlug)
client -> controller : GET /api/listings/{shop}/products/{product}/order
controller -> controller : Authenticate
controller -> handler : Send GetOrderOptionsQuery
handler -> db : Load shop, product, delivery methods, threshold and the member's last address
db --> handler : Stored data
handler --> controller : OrderOptionsDto
controller --> client : 200 OK
client --> dialog : Delivery methods, threshold, last address, reply time, lead time
dialog --> actor : Show summary and delivery methods (L2-046)
actor -> dialog : Choose "Ship to me" or "Pick up"
alt "Ship to me"
  dialog -> dialog : Show "Shipping address" prefilled from the last address
else "Pick up"
  dialog -> dialog : Hide the address field and send no address
end
dialog -> dialog : estimate: item, shipping (free at or above the shop's threshold), total (L2-046)
dialog --> actor : Show "Estimated total {amount} + tax"
@enduml
