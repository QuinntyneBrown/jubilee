@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Request an item

enum RequestKind {
  Booking
  Quote
  Order
  Space
}

enum RequestStatus {
  New
  Confirmed
  Declined
  Cancelled
  Completed
}

class Request {
  +Guid Id
  +RequestKind Kind
  +RequestStatus Status
  +string MemberSubject
  +string MemberName
  +Guid ListingId
  +string IdempotencyKey
  +string? ServiceName
  +string? OptionLabel
  +int? Quantity
  +int? UnitPriceCents
  +int? ItemCents
  +int? ShippingCents
  +int? TotalCents
  +string? DeliveryLabel
  +string? ShippingAddress
  +string? Note
  +DateTimeOffset CreatedAt
  +{static} AskForOrder(...): Request
  +Confirm(actor: string, now: DateTimeOffset): void
  +UndoConfirm(actor: string, now: DateTimeOffset): void
  +Decline(actor: string, now: DateTimeOffset, reason: string, message: string): void
  +Cancel(actor: string, now: DateTimeOffset): void
  +UndoCancel(actor: string, now: DateTimeOffset): void
  +Complete(actor: string, now: DateTimeOffset): void
}

class RequestTransition {
  +Guid Id
  +RequestStatus From
  +RequestStatus To
  +string Actor
  +DateTimeOffset At
  +DateTimeOffset? UndoableUntil
}

Request "1" *-- "1..*" RequestTransition : records
Request --> RequestKind : has
Request --> RequestStatus : has

enum DeliveryKind {
  Ship
  Pickup
}

class DeliveryMethod {
  +Guid Id
  +Guid ListingId
  +int Position
  +DeliveryKind Kind
  +string Label
  +int FeeCents
  +string Estimate
}

class Product {
  +Guid Id
  +string Slug
  +string Name
  +int PriceCents
  +int? Stock
  +int MinimumQuantity
  +int MaxQuantity
}

class ProductOption {
  +string Label
  +int? Stock
  +int MaxQuantity
}

class RequestItemCommand {
  +string Subject
  +string Name
  +string ShopSlug
  +string? ProductSlug
  +string? Option
  +int Quantity
  +Guid? DeliveryMethodId
  +string? ShippingAddress
  +string? Note
  +string? IdempotencyKey
}

class RequestItemCommandHandler {
  +Handle(command: RequestItemCommand): Task<BookedRequestDto>
}

class BookedRequestDto {
  +Guid Id
  +string Status
  +string MemberStatus
}

class OrderPricing <<static>> {
  +{static} For(product: Product, quantity: int, method: DeliveryMethod, freeShippingOverCents: int?): OrderAmounts
}

class OrderAmounts {
  +int UnitCents
  +int ItemCents
  +int ShippingCents
  +int TotalCents
}

class Notification {
  +string MemberSubject
  +string Kind
  +string Title
  +string Detail
  +string Target
}

Product "1" *-- "*" ProductOption : offers
DeliveryMethod --> DeliveryKind : has
RequestItemCommandHandler ..> RequestItemCommand : handles
RequestItemCommandHandler ..> OrderPricing : prices with
RequestItemCommandHandler ..> BookedRequestDto : returns
RequestItemCommandHandler --> Request : creates
RequestItemCommandHandler --> Notification : tells the owner with
OrderPricing ..> OrderAmounts : returns
OrderPricing ..> Product : reads
OrderPricing ..> DeliveryMethod : reads
@enduml
