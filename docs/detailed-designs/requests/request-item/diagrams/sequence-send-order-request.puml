@startuml
title UML sequence behaviour — send an order request
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "OrderRequestDialog" as dialog
  participant "RequestsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "RequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "RequestItemCommandHandler" as handler
  participant "OrderPricingService" as pricing
  participant "Request" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as outbox
end box
actor "Owner" as owner
actor -> dialog : Press "Send request"
dialog -> dialog : Require an address for "Ship to me" (L2-046)
dialog -> client : requestItem(command without prices, idempotency key)
client -> controller : POST /api/requests/orders
controller -> controller : Authenticate, apply L2-005 confirmed-member policy, check L2-132 idempotency key
alt body carries a price field
  controller --> client : 400 ProblemDetails (L2-133)
  client --> dialog : Failure
else body accepted
  controller -> handler : Send RequestItemCommand
  handler -> db : Load product, option, delivery method and stock
  db --> handler : Stored product data
  alt quantity exceeds stock
    handler --> controller : Validation failure on quantity with n left
    controller --> client : 422 with per-field code
    client --> dialog : Remaining count n
    dialog --> actor : Show "Only {n} left. Lower the quantity to continue."
  else stock is sufficient
    handler -> pricing : Recompute prices and totals from stored data (L2-046)
    pricing --> handler : OrderAmounts
    handler -> entity : Create order request with status New (L2-043)
    entity --> handler : Request and first RequestTransition
    handler -> db : Save request, conversation card and outbox messages in one unit of work
    db --> handler : Commit result
    handler --> controller : RequestCreatedResult
    controller --> client : 201 Created
    client --> dialog : Request ID, reply time and lead time
    dialog --> actor : Show "Request sent to {shop}" with "Keep shopping" and "View request"
    outbox -> db : Read pending outbox messages
    db --> outbox : Messages
    outbox --> owner : In-app notification, real-time event and e-mail
  end
end
@enduml
