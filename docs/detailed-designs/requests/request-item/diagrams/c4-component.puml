@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Request an item

Container_Boundary(web, "Jubilee Web") {
  Component(dialog, "RequestItemDialog", "Angular CDK dialog", "Collects delivery choice, shipping address and note; shows the estimate")
  Component(client, "RequestsApi", "Service contract (REQUESTS_API)", "Calls the order options and order request endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(options, "ListingBookingController", "ASP.NET Core controller", "Exposes GET /api/listings/{shop}/products/{product}/order")
  Component(ctrl, "RequestsController", "ASP.NET Core controller", "Exposes POST /api/requests/orders")
  Component(query, "GetOrderOptionsQueryHandler", "MediatR handler", "Reads delivery methods and threshold and last address")
  Component(handler, "RequestItemCommandHandler", "MediatR handler", "Checks key and stock and creates the order request")
  Component(pricing, "OrderPricing", "Domain service", "Computes amounts from stored data")
  Component(product, "Product", "Domain entity", "Holds options and price and stock")
  Component(entity, "Request", "Domain entity", "Owns the request lifecycle")
  Component(tell, "NotificationRules", "Application rules", "Stores the owner's notification")
  Component(events, "EventsController", "Server-sent events", "Streams a member's own notifications")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(outbox, "OutboxDispatcherJob", "Hosted job", "Sends the owner's e-mail")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Products and requests and notifications and outbox")

Rel(dialog, client, "Loads options and sends through")
Rel(client, options, "Calls", "JSON/HTTPS")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(options, query, "Sends GetOrderOptionsQuery")
Rel(ctrl, handler, "Sends RequestItemCommand")
Rel(handler, product, "Reads stock from")
Rel(handler, pricing, "Prices with")
Rel(pricing, product, "Reads price from")
Rel(handler, entity, "Creates")
Rel(handler, tell, "Tells the owner through")
Rel(handler, db, "Persists request and notification and outbox", "EF Core")
Rel(query, db, "Reads", "EF Core")
Rel(events, db, "Reads notifications", "EF Core")
Rel(outbox, db, "Reads outbox", "EF Core")
@enduml
