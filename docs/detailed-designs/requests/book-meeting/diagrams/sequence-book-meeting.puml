@startuml
title UML sequence behaviour — send a booking request
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "BookMeetingDialog" as dialog
  participant "RequestsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ListingBookingController" as listing
  participant "RequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "BookMeetingCommandHandler" as handler
  participant "BookingAvailability" as avail
  participant "Request" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as outbox
end box
actor "Owner" as owner
actor -> dialog : Choose a day
dialog -> client : availability(slug, serviceId, day)
client -> listing : GET /api/listings/{slug}/availability
listing -> avail : SlotsFor the day (L2-044: not past, not closed, within 180 days; L2-220: inside the meeting hours)
avail --> listing : Slots
listing --> client : 200 slots
client --> dialog : Slots
actor -> dialog : Choose a time and press "Send request"
dialog -> dialog : Validate day and time (L2-044)
dialog -> client : bookMeeting(request with idempotency key)
client -> controller : POST /api/requests/bookings
controller -> controller : Authenticate and apply [RequiresConfirmedEmail] (L2-005)
alt unconfirmed member
  controller --> client : 403 EMAIL_UNCONFIRMED
  client --> dialog : Blocked
else confirmed member
  controller -> handler : Send BookMeetingCommand
  handler -> db : Find a request of this member with the same idempotency key (L2-132)
  db --> handler : The first request (returned as it is) or nothing
  handler -> avail : IsOffered(day) and SlotsFor(day)
  avail --> handler : Offered or not
  alt slot no longer offered or invalid field
    handler --> controller : Validation failure
    controller --> client : 422 with per-field codes (DAY_UNAVAILABLE, TIME_UNAVAILABLE)
    client --> dialog : Field errors
    dialog --> actor : Show the field error and the times that are left
  else slot offered
    handler -> entity : Create booking with status New (L2-043)
    entity --> handler : Request and first RequestTransition
    handler -> db : Save request, owner notification and outbox e-mail in one unit of work
    db --> handler : Commit result
    handler --> controller : BookedRequestDto
    controller --> client : 201 Created
    client --> dialog : Request ID
    dialog --> actor : Show "Request sent to {business}" with "Close" and "View request"
    outbox -> db : Read due outbox messages
    db --> outbox : Messages
    outbox --> owner : E-mail (L2-044); the in-app notification is already saved
  end
end
@enduml
