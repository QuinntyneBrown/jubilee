@startuml
title UML sequence behaviour — add to calendar
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "RequestDetailPage" as page
  participant "RequestsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "RequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetBookingCalendarQueryHandler" as handler
  participant "CalendarFileBuilder" as builder
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Press "Add to calendar"
page -> client : calendarUrl(requestId)
client -> controller : GET /api/requests/{id}/calendar.ics
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send GetBookingCalendarQuery
handler -> db : Load booking owned by the caller (L2-133)
db --> handler : Request with BookingDetails or nothing
alt booking not found for this member
  handler --> controller : Not found
  controller --> client : 404 ProblemDetails
  client --> page : Error
else booking found
  handler -> builder : Build(request, businessName, requestUrl)
  alt status is Cancelled
    builder --> handler : Event with STATUS:CANCELLED (L2-050)
  else status is Confirmed or Completed
    builder --> handler : Event with title, start and end in America/Toronto, location or "Video" (L2-050)
  end
  handler --> controller : Calendar file
  controller --> client : 200 text/calendar attachment
  client --> page : File download
  page --> actor : Calendar file saved
end
@enduml
