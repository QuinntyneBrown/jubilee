@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Book a meeting

enum RequestKind {
  Booking
  Quote
  Order
  Space
}

enum RequestStatus {
  New
  Confirmed
  Declined
  Cancelled
  Completed
}

enum MeetingMode {
  Video
  InPerson
}

class Request {
  +Guid Id
  +RequestKind Kind
  +RequestStatus Status
  +string MemberSubject
  +string MemberName
  +Guid ListingId
  +string IdempotencyKey
  +Guid? ServiceId
  +string? ServiceName
  +DateTimeOffset? StartsAt
  +DateTimeOffset? EndsAt
  +MeetingMode? Mode
  +string? Location
  +string? Note
  +DateTimeOffset CreatedAt
  +{static} Book(...): Request
  +Confirm(actor: string, now: DateTimeOffset): void
  +UndoConfirm(actor: string, now: DateTimeOffset): void
  +Decline(actor: string, now: DateTimeOffset): void
  +Cancel(actor: string, now: DateTimeOffset): void
  +UndoCancel(actor: string, now: DateTimeOffset): void
  +Complete(actor: string, now: DateTimeOffset): void
}

class RequestTransition {
  +Guid Id
  +RequestStatus From
  +RequestStatus To
  +string Actor
  +DateTimeOffset At
  +DateTimeOffset? UndoableUntil
}

class Listing {
  +int MeetingDays
  +TimeOnly? MeetingOpensAt
  +TimeOnly? MeetingClosesAt
  +int? MeetingSlotMinutes
  +string? MeetingArea
  +MeetsOn(day: DayOfWeek): bool
  +SetMeetingHours(days: int, opensAt: TimeOnly, closesAt: TimeOnly, slotMinutes: int): void
}

class BookMeetingCommand {
  +string Subject
  +string Name
  +string ListingSlug
  +Guid ServiceId
  +string? Day
  +string? Time
  +string? Mode
  +string? Note
  +string? IdempotencyKey
}

class BookMeetingCommandHandler {
  +Handle(command: BookMeetingCommand): Task<BookedRequestDto>
}

class BookingAvailability <<static>> {
  +MaxDaysAhead: int
  +DefaultSlots: string[]
  +IsOffered(listing: Listing, day: DateOnly, now: DateTimeOffset): bool
  +SlotsFor(listing: Listing, length: TimeSpan, day: DateOnly, now: DateTimeOffset): IReadOnlyList<string>
  +LengthOf(service: Service): TimeSpan
  +MeetsOn(listing: Listing): string
}

class SetMeetingHoursCommand {
  +string Subject
  +IReadOnlyList<int>? Days
  +string? OpensAt
  +string? ClosesAt
  +int? SlotMinutes
}

class SetMeetingHoursCommandHandler {
  +Handle(command: SetMeetingHoursCommand): Task<MeetingHoursDto>
}

class MeetingHoursDto {
  +IReadOnlyList<int> Days
  +string OpensAt
  +string ClosesAt
  +int SlotMinutes
  +string MeetsOn
  +bool OwnerSet
}

class CalendarFileBuilder <<static>> {
  +Build(request: Request, business: string, publicBaseUrl: string, now: DateTimeOffset): string
}

Request "1" *-- "0..*" RequestTransition : records
Request --> RequestKind : has
Request --> RequestStatus : has
Request --> MeetingMode : has
BookMeetingCommandHandler ..> BookMeetingCommand : handles
BookMeetingCommandHandler ..> BookingAvailability : checks slot
BookMeetingCommandHandler --> Request : creates
BookingAvailability ..> Listing : reads meeting hours
SetMeetingHoursCommandHandler ..> SetMeetingHoursCommand : handles
SetMeetingHoursCommandHandler --> Listing : sets meeting hours
SetMeetingHoursCommandHandler ..> MeetingHoursDto : returns
CalendarFileBuilder ..> Request : reads
@enduml
