@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Book a meeting

Container_Boundary(web, "Jubilee Web") {
  Component(dialog, "BookMeetingDialog", "Angular dialog", "Collects service and day and mode and time and note")
  Component(hours, "MeetingHoursDialog", "Angular dialog", "The owner sets days and hours and slot length")
  Component(client, "RequestsApi", "Typed HTTP client", "Calls the booking endpoints")
  Component(catalogue, "CatalogueApi", "Typed HTTP client", "Calls the owner's services endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(listingCtrl, "ListingBookingController", "ASP.NET Core controller", "Exposes the booking options and availability of a listing")
  Component(ctrl, "RequestsController", "ASP.NET Core controller", "Exposes /api/requests endpoints")
  Component(ownerCtrl, "CatalogueController", "ASP.NET Core controller", "Exposes /api/my-business/meeting-hours")
  Component(handler, "BookMeetingCommandHandler", "MediatR handler", "Creates the booking request once per idempotency key")
  Component(availQuery, "GetAvailabilityQueryHandler", "MediatR handler", "Gives the slots of one day")
  Component(setHours, "SetMeetingHoursCommandHandler", "MediatR handler", "Validates and saves the owner's meeting hours")
  Component(avail, "BookingAvailability", "Application rules", "Computes slots from the listing's meeting hours")
  Component(entity, "Request", "Domain entity", "Owns the request lifecycle")
  Component(cal, "GetBookingCalendarQueryHandler", "MediatR handler", "Builds the iCalendar file with CalendarFileBuilder")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(outbox, "OutboxDispatcherJob", "Hosted job", "Sends the owner's e-mail from the outbox")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Listings and requests and notifications and outbox")

Rel(dialog, client, "Loads slots and sends booking through")
Rel(hours, catalogue, "Saves hours through")
Rel(client, listingCtrl, "Calls", "JSON/HTTPS")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(catalogue, ownerCtrl, "Calls", "JSON/HTTPS")
Rel(listingCtrl, availQuery, "Sends GetAvailabilityQuery")
Rel(ctrl, handler, "Sends BookMeetingCommand")
Rel(ctrl, cal, "Sends GetBookingCalendarQuery")
Rel(ownerCtrl, setHours, "Sends SetMeetingHoursCommand")
Rel(availQuery, avail, "Reads slots from")
Rel(handler, avail, "Checks slot with")
Rel(handler, entity, "Creates")
Rel(handler, db, "Persists request and notification and outbox", "EF Core")
Rel(setHours, db, "Saves the listing's hours", "EF Core")
Rel(cal, db, "Reads booking", "EF Core")
Rel(outbox, db, "Reads outbox", "EF Core")
@enduml
