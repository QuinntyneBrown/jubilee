@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Track requests

Container_Boundary(web, "Jubilee Web") {
  Component(list, "RequestsPage", "Angular page", "Lists requests at /requests")
  Component(detail, "RequestDetailPage", "Angular page", "Shows one request at /requests/:id")
  Component(store, "RequestsStore", "Signal store", "Holds list pages and counts and the open request")
  Component(client, "RequestsApi", "Typed HTTP client", "Calls GET /api/requests")
  Component(rt, "RealtimeClient", "Angular service", "Receives request events")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "RequestsController", "ASP.NET Core controller", "Exposes /api/requests endpoints")
  Component(lq, "ListRequestsQueryHandler", "MediatR handler", "Orders and pages the caller's requests")
  Component(gq, "GetRequestQueryHandler", "MediatR handler", "Returns one request with its transitions")
  Component(entity, "Request", "Domain entity", "Owns the request lifecycle")
  Component(hub, "EventsHub", "SignalR hub", "Pushes request events to their member")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(done, "BookingCompletionJob", "Hosted job", "Completes bookings after the meeting end time")
  Component(stale, "UnansweredRequestJob", "Hosted job", "Handles new requests unanswered after 7 days")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Requests and transitions and outbox")

Rel(list, store, "Reads")
Rel(detail, store, "Reads")
Rel(store, client, "Loads through")
Rel(rt, store, "Applies events to")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(hub, rt, "Pushes events", "WebSocket")
Rel(ctrl, lq, "Sends ListRequestsQuery")
Rel(ctrl, gq, "Sends GetRequestQuery")
Rel(lq, db, "Reads", "EF Core")
Rel(gq, db, "Reads", "EF Core")
Rel(done, entity, "Calls Complete on")
Rel(stale, entity, "Marks nudged")
Rel(done, db, "Reads and writes", "EF Core")
Rel(stale, db, "Reads and writes", "EF Core")
@enduml
