@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Track requests

Container_Boundary(web, "Jubilee Web") {
  Component(list, "RequestsPage", "Angular page", "Lists requests at /requests")
  Component(detail, "RequestDetailPage", "Angular page", "Shows one request at /requests/:id")
  Component(client, "RequestsApi", "Typed HTTP client (REQUESTS_API)", "Calls GET /api/requests")
  Component(rt, "RealtimeService", "Angular service", "Holds the event stream; brings request notifications")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "RequestsController", "ASP.NET Core controller", "Exposes /api/requests endpoints")
  Component(events, "EventsController", "ASP.NET Core controller", "Streams the member's notifications at GET /api/events")
  Component(lq, "ListRequestsQueryHandler", "MediatR handler", "Orders and pages the caller's requests")
  Component(gq, "GetRequestQueryHandler", "MediatR handler", "Returns one request with its timeline")
  Component(fulfil, "FulfilRequestCommandHandler", "MediatR handler", "Completes a confirmed order and tells the customer")
  Component(entity, "Request", "Domain entity", "Owns the request lifecycle")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(done, "BookingCompletionJob", "Hosted job", "Completes bookings after the meeting end time, once per 5 minutes")
  Component(stale, "UnansweredRequestJob", "Hosted job", "Reminds the owner of requests unanswered after 7 days, once per hour")
  Component(jobs, "ScheduledJobs", "Application service", "Runs each occurrence once across instances and records it in JobRun")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Requests, transitions, notifications, job runs and outbox")

Rel(list, client, "Loads through")
Rel(detail, client, "Loads through")
Rel(list, rt, "Reads again on a request notification")
Rel(detail, rt, "Reads again on its own notification")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(events, rt, "Pushes notifications and counts", "Server-sent events")
Rel(ctrl, lq, "Sends ListRequestsQuery")
Rel(ctrl, gq, "Sends GetRequestQuery")
Rel(lq, db, "Reads", "EF Core")
Rel(gq, db, "Reads", "EF Core")
Rel(events, db, "Reads notifications", "EF Core")
Rel(fulfil, entity, "Calls Complete on")
Rel(done, jobs, "Runs through")
Rel(stale, jobs, "Runs through")
Rel(done, entity, "Calls Complete on")
Rel(stale, entity, "Calls Nudge on")
Rel(jobs, db, "Claims and records runs", "EF Core")
@enduml
