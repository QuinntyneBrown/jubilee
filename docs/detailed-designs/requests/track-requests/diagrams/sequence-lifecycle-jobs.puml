@startuml
title UML sequence behaviour — automatic lifecycle steps
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Jubilee Worker" #D1FADF
  participant "BookingCompletionJob" as done
  participant "UnansweredRequestJob" as stale
  participant "OutboxDispatcherJob" as outbox
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ScheduledJobs" as jobs
  participant "Request" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor "Member" as member
actor "Owner" as owner
done -> jobs : RunBookingCompletionJobCommand (every minute)
jobs -> db : Claim this 5-minute occurrence in JobRun (L2-182)
alt another instance claimed it
  db --> jobs : Refused; nothing runs
else claimed
done -> db : Find Confirmed bookings whose meeting end time has passed
db --> done : Bookings
loop each booking
  done -> entity : Complete("system", now) (L2-043)
  entity --> done : Status Completed and RequestTransition recorded
end
done -> db : Save changes in one unit of work
db --> done : Commit result
jobs -> db : Record the run's success
end
stale -> jobs : RunUnansweredRequestJobCommand (every 10 minutes)
jobs -> db : Claim this hour in JobRun (L2-182)
stale -> db : Find New requests created 7 days ago or earlier with no NudgedAt
db --> stale : Requests
loop each request
  stale -> entity : Nudge(now) (L2-043)
  entity --> stale : NudgedAt set, status unchanged
end
stale -> db : Save changes, the owner's in-app reminder and one e-mail per request to the outbox (L2-182)
db --> stale : Commit result
jobs -> db : Record the run's success
outbox -> db : Read pending outbox messages
db --> outbox : Messages
outbox --> owner : One reminder about the unanswered request
member -> db : Opens the request: the detail offers "Cancel request" and "Ask again"
@enduml
