@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Track requests

enum RequestType {
  Booking
  Quote
  Order
}

enum RequestStatus {
  New
  Confirmed
  Declined
  Cancelled
  Completed
}

class Request {
  +Guid Id
  +RequestType Type
  +RequestStatus Status
  +Guid MemberId
  +Guid ListingId
  +Guid ConversationId
  +DeclineReason? DeclineReason
  +string? DeclineMessage
  +DateTimeOffset CreatedAt
  +DateTimeOffset? NudgedAt
  +Confirm(actorId: Guid, now: DateTimeOffset): void
  +Decline(actorId: Guid, reason: DeclineReason, message: string, now: DateTimeOffset): void
  +Cancel(actorId: Guid, now: DateTimeOffset): void
  +Complete(actorId: Guid?, now: DateTimeOffset): void
  +UndoLastTransition(actorId: Guid, now: DateTimeOffset): void
  +MarkNudged(now: DateTimeOffset): void
}

class RequestTransition {
  +Guid Id
  +RequestStatus? From
  +RequestStatus To
  +Guid? ActorId
  +DateTimeOffset OccurredAt
  +DateTimeOffset? UndoableUntil
}

Request "1" *-- "1..*" RequestTransition : records
Request --> RequestType : has
Request --> RequestStatus : has

class InvalidTransitionException {
  +RequestStatus From
  +string Attempted
  +string Code = "INVALID_TRANSITION"
}

class ListRequestsQuery {
  +Guid MemberId
  +RequestTab Tab
  +string? Cursor
  +int PageSize = 20
}

enum RequestTab {
  All
  Bookings
  Quotes
  Orders
  Declined
}

class ListRequestsQueryHandler {
  +Handle(query: ListRequestsQuery): Task<RequestListPage>
}

class RequestListPage {
  +IReadOnlyList<RequestListItemDto> Items
  +IReadOnlyDictionary<RequestTab, int> Counts
  +int OpenCount
  +int AwaitingReplyCount
  +string? NextCursor
}

class RequestListItemDto {
  +Guid Id
  +string Title
  +RequestType Type
  +string BusinessName
  +string DetailLine
  +RequestStatus Status
}

class GetRequestQueryHandler {
  +Handle(query: GetRequestQuery): Task<RequestDetailDto?>
}

class RequestDetailDto {
  +Guid Id
  +RequestStatus Status
  +string? DeclineMessage
  +bool OfferCancelOrAskAgain
  +IReadOnlyList<RequestTransition> Progress
}

Request ..> InvalidTransitionException : throws
ListRequestsQueryHandler ..> ListRequestsQuery : handles
ListRequestsQuery --> RequestTab : filters by
ListRequestsQueryHandler ..> RequestListPage : returns
RequestListPage "1" *-- "0..20" RequestListItemDto : contains
ListRequestsQueryHandler ..> Request : reads
GetRequestQueryHandler ..> Request : reads
GetRequestQueryHandler ..> RequestDetailDto : returns
@enduml
