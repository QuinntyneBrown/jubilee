@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Track requests

enum RequestKind {
  Booking
  Quote
  Order
  Space
}

enum RequestStatus {
  New
  Confirmed
  Declined
  Cancelled
  Completed
}

class Request {
  +Guid Id
  +RequestKind Kind
  +RequestStatus Status
  +string MemberSubject
  +string MemberName
  +Guid ListingId
  +DateTimeOffset CreatedAt
  +DateTimeOffset? StartsAt
  +DateTimeOffset? EndsAt
  +string? DeclineReason
  +string? DeclineMessage
  +DateTimeOffset? NudgedAt
  +{static} TimeSpan UndoWindow = 8 s
  +{static} TimeSpan UnansweredAfter = 7 days
  +Confirm(actor: string, now: DateTimeOffset): void
  +UndoConfirm(actor: string, now: DateTimeOffset): void
  +Decline(actor: string, now: DateTimeOffset, reason: string, message: string): void
  +Cancel(actor: string, now: DateTimeOffset): void
  +UndoCancel(actor: string, now: DateTimeOffset): void
  +Complete(actor: string, now: DateTimeOffset): void
  +IsUnanswered(now: DateTimeOffset): bool
  +Nudge(now: DateTimeOffset): void
}

class RequestTransition {
  +Guid Id
  +Guid RequestId
  +RequestStatus From
  +RequestStatus To
  +string Actor
  +DateTimeOffset At
  +DateTimeOffset? UndoableUntil
}

Request "1" *-- "1..*" RequestTransition : records
Request --> RequestKind : has
Request --> RequestStatus : has

class InvalidTransitionException {
  +RequestStatus From
  +RequestStatus To
}

class ListRequestsQuery {
  +string Subject
  +string? Tab
  +string? Cursor
}


class ListRequestsQueryHandler {
  +Handle(query: ListRequestsQuery): Task<MemberRequestsDto>
}

class MemberRequestsDto {
  +string Tab
  +MemberRequestCountsDto Counts
  +int Open
  +int Awaiting
  +IReadOnlyList<MemberRequestRowDto> Rows
  +string? NextCursor
}

class MemberRequestRowDto {
  +Guid Id
  +string Kind
  +string KindLabel
  +string Title
  +string Business
  +string? Detail
  +string Status
  +string StatusLabel
}

class GetRequestQueryHandler {
  +Handle(query: GetRequestQuery): Task<MemberRequestDetailDto>
}

class MemberRequestDetailDto {
  +Guid Id
  +string Status
  +CalloutDto Callout
  +bool CanCancel
  +bool CanAskAgain
  +bool Unanswered
  +IReadOnlyList<TimelineStepDto> Timeline
}

class FulfilRequestCommandHandler {
  +Handle(command: FulfilRequestCommand): Task<RequestDecisionDto>
}

class ScheduledJobs {
  +RunOnceAsync(job: string, every: TimeSpan, work): Task<bool>
  +LastSuccessAsync(job: string): Task<DateTimeOffset?>
}

class JobRun {
  +string Job
  +DateTimeOffset Occurrence
  +DateTimeOffset ClaimedAt
  +DateTimeOffset? SucceededAt
}

Request ..> InvalidTransitionException : throws
ListRequestsQueryHandler ..> ListRequestsQuery : handles
ListRequestsQueryHandler ..> MemberRequestsDto : returns
MemberRequestsDto "1" *-- "0..20" MemberRequestRowDto : contains
ListRequestsQueryHandler ..> Request : reads
GetRequestQueryHandler ..> Request : reads
GetRequestQueryHandler ..> MemberRequestDetailDto : returns
FulfilRequestCommandHandler --> Request : calls Complete
ScheduledJobs ..> JobRun : claims and records
@enduml
