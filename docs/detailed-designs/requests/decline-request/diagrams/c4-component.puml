@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Decline a request

Container_Boundary(web, "Jubilee Web") {
  Component(page, "IncomingRequestsPage", "Angular page", "Offers Decline on each new request and reads the list again")
  Component(dialog, "DeclineRequestDialog", "Angular CDK dialog", "Collects reason and required message")
  Component(toast, "ToastService", "Angular service", "Shows the declined toast or Request not declined")
  Component(client, "IncomingRequestsApi", "Service contract (INCOMING_REQUESTS_API)", "Calls the decline endpoint")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "IncomingRequestsController", "ASP.NET Core controller", "Exposes /api/my-business/requests and refuses unknown fields")
  Component(rules, "IncomingRules", "Application rules", "OwnedRequest passes for the owner of the listing only")
  Component(handler, "DeclineRequestCommandHandler", "MediatR handler", "Checks reason and message up to 1000 characters and applies the decline transition")
  Component(entity, "Request", "Domain entity", "Owns the request lifecycle")
  Component(tell, "NotificationRules", "Application rules", "Stores the customer's notification")
  Component(events, "EventsController", "Server-sent events", "Streams a member's own notifications")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(outbox, "OutboxDispatcherJob", "Hosted job", "Sends the customer's e-mail")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Requests and messages and notifications and outbox")

Rel(page, dialog, "Opens with DeclineRequestData")
Rel(dialog, client, "Declines through")
Rel(dialog, page, "Closes with the decision or the server's sentence")
Rel(page, client, "Reads the list again through")
Rel(page, toast, "Shows result toast with")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, handler, "Sends DeclineRequestCommand")
Rel(handler, rules, "Finds the owned request with")
Rel(handler, entity, "Calls Decline on")
Rel(handler, tell, "Tells the customer through")
Rel(handler, db, "Persists request and message and notification and outbox", "EF Core")
Rel(events, db, "Reads notifications", "EF Core")
Rel(outbox, db, "Reads outbox", "EF Core")
@enduml
