@startuml
title UML sequence behaviour — decline a request
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "IncomingRequestsPage" as page
  participant "DeclineRequestDialog" as dialog
  participant "IncomingRequestsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "IncomingRequestsController" as controller
  participant "EventsController" as events
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "DeclineRequestCommandHandler" as handler
  participant "Request" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as outbox
end box
actor "Member" as member
actor -> page : Press "Decline" on a new request
page -> dialog : Open with DeclineRequestData: the request row
dialog --> actor : Ask "Decline {customer}’s {type}?" with "Keep request" and "Decline request" (L2-129)
actor -> dialog : Choose a reason, write a message, press "Decline request"
dialog -> dialog : Require a message of at most 1,000 characters (L2-053)
alt message is empty
  dialog --> actor : Show "Write a short note so {customer} knows why and what to do next."
else message present
  dialog -> client : decline(requestId, reason, message)
  client -> controller : POST /api/my-business/requests/{id}/decline
  controller -> controller : Authenticate the session cookie; DeclineRequestBody refuses unknown fields
  controller -> handler : Send DeclineRequestCommand(subject, requestId, reason, message)
  handler -> db : IncomingRules.OwnedRequest: load request with transitions and its listing (L2-133)
  db --> handler : Current state
  handler -> handler : Check the message (1 to 1,000 characters) and the reason (one of Request.DeclineReasons)
  handler -> entity : Decline(actor, now, reason, message): New to Declined (L2-043)
  entity --> handler : Status Declined, reason and message stored, RequestTransition recorded
  handler -> handler : TellCustomer: message keyed request:{id}:declined; QueueEmail: Notification and e-mail
  handler -> db : Save request, message, Notification and OutboxMessage in one SaveChangesAsync
  db --> handler : Commit result
  handler --> controller : RequestDecisionDto
  controller --> client : 200 OK
  client --> dialog : RequestDecision
  dialog --> page : Close with the decision
  page -> client : list(tab), without the loading state
  client --> page : IncomingRequests with the row under Declined
  page --> actor : Show updated tabs and counts and the toast "{Type} declined. {Customer} has been told and can reply in Messages."
  events -> db : Read the member's new notifications
  events --> member : notification event on the open page (L2-070)
  outbox -> db : Read due outbox messages
  db --> outbox : Messages
  outbox --> member : E-mail "{Business} declined your {noun}" with the decline message
end
@enduml
