@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Decline a request

enum RequestKind {
  Booking
  Quote
  Order
  Space
}

enum RequestStatus {
  New
  Confirmed
  Declined
  Cancelled
  Completed
}

class Request {
  +Guid Id
  +RequestKind Kind
  +RequestStatus Status
  +string MemberSubject
  +string MemberName
  +Guid ListingId
  +string? DeclineReason
  +string? DeclineMessage
  +DateTimeOffset CreatedAt
  +{static} int MaxNoteLength = 1000
  +{static} string[] DeclineReasons
  +Confirm(actor: string, now: DateTimeOffset): void
  +UndoConfirm(actor: string, now: DateTimeOffset): void
  +Decline(actor: string, now: DateTimeOffset, reason: string, message: string): void
  +Cancel(actor: string, now: DateTimeOffset): void
  +UndoCancel(actor: string, now: DateTimeOffset): void
  +Complete(actor: string, now: DateTimeOffset): void
}

class RequestTransition {
  +Guid Id
  +RequestStatus From
  +RequestStatus To
  +string Actor
  +DateTimeOffset At
  +DateTimeOffset? UndoableUntil
}

Request "1" *-- "1..*" RequestTransition : records
Request --> RequestKind : has
Request --> RequestStatus : has

class InvalidTransitionException {
  +RequestStatus From
  +RequestStatus To
}

class ConflictException {
  +string Code
  +IReadOnlyDictionary<string, string>? Facts
}

class ValidationFailedException {
  +IReadOnlyDictionary<string, string> Errors
}

class IncomingRules <<static>> {
  +{static} OwnedRequest(db: IAppDbContext, subject: string, id: Guid): Task<(Request, Listing)>
  +{static} Invalid(request: Request): ConflictException
  +{static} TellCustomer(...): void
  +{static} QueueEmail(...): Task
}

class DeclineRequestBody {
  +string? Reason
  +string? Message
}

class DeclineRequestCommand {
  +string Subject
  +Guid RequestId
  +string? Reason
  +string? Message
}

class DeclineRequestCommandHandler {
  +Handle(command: DeclineRequestCommand): Task<RequestDecisionDto>
}

class RequestDecisionDto {
  +Guid Id
  +string Status
  +string StatusLabel
  +string Kind
  +string CustomerFirstName
  +DateTimeOffset? UndoUntil
}

class Conversation {
  +Guid Id
  +Guid ListingId
  +string MemberSubject
  +{static} Start(...): Conversation
}

class Message {
  +Guid ConversationId
  +bool FromOwner
  +string? IdempotencyKey
  +{static} Send(...): Message
}

class Notification {
  +string MemberSubject
  +string Kind
  +string Title
  +string Detail
  +string Target
  +Guid? CorrelationId
}

class OutboxMessage {
  +Guid Id
  +string ToAddress
  +string Subject
  +string TextBody
  +DateTimeOffset NextAttemptAt
  +Guid? CorrelationId
}

Request ..> InvalidTransitionException : throws
IncomingRules ..> ConflictException : builds INVALID_TRANSITION
DeclineRequestBody ..> DeclineRequestCommand : becomes
DeclineRequestCommandHandler ..> DeclineRequestCommand : handles
DeclineRequestCommandHandler ..> IncomingRules : finds the owned request with
DeclineRequestCommandHandler ..> ValidationFailedException : throws for reason or message
DeclineRequestCommandHandler --> Request : calls Decline
DeclineRequestCommandHandler ..> RequestDecisionDto : returns
DeclineRequestCommandHandler --> Message : writes the decline message
Conversation "1" *-- "*" Message : holds
DeclineRequestCommandHandler ..> Notification : tells the customer with
DeclineRequestCommandHandler ..> OutboxMessage : queues the e-mail
@enduml
