@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Decline a request

enum RequestType {
  Booking
  Quote
  Order
}

enum RequestStatus {
  New
  Confirmed
  Declined
  Cancelled
  Completed
}

class Request {
  +Guid Id
  +RequestType Type
  +RequestStatus Status
  +Guid MemberId
  +Guid ListingId
  +Guid ConversationId
  +DeclineReason? DeclineReason
  +string? DeclineMessage
  +DateTimeOffset CreatedAt
  +DateTimeOffset? NudgedAt
  +Confirm(actorId: Guid, now: DateTimeOffset): void
  +Decline(actorId: Guid, reason: DeclineReason, message: string, now: DateTimeOffset): void
  +Cancel(actorId: Guid, now: DateTimeOffset): void
  +Complete(actorId: Guid?, now: DateTimeOffset): void
  +UndoLastTransition(actorId: Guid, now: DateTimeOffset): void
  +MarkNudged(now: DateTimeOffset): void
}

class RequestTransition {
  +Guid Id
  +RequestStatus? From
  +RequestStatus To
  +Guid? ActorId
  +DateTimeOffset OccurredAt
  +DateTimeOffset? UndoableUntil
}

Request "1" *-- "1..*" RequestTransition : records
Request --> RequestType : has
Request --> RequestStatus : has

enum DeclineReason {
  CantMeetDate
  OutOfStock
  OutsideOffer
  SomethingElse
}

class InvalidTransitionException {
  +RequestStatus From
  +string Attempted
  +string Code = "INVALID_TRANSITION"
}

class DeclineRequestCommand {
  +Guid RequestId
  +Guid ActorId
  +DeclineReason Reason
  +string Message
}

class DeclineRequestCommandValidator {
  +int MessageMaxLength = 1000
  +Validate(command: DeclineRequestCommand): ValidationResult
}

class DeclineRequestCommandHandler {
  +Handle(command: DeclineRequestCommand): Task<RequestStatus>
}

class RequestDeclinedEvent {
  +Guid RequestId
  +Guid MemberId
  +DeclineReason Reason
  +string Message
}

class Conversation {
  +Guid Id
  +Guid MemberId
  +Guid ListingId
  +AppendRequestCard(request: Request, text: string?, now: DateTimeOffset): void
}

Request --> DeclineReason : has
Request ..> InvalidTransitionException : throws
Request "*" --> "1" Conversation : linked to
DeclineRequestCommandHandler ..> DeclineRequestCommand : handles
DeclineRequestCommandValidator ..> DeclineRequestCommand : validates
DeclineRequestCommand --> DeclineReason : carries
DeclineRequestCommandHandler --> Request : calls Decline
DeclineRequestCommandHandler --> Conversation : appends decline card
DeclineRequestCommandHandler ..> RequestDeclinedEvent : writes to outbox
@enduml
