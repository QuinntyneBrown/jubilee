@startuml
title UML sequence behaviour — a decline fails
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "IncomingRequestsPage" as page
  participant "DeclineRequestDialog" as dialog
  participant "IncomingRequestsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "IncomingRequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "DeclineRequestCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> dialog : Press "Decline request" with a reason and a message
dialog -> client : decline(requestId, reason, message)
client -> controller : POST /api/my-business/requests/{id}/decline
alt connection drops or the server fails
  controller --> client : No response or 5xx ProblemDetails
  client --> dialog : Error
  dialog --> actor : Show "We couldn’t send your decline. The request is still new and your note is kept. Try again." (L2-128)
  actor -> dialog : Press "Decline request" again
  dialog -> client : decline(requestId, same reason and message)
  client -> controller : POST /api/my-business/requests/{id}/decline
  controller --> client : Result of the retry
  client --> dialog : Result
else body carries a field it may not set, such as status
  controller --> client : 400 ProblemDetails (L2-133)
  client --> dialog : Error
  dialog --> actor : Show the failure alert and keep the reason and the message
else request belongs to another business
  controller -> handler : Send DeclineRequestCommand
  handler -> db : IncomingRules.OwnedRequest: load request and its listing
  db --> handler : Listing of another owner
  handler --> controller : ForbiddenException (L2-133)
  controller --> client : 403 ProblemDetails, code FORBIDDEN
  client --> dialog : Error
  dialog --> actor : Show the failure alert; nothing is declined
else reason or message refused by the server
  controller -> handler : Send DeclineRequestCommand
  handler --> controller : ValidationFailedException, reason INVALID or message REQUIRED or TOO_LONG
  controller --> client : 422 with per-field code
  client --> dialog : Error
  dialog --> actor : Show the failure alert and keep the reason and the message
else request is no longer New
  controller -> handler : Send DeclineRequestCommand
  handler -> db : IncomingRules.OwnedRequest: load request and its listing
  db --> handler : Current state, for example Cancelled
  handler --> controller : IncomingRules.Invalid, request unchanged (L2-043)
  controller --> client : 409 INVALID_TRANSITION with the sentence and requestStatus
  client --> dialog : Conflict
  dialog --> page : Close with the server's sentence (L2-053)
  page -> client : list(tab), without the loading state
  client --> page : IncomingRequests
  page --> actor : Show danger toast "Request not declined" with "{Customer} cancelled this request."
end
@enduml
