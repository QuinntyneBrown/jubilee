@startuml
title UML sequence behaviour — a decline fails
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "DeclineRequestDialog" as dialog
  participant "RequestsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "IncomingRequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "DeclineRequestCommandHandler" as handler
  participant "Request" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> dialog : Press "Decline request" with a reason and a message
dialog -> client : decline(requestId, reason, message)
client -> controller : POST /api/my-business/requests/{id}/decline
alt connection drops or the server fails
  controller --> client : No response or 5xx ProblemDetails
  client --> dialog : Error
  dialog --> actor : Show "We couldn't send your decline. The request is still new and your note is kept. Try again." (L2-128)
  actor -> dialog : Press "Decline request" again
  dialog -> client : decline(requestId, same reason and message)
  client -> controller : POST /api/my-business/requests/{id}/decline
  controller --> client : Result of the retry
  client --> dialog : Result
else caller is not the owner or a co-owner
  controller -> controller : Apply ListingOwnerPolicy (L2-133)
  controller --> client : 403 ProblemDetails
  client --> dialog : Forbidden
  dialog --> actor : Close and show the forbidden page
else request is no longer New
  controller -> handler : Send DeclineRequestCommand
  handler -> db : Load request
  db --> handler : Current state
  handler -> entity : Decline(actor, reason, message, now)
  entity --> handler : InvalidTransitionException, request unchanged (L2-043)
  handler --> controller : Conflict with current status
  controller --> client : 409 INVALID_TRANSITION
  client --> dialog : Current status
  dialog --> actor : Close and reload the row
end
@enduml
