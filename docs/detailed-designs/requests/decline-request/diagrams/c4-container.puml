@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Decline a request

Person(member, "Member", "Is told the request is declined and why")
Person(owner, "Owner", "Declines a new request with a message")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Incoming requests page and decline dialog")
  Container(api, "Jubilee API", "ASP.NET Core", "HTTPS JSON API under /api and the event stream /api/events")
  Container(worker, "Jubilee Worker", ".NET worker service", "Outbox dispatch and mail sending")
  ContainerDb(db, "Jubilee database", "SQL Server", "Requests and messages and notifications and outbox")
}
System_Ext(email, "E-mail provider", "Delivers the decline mail")

Rel(member, web, "Uses", "HTTPS")
Rel(owner, web, "Uses", "HTTPS")
Rel(web, api, "Calls and subscribes", "JSON/HTTPS and server-sent events")
Rel(api, db, "Reads and writes", "EF Core")
Rel(worker, db, "Reads outbox", "EF Core")
Rel(worker, email, "Sends mail via")
@enduml
