@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Decline a request

Person(member, "Member", "Is told the request is declined and why")
Person(owner, "Owner", "Declines a new request with a message")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Incoming requests page and decline dialog")
  Container(api, "Jubilee API", "ASP.NET Core", "HTTPS JSON API under /api and real-time hub")
  Container(worker, "Jubilee Worker", ".NET worker service", "Outbox dispatch and mail sending")
  ContainerDb(db, "Jubilee database", "SQL Server", "Requests and conversations and outbox")
  ContainerDb(cache, "Cache", "Redis", "Sessions")
}
System_Ext(email, "E-mail provider", "Delivers the decline mail")

Rel(member, web, "Uses", "HTTPS")
Rel(owner, web, "Uses", "HTTPS")
Rel(web, api, "Calls and subscribes", "JSON/HTTPS and WebSocket")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, cache, "Reads session")
Rel(worker, db, "Reads outbox", "EF Core")
Rel(worker, api, "Publishes real-time events through EventsHub")
Rel(worker, email, "Sends mail via")
@enduml
