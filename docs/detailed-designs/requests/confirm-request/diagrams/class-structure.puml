@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Confirm a request

enum RequestKind {
  Booking
  Quote
  Order
  Space
}

enum RequestStatus {
  New
  Confirmed
  Declined
  Cancelled
  Completed
}

class Request {
  +Guid Id
  +RequestKind Kind
  +RequestStatus Status
  +string MemberSubject
  +string MemberName
  +Guid ListingId
  +Guid? ServiceId
  +string? ServiceName
  +string? OptionLabel
  +int? Quantity
  +int? TotalCents
  +DateTimeOffset CreatedAt
  +{static} TimeSpan UndoWindow = 8 seconds
  +Confirm(actor: string, now: DateTimeOffset): void
  +UndoConfirm(actor: string, now: DateTimeOffset): void
  +Decline(actor: string, now: DateTimeOffset, reason: string, message: string): void
  +Cancel(actor: string, now: DateTimeOffset): void
  +UndoCancel(actor: string, now: DateTimeOffset): void
  +Complete(actor: string, now: DateTimeOffset): void
}

class RequestTransition {
  +Guid Id
  +RequestStatus From
  +RequestStatus To
  +string Actor
  +DateTimeOffset At
  +DateTimeOffset? UndoableUntil
}

Request "1" *-- "1..*" RequestTransition : records
Request --> RequestKind : has
Request --> RequestStatus : has

class InvalidTransitionException {
  +RequestStatus From
  +RequestStatus To
}

class ConflictException {
  +string Code
  +IReadOnlyDictionary<string, string> Facts
}

class IncomingRules <<static>> {
  +{static} OwnedRequest(db: IAppDbContext, subject: string, id: Guid): Task<(Request, Listing)>
  +{static} Invalid(request: Request): ConflictException
  +{static} TellCustomer(...): void
  +{static} QueueEmail(...): Task
}

class ConfirmRequestCommand {
  +string Subject
  +Guid RequestId
}

class ConfirmRequestCommandHandler {
  +Handle(command: ConfirmRequestCommand): Task<RequestDecisionDto>
  +{static} ConfirmedKey(requestId: Guid): string
}

class RequestDecisionDto {
  +Guid Id
  +string Status
  +string StatusLabel
  +string Kind
  +string CustomerFirstName
  +DateTimeOffset? UndoUntil
}

class UndoConfirmRequestCommand {
  +string Subject
  +Guid RequestId
}

class UndoConfirmRequestCommandHandler {
  +Handle(command: UndoConfirmRequestCommand): Task<RequestDecisionDto>
}

class Product {
  +Guid Id
  +string Name
  +int? Stock
  +ReduceStock(optionLabel: string?, quantity: int): void
  +RestoreStock(optionLabel: string?, quantity: int): StockChange
}

class InsufficientStockException {
  +int Available
  +int Requested
}

class OutboxMessage {
  +Guid Id
  +string ToAddress
  +string Subject
  +string TextBody
  +DateTimeOffset NextAttemptAt
  +DateTimeOffset? SentAt
  +DateTimeOffset? FailedAt
  +Guid? CorrelationId
  +{static} Email(...): OutboxMessage
  +IsDue(now: DateTimeOffset): bool
}

class Notification {
  +string MemberSubject
  +string Kind
  +string Title
  +string Detail
  +string Target
  +DateTimeOffset? ReadAt
  +Guid? CorrelationId
}

Request ..> InvalidTransitionException : throws
Product ..> InsufficientStockException : throws
IncomingRules ..> ConflictException : builds INVALID_TRANSITION
ConfirmRequestCommandHandler ..> ConfirmRequestCommand : handles
ConfirmRequestCommandHandler ..> IncomingRules : finds the owned request with
ConfirmRequestCommandHandler --> Request : calls Confirm
ConfirmRequestCommandHandler --> Product : reduces stock
ConfirmRequestCommandHandler ..> ConflictException : throws INSUFFICIENT_STOCK
ConfirmRequestCommandHandler ..> RequestDecisionDto : returns
ConfirmRequestCommandHandler ..> OutboxMessage : queues with the undo window as delay
ConfirmRequestCommandHandler ..> Notification : tells the customer with
UndoConfirmRequestCommandHandler ..> UndoConfirmRequestCommand : handles
UndoConfirmRequestCommandHandler ..> IncomingRules : finds the owned request with
UndoConfirmRequestCommandHandler --> Request : calls UndoConfirm
UndoConfirmRequestCommandHandler --> Product : restores stock
UndoConfirmRequestCommandHandler ..> RequestDecisionDto : returns
UndoConfirmRequestCommandHandler ..> OutboxMessage : removes unsent
UndoConfirmRequestCommandHandler ..> Notification : removes unread
@enduml
