@startuml
title UML sequence behaviour — undo a confirm
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ToastService" as toast
  participant "RequestsApi" as client
  participant "IncomingRequestsPage" as page
end box
box "Backend — Jubilee API" #D1FADF
  participant "IncomingRequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "UndoConfirmRequestCommandHandler" as handler
  participant "Request" as entity
  participant "Product" as product
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> toast : Press "Undo" within 8 seconds
toast -> client : undoConfirm(requestId)
client -> controller : POST /api/my-business/requests/{id}/confirm/undo
controller -> controller : Authenticate and apply ListingOwnerPolicy (L2-133)
controller -> handler : Send UndoConfirmRequestCommand
handler -> db : Load request, last transition, product and pending outbox messages
db --> handler : Current state
handler -> entity : UndoLastTransition(actor, now) (L2-052)
alt same actor and before UndoableUntil
  entity --> handler : Status New, RequestTransition recorded
  opt request type is Order
    handler -> product : RestoreStock(option, quantity)
    product --> handler : Stock restored
  end
  opt e-mail OutboxMessage not yet dispatched
    handler -> db : Cancel the e-mail message and withdraw the customer's notification (L2-052)
    db --> handler : Cancelled
  end
  handler -> db : Save changes in one unit of work
  db --> handler : Commit result
  handler --> controller : Status New
  controller --> client : 200 OK
  client --> page : Status New
  page --> actor : Show the request under New again
else undo window has passed
  entity --> handler : InvalidTransitionException
  handler --> controller : Conflict
  controller --> client : 409 INVALID_TRANSITION
  client --> page : Still confirmed
  page --> actor : Show the request as confirmed
end
@enduml
