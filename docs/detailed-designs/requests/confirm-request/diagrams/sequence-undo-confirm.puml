@startuml
title UML sequence behaviour — undo a confirm
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ToastService" as toast
  participant "IncomingRequestsPage" as page
  participant "IncomingRequestsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "IncomingRequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "UndoConfirmRequestCommandHandler" as handler
  participant "Request" as entity
  participant "Product" as product
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> toast : Press "Undo" within 8 seconds
toast -> page : Run the action of the toast
page -> client : undoConfirm(requestId)
client -> controller : POST /api/my-business/requests/{id}/confirm/undo
controller -> controller : Authenticate the session cookie
controller -> handler : Send UndoConfirmRequestCommand(subject, requestId)
handler -> db : IncomingRules.OwnedRequest: load request with transitions and its listing (L2-133)
db --> handler : Current state
handler -> entity : UndoConfirm(actor, now) (L2-052)
alt same actor and before UndoableUntil
  entity --> handler : Status New, RequestTransition recorded
  opt request kind is Order
    handler -> product : RestoreStock(optionLabel, quantity)
    product --> handler : StockChange
  end
  handler -> db : Remove the message keyed request:{id}:confirmed, the unsent OutboxMessage rows and the customer's unread Notification (L2-052)
  handler -> db : Save changes in one SaveChangesAsync
  db --> handler : Commit result
  handler --> controller : RequestDecisionDto with status new
  controller --> client : 200 OK
  client --> page : RequestDecision
  page -> page : Read the list again
  page --> actor : Show the request under New again and the toast "Confirmation undone"
else undo window has passed, or another actor
  entity --> handler : InvalidTransitionException
  handler --> controller : IncomingRules.Invalid
  controller --> client : 409 INVALID_TRANSITION
  client --> page : Error
  page --> actor : Show danger toast "Couldn’t undo the confirmation"; the request stays confirmed
end
@enduml
