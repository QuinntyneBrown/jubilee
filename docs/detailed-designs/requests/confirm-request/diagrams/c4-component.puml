@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Confirm a request

Container_Boundary(web, "Jubilee Web") {
  Component(page, "IncomingRequestsPage", "Angular page", "Offers Confirm on each new request and reports the answer in a toast")
  Component(dialog, "ConfirmRequestDialog", "Angular CDK dialog", "States the commitment and confirms")
  Component(toast, "ToastService", "Angular service", "Shows the success toast with Undo for 8 seconds")
  Component(client, "IncomingRequestsApi", "Service contract (INCOMING_REQUESTS_API)", "Calls the confirm and undo endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "IncomingRequestsController", "ASP.NET Core controller", "Exposes /api/my-business/requests")
  Component(rules, "IncomingRules", "Application rules", "OwnedRequest passes for the owner of the listing only")
  Component(confirm, "ConfirmRequestCommandHandler", "MediatR handler", "Applies the confirm transition")
  Component(undo, "UndoConfirmRequestCommandHandler", "MediatR handler", "Returns the request to new")
  Component(entity, "Request", "Domain entity", "Owns the request lifecycle")
  Component(product, "Product", "Domain entity", "Owns stock")
  Component(tell, "NotificationRules", "Application rules", "Stores the customer's notification")
  Component(events, "EventsController", "Server-sent events", "Streams a member's own notifications")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(outbox, "OutboxDispatcherJob", "Hosted job", "Sends the customer's e-mail after the undo window")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Requests and products and messages and notifications and outbox")

Rel(page, dialog, "Opens with ConfirmRequestData")
Rel(dialog, client, "Confirms through")
Rel(dialog, page, "Closes with the decision or hands it over through settled")
Rel(page, toast, "Shows result toast with")
Rel(toast, page, "Runs Undo or Try again on")
Rel(page, client, "Undoes and confirms again through")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, confirm, "Sends ConfirmRequestCommand")
Rel(ctrl, undo, "Sends UndoConfirmRequestCommand")
Rel(confirm, rules, "Finds the owned request with")
Rel(undo, rules, "Finds the owned request with")
Rel(confirm, entity, "Calls Confirm on")
Rel(confirm, product, "Reduces stock of")
Rel(confirm, tell, "Tells the customer through")
Rel(undo, entity, "Calls UndoConfirm on")
Rel(undo, product, "Restores stock of")
Rel(confirm, db, "Persists", "EF Core")
Rel(undo, db, "Persists and removes the unsent e-mail", "EF Core")
Rel(events, db, "Reads notifications", "EF Core")
Rel(outbox, db, "Reads outbox", "EF Core")
@enduml
