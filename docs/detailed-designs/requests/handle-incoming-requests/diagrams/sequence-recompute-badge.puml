@startuml
title UML sequence behaviour — recompute the badge
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Jubilee Worker" #D1FADF
  participant "ResponseTimeBadgeJob" as job
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ScheduledJobs" as once
  participant "RecomputeResponseTimesCommandHandler" as calc
  participant "ResponseTimeStat" as stat
  participant "ResponseTimes" as fast
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Frontend — Jubilee Web" #E0F2FE
  participant "BusinessPage and BusinessCard" as card
end box
actor "Member" as member
job -> job : Tick every ten minutes
job -> once : Send RunResponseTimeBadgeJobCommand; RunOnceAsync for this job and the start of the hour in UTC (L2-182)
once -> db : Insert JobRun with key (Job, Occurrence) and ClaimedAt
alt another instance already claimed the hour
  db --> once : Row found, or the insert refused by the key
  once --> job : Nothing done
else this instance claims the hour
  db --> once : JobRun inserted
  once -> calc : Send RecomputeResponseTimesCommand
  calc -> db : Read live listings, requests with transitions, conversations, messages and stats
  db --> calc : Stored data
  loop each live listing
    calc -> calc : Gather first responses to requests and messages in the last 30 days
    calc -> stat : Set(responses, now), or Compute for a listing without a stat
    stat -> stat : Take the median and the count
    alt median under 24 hours and at least 3 responses
      stat --> calc : RepliesFast = true (L2-054)
    else median 24 hours or more, or fewer than 3 responses
      stat --> calc : RepliesFast = false (L2-054)
    end
  end
  calc -> db : Save stats in one SaveChangesAsync
  db --> calc : Commit result
  alt the work ended
    calc --> once : Count of listings
    once -> db : Set SucceededAt on the JobRun, the job's last success (L2-182)
    once --> job : Done
  else the work threw
    calc --> once : Exception
    once -> once : Leave the JobRun without SucceededAt; the next hour runs again
    once --> job : Exception, logged
  end
end
member -> card : View a business page or a business card
card -> fast : repliesFast of BusinessCardDto or ListingPageDto, read through FastListings
fast -> db : Read ResponseTimeStat
db --> fast : Listings that reply fast
fast --> card : repliesFast
card --> member : Show the jb-badge "Replies fast" when repliesFast is true; nothing for a space
@enduml
