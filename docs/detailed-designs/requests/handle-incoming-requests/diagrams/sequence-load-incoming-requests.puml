@startuml
title UML sequence behaviour — load incoming requests
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "IncomingRequestsPage" as page
  participant "IncomingRequestsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "IncomingRequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ListIncomingRequestsQueryHandler" as handler
  participant "IncomingRules" as rules
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Open /my-business/requests
page -> page : memberGuard passes for a signed-in member; set state to loading
page -> client : list(tab new)
client -> controller : GET /api/my-business/requests?tab=new
controller -> controller : Authenticate the session cookie
controller -> handler : Send ListIncomingRequestsQuery(subject, tab, listing)
handler -> rules : Owned(subject, listing) (L2-133)
rules -> db : Read the caller's listings
db --> rules : Listings
alt caller owns no listing, or not the one named
  rules --> handler : ForbiddenException
  handler --> controller : ForbiddenException
  controller --> client : 403 ProblemDetails, code FORBIDDEN (L2-051)
  client --> page : Forbidden
  page --> actor : Go to /forbidden and show the forbidden page
else caller owns the listing
  rules --> handler : Listing
  handler -> db : Read the listing's requests newest first; Declined limited to 90 days; read RepliesFast
  db --> handler : Requests and stat
  handler -> handler : Count per tab over the whole listing and take at most 50 rows of the tab
  handler --> controller : IncomingRequestsDto
  controller --> client : 200 OK
  client --> page : IncomingRequests
  page -> page : Set state to loaded and remember the New requests seen
  alt no requests at all
    page --> actor : Show "No requests yet." with "Share your listing"
  else chosen tab is empty
    page --> actor : Show the tab message, for Declined with "Show new requests"
  else rows exist
    page --> actor : Show "{n} new" summary, tabs with counts and rows with "Decline" and "Confirm" (L2-051)
  end
end
@enduml
