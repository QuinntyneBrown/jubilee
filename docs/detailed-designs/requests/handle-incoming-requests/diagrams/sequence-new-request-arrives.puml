@startuml
title UML sequence behaviour — a new request arrives
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as member
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "IncomingRequestsPage" as page
  participant "IncomingRequestsApi" as client
  participant "RealtimeService" as rt
  participant "EventsApi" as stream
  participant "NavigationStore" as nav
  participant "ToastService" as toast
end box
box "Backend — Jubilee API" #D1FADF
  participant "RequestsController" as controller
  participant "IncomingRequestsController" as incoming
  participant "EventsController" as events
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "Create request handler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
member -> controller : POST /api/requests/bookings, quotes, orders or spaces
controller -> handler : Send the create command
handler -> handler : NotificationRules.Tell(owner, kind request, target /my-business/requests)
handler -> db : Save Request with status New, the owner's Notification and the e-mail OutboxMessage in one SaveChangesAsync (L2-043)
db --> handler : Commit result
handler --> controller : BookedRequestDto
controller --> member : 201 Created
alt event stream is connected
  events -> db : Read the owner's new notifications and badge counts
  db --> events : Notification and NavigationSummary
  events --> stream : notification event with its event ID, to the owner only (L2-070)
  stream --> rt : { type: 'notification', id, item }
  rt -> rt : Skip an event ID already seen; leave the toast of a request notification for this page to the page
  rt --> page : received emits the notification of kind request for /my-business/requests
  events --> stream : counts event with newRequestCount
  stream --> rt : { type: 'counts', counts }
  rt -> nav : apply(counts)
  nav --> page : newRequestCount changed
else event stream cannot connect
  stream --> rt : { type: 'connection', connected: false }
  rt --> page : connected is false
  page -> page : Ask every 5 seconds until connected is true again (L2-051)
end
page -> client : list(tab), without the loading state
client -> incoming : GET /api/my-business/requests?tab=
incoming --> client : 200 OK with rows and counts
client --> page : IncomingRequests
page -> page : Find each New request it had not seen
page --> actor : Row appears at the top within 5 seconds and the counts increase (L2-051)
page -> toast : show(info)
toast --> actor : "New {type} request. {Customer} asked for {summary}." once
opt connection dropped and reconnects
  stream -> events : Reconnect with Last-Event-ID
  events --> stream : Missed notifications, none twice (L2-070)
end
@enduml
