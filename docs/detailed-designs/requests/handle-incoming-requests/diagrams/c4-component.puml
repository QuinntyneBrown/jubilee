@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Handle incoming requests

Container_Boundary(web, "Jubilee Web") {
  Component(page, "IncomingRequestsPage", "Angular page", "Lists requests at /my-business/requests and holds its state in signals")
  Component(client, "IncomingRequestsApi", "Service contract (INCOMING_REQUESTS_API)", "Calls GET /api/my-business/requests")
  Component(rt, "RealtimeService", "Angular service", "Emits each notification once and knows whether the stream is connected")
  Component(stream, "EventsApi", "Service contract (EVENTS_API)", "Opens the server-sent event stream")
  Component(nav, "NavigationStore", "Angular service", "Holds the badge counts and newRequestCount")
  Component(toast, "ToastService", "Angular service", "Shows the new request toast")
  Component(badge, "BusinessPage and BusinessCard", "Angular page and jb-business-card", "Show the Replies fast badge")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "IncomingRequestsController", "ASP.NET Core controller", "Exposes /api/my-business/requests")
  Component(handler, "ListIncomingRequestsQueryHandler", "MediatR handler", "Returns rows and counts per tab")
  Component(rules, "IncomingRules", "Application rules", "Owned passes for the owner of the listing only")
  Component(create, "Create request handlers", "MediatR handlers", "Store the request and the owner's notification")
  Component(tell, "NotificationRules", "Application rules", "Stores the owner's notification")
  Component(events, "EventsController", "Server-sent events", "Streams a member's own notifications and counts")
  Component(fast, "ResponseTimes", "Application rules", "FastListings reads which listings reply fast")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(outbox, "OutboxDispatcherJob", "Hosted job", "Sends the owner's e-mail")
  Component(job, "ResponseTimeBadgeJob", "Hosted job", "Sends RunResponseTimeBadgeJobCommand every ten minutes")
  Component(once, "ScheduledJobs", "Application service", "RunOnceAsync claims the hour with a JobRun")
  Component(calc, "RecomputeResponseTimesCommandHandler", "MediatR handler", "Gathers the first responses of each live listing")
  Component(stat, "ResponseTimeStat", "Domain entity", "Takes the median and sets RepliesFast")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Requests and messages and notifications and response-time stats and job runs")

Rel(page, client, "Loads through")
Rel(page, rt, "Reads received and connected from")
Rel(page, nav, "Reads newRequestCount from")
Rel(page, toast, "Announces a new request with")
Rel(rt, stream, "Subscribes to")
Rel(rt, nav, "Applies counts to")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(stream, events, "Listens to", "Server-sent events")
Rel(ctrl, handler, "Sends ListIncomingRequestsQuery")
Rel(handler, rules, "Finds the owned listing with")
Rel(handler, db, "Reads", "EF Core")
Rel(create, tell, "Tells the owner through")
Rel(create, db, "Persists request and notification and outbox", "EF Core")
Rel(events, db, "Reads notifications and counts", "EF Core")
Rel(fast, db, "Reads stats", "EF Core")
Rel(badge, fast, "Reads repliesFast through the directory and listing page APIs", "JSON/HTTPS")
Rel(outbox, db, "Reads outbox", "EF Core")
Rel(job, once, "Runs once per hour through")
Rel(once, calc, "Sends RecomputeResponseTimesCommand")
Rel(once, db, "Inserts and completes JobRun", "EF Core")
Rel(calc, stat, "Computes with")
Rel(calc, db, "Reads responses and writes stats", "EF Core")
@enduml
