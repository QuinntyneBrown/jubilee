@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Handle incoming requests

Container_Boundary(web, "Jubilee Web") {
  Component(page, "IncomingRequestsPage", "Angular page", "Lists requests at /my-business/requests")
  Component(store, "IncomingRequestsStore", "Signal store", "Holds rows per tab and counts")
  Component(client, "RequestsApi", "Typed HTTP client", "Calls GET /api/my-business/requests")
  Component(rt, "RealtimeClient", "Angular service", "Receives request.created events")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "IncomingRequestsController", "ASP.NET Core controller", "Exposes /api/my-business/requests")
  Component(policy, "ListingOwnerPolicy", "Authorization policy", "Passes for the owner or a co-owner only")
  Component(handler, "ListIncomingRequestsQueryHandler", "MediatR handler", "Returns rows and counts per tab")
  Component(hub, "EventsHub", "SignalR hub", "Pushes events to the listing's owners")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(outbox, "OutboxDispatcherJob", "Hosted job", "Dispatches RequestCreatedEvent")
  Component(job, "ResponseTimeBadgeJob", "Hosted job", "Recomputes the badge at least hourly")
  Component(calc, "ResponseTimeCalculator", "Domain service", "Computes the median first response")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Requests and messages and response-time stats")

Rel(page, store, "Reads")
Rel(store, client, "Loads through")
Rel(rt, store, "Applies events to")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, policy, "Authorizes with")
Rel(ctrl, handler, "Sends ListIncomingRequestsQuery")
Rel(handler, db, "Reads", "EF Core")
Rel(outbox, db, "Reads outbox", "EF Core")
Rel(outbox, hub, "Publishes through")
Rel(hub, rt, "Pushes events", "WebSocket")
Rel(job, calc, "Computes with")
Rel(job, db, "Reads responses and writes stats", "EF Core")
@enduml
