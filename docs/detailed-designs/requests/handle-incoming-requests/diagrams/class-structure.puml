@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Handle incoming requests

enum RequestKind {
  Booking
  Quote
  Order
  Space
}

enum RequestStatus {
  New
  Confirmed
  Declined
  Cancelled
  Completed
}

class Request {
  +Guid Id
  +RequestKind Kind
  +RequestStatus Status
  +string MemberSubject
  +string MemberName
  +Guid ListingId
  +string? ServiceName
  +string? Note
  +string? DeclineReason
  +string? DeclineMessage
  +DateTimeOffset CreatedAt
  +DateTimeOffset? NudgedAt
  +{static} TimeSpan UndoWindow = 8 seconds
  +Confirm(actor: string, now: DateTimeOffset): void
  +UndoConfirm(actor: string, now: DateTimeOffset): void
  +Decline(actor: string, now: DateTimeOffset, reason: string, message: string): void
  +Cancel(actor: string, now: DateTimeOffset): void
  +UndoCancel(actor: string, now: DateTimeOffset): void
  +Complete(actor: string, now: DateTimeOffset): void
}

class RequestTransition {
  +Guid Id
  +RequestStatus From
  +RequestStatus To
  +string Actor
  +DateTimeOffset At
  +DateTimeOffset? UndoableUntil
}

Request "1" *-- "1..*" RequestTransition : records
Request --> RequestKind : has
Request --> RequestStatus : has

class ListIncomingRequestsQuery {
  +string Subject
  +string? Tab
  +string? ListingSlug
}

class ListIncomingRequestsQueryHandler {
  +{static} int PageSize = 50
  +Handle(query: ListIncomingRequestsQuery): Task<IncomingRequestsDto>
}

class IncomingRules <<static>> {
  +{static} TimeSpan DeclinedKept = 90 days
  +{static} Owned(db: IAppDbContext, subject: string, slug: string?): Task<Listing>
  +{static} OwnedRequest(db: IAppDbContext, subject: string, id: Guid): Task<(Request, Listing)>
  +{static} Invalid(request: Request): ConflictException
}

class IncomingRequestsDto {
  +OwnerListingDto Listing
  +string Tab
  +RequestCountsDto Counts
  +bool RepliesFast
  +IReadOnlyList<IncomingRequestRowDto> Rows
}

class OwnerListingDto {
  +string Name
  +string Slug
}

class RequestCountsDto {
  +int New
  +int Confirmed
  +int Declined
  +int All
}

class IncomingRequestRowDto {
  +Guid Id
  +string Kind
  +string KindLabel
  +string CustomerName
  +string CustomerInitials
  +string Title
  +string Detail
  +DateTimeOffset SentAt
  +string Status
  +string StatusLabel
  +string? Total
  +string? When
}

class ResponseTimeBadgeJob {
  #ExecuteAsync(stoppingToken: CancellationToken): Task
}

class RunResponseTimeBadgeJobCommand

class ScheduledJobs {
  +RunOnceAsync(job: string, every: TimeSpan, work): Task<bool>
  +LastSuccessAsync(job: string): Task<DateTimeOffset?>
}

class JobRun {
  +string Job
  +DateTimeOffset Occurrence
  +DateTimeOffset ClaimedAt
  +DateTimeOffset? SucceededAt
  +{static} OccurrenceOf(now: DateTimeOffset, every: TimeSpan): DateTimeOffset
  +{static} Claim(job: string, occurrence: DateTimeOffset, now: DateTimeOffset): JobRun
  +Succeed(now: DateTimeOffset)
}

class RecomputeResponseTimesCommand

class RecomputeResponseTimesCommandHandler {
  +Handle(command: RecomputeResponseTimesCommand): Task<int>
}

class ResponseTimeStat {
  +{static} TimeSpan Window = 30 days
  +{static} TimeSpan FastUnder = 24 hours
  +{static} int MinimumResponses = 3
  +Guid ListingId
  +TimeSpan? MedianFirstResponse
  +int ResponseCount
  +bool RepliesFast
  +DateTimeOffset ComputedAt
  +{static} Compute(listingId: Guid, responses: IReadOnlyList<TimeSpan>, now: DateTimeOffset): ResponseTimeStat
  +Set(responses: IReadOnlyList<TimeSpan>, now: DateTimeOffset): void
}

ListIncomingRequestsQueryHandler ..> ListIncomingRequestsQuery : handles
ListIncomingRequestsQueryHandler ..> IncomingRules : finds the owned listing with
ListIncomingRequestsQueryHandler ..> IncomingRequestsDto : returns
IncomingRequestsDto "1" *-- "1" OwnerListingDto : names
IncomingRequestsDto "1" *-- "1" RequestCountsDto : counts
IncomingRequestsDto "1" *-- "*" IncomingRequestRowDto : contains
ListIncomingRequestsQueryHandler ..> Request : reads
ListIncomingRequestsQueryHandler ..> ResponseTimeStat : reads RepliesFast
ResponseTimeBadgeJob ..> RunResponseTimeBadgeJobCommand : sends every ten minutes
RunResponseTimeBadgeJobCommand ..> ScheduledJobs : runs once through
ScheduledJobs --> JobRun : claims and completes
ScheduledJobs ..> RecomputeResponseTimesCommand : sends
RecomputeResponseTimesCommandHandler ..> RecomputeResponseTimesCommand : handles
RecomputeResponseTimesCommandHandler ..> RequestTransition : reads first owner transition
RecomputeResponseTimesCommandHandler --> ResponseTimeStat : computes and sets
@enduml
