@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Handle incoming requests

enum RequestType {
  Booking
  Quote
  Order
}

enum RequestStatus {
  New
  Confirmed
  Declined
  Cancelled
  Completed
}

class Request {
  +Guid Id
  +RequestType Type
  +RequestStatus Status
  +Guid MemberId
  +Guid ListingId
  +Guid ConversationId
  +DeclineReason? DeclineReason
  +string? DeclineMessage
  +DateTimeOffset CreatedAt
  +DateTimeOffset? NudgedAt
  +Confirm(actorId: Guid, now: DateTimeOffset): void
  +Decline(actorId: Guid, reason: DeclineReason, message: string, now: DateTimeOffset): void
  +Cancel(actorId: Guid, now: DateTimeOffset): void
  +Complete(actorId: Guid?, now: DateTimeOffset): void
  +UndoLastTransition(actorId: Guid, now: DateTimeOffset): void
  +MarkNudged(now: DateTimeOffset): void
}

class RequestTransition {
  +Guid Id
  +RequestStatus? From
  +RequestStatus To
  +Guid? ActorId
  +DateTimeOffset OccurredAt
  +DateTimeOffset? UndoableUntil
}

Request "1" *-- "1..*" RequestTransition : records
Request --> RequestType : has
Request --> RequestStatus : has

enum IncomingTab {
  New
  Confirmed
  Declined
  All
}

class ListIncomingRequestsQuery {
  +Guid ListingId
  +IncomingTab Tab
  +string? Cursor
}

class ListIncomingRequestsQueryHandler {
  +int DeclinedRetentionDays = 90
  +Handle(query: ListIncomingRequestsQuery): Task<IncomingRequestsPageDto>
}

class IncomingRequestsPageDto {
  +IReadOnlyList<IncomingRequestRowDto> Rows
  +IReadOnlyDictionary<IncomingTab, int> Counts
  +string? NextCursor
}

class IncomingRequestRowDto {
  +Guid Id
  +string CustomerInitials
  +string CustomerName
  +string Title
  +RequestType Type
  +DateTimeOffset SentAt
  +string Summary
  +RequestStatus Status
}

class ResponseTimeCalculator {
  +int WindowDays = 30
  +int MinimumResponses = 3
  +Compute(listingId: Guid, now: DateTimeOffset): ResponseTimeStat
}

class ResponseTimeStat {
  +Guid ListingId
  +TimeSpan? MedianFirstResponse
  +int ResponseCount
  +bool RepliesFast
  +DateTimeOffset ComputedAt
}

class ResponseTimeBadgeJob {
  +ExecuteAsync(stoppingToken: CancellationToken): Task
}

ListIncomingRequestsQueryHandler ..> ListIncomingRequestsQuery : handles
ListIncomingRequestsQuery --> IncomingTab : filters by
ListIncomingRequestsQueryHandler ..> IncomingRequestsPageDto : returns
IncomingRequestsPageDto "1" *-- "*" IncomingRequestRowDto : contains
ListIncomingRequestsQueryHandler ..> Request : reads
ResponseTimeBadgeJob ..> ResponseTimeCalculator : uses
ResponseTimeCalculator ..> RequestTransition : reads first owner transition
ResponseTimeCalculator ..> ResponseTimeStat : produces
@enduml
