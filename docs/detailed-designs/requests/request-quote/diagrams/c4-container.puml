@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Request a quote

Person(member, "Member", "Asks a business to price a piece of work")
Person(owner, "Owner", "Receives the quote request")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Quote dialog and request pages")
  Container(api, "Jubilee API", "ASP.NET Core", "HTTPS JSON API under /api")
  Container(worker, "Jubilee Worker", ".NET worker service", "Outbox dispatch and e-mail sending")
  ContainerDb(db, "Jubilee database", "SQL Server", "Members - requests with idempotency keys - notifications - outbox")
}
System_Ext(email, "E-mail provider", "Delivers the owner's request e-mail")

Rel(member, web, "Uses", "HTTPS")
Rel(owner, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(worker, db, "Reads outbox", "EF Core")
Rel(worker, email, "Sends e-mail via")
@enduml
