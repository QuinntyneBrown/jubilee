@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Request a quote

enum RequestKind {
  Booking
  Quote
  Order
  Space
}

enum RequestStatus {
  New
  Confirmed
  Declined
  Cancelled
  Completed
}

class Request {
  +Guid Id
  +RequestKind Kind
  +RequestStatus Status
  +string MemberSubject
  +string MemberName
  +Guid ListingId
  +string IdempotencyKey
  +Guid? ServiceId
  +string? ServiceName
  +string? Note
  +DateOnly? NeededBy
  +string? Budget
  +string? Phone
  +DateTimeOffset CreatedAt
  +{static} int MaxDescriptionLength = 2000
  +{static} int MaxBudgetLength = 60
  +{static} AskForQuote(...): Request
  +Confirm(actor: string, now: DateTimeOffset): void
  +UndoConfirm(actor: string, now: DateTimeOffset): void
  +Decline(actor: string, now: DateTimeOffset): void
  +Cancel(actor: string, now: DateTimeOffset): void
  +UndoCancel(actor: string, now: DateTimeOffset): void
  +Complete(actor: string, now: DateTimeOffset): void
}

class RequestTransition {
  +Guid Id
  +RequestStatus From
  +RequestStatus To
  +string Actor
  +DateTimeOffset At
  +DateTimeOffset? UndoableUntil
}

Request "1" *-- "1..*" RequestTransition : records
Request --> RequestKind : has
Request --> RequestStatus : has

class Member {
  +Guid Id
  +string? Phone
}

class GetQuoteOptionsQuery {
  +string Subject
  +string Slug
}

class GetQuoteOptionsQueryHandler {
  +Handle(query: GetQuoteOptionsQuery): Task<QuoteOptionsDto>
}

class QuoteOptionsDto {
  +BusinessRef Business
  +string OwnerFirstName
  +string? UsuallyReplies
  +string? Phone
}

class Profiles <<static>> {
  +{static} FormatPhone(digits: string?): string?
}

class RequestQuoteCommand {
  +string Subject
  +string Name
  +string ListingSlug
  +Guid? ServiceId
  +string? Description
  +string? NeededBy
  +string? Budget
  +string? Phone
  +string? IdempotencyKey
}

class RequestQuoteCommandHandler {
  +Handle(command: RequestQuoteCommand): Task<BookedRequestDto>
}

class BookedRequestDto {
  +Guid Id
  +string Status
  +string MemberStatus
}

class Notification {
  +string MemberSubject
  +string Kind
  +string Title
  +string Detail
  +string Target
  +Guid? CorrelationId
}

GetQuoteOptionsQueryHandler ..> GetQuoteOptionsQuery : handles
GetQuoteOptionsQueryHandler ..> QuoteOptionsDto : returns
GetQuoteOptionsQueryHandler ..> Member : reads the caller's phone
GetQuoteOptionsQueryHandler ..> Profiles : formats with
RequestQuoteCommandHandler ..> RequestQuoteCommand : handles
RequestQuoteCommandHandler --> Request : creates
RequestQuoteCommandHandler --> Notification : writes for the owner
RequestQuoteCommandHandler ..> BookedRequestDto : returns
@enduml
