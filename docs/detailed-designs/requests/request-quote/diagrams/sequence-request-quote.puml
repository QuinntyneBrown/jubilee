@startuml
title UML sequence behaviour — send a quote request
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "RequestQuoteDialog" as dialog
  participant "RequestsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ListingBookingController" as listing
  participant "RequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetQuoteOptionsQueryHandler" as options
  participant "RequestQuoteCommandHandler" as handler
  participant "Request" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as outbox
end box
actor "Owner" as owner
actor -> dialog : Press "Ask"
dialog -> client : quoteOptions(slug)
client -> listing : GET /api/listings/{slug}/quote
listing -> options : Send GetQuoteOptionsQuery(subject, slug)
options -> db : Read the public listing and the caller's member
db --> options : Listing and profile phone
options --> listing : QuoteOptionsDto with phone
listing --> client : 200 OK
client --> dialog : Options
dialog --> actor : Show the form with "Phone" filled in from the profile (L2-045 AC7)
actor -> dialog : Fill the form, change or clear the phone, press "Send request"
dialog -> dialog : Check description, phone and date (L2-045)
alt a field is invalid
  dialog --> actor : Show the field message and keep the input (L2-126)
else all fields valid
  dialog -> client : requestQuote(command with idempotency key)
  client -> controller : POST /api/requests/quotes
  controller -> controller : Authenticate, apply RequiresConfirmedEmail (L2-005)
  alt unconfirmed member
    controller --> client : 403 EMAIL_UNCONFIRMED
    client --> dialog : Blocked
    dialog --> actor : Show "Confirm your e-mail first" and keep the input
  else confirmed member
    controller -> handler : Send RequestQuoteCommand
    handler -> db : Look for the member's request with this key (L2-132)
    db --> handler : None
    handler -> handler : Repeat the field rules (L2-126 AC5)
    alt server validation fails
      handler --> controller : ValidationFailedException
      controller --> client : 422 with per-field codes
      client --> dialog : Field errors
      dialog --> actor : Show the field message
    else valid
      handler -> db : Load the public listing and the service
      db --> handler : Current state
      handler -> entity : AskForQuote, status New (L2-043)
      entity --> handler : Request
      handler -> db : Save request, owner notification and outbox e-mail in one save
      db --> handler : Commit result
      handler --> controller : BookedRequestDto
      controller --> client : 201 Created
      client --> dialog : Request ID
      dialog --> actor : Show "Quote request sent to {business}" with "Close" and "View request"
      outbox -> db : Read pending outbox messages
      db --> outbox : Messages
      outbox --> owner : E-mail "New quote request from {member}"
    end
  end
end
@enduml
