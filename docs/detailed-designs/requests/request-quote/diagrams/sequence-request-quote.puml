@startuml
title UML sequence behaviour — send a quote request
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "RequestQuoteDialog" as dialog
  participant "RequestsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "RequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "RequestQuoteCommandValidator" as validator
  participant "RequestQuoteCommandHandler" as handler
  participant "Request" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as outbox
end box
actor "Owner" as owner
actor -> dialog : Press "Ask" and fill the form
dialog -> dialog : Validate description, phone and date (L2-045)
alt a field is invalid
  dialog --> actor : Show the field message and keep the input (L2-126)
else all fields valid
  dialog -> client : requestQuote(command, idempotency key)
  client -> controller : POST /api/requests/quotes
  controller -> controller : Authenticate, apply L2-005 confirmed-member policy, check L2-132 idempotency key
  alt unconfirmed member
    controller --> client : 403 EMAIL_UNCONFIRMED
    client --> dialog : Blocked
  else confirmed member
    controller -> validator : Validate RequestQuoteCommand (L2-045 limits)
    validator --> controller : Validation result
    alt server validation fails
      controller --> client : 422 with per-field codes
      client --> dialog : Field errors
      dialog --> actor : Show the field message
    else valid
      controller -> handler : Send RequestQuoteCommand
      handler -> db : Load listing and conversation
      db --> handler : Current state
      handler -> entity : Create quote request with status New (L2-043)
      entity --> handler : Request and first RequestTransition
      handler -> db : Save request, conversation card and outbox messages in one unit of work
      db --> handler : Commit result
      handler --> controller : RequestCreatedResult
      controller --> client : 201 Created
      client --> dialog : Request ID
      dialog --> actor : Show "Quote request sent to {business}." with "Close" and "View request"
      outbox -> db : Read pending outbox messages
      db --> outbox : Messages
      outbox --> owner : In-app notification, real-time event and e-mail
    end
  end
end
@enduml
