@startuml
title UML sequence behaviour — repeat a quote request with the same key
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "RequestQuoteDialog" as dialog
  participant "RequestsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "RequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "RequestQuoteCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> dialog : Press "Send request" again after a failure, or the network retries
dialog -> client : requestQuote(command, same idempotency key)
client -> controller : POST /api/requests/quotes with the key in the body
controller -> handler : Send RequestQuoteCommand
handler -> db : Look for the member's request with this key (L2-132)
alt the member already sent this key
  db --> handler : The first request
  handler --> controller : BookedRequestDto of the first request
  controller --> client : 201 Created
  client --> dialog : Same request ID
else first use of the key
  db --> handler : None
  handler -> db : Save request, owner notification and outbox e-mail in one save
  db --> handler : Commit result
  handler --> controller : BookedRequestDto
  controller --> client : 201 Created
  client --> dialog : Request ID
end
dialog --> actor : Show one sent request
@enduml
