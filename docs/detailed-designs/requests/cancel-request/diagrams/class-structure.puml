@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Cancel a request

enum RequestType {
  Booking
  Quote
  Order
}

enum RequestStatus {
  New
  Confirmed
  Declined
  Cancelled
  Completed
}

class Request {
  +Guid Id
  +RequestType Type
  +RequestStatus Status
  +Guid MemberId
  +Guid ListingId
  +Guid ConversationId
  +DeclineReason? DeclineReason
  +string? DeclineMessage
  +DateTimeOffset CreatedAt
  +DateTimeOffset? NudgedAt
  +Confirm(actorId: Guid, now: DateTimeOffset): void
  +Decline(actorId: Guid, reason: DeclineReason, message: string, now: DateTimeOffset): void
  +Cancel(actorId: Guid, now: DateTimeOffset): void
  +Complete(actorId: Guid?, now: DateTimeOffset): void
  +UndoLastTransition(actorId: Guid, now: DateTimeOffset): void
  +MarkNudged(now: DateTimeOffset): void
}

class RequestTransition {
  +Guid Id
  +RequestStatus? From
  +RequestStatus To
  +Guid? ActorId
  +DateTimeOffset OccurredAt
  +DateTimeOffset? UndoableUntil
}

Request "1" *-- "1..*" RequestTransition : records
Request --> RequestType : has
Request --> RequestStatus : has

class InvalidTransitionException {
  +RequestStatus From
  +string Attempted
  +string Code = "INVALID_TRANSITION"
}

class CancelRequestCommand {
  +Guid RequestId
  +Guid MemberId
}

class CancelRequestCommandHandler {
  +Handle(command: CancelRequestCommand): Task<CancelResult>
}

class CancelResult {
  +RequestStatus Status
  +RequestStatus PreviousStatus
  +DateTimeOffset UndoableUntil
}

class UndoCancelRequestCommand {
  +Guid RequestId
  +Guid MemberId
}

class UndoCancelRequestCommandHandler {
  +Handle(command: UndoCancelRequestCommand): Task<RequestStatus>
}

class RequestCancelledEvent {
  +Guid RequestId
  +Guid ListingId
  +RequestStatus PreviousStatus
}

class RequestCancellationWithdrawnEvent {
  +Guid RequestId
  +Guid ListingId
  +RequestStatus RestoredStatus
}

Request ..> InvalidTransitionException : throws
CancelRequestCommandHandler ..> CancelRequestCommand : handles
CancelRequestCommandHandler --> Request : calls Cancel
CancelRequestCommandHandler ..> CancelResult : returns
CancelRequestCommandHandler ..> RequestCancelledEvent : writes to outbox
UndoCancelRequestCommandHandler ..> UndoCancelRequestCommand : handles
UndoCancelRequestCommandHandler --> Request : calls UndoLastTransition
UndoCancelRequestCommandHandler ..> RequestCancellationWithdrawnEvent : writes to outbox
@enduml
