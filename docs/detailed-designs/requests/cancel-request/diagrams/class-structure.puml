@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Cancel a request

enum RequestKind {
  Booking
  Quote
  Order
  Space
}

enum RequestStatus {
  New
  Confirmed
  Declined
  Cancelled
  Completed
}

class Request {
  +Guid Id
  +RequestKind Kind
  +RequestStatus Status
  +string MemberSubject
  +string MemberName
  +Guid ListingId
  +DateTimeOffset CreatedAt
  +DateTimeOffset? StartsAt
  +DateTimeOffset? EndsAt
  +string? DeclineReason
  +string? DeclineMessage
  +DateTimeOffset? NudgedAt
  +{static} TimeSpan UndoWindow = 8 s
  +{static} TimeSpan UnansweredAfter = 7 days
  +Confirm(actor: string, now: DateTimeOffset): void
  +UndoConfirm(actor: string, now: DateTimeOffset): void
  +Decline(actor: string, now: DateTimeOffset, reason: string, message: string): void
  +Cancel(actor: string, now: DateTimeOffset): void
  +UndoCancel(actor: string, now: DateTimeOffset): void
  +Complete(actor: string, now: DateTimeOffset): void
  +IsUnanswered(now: DateTimeOffset): bool
  +Nudge(now: DateTimeOffset): void
}

class RequestTransition {
  +Guid Id
  +Guid RequestId
  +RequestStatus From
  +RequestStatus To
  +string Actor
  +DateTimeOffset At
  +DateTimeOffset? UndoableUntil
}

Request "1" *-- "1..*" RequestTransition : records
Request --> RequestKind : has
Request --> RequestStatus : has

class InvalidTransitionException {
  +RequestStatus From
  +RequestStatus To
}

class CancelRequestCommand {
  +string Subject
  +Guid Id
}

class CancelRequestCommandHandler {
  +Handle(command: CancelRequestCommand): Task<MemberRequestDecisionDto>
}

class MemberRequestDecisionDto {
  +Guid Id
  +string Status
  +string StatusLabel
  +string Business
  +DateTimeOffset? UndoUntil
}

class UndoCancelRequestCommand {
  +string Subject
  +Guid Id
}

class UndoCancelRequestCommandHandler {
  +Handle(command: UndoCancelRequestCommand): Task<MemberRequestDecisionDto>
}

class MemberRequestMail {
  +TellOwner(listing, request, now, subject, text): Task
  +Invalid(request): ConflictException
}

class Notification {
  +string MemberSubject
  +string Kind = "request"
  +string Title
  +string Target = "/my-business/requests"
}

class OutboxMessage {
  +string ToAddress
  +string Subject
  +DateTimeOffset NextAttemptAt
}

Request ..> InvalidTransitionException : throws
CancelRequestCommandHandler ..> CancelRequestCommand : handles
CancelRequestCommandHandler --> Request : calls Cancel
CancelRequestCommandHandler ..> MemberRequestDecisionDto : returns
CancelRequestCommandHandler ..> MemberRequestMail : tells the owner through
UndoCancelRequestCommandHandler ..> UndoCancelRequestCommand : handles
UndoCancelRequestCommandHandler --> Request : calls UndoCancel
UndoCancelRequestCommandHandler ..> MemberRequestMail : tells the owner through
MemberRequestMail ..> Notification : writes
MemberRequestMail ..> OutboxMessage : writes
@enduml
