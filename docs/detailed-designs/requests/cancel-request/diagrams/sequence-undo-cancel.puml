@startuml
title UML sequence behaviour — undo a cancel
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ToastService" as toast
  participant "RequestsApi" as client
  participant "RequestDetailPage" as page
end box
box "Backend — Jubilee API" #D1FADF
  participant "RequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "UndoCancelRequestCommandHandler" as handler
  participant "Request" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as outbox
end box
actor "Owner" as owner
actor -> toast : Press "Undo" within 8 seconds
toast -> client : undoCancel(requestId)
client -> controller : POST /api/requests/{id}/cancel/undo
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send UndoCancelRequestCommand
handler -> db : Load request and last transition where MemberSubject is the caller (L2-133)
db --> handler : Current state
handler -> entity : UndoCancel(actor, now) (L2-049)
alt same actor and before UndoableUntil
  entity --> handler : Previous status restored, RequestTransition recorded
  handler -> db : Save request, the owner's "withdrew the cancellation" notification and e-mail in one unit of work
  db --> handler : Commit result
  handler --> controller : Restored status
  controller --> client : 200 OK
  client --> page : Restored status
  page --> actor : Show the request as open again
  outbox -> db : Read pending outbox messages
  db --> outbox : Messages
  outbox --> owner : Told the cancellation was withdrawn
else undo window has passed
  entity --> handler : InvalidTransitionException
  handler --> controller : Conflict
  controller --> client : 409 INVALID_TRANSITION
  client --> page : Still cancelled
  page --> actor : Show the request as cancelled
end
@enduml
