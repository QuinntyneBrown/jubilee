@startuml
title UML sequence behaviour — Open a screen of the admin application
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Staff member" as actor
box "Frontend — Jubilee Admin Web" #E0F2FE
  participant "staffGuard" as guard
  participant "StaffSessionService" as session
  participant "App and jb-admin-shell" as shell
  participant "RecordsPage" as page
end box
box "Backend — Jubilee API" #D1FADF
  participant "StaffSessionController" as ctrl
  participant "AdminTablesController" as admin
end box
actor -> session : Open /listing-reports: resolve() at start-up
session -> ctrl : GET /api/staff/session
alt no staff session
  ctrl --> session : 401 sign_in_required
  session -> guard : staff() is null
  guard --> actor : Redirect to /sign-in?returnUrl=/listing-reports (L2-188)
else staff session
  ctrl --> session : Name - initials - e-mail - roles (L2-190)
  session -> guard : staff() is set
  guard --> shell : Activate the route
  shell -> admin : GET /api/admin/tables
  admin --> shell : Tables the roles may read, with counts
  shell --> actor : Top bar and sidebar, Listing reports marked current (L2-272)
  shell -> page : Load the screen
  page -> admin : GET /api/admin/tables/listing-reports
  alt role may read it
    admin --> page : Rows
    page --> actor : The table (L2-276)
  else role may not
    admin --> page : 403 FORBIDDEN
    page --> actor : Nothing here for your role (L2-188)
  end
end
@enduml
