@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Run the admin application

class StaffSessionDto <<view model>> {
  +string displayName
  +string initials
  +string email
  +StaffRole[] roles
}
enum StaffRole {
  moderator
  admin
}
class StaffSessionService {
  +staff: Signal<StaffSessionDto | null>
  +refused: Signal<boolean>
  +resolve(): Promise<void>
  +signOut(): Observable<void>
  +expire(): void
  +signInUrl(returnUrl: string): string
}
interface StaffSessionApi {
  +getSession(): Observable<StaffSessionDto>
  +signOut(): Observable<void>
  +signInUrl(returnUrl: string): string
}
class App <<jb-root>> {
  #routeData: Signal<AdminRouteData>
  #notForRole: Signal<boolean>
  #signOut(): void
}
class AdminShell <<jb-admin-shell>> {
  +staff: AdminShellStaff | null
  +environment: string
  +groups: AdminNavGroup[]
  +current: string
  +jump: OutputEmitter<void>
  +signOut: OutputEmitter<void>
}
class AdminCatalogService {
  +catalog: Signal<AdminCatalog | null>
  +refresh(): void
}
class AdminOnlyPage {
  +signOut: OutputEmitter<void>
}
class AdminMovedPage {
  #adminLink: string
}
StaffSessionService --> StaffSessionApi : uses
StaffSessionService o-- StaffSessionDto : holds
StaffSessionDto --> StaffRole
App --> StaffSessionService : reads
App ..> AdminShell : composes
App --> AdminCatalogService : reads the tables
App ..> AdminOnlyPage : shows on 403 FORBIDDEN
AdminMovedPage ..> "ADMIN_URL" : reads token
@enduml
