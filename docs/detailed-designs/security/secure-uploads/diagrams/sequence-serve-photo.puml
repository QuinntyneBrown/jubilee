@startuml
title UML sequence behaviour — Serve a photo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Participant or Visitor" as user
box "Frontend — Jubilee Web" #E0F2FE
  participant "Browser" as browser
end box
box "Backend — Jubilee API" #D1FADF
  participant "AttachmentsController" as attachments
  participant "MediaController" as media
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "GetAttachmentQueryHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "FileMediaStore" as store
  database "Jubilee database" as db
end box
alt message photo
  user -> browser : Open a conversation with a photo
  browser -> attachments : GET /api/attachments/{id}?expires=…&sig=…
  attachments -> handler : Send GetAttachmentQuery
  handler -> handler : Check the signature and the expiry through IAttachmentLinks (L2-060)
  alt link forged or older than 5 minutes
    handler --> attachments : Not found
    attachments --> browser : 404
  else link valid
    handler -> db : Load MessageAttachment
    db --> handler : Key and ContentType
    handler -> store : Read(key, 0, format)
    store --> handler : Bytes
    handler --> attachments : AttachmentContent
    attachments --> browser : 200 with the stored Content-Type, nosniff and private, no-store
  end
else listing photo
  user -> browser : Open /b/:slug
  browser -> media : GET /media/{key}/{width}.{jpg|webp}
  media -> media : Accept a key of 32 hexadecimal characters and the widths 320, 640 and 1280
  alt name not of that form or nothing stored under it
    media --> browser : 404
  else rendition stored
    media -> store : Read(key, width, format)
    store --> media : Bytes
    media --> browser : 200 with Content-Type image/jpeg or image/webp, nosniff and a long cache life (L2-138)
  end
end
browser --> user : Show the photo
@enduml
