@startuml
title UML sequence behaviour — Upload a message photo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as user
box "Frontend — Jubilee Web" #E0F2FE
  participant "ConversationPage" as page
  participant "MessagesApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "ConversationsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "UploadAttachmentCommandHandler" as handler
  participant "ImageSanitizer" as sanitizer
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "ClamAvMalwareScanner" as scan
  participant "FileMediaStore" as store
  database "Jubilee database" as db
end box
participant "clamd" as scanner
user -> page : Send a message with a photo
page -> client : attach(id, blob)
client -> controller : POST /api/conversations/{id}/attachments
controller -> controller : Authenticate, verify anti-CSRF token and confirmed e-mail, cap body at 6 MB
controller -> handler : Send UploadAttachmentCommand
handler -> db : Load conversation for a participant (L2-133) and count uploads
db --> handler : Conversation
handler -> sanitizer : Sanitize(bytes): magic bytes, size and width (L2-138)
alt Not JPEG or PNG, over 5 MB, or over 8,000 pixels wide
  sanitizer --> handler : Refused with ImageProblem
  handler --> controller : InvalidImageException
  controller --> client : 422 INVALID_IMAGE or TOO_LARGE. Nothing stored (L2-138)
else Check passed
  sanitizer --> handler : Bytes without metadata
  handler -> scan : Scan(bytes)
  scan -> scanner : INSTREAM with the bytes, 10 second limit
  scanner --> scan : One line of answer, or none in time
  scan --> handler : ScanVerdict
  alt Infected
    handler --> controller : Refused
    controller --> client : 422 FAILED_SCAN. Nothing stored, never served (L2-138)
  else Unavailable
    handler --> controller : Refused
    controller --> client : 503 SCAN_UNAVAILABLE. Nothing stored (L2-138)
  else Clean
    handler -> store : Save(random key of 128 bits, 0, jpeg or png, bytes)
    store --> handler : Written outside the web root
    handler -> db : Save MessageAttachment with Key and ContentType
    db --> handler : Commit result
    handler --> controller : Attachment ID
    controller --> client : 201 Created with the id
  end
end
client --> page : Result
page --> user : Send the message with the photo, or say why it was not sent
@enduml
