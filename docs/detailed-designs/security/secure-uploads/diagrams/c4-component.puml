@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Secure uploads

Container_Boundary(web, "Jubilee Web") {
  Component(photo, "PhotoAttachmentService", "Angular service", "Early check of the first bytes and shrinking to 5 MB")
  Component(messages, "MessagesApi", "Service contract", "Posts one file to /api/conversations/{id}/attachments")
  Component(mybiz, "MyBusinessApi", "Service contract", "Posts one file to /api/my-business/photos")
}
Container_Boundary(api, "Jubilee API") {
  Component(conv, "ConversationsController", "ASP.NET Core controller", "Attach. Caps the body at 6 MB. Participants with a confirmed e-mail")
  Component(owner, "MyBusinessController", "ASP.NET Core controller", "AddPhoto. Caps the body at 6 MB. The owner's own listing")
  Component(upload, "UploadAttachmentCommandHandler", "MediatR handler", "Check then scan then store. Stops at the first failure")
  Component(add, "AddPhotoCommandHandler", "MediatR handler", "Check and re-encode then store. No scan yet")
  Component(sanitizer, "ImageSanitizer", "Application rules", "Magic bytes and size and width. Removes metadata")
  Component(processor, "IImageProcessor", "Application service", "SkiaImageProcessor. Re-encodes into renditions")
  Component(scan, "IMalwareScanner", "Application service", "Clean or Infected or Unavailable. Fails closed")
  Component(store, "IMediaStore", "Application service", "FileMediaStore. Random keys outside the web root")
  Component(attachments, "AttachmentsController", "ASP.NET Core controller", "Serves a message photo to a fresh signed link")
  Component(media, "MediaController", "ASP.NET Core controller", "Serves a listing rendition by its random name")
}
ContainerDb(db, "Jubilee database", "SQL Server", "MessageAttachment and ListingPhoto rows")
ContainerDb(files, "Media store", "Folder outside the web root", "Photo bytes")
System_Ext(clamd, "Malware scanner", "clamd daemon")

Rel(photo, messages, "Hands the checked photo to")
Rel(messages, conv, "Posts", "multipart/HTTPS")
Rel(mybiz, owner, "Posts", "multipart/HTTPS")
Rel(conv, upload, "Sends UploadAttachmentCommand")
Rel(owner, add, "Sends AddPhotoCommand")
Rel(upload, sanitizer, "1. Checks with")
Rel(upload, scan, "2. Scans through")
Rel(upload, store, "3. Saves through")
Rel(upload, db, "4. Saves MessageAttachment in", "EF Core")
Rel(add, processor, "1. Checks and re-encodes with")
Rel(add, store, "2. Saves each rendition through")
Rel(add, db, "3. Saves ListingPhoto in", "EF Core")
Rel(scan, clamd, "Sends the bytes", "INSTREAM/TCP")
Rel(store, files, "Writes and reads")
Rel(attachments, store, "Reads through")
Rel(media, store, "Reads through")
@enduml
