@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Secure uploads

Person(owner, "Owner", "Uploads listing and product photos")
Person(member, "Member", "Attaches photos to messages")
Person(visitor, "Visitor", "Views listing and product photos")
System(jubilee, "Jubilee", "Toronto's Christian marketplace. Checks every uploaded photo and scans message and product photos")
System_Ext(scanner, "Malware scanner", "clamd daemon on Jubilee's own network")

Rel(owner, jubilee, "Uploads listing and product photos to", "HTTPS")
Rel(member, jubilee, "Uploads message photos to", "HTTPS")
Rel(visitor, jubilee, "Fetches listing and product photos from", "HTTPS")
Rel(jubilee, scanner, "Has each message and product photo scanned by", "INSTREAM/TCP")
@enduml
