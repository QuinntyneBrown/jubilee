@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Secure uploads

Person(owner, "Owner", "Uploads listing photos")
Person(member, "Member", "Attaches photos to messages")
Person(visitor, "Visitor", "Views listing photos")
System(jubilee, "Jubilee", "Toronto's Christian marketplace. Checks every uploaded photo and scans message photos")
System_Ext(scanner, "Malware scanner", "clamd daemon on Jubilee's own network")

Rel(owner, jubilee, "Uploads listing photos to", "HTTPS")
Rel(member, jubilee, "Uploads message photos to", "HTTPS")
Rel(visitor, jubilee, "Fetches listing photos from", "HTTPS")
Rel(jubilee, scanner, "Has each message photo scanned by", "INSTREAM/TCP")
@enduml
