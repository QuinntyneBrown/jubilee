@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Secure uploads

class UploadAttachmentCommand {
  +string Subject
  +Guid ConversationId
  +byte[] Content
}

class UploadAttachmentCommandHandler {
  +Handle(command: UploadAttachmentCommand): Task<Guid>
}

class ImageSanitizer <<static>> {
  +const int MaxBytes = 5 MB
  +const int MaxWidth = 8000
  +Sanitize(bytes: byte[]): SanitizedImage
}

class SanitizedImage {
  +string ContentType
  +byte[] Content
  +ImageProblem Problem
  +bool Accepted
}

enum ImageProblem {
  None
  NotAnImage
  TooLarge
}

interface IMalwareScanner {
  +Scan(content: byte[], cancellationToken: CancellationToken): Task<ScanVerdict>
}

enum ScanVerdict {
  Clean
  Infected
  Unavailable
}

class ClamAvMalwareScanner
class NoMalwareScanner
class UnavailableMalwareScanner

interface IMediaStore {
  +Save(key: string, width: int, format: string, data: byte[]): Task
  +Read(key: string, width: int, format: string): Task<byte[]?>
  +Delete(key: string): Task
}

class FileMediaStore

class MessageAttachment {
  +Guid Id
  +Guid ConversationId
  +string UploaderSubject
  +string Key
  +string ContentType
  +byte[]? Content
}

class AddPhotoCommand {
  +string Subject
  +byte[] Content
}

class AddPhotoCommandHandler {
  +Handle(command: AddPhotoCommand): Task<ListingEditorDto>
}

interface IImageProcessor {
  +Process(upload: Stream): ProcessedImage
}

class SkiaImageProcessor {
  +const int MaxBytes = 5 MB
  +const int MaxSide = 8000
  +int[] Widths = 320, 640, 1280
}

class ProcessedImage {
  +int Width
  +int Height
  +IReadOnlyList<Rendition> Renditions
}

class Rendition {
  +int Width
  +string Format
  +byte[] Data
}

class ListingPhoto {
  +Guid Id
  +Guid ListingId
  +string Key
  +int Position
}

class UploadProductPhotoCommandHandler {
  +Handle(command: UploadProductPhotoCommand): Task<ProductPhotoDto>
}

class ProductPhoto {
  +Guid Id
  +Guid ListingId
  +string Key
  +int Width
  +int Height
  +DateTimeOffset UploadedAt
}

UploadAttachmentCommandHandler ..> UploadAttachmentCommand : handles
UploadAttachmentCommandHandler ..> ImageSanitizer : 1. checks
UploadAttachmentCommandHandler ..> IMalwareScanner : 2. scans
UploadAttachmentCommandHandler ..> IMediaStore : 3. stores
UploadAttachmentCommandHandler --> "1" MessageAttachment : 4. creates
ImageSanitizer ..> SanitizedImage : returns
SanitizedImage --> ImageProblem : has
IMalwareScanner ..> ScanVerdict : answers
ClamAvMalwareScanner ..|> IMalwareScanner
NoMalwareScanner ..|> IMalwareScanner
UnavailableMalwareScanner ..|> IMalwareScanner
FileMediaStore ..|> IMediaStore
AddPhotoCommandHandler ..> AddPhotoCommand : handles
AddPhotoCommandHandler ..> IImageProcessor : 1. checks and re-encodes
AddPhotoCommandHandler ..> IMediaStore : 2. stores each rendition
AddPhotoCommandHandler --> "1" ListingPhoto : 3. creates
SkiaImageProcessor ..|> IImageProcessor
IImageProcessor ..> ProcessedImage : returns
ProcessedImage "1" *-- "*" Rendition : contains
UploadProductPhotoCommandHandler ..> IImageProcessor : 1. checks and re-encodes
UploadProductPhotoCommandHandler ..> IMalwareScanner : 2. scans
UploadProductPhotoCommandHandler ..> IMediaStore : 3. stores each rendition
UploadProductPhotoCommandHandler --> "1" ProductPhoto : 4. creates
@enduml
