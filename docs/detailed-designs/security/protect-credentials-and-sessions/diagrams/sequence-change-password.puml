@startuml
title UML sequence behaviour — Change a password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as user
box "Frontend — Jubilee Web" #E0F2FE
  participant "AccountPage" as page
  participant "AccountApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "AccountController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ChangePasswordCommandHandler" as handler
  participant "PasswordPolicy" as policy
  participant "Member" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "BreachedPasswordClient" as checker
  participant "Argon2idPasswordHasher" as hasher
  participant "RedisSessionStore" as store
  database "Jubilee database" as db
end box
participant "Breached-password service" as breach
user -> page : Enter current and new password
page -> client : changePassword(current, new)
client -> controller : POST /api/account/password
controller -> controller : Authenticate session and verify anti-CSRF token (L2-135)
controller -> handler : Send ChangePasswordCommand
handler -> db : Load member
db --> handler : Member with password hash
handler -> hasher : Verify(hash, current)
hasher --> handler : Success
handler -> policy : Check 10 to 128 characters (L2-134)
policy --> handler : Result
alt Length outside 10 to 128
  handler --> controller : Validation failure
  controller --> client : 422 with per-field code
else Length accepted
  handler -> checker : IsBreachedAsync(new)
  checker -> breach : Range query with hash prefix (L2-134)
  breach --> checker : Matching suffixes
  checker --> handler : Breached or not
  alt Password appears in a breach
    handler --> controller : Validation failure
    controller --> client : 422 "This password has appeared in a data breach. Choose another."
  else Password accepted
    handler -> hasher : Hash with Argon2id and a new salt (L2-134)
    hasher --> handler : Encoded hash
    handler -> entity : SetPassword(hash, now)
    entity --> handler : Password changed
    handler -> db : Save member and revoke outstanding reset tokens (L2-134)
    db --> handler : Commit result
    handler -> store : RevokeAllExceptAsync(member, current session) (L2-134)
    store --> handler : Other sessions ended
    handler --> controller : Success
    controller --> client : 204 No Content
  end
end
client --> page : Result
page --> user : Show confirmation or field error
@enduml
