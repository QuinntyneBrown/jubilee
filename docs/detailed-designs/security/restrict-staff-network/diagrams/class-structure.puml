@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Restrict staff access by network

class IConfiguration {
  StaffAccess:AllowedNetworks
  StaffAccess:ProxyKey
}
class StaffNetworks {
  -IPNetwork[] networks
  +{static} From(configuration: IConfiguration): StaffNetworks
  +Allows(address: IPAddress?): bool
}
class StaffNetworkMiddleware {
  +InvokeAsync(context: HttpContext): Task
}
class StaffProxyMiddleware {
  +ProxyKeyHeader = "X-Jubilee-Proxy-Key"
  +ClientAddressHeader = "X-Jubilee-Client-Address"
  +InvokeAsync(context: HttpContext): Task
}
class ForwardedHeadersOptions
StaffNetworks ..> IConfiguration : reads AllowedNetworks
StaffNetworkMiddleware --> StaffNetworks : asks
StaffProxyMiddleware ..> IConfiguration : reads ProxyKey
ForwardedHeadersOptions ..> StaffProxyMiddleware : runs before
@enduml
