@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Secure transport and tokens

Person(member, "Member", "Browses and opens e-mailed links")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Token pages remove the token from the address bar")
  Container(api, "Jubilee API", "ASP.NET Core", "Redirects to HTTPS. Adds security headers. Issues and redeems link tokens")
  Container(worker, "Jubilee Worker", ".NET worker service", "Sends the e-mail that carries the plain token")
  ContainerDb(db, "Jubilee database", "SQL Server", "LinkToken rows with SHA-256 hash only. Outbox")
}
System_Ext(email, "E-mail provider", "Delivers e-mail")
System_Ext(obs, "Observability platform", "Receives logs with tokens redacted")

Rel(member, web, "Uses", "HTTPS TLS 1.2 or 1.3")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Stores token hashes in", "EF Core")
Rel(worker, db, "Reads outbox from", "EF Core")
Rel(worker, email, "Sends link via", "HTTPS")
Rel(api, obs, "Writes redacted logs to", "HTTPS")
@enduml
