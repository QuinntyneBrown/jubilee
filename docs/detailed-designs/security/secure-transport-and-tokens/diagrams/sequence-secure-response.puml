@startuml
title UML sequence behaviour — Answer a request with secured transport
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as user
box "Frontend — Jubilee Web" #E0F2FE
  participant "Browser" as browser
end box
box "Backend — Network edge" #FFF4E5
  participant "Edge TLS termination" as edge
end box
box "Backend — Jubilee API" #D1FADF
  participant "HttpsRedirectionMiddleware" as redirect
  participant "SecurityHeadersMiddleware" as headers
  participant "TokenPageHeaderPolicy" as tokenpolicy
  participant "Controller" as controller
end box
user -> browser : Enter an http:// address
browser -> edge : GET over plain HTTP
edge --> browser : Permanent redirect to https:// (L2-139)
browser -> edge : TLS handshake
alt Client offers TLS 1.3 or TLS 1.2
  edge --> browser : Session on TLS 1.3 when offered, else TLS 1.2 (L2-139)
  browser -> edge : GET over HTTPS
  edge -> redirect : Forward request
  redirect -> headers : Request is HTTPS
  headers -> controller : Next
  controller --> headers : Response
  headers -> tokenpolicy : Referrer policy for this route
  alt Token route
    tokenpolicy --> headers : no-referrer (L2-140)
  else Any other route
    tokenpolicy --> headers : strict-origin-when-cross-origin (L2-139)
  end
  headers -> headers : Add HSTS, nosniff, Permissions-Policy and CSP (L2-139, L2-136)
  headers --> edge : Response with security headers
  edge --> browser : Response
  browser -> browser : Remember HSTS for 31536000 seconds including subdomains
  browser --> user : Page
else Client offers only older protocol versions
  edge --> browser : Handshake refused (L2-139)
  browser --> user : Connection error
end
@enduml
