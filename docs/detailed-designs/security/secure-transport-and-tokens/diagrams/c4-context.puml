@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Secure transport and tokens

Person(visitor, "Visitor", "Opens pages and e-mailed links")
Person(member, "Member", "Confirms e-mail. Resets password. Downloads data")
System(jubilee, "Jubilee", "Toronto's Christian marketplace. Serves HTTPS only with security headers. Issues hashed link tokens")
System_Ext(email, "E-mail provider", "Delivers e-mails that carry links")

