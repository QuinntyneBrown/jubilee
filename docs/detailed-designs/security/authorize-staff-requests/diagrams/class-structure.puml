@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Authorize staff requests

class StaffPolicies <<static>> {
  +Moderator = "staff-moderator"
  +Admin = "staff-admin"
  +AddStaffPolicies(builder): AuthorizationBuilder
}
class StaffSession <<static>> {
  +Scheme = "Staff"
  +Cookie = "__Host-jubilee.staff"
}
class RequiresModeratorAttribute {
  +Policy = StaffPolicies.Moderator
}
class RequiresAdminAttribute {
  +Policy = StaffPolicies.Admin
}
class AuthorizeAttribute
class StaffChallenge {
  +OnRedirectToLogin(context): Task
  +OnRedirectToAccessDenied(context): Task
}
class AdminListingsController
class AdminReportsController
class AdminFeaturedController
class AdminAuditController
class AdminContentController
AuthorizeAttribute <|-- RequiresModeratorAttribute
AuthorizeAttribute <|-- RequiresAdminAttribute
RequiresModeratorAttribute ..> StaffPolicies
RequiresAdminAttribute ..> StaffPolicies
StaffPolicies ..> StaffSession : authenticates with
StaffSession --> StaffChallenge : events
AdminListingsController ..> RequiresModeratorAttribute
AdminReportsController ..> RequiresModeratorAttribute
AdminFeaturedController ..> RequiresModeratorAttribute
AdminAuditController ..> RequiresAdminAttribute
AdminContentController ..> RequiresAdminAttribute
@enduml
