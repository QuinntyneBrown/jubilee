@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Limit abuse

Person(visitor, "Visitor", "Joins or signs in or searches")
Person(member, "Member", "Sends messages and requests and reports")
Person(owner, "Owner", "Reports a member's messages as spam")
Person(verifier, "Verification team member", "Reviews spam suspensions")
System(jubilee, "Jubilee", "Toronto's Christian marketplace. Limits action rates and hides account existence")
System_Ext(bot, "Bot challenge provider", "Issues and verifies challenge tokens")
System_Ext(email, "E-mail provider", "Delivers join-attempt and lockout notices")

Rel(visitor, jubilee, "Submits forms to", "HTTPS")
Rel(member, jubilee, "Acts within limits in", "HTTPS")
Rel(owner, jubilee, "Reports spam in", "HTTPS")
Rel(verifier, jubilee, "Reviews suspensions in", "HTTPS")
Rel(jubilee, bot, "Verifies challenge token with", "HTTPS")
Rel(jubilee, email, "Sends notices via", "HTTPS")
@enduml
