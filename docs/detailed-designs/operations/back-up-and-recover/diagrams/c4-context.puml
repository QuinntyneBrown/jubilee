@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Back up and recover

Person(oncall, "On-call engineer", "Runs restores and reviews drill records")
Person(owner, "Owner", "Uploads listing photos")
System(jubilee, "Jubilee", "Toronto's Christian marketplace")
System_Ext(backup, "Hosting backup service", "Encrypted database backups in two Canadian regions. Vendor to supply")
System_Ext(pipeline, "Delivery pipeline", "Runs the quarterly restore drill. Vendor to supply")
