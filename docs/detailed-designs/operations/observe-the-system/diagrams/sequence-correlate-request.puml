@startuml
title UML sequence behaviour — Correlate a request across services
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "RequestsApi" as client
  participant "TraceInterceptor" as trace
end box
box "Backend — Jubilee API" #D1FADF
  participant "CorrelationIdMiddleware" as corr
  participant "RequestLoggingMiddleware" as reqlog
  participant "RequestsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "BookMeetingCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  participant "LogRedactor" as redactor
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as job
end box
participant "Observability platform" as obs
actor -> client : Send a booking
client -> trace : POST /api/requests/bookings
trace -> corr : Request with traceparent header
corr -> corr : Create correlation ID (L2-175)
corr -> reqlog : Continue in log scope
reqlog -> controller : Continue
controller -> handler : Send BookMeetingCommand
handler -> db : Save request and outbox message with correlation ID
db --> handler : Commit result
alt success
  handler --> controller : Typed result
  controller --> reqlog : 201
else failure
  handler --> controller : Failure
  controller --> reqlog : ProblemDetails with JB-REQ-503 and correlation ID (L2-118)
end
reqlog -> redactor : Entry with route, status, duration
redactor -> obs : JSON log line without secrets
obs --> redactor : Accepted
redactor --> reqlog : Done
reqlog --> corr : Response
corr --> trace : Response with X-Request-Id header
trace --> client : Response
client --> actor : Result or error reference
job -> db : Read outbox message
db --> job : Message with correlation ID
job -> job : Begin JobCorrelationScope
job -> obs : Job log lines and spans under the same correlation ID
obs --> job : Accepted
@enduml
