title Class structure — Send feedback from the panel

interface FeedbackApi {
  +sendRating(request: RatingRequest, idempotencyKey: string): Observable<FeedbackItem>
  +sendBugReport(request: BugReportRequest, idempotencyKey: string): Observable<FeedbackItem>
  +sendKudos(request: KudosRequest, idempotencyKey: string): Observable<FeedbackItem>
}

class HttpFeedbackApi {
  -http: HttpClient
}

class FeedbackDialog {
  #tab: Signal<FeedbackTab>
  #view: Signal<View>
  #busy: Signal<boolean>
  #failure: Signal<FeedbackFailure>
  #rating: Signal<number | null>
  #ratingNote: Signal<string>
  #happened: Signal<string>
  #chips: Signal<KudosChip[]>
  #kudosNote: Signal<string>
  #canSend: Signal<boolean>
  #thanks: Signal<string>
  -keys: Record<FeedbackTab, string>
  #choose(tab: FeedbackTab): void
  #toggle(chip: KudosChip): void
  #send(): void
  #close(): void
}

class FeedbackDialogData {
  +page: string
}

enum FeedbackTab {
  rate
  bug
  kudos
}

enum View {
  form
  busy
  failed
  sent
}

class RatingRequest {
  +rating: number
  +note?: string
  +areas?: Partial<Record<FeedbackArea, number>>
  +mayContact?: boolean
}

class BugReportRequest {
  +where?: BugPlace
  +happened: string
  +expected?: string
  +frequency?: BugFrequency
  +screen?: string
  +version?: string
  +screenshotIds?: string[]
  +mayContact?: boolean
}

class KudosRequest {
  +business?: string
  +chips: KudosChip[]
  +note?: string
  +showOnPage?: boolean
  +mayContact?: boolean
}

class FeedbackItem {
  +id: string
  +kind: FeedbackKind
  +createdAt: string
  +status: FeedbackStatus
  +rating: number | null
  +summary: string | null
  +reference: string | null
  +business: string | null
  +reply: string | null
}

class App {
  #routeData: Signal<JbRouteData>
  #member: Signal<ChromeMember | null>
  #openFeedback(launcher: HTMLElement): Promise<void>
}

class FeedbackLauncher <<jb-feedback-launcher>> {
  +opened: OutputEmitterRef<HTMLButtonElement>
}

HttpFeedbackApi ..|> FeedbackApi
App --> FeedbackLauncher : renders
App ..> FeedbackDialog : opens
FeedbackDialog --> FeedbackDialogData : receives
FeedbackDialog --> FeedbackApi : sends through
FeedbackDialog --> "1" FeedbackTab
FeedbackDialog --> "1" View
FeedbackApi ..> RatingRequest
FeedbackApi ..> BugReportRequest
FeedbackApi ..> KudosRequest
FeedbackApi ..> FeedbackItem : answers
@enduml
