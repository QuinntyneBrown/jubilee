@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Follow your feedback

class FeedbackPage {
  #historyState: Signal<"loading" | "error" | "loaded">
  -sentItems: Signal<FeedbackItem[]>
  #history: Signal<FeedbackHistoryItem[]>
  #loadHistory(): void
}

class FeedbackHistory <<jb-feedback-history>> {
  +state: InputSignal<"loading" | "error" | "loaded">
  +items: InputSignal<FeedbackHistoryItem[]>
  +headingId: InputSignal<string>
  +retry: OutputEmitterRef<void>
}

class FeedbackHistoryItem {
  +id: string
  +kind: FeedbackHistoryKind
  +title: string
  +date: string
  +dateTime: string
  +reference: string | null
  +status: string
  +reply: string | null
}

interface FeedbackApi {
  +mine(): Observable<FeedbackItem[]>
}

class FeedbackItem {
  +id: string
  +kind: "rating" | "bug-report" | "kudos"
  +createdAt: string
  +status: "received" | "read" | "in-progress" | "fixed"
  +rating: number | null
  +summary: string | null
  +reference: string | null
  +business: string | null
  +reply: string | null
}

class GetMyFeedbackQuery {
  +string Subject
}

class GetMyFeedbackQueryHandler {
  +Handle(request: GetMyFeedbackQuery, cancellationToken: CancellationToken): Task<IReadOnlyList<FeedbackItemDto>>
}

class FeedbackWire <<static>> {
  +{static} SummaryLength: int = 80
  +{static} ToItem(feedback: Feedback): FeedbackItemDto
  +{static} Summary(happened: string?): string?
}

class FeedbackItemDto {
  +Guid Id
  +string Kind
  +DateTimeOffset CreatedAt
  +string Status
  +int? Rating
  +string? Summary
  +string? Reference
  +string? Business
  +string? Reply
}

enum FeedbackStatus {
  Received
  Read
  InProgress
  Fixed
}

class Feedback {
  +Guid Id
  +FeedbackKind Kind
  +string MemberSubject
  +FeedbackStatus Status
  +string? Reply
  +DateTimeOffset CreatedAt
  +MarkRead(): void
  +StartWork(): void
  +MarkFixed(): void
  +ReplyWith(reply: string): void
}

FeedbackPage --> FeedbackApi : loads through
FeedbackPage --> FeedbackHistory : passes items and state to
FeedbackHistory --> "0..*" FeedbackHistoryItem : shows
FeedbackApi ..> FeedbackItem : answers
GetMyFeedbackQueryHandler ..> GetMyFeedbackQuery : handles
GetMyFeedbackQueryHandler ..> FeedbackItemDto : answers
GetMyFeedbackQueryHandler --> Feedback : reads
GetMyFeedbackQueryHandler ..> FeedbackWire : maps with
Feedback --> "1" FeedbackStatus
@enduml
