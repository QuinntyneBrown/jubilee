@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Answer a moment check-in

class MomentCheck <<jb-moment-check>> {
  +question: InputSignal<string>
  +score: InputSignal<number | null>
  +thanked: InputSignal<boolean>
  +noteMax: InputSignal<number>
  +scoreChange: OutputEmitterRef<number>
  +sent: OutputEmitterRef<string>
}

class ScoreScale <<jb-score-scale>> {
  +legend: InputSignal<string>
  +value: InputSignal<number | null>
  +wide: InputSignal<boolean>
  +clearable: InputSignal<boolean>
  +valueChange: OutputEmitterRef<number | null>
}

class MomentCheckIn {
  -id: string
  +score: WritableSignal<number | null>
  +thanked: WritableSignal<boolean>
  +choose(score: number): void
  +send(note: string): void
}

interface FeedbackApi {
  +saveCheckIn(id: string, request: CheckInRequest): Observable<void>
}

class CheckInRequest {
  +moment: "request-sent" | "listing-submitted"
  +score: number
  +note?: string
}

class SaveCheckInCommand {
  +Guid Id
  +string Subject
  +string MemberName
  +string? Moment
  +int? Score
  +string? Note
}

class SaveCheckInCommandHandler {
  +{static} int CheckInsPerHour = 30
  +Handle(request: SaveCheckInCommand, cancellationToken: CancellationToken): Task
}

enum CheckInMoment {
  RequestSent
  ListingSubmitted
}

enum FeedbackKind {
  Rating
  BugReport
  Kudos
  CheckIn
}

class Feedback {
  +Guid Id
  +FeedbackKind Kind
  +string MemberSubject
  +CheckInMoment? Moment
  +int? Rating
  +string? Note
  +DateTimeOffset CreatedAt
  +{static} CheckIn(id, memberSubject, memberName, moment, score, note, now): Feedback
  +Answer(moment: CheckInMoment, score: int, note: string?): void
}

MomentCheck *-- "1" ScoreScale
MomentCheckIn --> FeedbackApi : saves through
FeedbackApi ..> CheckInRequest
SaveCheckInCommandHandler ..> SaveCheckInCommand : handles
SaveCheckInCommandHandler --> Feedback : creates or replaces
Feedback --> "1" FeedbackKind
Feedback --> "0..1" CheckInMoment
@enduml
