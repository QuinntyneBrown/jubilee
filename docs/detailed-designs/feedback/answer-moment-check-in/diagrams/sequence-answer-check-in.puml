@startuml
title UML sequence behaviour — Answer a moment check-in
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "Confirmation container" as host
  participant "jb-moment-check" as check
  participant "FeedbackApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "FeedbackController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SaveCheckInCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
note over host : BookMeetingDialog or RequestQuoteDialog or RequestItemDialog success view, or ListBusinessPage submitted view
host -> host : Make one check-in id for this confirmation
host -> check : Render with the question of the moment
check --> actor : "How easy was it to send your request?" with 1 to 5 between "Very hard" and "Very easy" (L2-211)
alt Member ignores the question
  actor -> host : Leave the confirmation
  host --> actor : Nothing stored
else Member chooses a score
  actor -> check : Choose a score
  check -> host : scored(score)
  host -> client : saveCheckIn(id, { moment, score })
  client -> controller : PUT /api/feedback/check-ins/{id}
  controller -> handler : Send SaveCheckInCommand with the member of the session
  handler -> db : Load Feedback by id
  db --> handler : Feedback or none
  alt No feedback with the id
    handler -> db : Save a new Feedback of kind CheckIn unless past 30 in the hour
  else Check-in of the caller
    handler -> db : Replace the score and the note (one answer per confirmation)
  else Feedback of another member
    handler --> controller : NotFoundException (L2-133)
  end
  controller --> client : 204 or 404 or 422 or 429
  client --> host : Result, ignored when it is an error
  alt Score of 4 or 5
    check --> actor : "Thanks, that helps us."
  else Score of 3 or less
    check --> actor : Field "What got in the way?" and button "Send"
    opt Member chooses another score
      actor -> check : Choose a score
      host -> client : saveCheckIn(id, { moment, score }) replaces the first
    end
    actor -> check : Type a note or none and press "Send"
    check -> host : noted(note)
    host -> client : saveCheckIn(id, { moment, score, note })
    client -> controller : PUT /api/feedback/check-ins/{id}
    controller --> client : 204 No Content
    check --> actor : "Thanks, that helps us."
  end
end
opt The answer cannot be stored
  client --> host : Error or timeout
  host --> actor : Nothing said and the confirmation is not blocked (L2-211)
end
@enduml
