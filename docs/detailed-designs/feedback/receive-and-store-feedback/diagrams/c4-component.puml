@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Receive and store feedback

Container(web, "Jubilee Web", "Angular single-page application", "FeedbackApi")
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "FeedbackController", "ASP.NET Core controller", "api/feedback with the member from the session")
  Component(rating, "SendRatingCommandHandler", "MediatR handler", "Stores a rating with its area scores")
  Component(bug, "SendBugReportCommandHandler", "MediatR handler", "Stores a bug report with a reference and its screenshots")
  Component(kudos, "SendKudosCommandHandler", "MediatR handler", "Stores kudos for the team or a contacted business")
  Component(shot, "UploadFeedbackScreenshotCommandHandler", "MediatR handler", "Cleans and stores one picture")
  Component(checkin, "SaveCheckInCommandHandler", "MediatR handler", "Creates or replaces a check-in by id")
  Component(mine, "GetMyFeedbackQueryHandler", "MediatR handler", "Lists the caller's own items")
  Component(biz, "GetKudosBusinessesQueryHandler", "MediatR handler", "Lists the contacted businesses")
  Component(rules, "FeedbackRules", "Application rules", "Hourly limit of 10 items per member")
  Component(sanitizer, "ImageSanitizer", "Application service", "Decides the type from the bytes and removes metadata")
  Component(entity, "Feedback", "Domain entity", "One record of four kinds with status and reply")
  Component(screenshot, "FeedbackScreenshot", "Domain entity", "Cleaned picture of one member")
  Component(erasure, "AccountErasure", "Application service", "Deletes a member's data with the account")
  Component(export, "DataExportBuilder", "Application service", "Builds the data download")
  Component(ctx, "IAppDbContext", "EF Core abstraction", "Feedback and FeedbackScreenshots sets")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Feedback and FeedbackScreenshots tables")

Rel(web, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, rating, "Sends SendRatingCommand")
Rel(ctrl, bug, "Sends SendBugReportCommand")
Rel(ctrl, kudos, "Sends SendKudosCommand")
Rel(ctrl, shot, "Sends UploadFeedbackScreenshotCommand")
Rel(ctrl, checkin, "Sends SaveCheckInCommand")
Rel(ctrl, mine, "Sends GetMyFeedbackQuery")
Rel(ctrl, biz, "Sends GetKudosBusinessesQuery")
Rel(rating, rules, "Applies")
Rel(bug, rules, "Applies")
Rel(kudos, rules, "Applies")
Rel(shot, sanitizer, "Cleans with")
Rel(rating, entity, "Creates")
Rel(bug, entity, "Creates")
Rel(kudos, entity, "Creates")
Rel(checkin, entity, "Creates or replaces")
Rel(shot, screenshot, "Creates")
Rel(bug, screenshot, "Links")
Rel(mine, ctx, "Reads through")
Rel(biz, ctx, "Reads through")
Rel(erasure, ctx, "Deletes feedback and screenshots through")
Rel(export, ctx, "Reads feedback through")
Rel(ctx, db, "Maps to", "EF Core")
@enduml
