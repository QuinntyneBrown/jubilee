@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Receive and store feedback

enum FeedbackKind {
  Rating
  BugReport
  Kudos
  CheckIn
}

enum FeedbackStatus {
  Received
  Read
  InProgress
  Fixed
}

enum BugFrequency {
  Once
  Sometimes
  EveryTime
}

enum CheckInMoment {
  RequestSent
  ListingSubmitted
}

class AreaScores <<record>> {
  +int? Finding
  +int? Listing
  +int? Messaging
  +int? Trust
}

class Feedback {
  +{static} int MaxNoteLength = 1000
  +{static} int MaxAnswerLength = 2000
  +{static} int MaxScreenshots = 3
  +{static} int MaxScreenLength = 100
  +{static} int MaxVersionLength = 40
  +{static} int MaxUserAgentLength = 400
  +{static} string[] KudosChips
  +{static} string[] BugPlaces
  +Guid Id
  +FeedbackKind Kind
  +string MemberSubject
  +string MemberName
  +FeedbackStatus Status
  +DateTimeOffset CreatedAt
  +string IdempotencyKey
  +bool MayContact
  +int? Rating
  +string? Note
  +int? FindingScore
  +int? ListingScore
  +int? MessagingScore
  +int? TrustScore
  +string? Reply
  .. bug report ..
  +string? Reference
  +string? Place
  +string? Happened
  +string? Expected
  +BugFrequency? Frequency
  +string? Screen
  +string? UserAgent
  +string? AppVersion
  .. kudos ..
  +Guid? ListingId
  +string? BusinessName
  +string? Chips
  +bool ShowOnPage
  .. check-in ..
  +CheckInMoment? Moment
  --
  +{static} IsScore(score: int?): bool
  +{static} Rate(...): Feedback
  +{static} ReportBug(...): Feedback
  +{static} Thank(...): Feedback
  +{static} CheckIn(id: Guid, ...): Feedback
  +Answer(moment: CheckInMoment, score: int, note: string?): void
  +MarkRead(): void
  +StartWork(): void
  +MarkFixed(): void
  +ReplyWith(reply: string): void
}

class FeedbackScreenshot {
  +Guid Id
  +Guid? FeedbackId
  +string UploaderSubject
  +string ContentType
  +byte[] Content
  +DateTimeOffset CreatedAt
  +{static} Store(uploaderSubject, contentType, content, now): FeedbackScreenshot
  +AttachTo(feedbackId: Guid): void
}

class Listing {
  +Guid Id
  +string Slug
  +string Name
}

class FeedbackController {
  +Mine(): IReadOnlyList<FeedbackItemDto>
  +Businesses(): IReadOnlyList<KudosBusinessDto>
  +Rate(request: SendRatingBody): 201
  +ReportBug(request: SendBugReportBody): 201
  +Thank(request: SendKudosBody): 201
  +Upload(file: IFormFile?): 201 or 422
  +CheckIn(id: Guid, request: SaveCheckInBody): 204
}

class SendRatingCommand
class SendBugReportCommand
class SendKudosCommand
class SaveCheckInCommand
class UploadFeedbackScreenshotCommand
class GetMyFeedbackQuery
class GetKudosBusinessesQuery

class FeedbackRules <<static>> {
  +{static} int ItemsPerHour = 10
  +{static} TimeSpan Window = 1 hour
  +{static} KeyOf(idempotencyKey: string?): string
  +{static} Earlier(db, subject, key): Task<Feedback?>
  +{static} EnsureWithinLimit(db, subject, now): Task
  +{static} Note(note: string?, errors): string?
}

class FeedbackWire <<static>> {
  +{static} ToItem(feedback: Feedback): FeedbackItemDto
  +{static} Summary(happened: string?): string?
}

class KudosBusinesses <<static>> {
  +{static} For(db, subject): Task<List<Listing>>
}

class ImageSanitizer <<static>> {
  +{static} Sanitize(bytes: byte[]): SanitizedImage
}

Feedback --> "1" FeedbackKind
Feedback --> "1" FeedbackStatus
Feedback --> "0..1" BugFrequency
Feedback --> "0..1" CheckInMoment
Feedback ..> AreaScores : takes
Feedback "0..1" o-- "0..3" FeedbackScreenshot : screenshots of a bug report
Feedback "0..*" --> "0..1" Listing : kudos for
FeedbackController ..> SendRatingCommand : sends
FeedbackController ..> SendBugReportCommand : sends
FeedbackController ..> SendKudosCommand : sends
FeedbackController ..> SaveCheckInCommand : sends
FeedbackController ..> UploadFeedbackScreenshotCommand : sends
FeedbackController ..> GetMyFeedbackQuery : sends
FeedbackController ..> GetKudosBusinessesQuery : sends
SendRatingCommand ..> Feedback : creates
SendBugReportCommand ..> Feedback : creates
SendKudosCommand ..> Feedback : creates
SaveCheckInCommand ..> Feedback : creates or replaces
UploadFeedbackScreenshotCommand ..> FeedbackScreenshot : creates
UploadFeedbackScreenshotCommand ..> ImageSanitizer : cleans with
SendRatingCommand ..> FeedbackRules : limited by
SendBugReportCommand ..> FeedbackRules : limited by
SendKudosCommand ..> FeedbackRules : limited by
SendKudosCommand ..> KudosBusinesses : checks the business with
GetKudosBusinessesQuery ..> KudosBusinesses : lists
GetMyFeedbackQuery ..> FeedbackWire : maps with
@enduml
