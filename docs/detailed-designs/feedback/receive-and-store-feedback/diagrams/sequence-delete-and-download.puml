@startuml
title UML sequence behaviour — Delete and download
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Backend — Jubilee API" #D1FADF
  participant "AccountController" as controller
end box
box "Backend — Jubilee Worker" #F4EBFF
  participant "WorkerHost" as worker
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "DeleteAccountCommandHandler" as delete
  participant "DataExportBuilder" as export
  participant "DataArchive" as archive
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
alt Member deletes their account (L2-017)
  actor -> controller : DELETE /api/account after typing DELETE
  controller -> delete : Send DeleteAccountCommand
  delete -> db : Remove the FeedbackScreenshots rows the member uploaded
  delete -> db : Remove the Feedback rows of the member's subject
  delete -> db : Save with the deletion of the account
  db --> delete : Commit result
  delete --> controller : Done
  controller --> actor : Account deleted with its feedback and screenshots (L2-214)
else Member downloads their data (L2-018)
  actor -> controller : POST /api/account/data-exports
  controller --> actor : Export requested
  worker -> export : BuildDueAsync
  export -> archive : BuildAsync(member)
  archive -> db : Load the member's Feedback of all four kinds and count the screenshots of each report
  db --> archive : Feedback rows and counts
  archive -> archive : Add "feedback", oldest first, with a count of screenshots and not the pictures
  archive --> export : Archive
  export -> db : Mark the export ready and queue its e-mail
  actor -> controller : GET /api/account/data-exports/{token}
  controller --> actor : Archive that includes the feedback (L2-214)
end
@enduml
