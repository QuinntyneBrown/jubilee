@startuml
title UML sequence behaviour — Store a screenshot
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "Jubilee Web" as web
box "Backend — Jubilee API" #D1FADF
  participant "FeedbackController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "UploadFeedbackScreenshotCommandHandler" as handler
  participant "ImageSanitizer" as sanitizer
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
web -> controller : POST /api/feedback/screenshots with the picture as the form file "file"
controller -> handler : Send UploadFeedbackScreenshotCommand(Subject, Content) with the member of the session
handler -> db : Count the member's screenshots of the past hour
db --> handler : Count
alt 30 already
  handler --> controller : RateLimitedException
  controller --> web : 429 with Retry-After (L2-137)
else Under the limit
  handler -> sanitizer : Sanitize(bytes)
  sanitizer -> sanitizer : Decide JPEG or PNG from the bytes and check 5 MB and the pixel limit and re-encode without metadata (L2-138)
  sanitizer --> handler : SanitizedImage or a problem
  alt Not a JPEG or PNG
    handler --> controller : InvalidImageException INVALID_IMAGE
    controller --> web : 422 and nothing stored
  else Too large
    handler --> controller : InvalidImageException TOO_LARGE
    controller --> web : 422 and nothing stored
  else Clean picture
    handler -> db : Save FeedbackScreenshot.Store with UploaderSubject and no FeedbackId
    db --> handler : Commit result
    handler --> controller : Screenshot id
    controller --> web : 201 Created with the id
  end
end
note over controller, db : No endpoint returns a screenshot. A bug report names up to three by id (L2-214).
@enduml
