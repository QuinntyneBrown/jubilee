@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Send feedback from the page

interface FeedbackApi {
  +sendRating(request: RatingRequest, idempotencyKey: string): Observable<FeedbackItem>
  +sendBugReport(request: BugReportRequest, idempotencyKey: string): Observable<FeedbackItem>
  +sendKudos(request: KudosRequest, idempotencyKey: string): Observable<FeedbackItem>
  +uploadScreenshot(picture: Blob): Observable<StoredScreenshot>
  +kudosBusinesses(): Observable<KudosBusiness[]>
  +mine(): Observable<FeedbackItem[]>
}

class HttpFeedbackApi {
  -http: HttpClient
}

class FeedbackPage {
  #tab: Signal<Tab>
  #view: Signal<View>
  #problems: Signal<Partial<Record<FieldName, string>>>
  #mayContact: Signal<boolean>
  #rating: Signal<number | null>
  #scores: Signal<Partial<Record<FeedbackArea, number>>>
  #where: Signal<BugPlace | "">
  #frequency: Signal<BugFrequency | null>
  #screenshots: Signal<Screenshot[]>
  #forBusiness: Signal<boolean>
  #businesses: Signal<KudosBusiness[] | null>
  #showOnPage: Signal<boolean>
  -keys: Record<Tab, string>
  #choose(tab: Tab): void
  #score(area: FeedbackArea, score: number | null): void
  #often(frequency: BugFrequency): void
  #toggle(chip: KudosChip): void
  #addScreenshots(files: File[]): Promise<void>
  #removeScreenshot(id: string): void
  #submit(): void
  -uploadScreenshots(): Observable<string[]>
}

class RatingRequest {
  +rating: number
  +note?: string
  +areas?: Partial<Record<FeedbackArea, number>>
  +mayContact?: boolean
}

enum FeedbackArea {
  finding
  listing
  messaging
  trust
}

class BugReportRequest {
  +where?: BugPlace
  +happened: string
  +expected?: string
  +frequency?: BugFrequency
  +screen?: string
  +version?: string
  +screenshotIds?: string[]
  +mayContact?: boolean
}

class KudosRequest {
  +business?: string
  +chips: KudosChip[]
  +note?: string
  +showOnPage?: boolean
  +mayContact?: boolean
}

class Screenshot {
  +id: string
  +name: string
  +file: Blob
  +storedId: string | null
}

class StoredScreenshot {
  +id: string
}

class KudosBusiness {
  +slug: string
  +name: string
}

class FeedbackItem {
  +id: string
  +kind: FeedbackKind
  +createdAt: string
  +status: FeedbackStatus
  +rating: number | null
  +summary: string | null
  +reference: string | null
  +business: string | null
  +reply: string | null
}

class PhotoAttachmentService {
  +typeOf(file: Blob): Promise<"image/jpeg" | "image/png" | null>
}

HttpFeedbackApi ..|> FeedbackApi
FeedbackPage --> FeedbackApi : sends through
FeedbackPage --> PhotoAttachmentService : checks files with
FeedbackPage "1" *-- "0..3" Screenshot
FeedbackPage --> "0..*" KudosBusiness
RatingRequest ..> FeedbackArea
FeedbackApi ..> RatingRequest
FeedbackApi ..> BugReportRequest
FeedbackApi ..> KudosRequest
FeedbackApi ..> StoredScreenshot : answers
FeedbackApi ..> FeedbackItem : answers
@enduml
