@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Send feedback from the page

Container_Boundary(web, "Jubilee Web") {
  Component(guard, "memberGuard", "Angular route guard", "Sends a visitor to sign in and back")
  Component(page, "FeedbackPage", "Angular page", "Route /feedback/:tab with three forms and view and one idempotency key per tab")
  Component(tabs, "div[jb-tab-list] segmented look", "Library component", "Rate and Report a bug and Kudos")
  Component(stars, "jb-star-scale", "Library component", "Overall rating as five native radios")
  Component(rows, "jb-score-rows and jb-score-row", "Library component", "One row per area with its name and detail")
  Component(scores, "jb-score-scale", "Library component", "Clearable 1 to 5 score of one area")
  Component(chips, "jb-chip", "Library component", "How often and the kudos chips with a 44 px hit area on a touch screen")
  Component(files, "jb-file-list", "Library component", "Add screenshots and each file by name with Remove")
  Component(history, "jb-feedback-history", "Library component", "Your feedback")
  Component(photo, "PhotoAttachmentService", "Angular service", "typeOf decides JPEG or PNG from the first bytes")
  Component(client, "FeedbackApi", "Service contract", "FEEDBACK_API implemented by HttpFeedbackApi")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "FeedbackController", "ASP.NET Core controller", "Exposes /api/feedback and its ratings and bug-reports and kudos and screenshots and businesses")
}

Rel(guard, page, "Admits a member to")
Rel(page, tabs, "Composes")
Rel(page, stars, "Composes")
Rel(page, rows, "Composes")
Rel(rows, scores, "Holds one per area")
Rel(page, chips, "Composes")
Rel(page, files, "Composes")
Rel(page, history, "Composes")
Rel(page, photo, "Checks each file with")
Rel(page, client, "Sends through")
Rel(client, ctrl, "Calls with Idempotency-Key on creates", "JSON/HTTPS")
@enduml
