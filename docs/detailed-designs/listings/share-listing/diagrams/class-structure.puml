@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Share a listing

class ShareListingDialog {
  +data: ShareListingData
  +url: string
  +mailto: string
  +whatsapp: string
  +canShare: boolean
  +copied: Signal<boolean>
  +copy(): Promise<void>
  +more(): Promise<void>
  +close(): void
}

class ShareListingData {
  +slug: string
  +businessName: string
}

class "server.js" as Server {
  +previewAgents: RegExp
  +previewPath(req): string | null
  +proxy(req, res, path)
}

class SharePreviewController {
  +Get(slug: string): Task<ContentResult>
}

class GetSharePreviewQuery {
  +string Slug
}

class GetSharePreviewQueryHandler {
  +Handle(query: GetSharePreviewQuery): Task<string>
}

class AccountSettings {
  +string PublicBaseUrl
}

class Listing {
  +Guid Id
  +string Slug
  +string Name
  +string Tagline
}

ShareListingDialog --> "1" ShareListingData : shares
Server ..> SharePreviewController : forwards preview fetchers to
SharePreviewController ..> GetSharePreviewQuery : sends
GetSharePreviewQueryHandler ..> GetSharePreviewQuery : handles
GetSharePreviewQueryHandler --> Listing : loads (WherePublic)
GetSharePreviewQueryHandler ..> AccountSettings : reads the public host
@enduml
