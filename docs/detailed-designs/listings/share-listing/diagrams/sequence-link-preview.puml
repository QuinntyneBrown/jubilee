@startuml
title UML sequence behaviour — Serve the link preview of a shared listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "Social or chat app" as app
box "App host" #E0F2FE
  participant "server.js" as host
end box
box "Backend — Jubilee API" #D1FADF
  participant "SharePreviewController" as controller
  participant "GetSharePreviewQueryHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
app -> host : GET https://{host}/b/{slug}\nUser-Agent: a link-preview fetcher
alt User agent matches previewAgents
  host -> controller : GET /api/listings/{slug}/social-preview
  controller -> handler : Send GetSharePreviewQuery
  handler -> db : Load the public listing (WherePublic, L2-028)
  db --> handler : Listing or none
  alt Public listing
    handler --> controller : Document with og:title, og:description, og:url, og:image (L2-038 AC4)
    controller --> host : 200 text/html
    host --> app : 200 the preview document
    app -> host : GET /og-image.png
    host --> app : 1200 × 630 PNG
  else Not public or unknown
    handler --> controller : NotFoundException
    controller --> host : 404 problem details
    host --> app : 404, no listing tags
  end
else Any other user agent (a browser, a search engine)
  host --> app : 200 index.html (the app)
end
@enduml
