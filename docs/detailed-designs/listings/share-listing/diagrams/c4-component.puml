@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Share a listing

Container_Boundary(web, "Jubilee Web") {
  Component(page, "BusinessPage", "Angular page", "Opens the dialog at /b/{slug}/share")
  Component(dialog, "ShareListingDialog", "Angular dialog", "Share {business} with the link, Copy, E-mail, WhatsApp and More…; a polite status says Link copied")
}
Container_Boundary(host, "App host") {
  Component(server, "server.js", "Node.js", "Sends a link-preview fetcher's /b/{slug} to the social preview (previewAgents)")
}
Container_Boundary(api, "Jubilee API") {
  Component(controller, "SharePreviewController", "ASP.NET Core controller", "GET /api/listings/{slug}/social-preview")
  Component(handler, "GetSharePreviewQueryHandler", "MediatR handler", "Encodes the Open Graph tags of a public listing")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Listing rows")
System_Ext(apps, "Social or chat app", "Fetches link previews")

Rel(page, dialog, "Opens")
Rel(apps, server, "Requests /b/{slug}", "HTTPS")
Rel(server, controller, "Forwards a preview fetcher to", "HTTP")
Rel(controller, handler, "Sends GetSharePreviewQuery")
Rel(handler, db, "Queries", "EF Core")
@enduml
