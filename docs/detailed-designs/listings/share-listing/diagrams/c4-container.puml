@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Share a listing

Person(member, "Visitor or Member", "Shares a listing")
System_Ext(apps, "Social or chat app", "Fetches link previews")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Share dialog with Copy and E-mail and WhatsApp and More")
  Container(host, "App host", "Node.js (eng/azure/server.js)", "Serves the app and og-image.png; sends preview fetchers of /b/{slug} to the social preview")
  Container(api, "Jubilee API", "ASP.NET Core", "Serves the social preview with Open Graph tags")
  ContainerDb(db, "Jubilee database", "SQL Server", "Listing name and tagline")
}
Rel(member, web, "Uses", "HTTPS")
Rel(member, apps, "Pastes or sends the link in")
Rel(apps, host, "Requests /b/{slug} and /og-image.png from", "HTTPS")
Rel(host, api, "Forwards /api/listings/{slug}/social-preview to", "HTTP")
Rel(api, db, "Reads the public listing from", "EF Core")
@enduml
