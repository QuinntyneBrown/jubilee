@startuml
title UML sequence behaviour — Share a listing from the dialog
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor or Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "BusinessPage" as page
  participant "ShareListingDialog" as dialog
end box
participant "Browser and device" as device
actor -> page : Press "Share" (/b/{slug}/share)
page -> dialog : Open with the slug and business name; the CDK keeps the focused "Share"
dialog -> device : Is navigator.share a function?
device --> dialog : Web Share API present or absent
dialog --> actor : "Share {business}" with the link, "Copy", "E-mail", "WhatsApp", "More…" where present, "Done" (L2-038 AC1, AC3)
alt Press "Copy"
  actor -> dialog : Press "Copy"
  dialog -> device : navigator.clipboard.writeText(link), else select and copy
  dialog --> actor : "Copied ✓" for 2 seconds; the status region says "Link copied" (L2-038 AC2)
else Press "E-mail" or "WhatsApp"
  actor -> device : Follow the mailto: or https://wa.me/?text= link
  device --> actor : Open the mail or WhatsApp composer
else Press "More…" where the Web Share API exists
  actor -> dialog : Press "More…"
  dialog -> device : navigator.share({ title: "{business} on Jubilee", url })
  device --> actor : Open the native share sheet (L2-038 AC3)
end
actor -> dialog : Press "Done" or Escape
dialog --> page : Close; back to /b/{slug}
page --> actor : Focus returns to "Share" (L2-130 AC2)
@enduml
