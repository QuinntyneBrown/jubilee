@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View a business page

Container_Boundary(web, "Jubilee Web") {
  Component(page, "BusinessPage", "Angular page", "Route /b/:slug that picks the layout by ListingKind")
  Component(svc, "ServiceRow", "Angular component", "One service with its Book or Ask action")
  Component(shop, "ProductCard", "Angular component", "One product, with Sold out on its tile")
  Component(related, "BusinessCard", "Angular component", "One of up to two cards of More in {category}")
  Component(banner, "Alert", "Angular component", "Owner banner, or the preview banner with the status")
  Component(client, "ListingsApi", "Typed HTTP client", "Calls the listing endpoints")
}
Container_Boundary(api, "Jubilee API") {
  Component(ctrl, "ListingsController", "ASP.NET Core controller", "GET /api/listings/{slug} and POST /api/listings/{slug}/views")
  Component(handler, "GetListingPageQueryHandler", "MediatR handler", "Builds the ListingPageDto for the viewer")
  Component(policy, "PublicListingFilter", "Domain specification", "The one definition of a public listing")
  Component(views, "RecordListingViewCommandHandler", "MediatR handler", "Counts a view unless it is excluded")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(job, "ResponseTimeBadgeJob", "Hosted job", "Sets ReplyTimeBand from the 90-day median")
}
ContainerDb(cache, "IDirectoryReadCache", "Redis", "Public listing pages for at most 60 seconds")
ContainerDb(db, "Jubilee database", "SQL Server", "Listing data")

Rel(page, svc, "Renders for a service business")
Rel(page, shop, "Renders for a shop")
Rel(page, related, "Renders")
Rel(page, banner, "Renders for the owner and for a preview")
Rel(page, client, "Loads through")
Rel(client, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, handler, "Sends GetListingPageQuery")
Rel(ctrl, views, "Sends RecordListingViewCommand")
Rel(handler, policy, "Checks visibility with")
Rel(handler, cache, "Reads and writes", "Redis protocol")
Rel(handler, db, "Queries", "EF Core")
Rel(views, db, "Checks the last 30 minutes and inserts ListingView", "EF Core")
Rel(job, db, "Updates Listing.ReplyTimeBand", "EF Core")
@enduml
