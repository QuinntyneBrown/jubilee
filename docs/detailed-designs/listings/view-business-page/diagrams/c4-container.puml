@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View a business page

Person(member, "Visitor or Member", "Reads a listing")
Person(owner, "Owner", "Views their own listing")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Service business page and shop page at /b/:slug")
  Container(api, "Jubilee API", "ASP.NET Core", "Serves listing pages and records listing views")
  Container(worker, "Jubilee Worker", ".NET worker service", "Computes the reply-time band of each listing")
  ContainerDb(cache, "Cache", "Redis", "Public listing pages for at most 60 seconds and view de-duplication keys")
  ContainerDb(db, "Jubilee database", "SQL Server", "Listings and services and products and listing views")
  ContainerDb(media, "Media storage", "Object storage + CDN", "Cover and product photos")
}
Rel(member, web, "Uses", "HTTPS")
Rel(owner, web, "Uses", "HTTPS")
Rel(web, api, "Loads the listing page from", "JSON/HTTPS")
Rel(web, media, "Loads photos from", "HTTPS")
Rel(api, cache, "Reads and writes", "Redis protocol")
Rel(api, db, "Reads listings and writes views in", "EF Core")
Rel(worker, db, "Reads first-reply times and writes reply-time bands in", "EF Core")
@enduml
