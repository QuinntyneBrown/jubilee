@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — View a business page

enum ListingKind {
  Services
  Shop
  Space
}

enum ViewerRelation {
  Visitor
  Member
  Owner
  Moderator
}

enum ReplyTimeBand {
  None
  WithinFewHours
  WithinDay
  WithinFewDays
}

class Listing {
  +Guid Id
  +string? OwnerId
  +string CategorySlug
  +string Slug
  +string Name
  +string Tagline
  +string? Highlight
  +ListingKind Kind
  +ListingStage Stage
  +bool IsPaused
  +bool IsUnderModerationHold
  +DateTimeOffset? DeletedAt
  +ReplyTimeBand ReplyTimeBand
  +IsPublic(): bool
}

class Service {
  +Guid Id
  +string Name
  +string Detail
  +ServicePriceKind PriceKind
  +int? PriceCents
  +int Position
}

class Product {
  +Guid Id
  +string Slug
  +string Name
  +int PriceCents
  +bool IsSoldOut
}

class PublicListingFilter <<static>> {
  +Criteria: Expression<Func<Listing, bool>>
  +IsSatisfiedBy(listing: Listing): bool
}

class ListingStatus <<static>> {
  +Of(listing: Listing): string
}

class ProductCardDto {
  +string Slug
  +string Name
  +int PriceCents
  +bool SoldOut
}

class GetListingPageQuery {
  +string Slug
  +Viewer Viewer
}

class GetListingPageQueryHandler {
  +Handle(query: GetListingPageQuery): Task<ListingPageDto>
}

class ListingPageDto {
  +string Kind
  +string ViewerRelation
  +string Stage
  +string Status
  +ListingDetailsDto Details
  +IReadOnlyList<ServiceRowDto> Services
  +IReadOnlyList<ProductCardDto> Products
  +IReadOnlyList<BusinessCardDto> Related
}

class RecordListingViewCommand {
  +string Slug
  +Viewer Viewer
}

class ListingView {
  +Guid Id
  +Guid ListingId
  +string VisitorKey
  +DateTimeOffset ViewedAt
}

class ResponseTimeBadgeJob {
  +ExecuteAsync(stoppingToken: CancellationToken): Task
}

Listing "1" *-- "0..*" Service
Listing "1" *-- "0..*" Product
Listing --> "1" ListingKind
Listing --> "1" ReplyTimeBand
Listing "1" o-- "0..*" ListingView
GetListingPageQueryHandler ..> GetListingPageQuery : handles
GetListingPageQueryHandler ..> PublicListingFilter : checks with
GetListingPageQueryHandler ..> ListingStatus : names the status with
ListingPageDto --> "0..50" ProductCardDto
GetListingPageQueryHandler ..> ListingPageDto : returns
GetListingPageQueryHandler --> Listing : loads
ListingPageDto ..> ViewerRelation : carries
RecordListingViewCommand ..> ListingView : creates
ResponseTimeBadgeJob ..> Listing : updates band of
@enduml
