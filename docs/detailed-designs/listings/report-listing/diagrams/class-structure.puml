@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Report a listing

enum ReportReason {
  NotRealBusiness
  Misleading
  BadExperience
  Other
}

enum ReportStatus {
  Open
  InReview
  Resolved
}

class ListingReport {
  +Guid Id
  +Guid ListingId
  +string ReporterSubject
  +string ReporterName
  +ReportStatus Status
  +DateTimeOffset CreatedAt
  +{static} int MaxDescriptionLength = 2000
  +{static} Open(listingId, reporterSubject, reporterName, now): ListingReport
  +AcceptsAdditionAt(now): bool
  +Add(reason, description, idempotencyKey, now): ListingReportEntry
}

class ListingReportEntry {
  +Guid Id
  +Guid ReportId
  +ReportReason Reason
  +string Description
  +string IdempotencyKey
  +DateTimeOffset CreatedAt
}

class ReportListingCommand {
  +string Subject
  +string Slug
  +string? Reason
  +string? Description
  +string? IdempotencyKey
  +string? ReporterName
}

class ReportListingCommandHandler {
  +{static} int EntriesPerHour = 10
  +Handle(command): Task<ReportedDto>
}

class ReportSubmitted {
  +{static} Tell(db, team, listing, report, entry, now): void
}

class VerificationTeam {
  +{static} Tell(db, settings, subject, body, now, correlationId): void
}

class VerificationSettings {
  +string? TeamEmail
  +string AdminBaseUrl
}

class Listing {
  +Guid Id
  +string OwnerId
  +string Slug
  +string Name
}

class OutboxMessage {
  +Guid Id
  +string ToAddress
  +string Subject
  +string TextBody
  +Guid? CorrelationId
  +{static} Email(...): OutboxMessage
}

ListingReport "1" *-- "1..*" ListingReportEntry
ListingReport --> "1" ReportStatus
ListingReportEntry --> "1" ReportReason
ListingReport "0..*" --> "1" Listing : about
ReportListingCommandHandler ..> ReportListingCommand : handles
ReportListingCommandHandler --> ListingReport : creates or extends
ReportListingCommandHandler ..> ReportSubmitted : tells the team through
ReportSubmitted ..> VerificationTeam : uses
VerificationTeam ..> VerificationSettings : reads
VerificationTeam ..> OutboxMessage : writes
@enduml
