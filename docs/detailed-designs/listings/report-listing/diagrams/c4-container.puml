@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Report a listing

Person(member, "Member", "Reports a listing")
Person(verifier, "Verification team member", "Reviews reports")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Report dialog on the listing page")
  Container(api, "Jubilee API", "ASP.NET Core", "Validates and stores reports")
  Container(worker, "Jubilee Worker", ".NET worker service", "Dispatches verifier notifications from the outbox")
  ContainerDb(cache, "Cache", "Redis", "Idempotency keys for 24 hours")
  ContainerDb(db, "Jubilee database", "SQL Server", "Reports and outbox")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Posts the report to", "JSON/HTTPS")
Rel(api, cache, "Stores the idempotency record in", "Redis protocol")
Rel(api, db, "Writes the report and outbox message in", "EF Core")
Rel(worker, db, "Reads the outbox from", "EF Core")
Rel(worker, verifier, "Notifies in-app")
@enduml
