@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Report a listing

Person(member, "Member", "Reports a listing")
Person(moderator, "Jubilee team member", "Reviews reports")
System_Ext(mail, "E-mail service", "Delivers e-mail")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Report dialog on the listing page")
  Container(api, "Jubilee API", "ASP.NET Core", "Validates and stores reports and the team's e-mail")
  Container(worker, "Jubilee Worker", ".NET worker service", "Sends the outbox e-mails")
  Container(admin, "Jubilee Admin", "Angular single-page application", "Reports list at /reports")
  ContainerDb(db, "Jubilee database", "SQL Server", "Reports and outbox")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Posts the report to", "JSON/HTTPS")
Rel(api, db, "Writes the report and the outbox message in", "EF Core")
Rel(worker, db, "Reads the outbox from", "EF Core")
Rel(worker, mail, "Sends New report: {business} through")
Rel(mail, moderator, "Delivers to the team's address")
Rel(moderator, admin, "Opens /reports/{id} in")
@enduml
