@startuml
title UML sequence behaviour — Send a report
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ReportListingDialog" as dialog
  participant "ReportsApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "IdempotencyMiddleware" as idem
  participant "ReportsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "ReportListingCommandHandler" as handler
  participant "Report" as entity
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Cache" as cache
  database "Jubilee database" as db
end box
actor -> dialog : Press "Report this listing"
alt Visitor without a session
  dialog --> actor : Open the sign-in prompt (L2-039)
else Signed-in member
  dialog --> actor : Show "Report {business}" with "What's wrong?" and "Tell us what happened"
  actor -> dialog : Choose a reason and type a description and press "Send report"
  dialog -> dialog : Check reason and description
  alt Reason missing or description empty
    dialog --> actor : Show the errors under the fields and focus the first invalid field (L2-126)
  else Form valid
    dialog -> client : createReport(slug, reason, description, idempotency key)
    client -> idem : POST /api/listings/{slug}/reports
    idem -> cache : Look up the Idempotency-Key (L2-132)
    cache --> idem : Record or none
    alt Key seen within 24 hours
      idem --> client : Original response
    else New key
      idem -> controller : Pass the request
      controller -> controller : Authenticate the session and check the CSRF token (L2-133)
      controller -> handler : Send ReportListingCommand
      handler -> handler : Validate reason and description of at most 2,000 characters
      handler -> db : Load Listing and the reporter's open Report created within 24 hours
      db --> handler : Listing and Report or none
      alt Report by this member exists within 24 hours
        handler -> entity : AddEntry(reason, description, now) (L2-039)
        entity --> handler : Entry added to the first report
      else No recent report
        handler -> entity : Create(listing, reporter, reason, description, now)
        entity --> handler : Report with status Open
      end
      handler -> db : Save the report and a ReportSubmitted outbox message in one transaction
      db --> handler : Commit result
      handler --> controller : Report identifier
      controller --> idem : 201 Created
      idem -> cache : Store the response for 24 hours
      cache --> idem : Stored
      idem --> client : 201 Created
    end
    client --> dialog : Success
    dialog --> actor : Show "Thanks for telling us." and the private-report confirmation (L2-039)
  end
end
opt Submission fails or takes longer than 10 seconds
  client --> dialog : Error or timeout
  dialog --> actor : Show the failed state with the input kept (L2-128)
end
@enduml
