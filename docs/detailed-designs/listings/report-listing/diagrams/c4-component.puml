@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Report a listing

Container_Boundary(web, "Jubilee Web") {
  Component(dialog, "ReportListingDialog", "Angular dialog", "Reason and description form with counter")
  Component(signin, "SignInRequiredDialog", "Angular dialog", "Sign-in prompt for visitors")
  Component(keys, "IdempotencyKeyFactory", "Angular service", "Creates one key per dialog instance")
  Component(client, "ReportsApi", "Typed HTTP client", "Posts listing reports")
}
Container_Boundary(api, "Jubilee API") {
  Component(idem, "IdempotencyMiddleware", "ASP.NET Core middleware", "Replays the result of a repeated key")
  Component(ctrl, "ReportsController", "ASP.NET Core controller", "POST /api/listings/{slug}/reports")
  Component(validator, "ReportListingCommandValidator", "FluentValidation validator", "Reason and description rules")
  Component(handler, "ReportListingCommandHandler", "MediatR handler", "Creates a report or adds to an open one")
  Component(report, "Report", "Domain entity", "Owns entries and the 24-hour merge rule")
}
ContainerDb(cache, "Cache", "Redis", "Idempotency keys")
ContainerDb(db, "Jubilee database", "SQL Server", "Report and OutboxMessage rows")

Rel(dialog, keys, "Gets a key from")
Rel(dialog, client, "Submits through")
Rel(client, idem, "Calls with Idempotency-Key", "JSON/HTTPS")
Rel(idem, cache, "Reads and writes", "Redis protocol")
Rel(idem, ctrl, "Passes new requests to")
Rel(ctrl, handler, "Sends ReportListingCommand")
Rel(handler, validator, "Is validated by")
Rel(handler, report, "Creates or extends")
Rel(handler, db, "Saves report and outbox message", "EF Core")
@enduml
