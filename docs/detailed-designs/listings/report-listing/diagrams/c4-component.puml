@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Report a listing

Container_Boundary(web, "Jubilee Web") {
  Component(dialog, "ReportListingDialog", "Angular dialog", "Reason and description form with counter; one key per dialog (newKey)")
  Component(signin, "SignInRequiredDialog", "Angular dialog", "Sign-in prompt for visitors")
  Component(client, "ReportsApi (REPORTS_API)", "Typed HTTP client", "Posts listing reports with the Idempotency-Key header")
}
Container_Boundary(api, "Jubilee API and Application") {
  Component(ctrl, "ListingReportsController", "ASP.NET Core controller", "POST /api/listings/{slug}/reports")
  Component(handler, "ReportListingCommandHandler", "MediatR handler", "Checks the key, the rules and the rate; creates a report or adds to one")
  Component(report, "ListingReport", "Domain entity", "Owns entries and the 24-hour addition rule")
  Component(notice, "ReportSubmitted", "Application notice", "Writes the team's e-mail of a report")
  Component(team, "JubileeTeam", "Application service", "Decides who on the team is told (TeamSettings)")
}
Container_Boundary(worker, "Jubilee Worker") {
  Component(job, "OutboxDispatcherJob", "Background job", "Sends due outbox e-mails")
}
ContainerDb(db, "Jubilee database", "SQL Server", "ListingReport, ListingReportEntry and OutboxMessage rows")

Rel(dialog, client, "Submits through")
Rel(client, ctrl, "Calls with Idempotency-Key", "JSON/HTTPS")
Rel(ctrl, handler, "Sends ReportListingCommand")
Rel(handler, report, "Creates or extends")
Rel(handler, notice, "Tells the team through")
Rel(notice, team, "Tell(subject, body)")
Rel(handler, db, "Saves report and outbox message in one transaction", "EF Core")
Rel(job, db, "Reads due OutboxMessage rows", "EF Core")
@enduml
