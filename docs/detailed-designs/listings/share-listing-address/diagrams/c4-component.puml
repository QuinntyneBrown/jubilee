@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Share the address of a listing

Container_Boundary(web, "Jubilee Web") {
  Component(share, "ShareListingDialog", "Angular dialog", "Link, Copy, E-mail, WhatsApp and More… with the address")
  Component(list, "ListBusinessPage", "Angular page", "Your address on the publish success state")
  Component(mine, "MyBusinessPage", "Angular page", "Your address on the Your listing card")
  Component(edit, "EditListingPage", "Angular page", "Your address, read-only, and the note after a rename")
  Component(helper, "listingAddress", "Pure function (api library)", "Address, or {origin}/b/{slug} where there is none")
  Component(copy, "CopyLink", "Class", "Clipboard write and the 2-second Copied state")
}
Container_Boundary(api, "Jubilee API") {
  Component(handlers, "Listing page, publish, My business and editor handlers", "MediatR handlers", "Fill address on their DTOs")
  Component(settings, "AddressSettings", "Singleton", "AddressOf(slug)")
}

Rel(share, helper, "Builds its link with")
Rel(list, helper, "Builds its link with")
Rel(mine, helper, "Builds its link with")
Rel(edit, helper, "Builds its link with")
Rel(share, copy, "Copies through")
Rel(list, copy, "Copies through")
Rel(mine, copy, "Copies through")
Rel(list, handlers, "Publishes through", "JSON/HTTPS")
Rel(mine, handlers, "Reads My business from", "JSON/HTTPS")
Rel(edit, handlers, "Reads and saves the listing through", "JSON/HTTPS")
Rel(handlers, settings, "Ask AddressOf(slug)")
@enduml
