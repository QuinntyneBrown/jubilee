@startuml
title UML sequence behaviour — Save an item and undo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "Heart (Saveable or page)" as heart
  participant "SavedStore" as store
  participant "ToastService" as toast
  participant "SavedApi" as client
end box
box "Backend — Jubilee API" #D1FADF
  participant "SavedController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SaveBusinessCommandHandler" as handler
  participant "SaveHandler" as list
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> heart : Press the heart on an unsaved business
heart -> store : toggle(target)
store --> heart : Saved state set at once, key busy
heart --> actor : Heart shows aria-pressed="true" and aria-busy="true" (L2-041)
store -> client : saveBusiness(slug)
client -> controller : PUT /api/saved/businesses/{slug}
controller -> controller : Authenticate the session and take the member from it
controller -> handler : Send SaveBusinessCommand
handler -> db : Find the public listing by its slug
db --> handler : Listing
handler -> list : AddAsync(db, subject, Business, listingId, now)
list -> db : Is it saved already, and how many are saved?
alt Fewer than 500 items saved
  list --> handler : SavedItem
  handler -> db : Save changes in one unit of work
  db --> handler : Commit result
  handler --> controller : Success
  controller --> client : 204 No Content
  client --> store : Saved, key no longer busy
  store -> toast : Show the success toast for 8 seconds
  toast --> actor : "Saved {business}. Find it any time under Saved." with "Undo" (L2-041)
  opt Member presses "Undo" within 8 seconds
    actor -> toast : Press "Undo"
    toast -> store : remove(target)
    store --> heart : Unsaved state
    store -> client : unsaveBusiness(slug)
    client -> controller : DELETE /api/saved/businesses/{slug}
    controller --> client : 204 No Content
    client --> store : Removed
    heart --> actor : Heart returns to unpressed (L2-041)
  end
else 500 items already saved
  list --> handler : Limit reached
  handler --> controller : SAVED_LIMIT_REACHED
  controller --> client : 409 ProblemDetails
  client --> store : Refused
  store --> heart : Unsaved state
  store -> toast : Show the refusal
  toast --> actor : "You can save up to 500 items. Remove some to add more." (L2-041)
end
opt Request cannot reach the server
  client --> store : Network error
  store --> heart : Unsaved state
  store -> toast : Show the error toast with "Try again"
  toast --> actor : "Couldn't save {business}. You're offline. Reconnect and tap the heart again." (L2-041)
end
@enduml
