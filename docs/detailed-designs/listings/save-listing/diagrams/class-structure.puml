@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Save a listing

enum SavedItemKind {
  Business
  Product
}

class SavedItem {
  +{static} int MaxItems = 500
  +Guid Id
  +string MemberSubject
  +SavedItemKind Kind
  +Guid TargetId
  +DateTimeOffset SavedAt
  +{static} Business(memberSubject, listingId, now): SavedItem
  +{static} Product(memberSubject, productId, now): SavedItem
}

class SaveBusinessCommand {
  +string MemberSubject
  +string ListingSlug
}

class SaveProductCommand {
  +string MemberSubject
  +string ListingSlug
  +string ProductSlug
}

class SaveHandler {
  +{static} AddAsync(db, subject, kind, targetId, now): Task
}

class UnsaveBusinessCommand {
  +string MemberSubject
  +string ListingSlug
}

class UnsaveProductCommand {
  +string MemberSubject
  +string ListingSlug
  +string ProductSlug
}

class UnsaveItemCommand {
  +string MemberSubject
  +Guid ItemId
}

class GetSavedListQuery {
  +string MemberSubject
}

class GetSavedListQueryHandler {
  +Handle(query: GetSavedListQuery): Task<SavedListDto>
}

class SavedListDto {
  +int BusinessCount
  +int ProductCount
  +IReadOnlyList<SavedItemDto> Items
}

class SavedItemDto {
  +Guid Id
  +string Kind
  +string Name
  +DateTimeOffset SavedAt
  +bool Available
  +BusinessCardDto? Business
  +ProductCardDto? Product
}

class SavedStore {
  +list: Signal<SavedList | null>
  +load(): void
  +reset(): void
  +isSaved(target: SaveTarget): boolean
  +isBusy(target: SaveTarget): boolean
  +toggle(target: SaveTarget): void
  +save(target: SaveTarget): void
  +remove(target: SaveTarget): void
  +removeItem(item: SavedItem, done): void
}

class CardHearts {
  +attach(): void
  +isSaved(target: SaveTarget): boolean
  +isBusy(target: SaveTarget): boolean
  +press(target: SaveTarget, button: HTMLElement): void
}

class PendingActionService {
  +remember(action: PendingAction): void
  +take(kind, path): boolean
  +takeSave(path): SaveTarget | null
}

class Saveable <<jb-saveable>> {
  +name: string
  +saved: boolean
  +busy: boolean
  +pressed: output<HTMLButtonElement>
}

SavedItem --> "1" SavedItemKind
SaveHandler ..> SavedItem : adds
SaveBusinessCommand ..> SaveHandler : handled through
SaveProductCommand ..> SaveHandler : handled through
GetSavedListQueryHandler ..> GetSavedListQuery : handles
GetSavedListQueryHandler ..> SavedListDto : returns
SavedListDto *-- "0..500" SavedItemDto
SavedStore ..> SavedListDto : holds
CardHearts --> SavedStore : toggles through
CardHearts --> PendingActionService : remembers a visitor's save in
Saveable ..> CardHearts : pressed is handled by
@enduml
