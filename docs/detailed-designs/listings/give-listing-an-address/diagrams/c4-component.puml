@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Give a listing an address

Container_Boundary(api, "Jubilee API") {
  Component(submit, "PublishListingCommandHandler", "MediatR handler", "Publishes a listing; saves again with a fresh slug when two publishes collide")
  Component(save, "SaveListingCommandHandler", "MediatR handler", "Moves the slug when the business name changes")
  Component(slugs, "ListingSlugs", "Application service", "Finds a free slug; keeps the old one on a change of name")
  Component(rules, "AddressRules", "Static rules", "Shape of a slug, numeric suffix, well-formed label")
  Component(settings, "AddressSettings", "Singleton", "Address domain and reserved words")
}
Container_Boundary(cli, "Jubilee CLI") {
  Component(migrate, "JubileeCli", "Console command", "jubilee migrate")
  Component(realign, "RealignListingSlugsCommandHandler", "MediatR handler", "Gives older listings a slug that keeps the rules")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Listings and ListingSlugs")

Rel(submit, slugs, "Asks for a free slug")
Rel(save, slugs, "Follows the new name with")
Rel(migrate, realign, "Sends RealignListingSlugsCommand")
Rel(realign, slugs, "Follows the name with")
Rel(slugs, rules, "Shapes the slug with")
Rel(slugs, settings, "Reads reserved words from")
Rel(slugs, db, "Reads slugs in use and kept from", "EF Core")
Rel(submit, db, "Saves the listing to", "EF Core")
Rel(realign, db, "Saves realigned listings to", "EF Core")
@enduml
