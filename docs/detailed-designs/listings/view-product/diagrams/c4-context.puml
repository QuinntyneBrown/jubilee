@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — View a product

Person(visitor, "Visitor", "Reads a product page without an account")
Person(member, "Member", "Chooses options and asks for a back-in-stock alert")
Person(owner, "Owner", "Changes the stock of a product")
System(jubilee, "Jubilee", "Toronto's Christian marketplace")
