@startuml
title UML sequence behaviour — Stock change and back-in-stock notice
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ProductEditorDialog" as dialog
  participant "MyProductsPage" as page
  participant "ToastService" as toast
end box
box "Backend — Jubilee API" #D1FADF
  participant "CatalogueController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SaveProductCommandHandler" as handler
  participant "Product" as product
  participant "StockAlertNotifier" as notifier
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as job
end box
participant "E-mail provider" as email
actor -> dialog : Save a product with a new stock value
dialog -> controller : PUT /api/my-business/products/{id}
controller -> handler : Send SaveProductCommand
handler -> product : SetStock(stock)
alt Stock becomes 0
  product --> handler : StockChange BecameSoldOut
  handler -> db : Save changes
  db --> handler : Commit result
  handler --> controller : ProductRowDto with stockChange became-sold-out
  controller --> dialog : 200
  dialog --> page : Close with the saved product
  page -> toast : Show the warning toast
  toast --> actor : "“{product}” is sold out. Members can still ask to be told when it's back." (L2-036)
else Stock rises from 0 to above 0
  product --> handler : StockChange BackInStock
  handler -> notifier : TellAsync(product)
  notifier -> db : Load the shop and the StockAlert rows with NotifiedAt empty
  db --> notifier : Waiting members
  loop Each waiting member, when the shop is public
    notifier -> notifier : Set NotifiedAt and add the Notification "{product} is back in stock" (L2-036)
    opt "Request updates" e-mail is on and the address is confirmed (L2-068)
      notifier -> notifier : Queue one e-mail in the outbox
    end
  end
  notifier --> handler : Done
  handler -> db : Save the product, the alerts, the notifications and the e-mails in one transaction
  db --> handler : Commit result
  handler --> controller : ProductRowDto with stockChange back-in-stock
  controller --> dialog : 200
  dialog --> page : Close with the saved product
  page -> toast : Show "Product updated"
  job -> db : Read the e-mails that are due
  db --> job : The back-in-stock e-mail
  job -> email : Send it once, with its unsubscribe link
  email --> job : Accepted
  job -> db : Mark the e-mail sent
  db --> job : Saved
end
@enduml
