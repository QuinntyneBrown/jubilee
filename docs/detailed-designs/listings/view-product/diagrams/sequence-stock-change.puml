@startuml
title UML sequence behaviour — Stock change and back-in-stock notice
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "ProductEditorDialog" as dialog
  participant "ToastService" as toast
end box
box "Backend — Jubilee API" #D1FADF
  participant "ProductsController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "Product" as product
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
box "Backend — Jubilee Worker" #D1FADF
  participant "OutboxDispatcherJob" as job
  participant "StockAlertNotifier" as notifier
end box
participant "E-mail provider" as email
actor -> dialog : Save a product with a new stock value
dialog -> controller : Update the product through the owner API
controller -> product : SetStock(optionId, stock)
alt Stock in every option becomes 0
  product --> controller : StockChange BecameSoldOut
  controller -> db : Save changes in one unit of work
  db --> controller : Commit result
  controller --> dialog : 200 with stockChange becameSoldOut
  dialog -> toast : Show the warning toast
  toast --> actor : "“{product}” is sold out. Members can still ask to be told when it's back." (L2-036)
else Stock rises from 0 to above 0
  product --> controller : StockChange BackInStock
  controller -> db : Save the product and a ProductBackInStock outbox message in one transaction
  db --> controller : Commit result
  controller --> dialog : 200 with stockChange backInStock
  dialog --> actor : Close the editor
  job -> db : Read the undispatched OutboxMessage
  db --> job : ProductBackInStock
  job -> notifier : HandleAsync(message)
  notifier -> db : Load StockAlert rows with NotifiedAt empty
  db --> notifier : Waiting members
  loop Each waiting member
    notifier -> db : Set NotifiedAt and insert the in-app Notification (L2-036)
    db --> notifier : Saved
    notifier -> email : Send the back-in-stock e-mail once (L2-036)
    email --> notifier : Accepted
  end
  notifier --> job : Handled
  job -> db : Mark the OutboxMessage dispatched
  db --> job : Saved
end
@enduml
