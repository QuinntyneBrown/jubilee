@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — View a product

enum StockChange {
  None
  BecameSoldOut
  BackInStock
}

class Product {
  +Guid Id
  +Guid ListingId
  +string Slug
  +string Name
  +int PriceCents
  +bool IsPerUnit
  +int? Stock
  +int MinimumQuantity
  +string? RestockNote
  +bool IsSoldOut
  +int MaxQuantity
  +SetStock(stock: int?): StockChange
  +SetStock(optionLabel: string, stock: int?): StockChange
  +ReduceStock(optionLabel: string?, quantity: int): void
  +RestoreStock(optionLabel: string?, quantity: int): StockChange
}

class ProductOption {
  +string Label
  +int? Stock
  +int Position
  +int MaxQuantity
}

class ProductAttribute {
  +string Label
  +string Value
  +int Position
}

class StockAlert {
  +Guid Id
  +Guid ProductId
  +string MemberSubject
  +DateTimeOffset RequestedAt
  +DateTimeOffset? NotifiedAt
  +MarkNotified(now: DateTimeOffset): void
}

class GetProductPageQueryHandler {
  +Handle(query: GetProductPageQuery): Task<ProductPageDto>
}

class ProductPageDto {
  +Guid Id
  +string Name
  +int PriceCents
  +string? DeliveryLine
  +bool SoldOut
  +bool StockAlertRequested
  +IReadOnlyList<ProductOptionDto> Options
  +IReadOnlyList<ProductCardDto> More
}

class ProductCardDto {
  +string Slug
  +string Name
  +int PriceCents
  +bool SoldOut
}

class RequestStockAlertCommand {
  +Guid ProductId
  +string MemberSubject
}

class RequestStockAlertCommandHandler {
  +Handle(command: RequestStockAlertCommand): Task
}

class SaveProductCommandHandler {
  +Handle(command: SaveProductCommand): Task<ProductRowDto>
}

class ProductRowDto {
  +Guid Id
  +string Name
  +int? Stock
  +bool SoldOut
  +string StockChange
}

class StockAlertNotifier <<static>> {
  +TellAsync(db: IAppDbContext, settings: AccountSettings, product: Product, now: DateTimeOffset): Task<int>
}

class Notification {
  +string MemberSubject
  +string Kind
  +string Title
  +string Detail
  +string Target
}

Product "1" *-- "0..*" ProductOption
Product "1" *-- "0..*" ProductAttribute
Product "1" o-- "0..*" StockAlert
Product ..> StockChange : returns
GetProductPageQueryHandler ..> ProductPageDto : returns
GetProductPageQueryHandler --> Product : loads
ProductPageDto --> "0..3" ProductCardDto
RequestStockAlertCommandHandler ..> RequestStockAlertCommand : handles
RequestStockAlertCommandHandler ..> StockAlert : creates
SaveProductCommandHandler --> Product : sets stock on
SaveProductCommandHandler ..> ProductRowDto : returns
SaveProductCommandHandler ..> StockAlertNotifier : calls when BackInStock
StockAlertNotifier --> "0..*" StockAlert : marks notified
StockAlertNotifier ..> Notification : creates
@enduml
