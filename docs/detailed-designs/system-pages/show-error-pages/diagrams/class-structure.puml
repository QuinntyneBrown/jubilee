@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Show error pages
enum FailureKind {
  UpstreamDependency
  ServiceUnavailable
  Unhandled
}
class ErrorReference {
  +string Value
  +string Area
  +int Status
  +ToString(): string
}
class ErrorReferenceFactory {
  +ForLoadFailure(area: string, kind: FailureKind): ErrorReference
  +ForUnhandled(correlationId: string): ErrorReference
}
class ErrorAreaAttribute {
  +string Area
}
class JubileeProblemDetails {
  +string Type
  +string Title
  +int Status
  +string Reference
  +string CorrelationId
  +IDictionary<string, string[]> Errors
}
class ProblemDetailsMiddleware {
  +InvokeAsync(context: HttpContext): Task
  -Write(context: HttpContext, problem: JubileeProblemDetails): Task
}
class GetDocumentStatusQueryHandler {
  +Handle(query: GetDocumentStatusQuery): Task<DocumentStatusDto>
}
class DocumentStatusDto {
  +int Status
  +string? Location
}
class ListingSlugs {
  +UniqueAsync(db, name: string, listingId: Guid?): Task<string>
}
class KeptSlugRedirectAttribute {
  +OnExceptionAsync(context: ExceptionContext): Task
}
class ListingSlug {
  +string Slug
  +Guid ListingId
  +DateTimeOffset RetiredAt
}
class Listing {
  +string Slug
  +Rename(name: string, slug: string, now: DateTimeOffset): string?
}
class SaveListingCommandHandler {
  +Handle(command: SaveListingCommand): Task<EditorDto>
}
class AccessRequest {
  +Guid Id
  +string MemberSubject
  +string Url
  +DateTimeOffset CreatedAt
}
class CreateAccessRequestCommandHandler {
  +Handle(command: CreateAccessRequestCommand): Task<AccessRequestedDto>
}
class VerificationTeam {
  +Tell(db, settings, subject, textBody, now)
}

ProblemDetailsMiddleware ..> ErrorReferenceFactory : uses
ProblemDetailsMiddleware ..> JubileeProblemDetails : writes
ProblemDetailsMiddleware ..> ErrorAreaAttribute : reads
ErrorReferenceFactory --> ErrorReference : creates
ErrorReferenceFactory ..> FailureKind
JubileeProblemDetails --> "0..1" ErrorReference
GetDocumentStatusQueryHandler --> DocumentStatusDto : returns
GetDocumentStatusQueryHandler ..> ListingSlug : reads
KeptSlugRedirectAttribute ..> ListingSlug : reads
SaveListingCommandHandler ..> ListingSlugs : uses
SaveListingCommandHandler --> ListingSlug : keeps the old slug
ListingSlug --> Listing
CreateAccessRequestCommandHandler --> AccessRequest : creates
CreateAccessRequestCommandHandler ..> VerificationTeam : tells
@enduml
