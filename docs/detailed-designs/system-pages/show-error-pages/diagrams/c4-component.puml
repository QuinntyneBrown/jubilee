@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show error pages
Container_Boundary(web, "Jubilee Web") {
  Component(nf, "NotFoundPage", "Angular page", "Shows the not found copy with Back to browse and Search")
  Component(fb, "ForbiddenPage", "Angular page", "Shows the forbidden copy with Ask for access")
  Component(se, "ServerErrorPage", "Angular page", "Shows the server error copy and Reference JB-500-code")
  Component(les, "LoadErrorState", "Angular component", "Shows a failed section with its reference and Try again")
  Component(interceptor, "errorInterceptor", "HTTP interceptor", "Opens the server error and maintenance pages for a failed read")
}
Container_Boundary(hostb, "App host") {
  Component(host, "server.js", "Node", "Answers a page load with its status, the app or a static page")
  Component(manifest, "routes.json", "JSON", "The app's addresses")
  Component(statics, "Static pages", "HTML", "server-error.html and maintenance.html, no script")
}
Container_Boundary(api, "Jubilee API") {
  Component(docs, "DocumentsController", "ASP.NET Core controller", "GET /api/documents/status: 200, 301, 403 or 404")
  Component(kept, "KeptSlugRedirectAttribute", "Exception filter", "301 for a kept listing slug")
  Component(corr, "CorrelationIdMiddleware", "Middleware", "Assigns the correlation ID of each request")
  Component(pd, "ProblemDetailsMiddleware", "Middleware", "Turns failures into RFC 9457 responses without internals")
  Component(ref, "ErrorReferenceFactory", "Application service", "Builds JB-AREA-NNN and JB-500-code references")
  Component(help, "HelpController", "ASP.NET Core controller", "Exposes POST /api/help/access-requests")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Listings, kept slugs, access requests, outbox")
System_Ext(observability, "Observability platform", "Searchable logs")
System_Ext(email, "E-mail service", "Sends the outbox")

Rel(host, manifest, "Matches the address against")
Rel(host, docs, "Asks the status of a page load", "JSON/HTTP")
Rel(host, statics, "Serves when the app cannot answer")
Rel(interceptor, se, "Opens for an unhandled read failure")
Rel(fb, help, "Posts an access request to", "JSON/HTTPS")
Rel(nf, les, "Shares the layout of")
Rel(docs, db, "Reads listings and kept slugs", "EF Core")
Rel(kept, db, "Reads kept slugs", "EF Core")
Rel(pd, ref, "Asks for a reference")
Rel(pd, corr, "Reads the correlation ID from")
Rel(pd, observability, "Logs reference and correlation ID to")
Rel(help, db, "Writes the access request and the team's e-mail", "EF Core")
Rel(db, email, "Outbox sent by the worker to")
@enduml
