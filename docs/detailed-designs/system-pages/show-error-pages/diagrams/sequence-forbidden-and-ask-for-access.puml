@startuml
title UML sequence behaviour — Refuse a page and ask for access
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "Browser" as browser
  participant "ForbiddenPage" as page
  participant "HelpApi" as client
end box
box "App host — server.js" #FEF3C7
  participant "server.js" as host
end box
box "Backend — Jubilee API" #D1FADF
  participant "DocumentsController" as docs
  participant "HelpController" as controller
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "CreateAccessRequestCommandHandler" as handler
  participant "VerificationTeam" as team
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> browser : Open the owner's workspace /my-business
browser -> host : GET page URL with the session cookie
host -> docs : GET /api/documents/status?path=/my-business&owner=true
alt no session (visitor)
  docs --> host : { status: 200 }
  host --> browser : 200 with the application shell
  browser --> actor : memberGuard sends them to /sign-in with the return URL (L2-114 AC3)
else signed in, owns no listing
  docs --> host : { status: 403 }
  host --> browser : 403 with the application shell (L2-114 AC1)
  browser -> page : The page's data answers 403; show the forbidden page
  page --> actor : "You don't have access to this page." with "Back to browse" and "Ask for access"
  actor -> page : Press "Ask for access"
  page -> client : askForAccess(url)
  client -> controller : POST /api/help/access-requests with an idempotency key (L2-132)
  controller -> handler : CreateAccessRequestCommand
  handler -> handler : Validate the address; 5 an hour at most (L2-127)
  handler -> team : Tell("Access request: {address}", ...)
  team -> db : Add the e-mail to the outbox
  handler -> db : Save the AccessRequest and the e-mail together; grant nothing (L2-114 AC2)
  controller --> client : 201
  page --> actor : Toast: the request was sent
end
@enduml
