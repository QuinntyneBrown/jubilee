@startuml
title UML sequence behaviour — Save the draft when the session ends
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "FormDraftDirective" as form
  participant "sessionExpiredInterceptor" as interceptor
  participant "DraftRegistry" as registry
  participant "DraftStore" as store
  participant "SessionService" as session
  participant "SessionExpiredPage" as page
end box
box "Backend — Jubilee API" #D1FADF
  participant "Cookie authentication" as mw
  participant "DatabaseTicketStore" as sessions
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> form : Fill in a form and submit
form -> interceptor : HTTP request
interceptor -> mw : Request to /api with the session cookie
mw -> sessions : RetrieveAsync(key)
sessions -> db : Find the MemberSession by the hash of the key
db --> sessions : Row or nothing
sessions -> sessions : SessionPolicy.IsExpired - 30-day age and 12-hour inactivity (L2-010)
alt session ended
  sessions --> mw : Nothing
  mw --> interceptor : 401 ProblemDetails with code SESSION_EXPIRED
  opt SessionService.member() is still set - first refusal only (L2-116)
    interceptor -> registry : saveAll()
    registry -> form : snapshot()
    form --> registry : Values of the named controls - no password - no file
    registry -> store : save(owner, address, key, values) (L2-116)
    store --> registry : Saved in localStorage
    registry --> interceptor : Saved
    interceptor -> session : expire()
    session --> interceptor : Member cleared
    interceptor -> page : Navigate to /session-expired?returnUrl={Router.url}
    page --> actor : Show "You've been signed out." with "Sign in"
  end
else session valid
  sessions --> mw : Ticket
  mw --> interceptor : Response of the endpoint
  interceptor --> form : Result
  form --> actor : Show the result
end
@enduml
