@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Handle session expiry
class MemberSession {
  +Guid Id
  +string KeyHash
  +Guid? MemberId
  +bool Persistent
  +DateTimeOffset CreatedAt
  +DateTimeOffset LastActivityAt
  +DateTimeOffset? EndedAt
  +Touch(now: DateTimeOffset): void
  +End(now: DateTimeOffset): void
}
class SessionPolicy <<static>> {
  +TimeSpan AbsoluteLifetime = 30 days
  +TimeSpan IdleTimeout = 12 hours
  +IsExpired(session: MemberSession, now: DateTimeOffset): bool
}
class DatabaseTicketStore {
  +StoreAsync(ticket: AuthenticationTicket): Task<string>
  +RetrieveAsync(key: string): Task<AuthenticationTicket?>
  +RemoveAsync(key: string): Task
}
class "sessionExpiredInterceptor" as interceptor <<function>> {
  +(request: HttpRequest, next: HttpHandlerFn): Observable<HttpEvent>
}
class SessionService {
  +member: Signal<Member | null>
  +expire(): void
  +signOut(): Observable<void>
}
class "DraftValues" as values <<type>> {
  Record<string, string | boolean>
}
interface DraftSource {
  +key: string
  +snapshot(): DraftValues | null
  +restore(values: DraftValues): void
}
class FormDraftDirective {
  selector form[jbDraft]
  +key: string
  +snapshot(): DraftValues | null
  +restore(values: DraftValues): void
}
class DraftRegistry {
  +register(source: DraftSource): () => void
  +saveAll(): void
}
class Draft {
  +owner: string
  +address: string
  +key: string
  +values: DraftValues
  +savedAt: number
}
class DraftStore {
  localStorage key "jubilee-drafts"
  +save(owner: string, address: string, key: string, values: DraftValues): void
  +take(owner: string, address: string, key: string): DraftValues | null
  +keepOnly(owner: string): void
}
class "draftOwner" as owner <<function>> {
  +draftOwner(member: Member): string
}
class SignOutDialog {
  #confirm(): void
}
class "sanitiseReturnUrl" as sanitise <<function>> {
  +sanitiseReturnUrl(value: string | null): string
}
class SessionExpiredPage {
  #signInQuery: { returnUrl: string }
}

DatabaseTicketStore --> MemberSession : stores
DatabaseTicketStore ..> SessionPolicy : uses
SessionPolicy ..> MemberSession : evaluates
FormDraftDirective ..|> DraftSource
DraftSource ..> values
DraftRegistry "1" o-- "*" DraftSource
DraftRegistry ..> DraftStore : saves and takes
DraftRegistry ..> owner : names the member
DraftRegistry ..> SessionService : reads the member
DraftStore "1" o-- "*" Draft
Draft --> values
interceptor ..> DraftRegistry : saveAll
interceptor ..> SessionService : expire
SignOutDialog ..> DraftRegistry : saveAll
SignOutDialog ..> SessionService : signOut
SessionExpiredPage ..> sanitise : uses
@enduml
