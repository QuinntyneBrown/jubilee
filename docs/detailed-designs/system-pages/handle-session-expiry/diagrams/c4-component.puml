@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Handle session expiry
Container_Boundary(web, "Jubilee Web") {
  Component(form, "FormDraftDirective", "Angular directive form[jbDraft]", "Draft source of a form of named native controls")
  Component(interceptor, "sessionExpiredInterceptor", "HTTP interceptor", "Reacts to 401 SESSION_EXPIRED from any API call")
  Component(registry, "DraftRegistry", "Angular service", "Holds the draft sources of the page on screen - saves and restores their drafts")
  Component(store, "DraftStore", "Angular service", "Keeps drafts in localStorage per member - address and key")
  Component(owner, "draftOwner", "Function", "Hashes the member's e-mail address")
  Component(toasts, "ToastService", "Angular service", "Shows We kept what you typed")
  Component(session, "SessionService", "Angular service", "Holds the signed-in member")
  Component(page, "SessionExpiredPage", "Angular page", "Shows the signed-out copy and Sign in at /session-expired")
  Component(signin, "SignInPage", "Angular page", "Signs in and navigates to the return URL")
  Component(signout, "SignOutDialog", "Angular dialog", "Saves drafts before sign-out")
}
Container_Boundary(api, "Jubilee API") {
  Component(mw, "Cookie authentication", "ASP.NET Core cookie scheme", "Resolves the session cookie and answers 401 SESSION_EXPIRED")
  Component(ctrl, "SessionController", "ASP.NET Core controller", "Exposes POST /api/session")
  Component(sessions, "DatabaseTicketStore", "ASP.NET Core ITicketStore", "Reads and writes MemberSession rows")
}
ContainerDb(db, "Jubilee database", "SQL Server", "Sessions table")

Rel(form, registry, "Registers with")
Rel(interceptor, mw, "Receives 401 from", "JSON/HTTPS")
Rel(interceptor, registry, "Calls saveAll on")
Rel(interceptor, session, "Expires the member in")
Rel(interceptor, page, "Navigates to with returnUrl")
Rel(signout, registry, "Calls saveAll on")
Rel(registry, store, "Saves and takes drafts through")
Rel(registry, owner, "Names the member with")
Rel(registry, session, "Reads the member from")
Rel(registry, form, "Restores the draft of")
Rel(registry, toasts, "Announces a restored draft through")
Rel(page, signin, "Links to with returnUrl")
Rel(signin, ctrl, "Signs in through", "JSON/HTTPS")
Rel(mw, sessions, "Retrieves the session through")
Rel(ctrl, sessions, "Starts a new session through")
Rel(sessions, db, "Reads and writes", "EF Core")
@enduml
