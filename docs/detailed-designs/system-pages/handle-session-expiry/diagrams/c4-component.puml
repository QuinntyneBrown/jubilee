@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Handle session expiry
Container_Boundary(web, "Jubilee Web") {
  Component(form, "FormDraftDirective", "Angular directive", "Registers a form as a draft source and applies restored values")
  Component(interceptor, "SessionExpiryInterceptor", "HTTP interceptor", "Reacts to 401 SESSION_EXPIRED from any API call")
  Component(registry, "DraftRegistry", "Angular service", "Collects the drafts of every registered form on the current page")
  Component(store, "DraftStore", "Angular service", "Persists drafts in browser storage per member and route")
  Component(ret, "ReturnUrlService", "Angular service", "Remembers and validates the page to return to")
  Component(page, "SessionExpiredPage", "Angular page", "Shows the signed-out copy and Sign in at /session-expired")
  Component(signin, "SignInPage", "Angular page", "Signs in and navigates to the return URL")
}
Container_Boundary(api, "Jubilee API") {
  Component(mw, "SessionAuthenticationMiddleware", "Middleware", "Validates the session cookie and its lifetime")
  Component(auth, "AuthController", "ASP.NET Core controller", "Exposes POST /api/auth/sign-in")
  Component(sessions, "SessionStore", "Infrastructure service", "Reads and writes Session records")
}
ContainerDb(cache, "Cache", "Redis", "Sessions")

Rel(form, registry, "Registers with")
Rel(interceptor, mw, "Receives 401 from", "JSON/HTTPS")
Rel(interceptor, registry, "Asks for current drafts")
Rel(interceptor, store, "Saves drafts through")
Rel(interceptor, ret, "Stores the current URL in")
Rel(interceptor, page, "Navigates to")
Rel(page, signin, "Links to")
Rel(signin, auth, "Signs in through", "JSON/HTTPS")
Rel(signin, ret, "Reads the return URL from")
Rel(form, store, "Restores its draft from")
Rel(mw, sessions, "Loads the session through")
Rel(auth, sessions, "Creates a new session through")
Rel(sessions, cache, "Reads and writes", "Redis protocol")
@enduml
