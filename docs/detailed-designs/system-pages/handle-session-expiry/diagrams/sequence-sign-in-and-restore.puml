@startuml
title UML sequence behaviour — Sign in and restore the draft
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "SessionExpiredPage" as page
  participant "SignInPage" as signin
  participant "FormDraftDirective" as form
  participant "DraftRegistry" as registry
  participant "DraftStore" as store
  participant "ToastService" as toasts
end box
box "Backend — Jubilee API" #D1FADF
  participant "SessionController" as controller
  participant "DatabaseTicketStore" as sessions
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "SignInCommandHandler" as handler
end box
box "Backend — Jubilee Infrastructure" #FFF4E5
  database "Jubilee database" as db
end box
actor -> page : Press "Sign in"
page -> page : sanitiseReturnUrl - accept same-origin paths only
page -> signin : Navigate to /sign-in?returnUrl={return URL}
actor -> signin : Enter credentials
signin -> controller : POST /api/session
controller -> handler : Send SignInCommand
handler -> db : Load the member and verify the password
db --> handler : Member
handler --> controller : Outcome SignedIn
controller -> sessions : SignInMemberAsync - StoreAsync(ticket)
sessions -> db : Add a MemberSession row with a new identifier (L2-010)
db --> sessions : Commit result
sessions --> controller : New key
controller --> signin : 200 with a new session cookie
signin -> form : Navigate to the return URL - the form appears
form -> registry : register(source)
registry -> store : take(owner, address, key)
alt draft belongs to this member and is under 30 days old
  store --> registry : Values - removed from localStorage
  registry -> form : restore(values) (L2-116)
  form -> form : Write the values and dispatch input and change
  registry -> toasts : Show "We kept what you typed"
  form --> actor : Show the same page with the draft restored
else no draft or another member signed in
  store --> registry : Nothing
  form --> actor : Show the page with an empty form
end
@enduml
