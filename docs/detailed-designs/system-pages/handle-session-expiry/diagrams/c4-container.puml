@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Handle session expiry
Person(member, "Member", "Signs in again after the session ended")
System_Boundary(jubilee, "Jubilee") {
  Container(web, "Jubilee Web", "Angular single-page application", "Saves drafts in browser storage and shows /session-expired and restores drafts")
  Container(api, "Jubilee API", "ASP.NET Core", "Authenticates the session cookie and answers 401 when the session ended")
  ContainerDb(db, "Jubilee database", "SQL Server", "Members - credentials and the Sessions table")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and creates sessions and reads the member at sign-in", "EF Core")
@enduml
