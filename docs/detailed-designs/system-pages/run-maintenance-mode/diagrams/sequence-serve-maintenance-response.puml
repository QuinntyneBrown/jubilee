@startuml
title UML sequence behaviour — Answer requests during maintenance
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Jubilee Web" #E0F2FE
  participant "Browser" as browser
  participant "errorInterceptor" as interceptor
  participant "MaintenancePage" as page
end box
box "App host — server.js" #FEF3C7
  participant "server.js" as host
end box
box "Backend — Jubilee API" #D1FADF
  participant "MaintenanceMiddleware" as mw
  participant "Rest of the pipeline" as next
end box
box "Backend — Jubilee Application and Domain" #ECFDF3
  participant "MaintenanceState" as state
end box
actor -> browser : Request any page
browser -> host : GET page URL
host -> mw : GET /api/documents/status?path=
mw -> state : Current
state --> mw : MaintenanceOptions
alt maintenance mode is on
  mw -> mw : Compute Retry-After from the back-by time (L2-117)
  mw --> host : 503 ProblemDetails MAINTENANCE with backBy and Retry-After
  host -> host : Write the back-by time into static/maintenance.html
  host --> browser : 503 with Retry-After and the static maintenance page, no script
  browser --> actor : Show "Jubilee is being updated." with the back-by time and "Check again"
else maintenance mode is off
  mw -> next : Next
  next --> mw : { status }
  mw --> host : { status }
  host --> browser : The application shell
  browser --> actor : Show the page
end
opt the application is already open when the switch turns on
  actor -> browser : Use the open application
  browser -> interceptor : HTTP request
  interceptor -> mw : API call
  mw --> interceptor : 503 ProblemDetails with code MAINTENANCE, backBy and Retry-After
  interceptor -> page : Navigate with the back-by time
  page --> actor : Show "We're back by {time} Eastern on {day}. Nothing you've sent is lost."
  actor -> page : Press "Check again"
  page -> mw : Open the page the member left again
  mw --> page : 503 again, or the page's data once the switch is off
end
@enduml
