{
  "name": "jubilee-e2e",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test --trace off",
    "baseline": "JB_BASELINE=1 playwright test tests/visual --update-snapshots --trace off",
    "sweeps": "npm run baseline && JB_SWEEPS=1 playwright test tests/visual tests/responsive.spec.ts tests/accessibility.spec.ts --trace off",
    "record-api": "JB_RECORD_API=1 playwright test --trace off",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "http-server": "^14.1.1",
    "typescript": "~6.0.2"
  }
}
